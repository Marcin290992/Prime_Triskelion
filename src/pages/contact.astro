---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Prime Triskelion">

  <main id="contact-page">

    <!-- ── Page header ──────────────────────────────────────────────── -->
    <!-- Desktop only: .cp-header-pin reserves the header's FULL (unshrunk)
         height, set once in JS as an explicit inline height rather than
         left to shrink along with the title — the form grid's position
         comes from that reserved height, not from .cp-header's own live
         (shrinking) size. Keeping them decoupled is what leaves the form
         actually visible under the collapsed header instead of tucked
         behind it: if the reserved space shrank in lockstep with the
         header, the grid would always sit exactly at the header's current
         covered height, however small — meaning content directly below
         would be hidden the instant the shrink finished, no matter how
         short the shrink or how small the final size (this was tried; see
         git history/prior notes). Reserving the full height up front means
         there's real slack for the small, pinned header and the fully
         visible form to coexist, for as long as that slack lasts.
         .cp-header itself is sticky (top:0) inside that reserved space and
         shrinks (font-size, via --cp-title-scale, on .cp-header-content —
         .cp-header's own padding-top, which clears the fixed logo, stays
         constant) tied to raw window.scrollY rather than its own position,
         since a stuck sticky element's getBoundingClientRect().top doesn't
         move — it'd never see the shrink finish.
         Mobile is untouched: see the mobile media query, which resets both
         back to normal (non-pinned, non-shrinking) flow. -->
    <div class="cp-header-pin">
    <div class="cp-header">
      <canvas id="contact-flame-canvas" aria-hidden="true"></canvas>
      <div class="cp-header-content">
        <h1 class="cp-title">
          <span class="cp-title__line"><span class="cp-title__word">Let's build</span></span>
          <span class="cp-title__line"><span class="cp-title__word">something</span></span>
          <span class="cp-title__line"><span class="cp-title__word cta-red">sharp.</span></span>
        </h1>
      </div>
    </div>
    </div>

    <!-- ── Two-column grid ──────────────────────────────────────────── -->
    <div class="cp-grid" data-after-hero>

      <!-- LEFT: brand info -->
      <aside class="cp-info">
        <div class="cp-info__body">
          <p class="cp-info__label">Direct line</p>
          <a href="mailto:hello@primetriskelion.com" class="cp-info__email">
            <span class="cp-info__email-text">hello@primetriskelion.com</span>
            <span class="cp-info__email-arrow" aria-hidden="true">↗</span>
          </a>

          <p class="cp-info__label">Availability</p>
          <p class="cp-info__val">
            <span class="cp-info__dot"></span>Open for new projects
          </p>
          <p class="cp-info__val cp-info__val--sub">Replies within 24 hours</p>

          <p class="cp-info__label">Studio</p>
          <p class="cp-info__val">London, UK</p>
          <p class="cp-info__val cp-info__val--sub">
            Local time <span class="cp-info__time" id="cp-local-time">--:--</span> · Est. 2024
          </p>
        </div>
      </aside>

      <!-- RIGHT: form -->
      <div class="cp-form-col">
        <form id="contact-form" class="cp-form" novalidate>

          <div class="cp-row cp-row--2">
            <div class="cp-field">
              <label for="cf-name" class="cp-label">
                <span class="cp-label__num">01</span>Full Name <span class="cp-req" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="cf-name"
                name="name"
                placeholder="First &amp; Last Name"
                autocomplete="name"
                required
              />
            </div>

            <div class="cp-field">
              <label for="cf-company" class="cp-label"><span class="cp-label__num">02</span>Company / Brand</label>
              <input
                type="text"
                id="cf-company"
                name="company"
                placeholder="Your brand name"
                autocomplete="organization"
              />
            </div>
          </div>

          <div class="cp-row cp-row--2">
            <div class="cp-field">
              <label for="cf-email" class="cp-label">
                <span class="cp-label__num">03</span>Email <span class="cp-req" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="cf-email"
                name="email"
                placeholder="hello@yourcompany.com"
                autocomplete="email"
                required
              />
            </div>

            <div class="cp-field">
              <label for="cf-phone" class="cp-label"><span class="cp-label__num">04</span>Phone</label>
              <input
                type="tel"
                id="cf-phone"
                name="phone"
                placeholder="+44 ··· ··· ····"
                autocomplete="tel"
              />
            </div>
          </div>

          <fieldset class="cp-row cp-chips-set">
            <legend class="cp-label"><span class="cp-label__num">05</span>What do you need?</legend>
            <div class="cp-chips">
              {['Branding', 'Website', 'Development', '3D', 'Motion', 'Strategy'].map((s) => (
                <label class="cp-chip">
                  <input type="checkbox" name="service" value={s} />
                  <span class="cp-chip__face">{s}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="cp-row cp-chips-set">
            <legend class="cp-label"><span class="cp-label__num">06</span>Budget</legend>
            <div class="cp-chips">
              {['< £5k', '£5–15k', '£15–30k', '£30k+', 'Not sure yet'].map((b) => (
                <label class="cp-chip">
                  <input type="radio" name="budget" value={b} />
                  <span class="cp-chip__face">{b}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="cp-row">
            <div class="cp-field">
              <label for="cf-message" class="cp-label">
                <span class="cp-label__num">07</span>Tell me more <span class="cp-req" aria-hidden="true">*</span>
              </label>
              <textarea
                id="cf-message"
                name="message"
                placeholder="Describe your project, goals, timeline…"
                rows="4"
                required
              ></textarea>
            </div>
          </div>

          <!-- GDPR -->
          <div class="cp-row">
            <label class="cp-consent" for="cf-gdpr">
              <input type="checkbox" id="cf-gdpr" name="gdpr" required />
              <span class="cp-consent__box" aria-hidden="true"></span>
              <span class="cp-consent__text">
                I've read the privacy policy and consent to my data being stored
                to receive information about Prime Triskelion services.
              </span>
            </label>
          </div>

          <!-- Submit -->
          <div class="cp-row cp-row--submit">
            <div class="h-hero-cta-wrap">
              <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
              <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
              <button type="submit" class="h-hero-cta h-hero-cta--fixed" id="cf-submit-btn">
                <span class="hud-spin-border"></span>
                <span class="h-hero-cta__text">Send message</span>
                <span class="cp-submit__arrow" aria-hidden="true">→</span>
              </button>
            </div>
            <p class="cp-submit__note" id="cf-status" aria-live="polite"></p>
          </div>

        </form>

        <!-- Shown in place of the form once it's sent -->
        <div class="cp-success" id="cp-success" hidden>
          <p class="cp-success__kicker"><span class="cp-info__dot"></span>Message received</p>
          <p class="cp-success__title">Thank you.<br /><span class="cta-red">Talk soon.</span></p>
          <p class="cp-success__text">I'll read it properly and get back to you within 24 hours.</p>
          <button type="button" class="cp-success__again" id="cp-send-another">Send another message</button>
        </div>
      </div>

    </div>
  </main>

</Layout>

<style>
  /* ── Page wrapper ──────────────────────────────────────────────────── */
  #contact-page {
    background: rgb(var(--c-bg));
    min-height: 100svh;
    padding-top: clamp(7rem, 14vw, 12rem);
    padding-bottom: clamp(6rem, 12vw, 12rem);
    padding-inline: var(--site-gutter, 2rem);
  }
  @media (min-width: 1025px) {
    #contact-page { padding-right: clamp(5rem, 8vw, 9rem); }
    /* .cp-header carries its own top padding on desktop (below), so don't
       double it up with the page wrapper's — that stacking is what blew up
       the hero on short/wide laptop screens (e.g. 1920×1080). */
    #contact-page { padding-top: 0; }
  }

  /* ── Header ────────────────────────────────────────────────────────── */
  .cp-header {
    position: relative;
    overflow: hidden;
    /* vh-based, like every other page hero on the site — vw made this scale
       with viewport width instead of height, so on wide-but-short laptop
       screens it produced a huge empty top gap. */
    padding: clamp(6rem, 12vh, 10rem) 0 clamp(4rem, 8vh, 6rem);
  }
  #contact-flame-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.5;
    pointer-events: none;
    /* Same intersected masks as the CTA flame: a soft fade-in from the top
       so the header's own boundary doesn't read as a hard cut, and a
       fade-in from the left so the flame never shows behind the headline,
       which sits in roughly the left 58%. */
    mask-image:
      linear-gradient(to bottom, transparent 0%, black 30%),
      linear-gradient(to right, transparent 0%, transparent 58%, black 74%, black 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, black 30%),
      linear-gradient(to right, transparent 0%, transparent 58%, black 74%, black 100%);
    -webkit-mask-composite: source-in;
  }

  /* ── Header shrink + pin (desktop only) ─────────────────────────────────
     See the long comment in the markup above .cp-header-pin for why the
     reserved space and the visual shrink are deliberately decoupled. */
  @media (min-width: 1025px) {
    .cp-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgb(var(--c-bg));
      /* Bottom padding shrinks along with the title (top stays fixed —
         it's clearing the fixed logo) so the collapsed header is
         genuinely compact, not just smaller text floating in the same
         tall box. */
      padding-bottom: calc(clamp(4rem, 8vh, 6rem) * var(--cp-title-scale, 1));
    }
    /* 16vh cap: on wide-but-short laptops (MacBook Air 13") the 10vw title
       took ~60% of the first screen and pushed the form down under the
       bottom HUD. */
    .cp-header-content .cp-title {
      font-size: calc(clamp(3.5rem, min(10vw, 16vh), 13rem) * var(--cp-title-scale, 1));
    }
  }

  @media (max-width: 1024px) {
    /* Title runs full-width on mobile/tablet, so there's no clear column
       for the flame to sit beside without crossing the text. Instead of
       hiding it, dial it down to a faint full-width ambient glow (top/bottom
       fade only, no left/right mask) — too dim to compete with the text. */
    #contact-flame-canvas {
      opacity: 0.16;
      mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 80%, transparent 100%);
      mask-composite: intersect;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 80%, transparent 100%);
      -webkit-mask-composite: source-in;
    }
  }
  .cp-title {
    position: relative;
    z-index: 1;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 10vw, 13rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
    margin: 0;
    opacity: 0;
    filter: blur(20px);
    transition: opacity 0.9s ease 0.1s, filter 1.1s cubic-bezier(0.16,1,0.3,1) 0.1s;
  }
  .cp-title.is-visible { opacity: 1; filter: blur(0); }
  .cp-title__line { display: block; }
  /* Mobile: each line blurs in on its own (staggered, see initContact),
     like the other page titles — the h1 itself is shown as-is. */
  @media (max-width: 1024px) {
    .cp-title { opacity: 1; filter: none; transition: none; }
    .cp-title__word { display: block; opacity: 0; filter: blur(18px); }
  }

  /* ── Two-column grid ───────────────────────────────────────────────── */
  .cp-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: start;
    opacity: 0;
    transform: translateY(20px);
    filter: blur(8px);
    transition: opacity 0.8s ease 0.35s, transform 0.8s cubic-bezier(0.16,1,0.3,1) 0.35s, filter 0.9s ease 0.35s;
  }
  .cp-grid.is-visible { opacity: 1; transform: none; filter: blur(0); }

  /* ── Left: info column ─────────────────────────────────────────────── */
  .cp-info {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .cp-info__body {
    display: flex;
    flex-direction: column;
  }
  .cp-info__label {
    font-family: var(--f-body);
    font-size: 10px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgb(var(--c-red) / 0.75);
    margin: 2rem 0 0.7rem;
  }
  .cp-info__label:first-child { margin-top: 0; }
  /* The email is the page's second CTA: bigger, with a red underline that
     draws in on hover and an arrow that lifts. */
  .cp-info__email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    align-self: flex-start;
    max-width: 100%;
    font-family: var(--f-body);
    font-size: clamp(1.05rem, 1.55vw, 1.55rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    color: rgb(var(--c-cream));
    text-decoration: none;
  }
  .cp-info__email-text {
    overflow-wrap: anywhere;
    background: linear-gradient(rgb(var(--c-red)), rgb(var(--c-red))) no-repeat left bottom / 0% 1px;
    padding-bottom: 0.2em;
    transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cp-info__email-arrow {
    color: rgb(var(--c-red));
    font-size: 0.8em;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cp-info__email:hover .cp-info__email-text,
  .cp-info__email:focus-visible .cp-info__email-text { background-size: 100% 1px; }
  .cp-info__email:hover .cp-info__email-arrow { transform: translate(3px, -3px); }
  .cp-info__time { color: rgb(var(--c-cream) / 0.6); font-variant-numeric: tabular-nums; }
  .cp-info__val {
    font-family: var(--f-body);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 300;
    color: rgb(var(--c-cream) / 0.75);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cp-info__val--sub {
    display: block;
    font-size: clamp(0.82rem, 1vw, 0.95rem);
    color: rgb(var(--c-cream) / 0.38);
    margin-top: 0.3rem;
  }
  .cp-info__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(74, 222, 128);
    flex-shrink: 0;
    animation: dot-pulse 2.4s ease-in-out infinite;
  }
  @keyframes dot-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  /* ── Form ──────────────────────────────────────────────────────────── */
  /* Editorial form: numbered labels, underline-only fields with large type,
     services/budget as selectable chips, a red rule that draws in under the
     focused field. */
  .cp-form {
    display: flex;
    flex-direction: column;
    gap: clamp(1.4rem, 2.6vh, 2rem);
  }
  .cp-row { display: flex; flex-direction: column; gap: 1rem; }
  .cp-row--2 { flex-direction: row; gap: clamp(1.5rem, 3vw, 2.75rem); }
  .cp-row--2 .cp-field { flex: 1 1 0; min-width: 0; }
  .cp-row--submit {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .cp-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .cp-label {
    display: flex;
    align-items: baseline;
    gap: 0.9em;
    padding: 0;
    font-family: var(--f-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.5);
  }
  .cp-label__num {
    letter-spacing: 0.12em;
    color: rgb(var(--c-red) / 0.8);
  }
  .cp-req { color: rgb(var(--c-red)); margin-left: -0.6em; }

  /* Inputs & textarea: underline only */
  .cp-form input[type="text"],
  .cp-form input[type="email"],
  .cp-form input[type="tel"],
  .cp-form input[type="url"],
  .cp-form textarea {
    width: 100%;
    background:
      linear-gradient(rgb(var(--c-red)), rgb(var(--c-red))) no-repeat left bottom / 0% 1px,
      linear-gradient(rgb(var(--c-cream) / 0.16), rgb(var(--c-cream) / 0.16)) no-repeat left bottom / 100% 1px;
    border: 0;
    border-radius: 0;
    padding: 0.55rem 0 0.7rem;
    font-family: var(--f-body);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    font-weight: 300;
    letter-spacing: -0.005em;
    color: rgb(var(--c-cream));
    outline: none;
    transition: background-size 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-appearance: none;
    appearance: none;
  }
  .cp-form input::placeholder,
  .cp-form textarea::placeholder {
    color: rgb(var(--c-cream) / 0.2);
  }
  .cp-form input:focus,
  .cp-form textarea:focus,
  .cp-form input.is-invalid,
  .cp-form textarea.is-invalid {
    background-size: 100% 1px, 100% 1px;
  }
  .cp-form textarea {
    resize: none;
    min-height: clamp(90px, 14vh, 140px);
    line-height: 1.5;
  }

  /* Chips (services: multi-select, budget: single) */
  .cp-chips-set { border: 0; margin: 0; padding: 0; min-width: 0; }
  .cp-chips-set legend { margin-bottom: 0.9rem; }
  .cp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cp-chip { position: relative; cursor: pointer; }
  .cp-chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .cp-chip__face {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.05rem;
    border: 1px solid rgb(var(--c-cream) / 0.14);
    font-family: var(--f-body);
    font-size: clamp(0.82rem, 0.95vw, 0.92rem);
    font-weight: 400;
    color: rgb(var(--c-cream) / 0.62);
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cp-chip__face::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-left: -0.55rem;
    background: rgb(var(--c-red));
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), margin 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .cp-chip:hover .cp-chip__face { border-color: rgb(var(--c-cream) / 0.32); color: rgb(var(--c-cream) / 0.9); }
  }
  .cp-chip input:focus-visible + .cp-chip__face { border-color: rgb(var(--c-cream) / 0.55); }
  .cp-chip input:checked + .cp-chip__face {
    border-color: rgb(var(--c-red) / 0.7);
    background: rgb(var(--c-red) / 0.1);
    color: rgb(var(--c-cream));
  }
  .cp-chip input:checked + .cp-chip__face::before { transform: scale(1); margin-left: 0; }

  /* Consent checkbox */
  .cp-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }
  .cp-consent input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .cp-consent__box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    border: 1px solid rgb(var(--c-cream) / 0.2);
    background: transparent;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .cp-consent__box::after {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    background: rgb(var(--c-red));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cp-consent input:checked ~ .cp-consent__box { border-color: rgb(var(--c-red) / 0.6); }
  .cp-consent input:checked ~ .cp-consent__box::after { opacity: 1; }
  .cp-consent input:focus-visible ~ .cp-consent__box { border-color: rgb(var(--c-cream) / 0.55); }
  .cp-consent.is-invalid .cp-consent__box { border-color: rgb(var(--c-red) / 0.8); }
  .cp-consent__text {
    font-family: var(--f-body);
    font-size: clamp(0.72rem, 0.85vw, 0.8rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--c-cream) / 0.38);
  }

  /* Submit: the form's one big action */
  #cf-submit-btn {
    gap: 0.85rem;
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    padding: 1.15rem 2.1rem;
  }
  .cp-submit__arrow {
    color: rgb(var(--c-red));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #cf-submit-btn:hover .cp-submit__arrow { transform: translateX(5px); }
  #cf-submit-btn:disabled { opacity: 0.55; cursor: progress; }

  .cp-submit__note {
    font-family: var(--f-body);
    font-size: 0.8rem;
    font-weight: 300;
    color: rgb(var(--c-cream) / 0.4);
    margin: 0;
  }
  .cp-submit__note--ok  { color: rgba(74, 222, 128, 0.85); }
  .cp-submit__note--err { color: rgb(var(--c-red) / 0.85); }

  /* Sent state (replaces the form) */
  .cp-success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    padding: clamp(1rem, 3vh, 2.5rem) 0;
  }
  .cp-success[hidden],
  .cp-form[hidden] { display: none; }
  .cp-success__kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--f-body);
    font-size: 10px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.55);
  }
  .cp-success__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.6rem, min(5.5vw, 9vh), 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }
  .cp-success__text {
    margin: 0;
    max-width: 38ch;
    font-family: var(--f-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--c-cream) / 0.6);
  }
  .cp-success__again {
    margin-top: 0.6rem;
    padding: 0 0 0.2rem;
    background: none;
    border: 0;
    border-bottom: 1px solid rgb(var(--c-cream) / 0.25);
    font-family: var(--f-body);
    font-size: 0.85rem;
    color: rgb(var(--c-cream) / 0.6);
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .cp-success__again:hover { color: rgb(var(--c-cream)); border-color: rgb(var(--c-red)); }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .cp-header {
      /* Keep real padding here (matching CtaSection's mobile scale) instead
         of zeroing it out — the flame canvas is still visible at 0.16
         opacity on mobile, and collapsing this to padding:0 starved it of
         vertical room, squashing its shape into a flat sliver that didn't
         match the flame's appearance on every other page's CTA section. */
      padding: clamp(4rem, 14vw, 8rem) 0 clamp(3rem, 10vw, 6rem);
      /* Cinematic first screen, softer than Projects/Services: ~82% of
         the (stable) screen with the title centred in it — so a bit above
         the middle — and the top of the contact details peeking in below,
         since people here usually want the form. */
      box-sizing: border-box;
      min-height: 82svh;
      min-height: calc(var(--app-stable-vh, 1svh) * 82);
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-bottom: 1.5rem;
    }
    /* The header now clears the logo itself. */
    #contact-page { padding-top: 0; }
    .cp-grid {
      grid-template-columns: 1fr;
      gap: clamp(3.5rem, 9vw, 5.5rem);
      /* Mobile: plain fade after the title (data-after-hero), not the
         desktop blur/slide-up. */
      opacity: 1;
      transform: none;
      filter: none;
      transition: opacity 0.8s ease;
    }
    .cp-info {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2rem;
    }
    .cp-info__body { flex: 1 1 240px; }
    .cp-info__email { font-size: clamp(1.15rem, 4.6vw, 1.5rem); }

    .cp-form { gap: 2rem; }
    .cp-row--2 { gap: 2rem; }
    .cp-row--submit { margin-top: 0.5rem; }
    /* iOS Safari auto-zooms the page on focus for any field under 16px —
       keep every field at 16px+ on touch widths. */
    .cp-form input[type="text"],
    .cp-form input[type="email"],
    .cp-form input[type="tel"],
    .cp-form input[type="url"],
    .cp-form textarea {
      font-size: 1.1rem;
      padding: 0.7rem 0 0.8rem;
    }
    .cp-form textarea { min-height: 120px; }
    /* Bigger tap targets for the chips. */
    .cp-chip__face { padding: 0.75rem 1.1rem; font-size: 0.9rem; }
    .cp-chip__face::before { display: none; }
    #cf-submit-btn { padding: 1.2rem 1.5rem; }
    .cp-success__title { font-size: clamp(2.6rem, 11vw, 4.5rem); }
  }

  /* Phones: one field per row, full-width submit. */
  @media (max-width: 640px) {
    .cp-row--2 { flex-direction: column; }
    .cp-row--submit { flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  import { onReady } from '../utils/onReady';
  import { afterPageTransition, revealAfterHero } from '../utils/afterPageTransition';
  import gsap from 'gsap';
  import { sendContactEmail } from '../utils/sendContactEmail';
  import { initFlameCanvas } from '../utils/flameCanvas';

  function initContactFlame() {
    const canvas = document.getElementById('contact-flame-canvas') as HTMLCanvasElement | null;
    const header = document.querySelector<HTMLElement>('.cp-header');
    if (!canvas || !header) return;
    initFlameCanvas(canvas, header);
  }

  let _shrinkCleanup: (() => void) | null = null;

  // Shrinks the header (via --cp-title-scale, consumed by .cp-header-content
  // in <style> above) tied to raw scroll position — .cp-header is sticky
  // and pinned at top:0 (see its desktop rule in <style>), so it stays on
  // screen the whole time, shrinking quickly and then staying small.
  // Desktop only; mobile never pins or shrinks the header.
  function initContactShrink() {
    _shrinkCleanup?.();
    _shrinkCleanup = null;

    if (window.matchMedia('(max-width: 1024px)').matches) return;

    const pinWrap = document.querySelector<HTMLElement>('.cp-header-pin');
    const header = document.querySelector<HTMLElement>('.cp-header');
    const page = document.getElementById('contact-page');
    if (!pinWrap || !header || !page) return;

    // A contact page is high-intent — the shrink should read as quick and
    // get out of the way, not as a scroll story to sit through.
    const MIN_SCALE = 0.4;
    // How much scroll it takes to fully shrink, as a fraction of one
    // viewport height — a short runway means one quick flick of the wheel
    // gets straight past the collapsing hero.
    const RUNWAY_FRAC = 0.15;

    // .cp-header-pin reserves the header's full (unshrunk) height as a
    // constant, regardless of how far it's currently shrunk — see the long
    // comment in the markup above .cp-header-pin for why. Re-measured on
    // resize and once webfonts are actually in (font-display: swap can
    // make the very first measurement land on the fallback font, which is
    // narrower/shorter).
    function measurePinHeight() {
      page!.style.setProperty('--cp-title-scale', '1');
      pinWrap!.style.height = `${header!.offsetHeight}px`;
    }
    measurePinHeight();
    window.addEventListener('resize', measurePinHeight);
    document.fonts?.ready?.then(measurePinHeight).catch(() => {});

    function update() {
      // .cp-header is sticky and pinned essentially from the first pixel
      // of scroll, so its own getBoundingClientRect().top stays put at ~0
      // once stuck — it can't tell us how far the page has actually
      // scrolled. Raw scrollY can, since the header sticks right at the
      // very top of the page.
      const runway = Math.max(1, window.innerHeight * RUNWAY_FRAC);
      const scrolled = Math.max(0, Math.min(runway, window.scrollY));
      const progress = scrolled / runway;
      const scale = 1 - progress * (1 - MIN_SCALE);
      page!.style.setProperty('--cp-title-scale', String(scale));
    }

    // 'scroll' can fire multiple times per animation frame during a fast
    // flick — batching the write down to once per frame avoids forcing a
    // layout recalculation more often than the browser can actually paint.
    let rafId = 0;
    function onScroll() {
      if (rafId) return;
      rafId = requestAnimationFrame(() => { rafId = 0; update(); });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();

    _shrinkCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', update);
      window.removeEventListener('resize', measurePinHeight);
      if (rafId) cancelAnimationFrame(rafId);
    };
  }

  function initContact() {
    const page = document.getElementById('contact-page');
    if (!page) return;

    // ── Entrance animations ────────────────────────────────────────────
    const title  = page.querySelector('.cp-title')  as HTMLElement | null;
    const grid   = page.querySelector('.cp-grid')   as HTMLElement | null;

    afterPageTransition(() => requestAnimationFrame(() => {
      // Mobile: line-by-line blur-in, same as About's "Who's Behind?" and
      // the Projects/Services titles.
      if (window.matchMedia('(max-width: 1024px)').matches) {
        gsap.timeline({ defaults: { ease: 'power4.out' } })
          .to(page.querySelectorAll<HTMLElement>('.cp-title__word'),
            { opacity: 1, filter: 'blur(0px)', duration: 1.15, stagger: 0.14 }, 0.08);
      } else if (title) {
        setTimeout(() => title.classList.add('is-visible'), 80);
      }
      // Mobile: the grid fades in via revealAfterHero instead.
      if (grid && !window.matchMedia('(max-width: 1024px)').matches)
        setTimeout(() => grid.classList.add('is-visible'), 220);
      revealAfterHero();
    }));

    // ── Form validation & submission ───────────────────────────────────
    const form   = document.getElementById('contact-form')  as HTMLFormElement | null;
    const status = document.getElementById('cf-status')     as HTMLElement | null;

    if (!form) return;

    // Sent state: the form fades out and the thank-you panel takes its
    // place; "Send another message" brings the (reset) form back.
    const success = document.getElementById('cp-success');
    function showSuccess(on: boolean) {
      if (!success) return;
      const from = on ? form! : success;
      const to = on ? success : form!;
      gsap.to(from, {
        opacity: 0, y: -10, duration: 0.35, ease: 'power2.in',
        onComplete: () => {
          from.hidden = true;
          gsap.set(from, { clearProps: 'opacity,transform' });
          to.hidden = false;
          gsap.fromTo(to, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', clearProps: 'opacity,transform' });
          if (on) success.scrollIntoView({ block: 'center', behavior: 'smooth' });
        },
      });
    }
    document.getElementById('cp-send-another')?.addEventListener('click', () => showSuccess(false));

    // Clear a field's / the consent's error as soon as it's fixed.
    form.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('is-invalid'));
    form.addEventListener('change', (e) => (e.target as HTMLElement).closest('.cp-consent')?.classList.remove('is-invalid'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
      if (status) { status.textContent = ''; status.className = 'cp-submit__note'; }

      // Basic validation
      let ok = true;
      const required = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]');
      required.forEach(el => {
        if (!el.value.trim() && el.type !== 'checkbox') { el.classList.add('is-invalid'); ok = false; }
        if (el.type === 'checkbox' && !(el as HTMLInputElement).checked) {
          el.closest('.cp-consent')?.classList.add('is-invalid');
          ok = false;
        }
      });

      if (!ok) {
        if (status) { status.textContent = 'Please fill in all required fields.'; status.classList.add('cp-submit__note--err'); }
        return;
      }

      const btn = document.getElementById('cf-submit-btn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;

      const data = new FormData(form);
      const sent = await sendContactEmail({
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        message: String(data.get('message') || ''),
        company: String(data.get('company') || '') || undefined,
        phone: String(data.get('phone') || '') || undefined,
        service: data.getAll('service').map(String).join(', ') || undefined,
        budget: String(data.get('budget') || '') || undefined,
      });

      if (sent) {
        form.reset();
        showSuccess(true);
      } else {
        if (status) { status.textContent = 'Something went wrong. Please email me directly.'; status.classList.add('cp-submit__note--err'); }
      }
      if (btn) btn.disabled = false;
    });
  }

  // Live London time in the info column.
  let _clockTimer = 0;
  function initLocalTime() {
    clearInterval(_clockTimer);
    const el = document.getElementById('cp-local-time');
    if (!el) return;
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit' });
    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    _clockTimer = window.setInterval(tick, 15000);
  }

  onReady(initContact);
  onReady(initContactShrink);
  onReady(initLocalTime);
  document.addEventListener('astro:page-load', initContactFlame);
  document.addEventListener('astro:before-swap', () => {
    _shrinkCleanup?.();
    _shrinkCleanup = null;
    clearInterval(_clockTimer);
  });
</script>
