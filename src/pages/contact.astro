---
import Layout from '../layouts/Layout.astro';
import { BOOKING_URL, CONTACT_EMAIL } from '../utils/contactLinks';

const SERVICES = ['Branding', 'Website', 'Development', '3D', 'Motion', 'Strategy'];
const BUDGETS = ['< £5k', '£5–15k', '£15–30k', '£30k+', 'Not sure yet'];
const EMAIL = CONTACT_EMAIL;
---

<Layout title="Contact — Prime Triskelion">

  <main id="contact-page">
    <!-- One-screen, step-by-step contact: the intent screen (brand line +
         three options) branches into a short path of one-question steps.
         The flame fills the stage behind it the whole time. No pinned or
         shrinking header — there's nothing to scroll through anymore. -->
    <section class="cp-stage" id="cp-stage">
      <canvas id="contact-flame-canvas" aria-hidden="true"></canvas>
      <div class="cp-progress" aria-hidden="true"><div class="cp-progress__fill" id="cp-progress"></div></div>

      <form class="cp-steps" id="cp-form" novalidate>

        <!-- Intent -->
        <div class="cp-step is-active" data-id="intent">
          <h1 class="cp-title">
            <span class="cp-title__line"><span class="cp-title__word">Let's build</span></span>
            <span class="cp-title__line"><span class="cp-title__word">something</span></span>
            <span class="cp-title__line"><span class="cp-title__word cta-red">sharp.</span></span>
          </h1>
          <div class="cp-intro">
            <p class="cp-meta">What brings you here today?</p>
            <div class="cp-chips cp-chips--intent" role="radiogroup" aria-label="What brings you here today?">
              <label class="cp-chip"><input type="radio" name="intent" value="project" /><span>Start a project</span></label>
              <label class="cp-chip"><input type="radio" name="intent" value="call" /><span>Book a call</span></label>
              <label class="cp-chip"><input type="radio" name="intent" value="hello" /><span>Drop a quick word</span></label>
              <label class="cp-chip"><input type="radio" name="intent" value="copy" /><span>Copy my email</span></label>
            </div>
            <p class="cp-error" data-error>Pick one to continue.</p>
          </div>
        </div>

        <!-- Name (+ company on the project path) -->
        <div class="cp-step" data-id="name">
          <p class="cp-meta" data-meta></p>
          <h2 class="cp-q">Who's the mind<br />behind it?</h2>
          <div class="cp-ans">
            <div class="cp-field">
              <input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="Your name" required />
              <p class="cp-error" data-error>Please enter your name.</p>
            </div>
            <div class="cp-field" data-only="project">
              <input type="text" name="company" placeholder="Company / brand (optional)" autocomplete="organization" aria-label="Company or brand" />
            </div>
          </div>
        </div>

        <div class="cp-step" data-id="services">
          <p class="cp-meta" data-meta></p>
          <h2 class="cp-q">Where do I<br />come into play?</h2>
          <div class="cp-ans">
            <div class="cp-chips" role="group" aria-label="Services">
              {SERVICES.map((s) => (
                <label class="cp-chip"><input type="checkbox" name="service" value={s} /><span>{s}</span></label>
              ))}
            </div>
            <p class="cp-hint">Pick any — or skip.</p>
          </div>
        </div>

        <div class="cp-step" data-id="budget">
          <p class="cp-meta" data-meta></p>
          <h2 class="cp-q">What budget range<br />are we playing in?</h2>
          <div class="cp-ans">
            <div class="cp-chips" role="radiogroup" aria-label="Budget">
              {BUDGETS.map((b) => (
                <label class="cp-chip"><input type="radio" name="budget" value={b} /><span>{b}</span></label>
              ))}
            </div>
            <p class="cp-hint">Optional — a rough idea helps.</p>
          </div>
        </div>

        <div class="cp-step" data-id="message">
          <p class="cp-meta" data-meta></p>
          <h2 class="cp-q" data-q="project">Give me the<br />full picture.</h2>
          <h2 class="cp-q" data-q="hello">What's on<br />your mind?</h2>
          <div class="cp-ans">
            <div class="cp-field">
              <textarea name="message" placeholder="Context, goals, timing…" aria-label="Your message" required></textarea>
              <p class="cp-error" data-error>Please write a few words.</p>
            </div>
          </div>
        </div>

        <div class="cp-step" data-id="email">
          <p class="cp-meta" data-meta></p>
          <h2 class="cp-q">Where should I<br /><span class="cta-red">write back?</span></h2>
          <div class="cp-ans">
            <div class="cp-field">
              <input type="email" name="email" placeholder="you@company.com" autocomplete="email" aria-label="Your email" required />
              <p class="cp-error" data-error>Please enter a valid email.</p>
            </div>
          </div>
        </div>

        <!-- Call path: the booking page opens in a new tab straight from the
             click; this screen covers a blocked popup and the way back. -->
        <div class="cp-step" data-id="call">
          <p class="cp-meta">Book a call</p>
          <h2 class="cp-q">Pick a time<br /><span class="cta-red">that works.</span></h2>
          <div class="cp-ans">
            <p class="cp-done-text">The calendar just opened in a new tab — choose a slot and you'll get an invite straight away.</p>
            <div class="cp-links">
              <a class="cp-link" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Open the calendar ↗</a>
              <button class="cp-link" type="button" data-restart>Back to start</button>
            </div>
          </div>
        </div>

        <!-- Copy path: no questions -->
        <div class="cp-step" data-id="copy">
          <p class="cp-meta">Copy my email</p>
          <div class="cp-ans">
            <p class="cp-big-email" id="cp-big-email">{EMAIL}</p>
            <p class="cp-status" aria-live="polite"><span id="cp-copy-text">Copied to your clipboard</span></p>
            <div class="cp-links">
              <a class="cp-link" href={`mailto:${EMAIL}`}>Open mail app ↗</a>
              <button class="cp-link" type="button" id="cp-copy-again">Copy again</button>
              <button class="cp-link" type="button" data-restart>Back to start</button>
            </div>
          </div>
        </div>

        <!-- Sent -->
        <div class="cp-step" data-id="done">
          <p class="cp-meta"><span class="cp-dot"></span>Message received</p>
          <h2 class="cp-q">Thank you,<br /><span class="cta-red" id="cp-done-name">friend.</span></h2>
          <div class="cp-ans">
            <p class="cp-done-text" id="cp-done-text">I'll read it properly and get back to you within 24 hours.</p>
            <button class="cp-link" type="button" data-restart>Back to start</button>
          </div>
        </div>

        <!-- BACK | 1 / 5 | NEXT — only inside a path -->
        <div class="cp-controls" id="cp-controls">
          <button class="cp-back" type="button" id="cp-back">Back</button>
          <span class="cp-count" id="cp-count" aria-live="polite">1 / 5</span>
          <button class="cp-next" type="submit" id="cp-next"><span class="cp-beam" aria-hidden="true"></span><span class="cp-next__label" id="cp-next-label">Next</span></button>
        </div>
      </form>
    </section>
  </main>

</Layout>

<style>
  /* ── Stage ─────────────────────────────────────────────────────────── */
  #contact-page { background: rgb(var(--c-bg)); }

  .cp-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100svh;
    min-height: calc(var(--app-stable-vh, 1svh) * 100);
    /* top clears the fixed logo, bottom the fixed MENU button */
    padding: clamp(6.5rem, 13vh, 9rem) var(--site-gutter, 1.5rem) clamp(7.5rem, 14vh, 9.5rem);
  }

  /* Flame behind the whole conversation. Masked so it burns at the sides
     and from the bottom, never behind the centred text column. */
  #contact-flame-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    /* Lit last in the entrance (after the title and the options). */
    opacity: 0;
    transition: opacity 1.8s ease;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, black 32%),
      linear-gradient(to right, black 0%, black 14%, transparent 34%, transparent 66%, black 86%, black 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent 0%, black 32%),
      linear-gradient(to right, black 0%, black 14%, transparent 34%, transparent 66%, black 86%, black 100%);
    mask-composite: intersect;
  }
  #contact-flame-canvas.is-lit { opacity: 0.5; }

  .cp-progress {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: rgb(var(--c-cream) / 0.06);
    z-index: 2;
  }
  .cp-progress__fill {
    height: 100%;
    background: rgb(var(--c-red));
    transform: scaleX(0);
    transform-origin: left;
  }

  /* All steps share one grid cell and only the active one is displayed, so
     the stage is as tall as the current step. */
  .cp-steps {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    max-width: 880px;
  }
  .cp-step {
    grid-area: 1 / 1;
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cp-step.is-active { display: flex; }

  /* ── Type ──────────────────────────────────────────────────────────── */
  .cp-title {
    margin: 0 0 clamp(1.8rem, 4.5vh, 3rem);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.6rem, min(8vw, 11.5vh), 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }
  .cp-title__line { display: block; }
  .cp-title__word { display: block; opacity: 0; filter: blur(18px); }

  .cp-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
  }

  .cp-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.3rem;
    font-family: var(--f-body);
    font-size: 10px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.5);
  }
  .cp-q {
    margin: 0 0 clamp(1.8rem, 5vh, 2.8rem);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2rem, min(5vw, 8vh), 4.2rem);
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }
  .cp-ans {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }
  .cp-hint { margin: -0.6rem 0 0; font-size: 0.85rem; color: rgb(var(--c-cream) / 0.35); }
  .cp-error {
    min-height: 1.3em;
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: rgb(var(--c-red));
    opacity: 0;
  }
  .cp-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgb(74 222 128);
    flex-shrink: 0;
    animation: cp-dot-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cp-dot-pulse { 50% { opacity: 0.35; } }

  /* ── Fields ────────────────────────────────────────────────────────── */
  .cp-field {
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cp-steps input[type="text"],
  .cp-steps input[type="email"],
  .cp-steps textarea {
    width: 100%;
    border: 0;
    border-radius: 0;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    padding: 0.7rem 0 0.8rem;
    text-align: center;
    font: 300 clamp(1.3rem, 2vw, 2rem)/1.4 var(--f-body);
    color: rgb(var(--c-cream));
    background:
      linear-gradient(rgb(var(--c-cream) / 0.7), rgb(var(--c-cream) / 0.7)) no-repeat center bottom / 0% 1px,
      linear-gradient(rgb(var(--c-cream) / 0.16), rgb(var(--c-cream) / 0.16)) no-repeat center bottom / 100% 1px;
    transition: background-size 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cp-steps ::placeholder { color: rgb(var(--c-cream) / 0.2); }
  .cp-steps input:focus,
  .cp-steps textarea:focus { background-size: 100% 1px, 100% 1px; }
  /* Errors are the one place red appears on a field. */
  .cp-steps .is-invalid {
    background: linear-gradient(rgb(var(--c-red) / 0.8), rgb(var(--c-red) / 0.8)) no-repeat center bottom / 100% 1px;
  }
  .cp-steps textarea {
    resize: none;
    min-height: 130px;
    text-align: left;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
  }

  /* ── Chips (options, services, budget) ─────────────────────────────── */
  .cp-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    max-width: 760px;
  }
  .cp-chip { position: relative; cursor: pointer; }
  /* The four intent options as an even 2×2 grid (not a 3 + 1 wrap);
     one column on phones (see the 640px rule). */
  .cp-chips--intent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 580px);
  }
  .cp-chips--intent .cp-chip span { width: 100%; box-sizing: border-box; }
  .cp-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .cp-chip span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.7rem;
    border: 1px solid rgb(var(--c-cream) / 0.2);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(0.85rem, 1vw, 1rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.7);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease;
  }
  /* Neutral states only — no red hovers, like the rest of the site. */
  .cp-chip input:checked + span {
    border-color: rgb(var(--c-cream) / 0.75);
    background: rgb(var(--c-cream) / 0.07);
    color: rgb(var(--c-cream));
  }
  .cp-chip input:focus-visible + span { border-color: rgb(var(--c-cream) / 0.6); }
  @media (hover: hover) {
    .cp-chip:hover span { border-color: rgb(var(--c-cream) / 0.4); color: rgb(var(--c-cream) / 0.95); }
  }

  /* ── Controls: BACK | 1 / 5 | NEXT ─────────────────────────────────── */
  .cp-controls {
    grid-area: 2 / 1;
    /* Hidden until a path is chosen — set from JS (syncChrome). Hidden by
       default so it can't flash on the intent screen before the script
       has run (it did on mobile). */
    display: none;
    align-items: stretch;
    justify-content: center;
    gap: 0.5rem;
    margin-top: clamp(2.2rem, 5vh, 3.2rem);
  }
  .cp-controls > * {
    box-sizing: border-box;
    min-height: 50px;
    min-width: 104px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.4rem;
    font-family: var(--f-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .cp-back {
    cursor: pointer;
    border: 1px solid rgb(var(--c-cream) / 0.18);
    border-radius: 0;
    background: rgb(var(--c-cream) / 0.02);
    color: rgb(var(--c-cream) / 0.65);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  @media (hover: hover) {
    .cp-back:hover { color: rgb(var(--c-cream)); border-color: rgb(var(--c-cream) / 0.4); }
  }
  .cp-count {
    border: 1px solid rgb(var(--c-cream) / 0.08);
    background: rgb(var(--c-cream) / 0.04);
    color: rgb(var(--c-cream) / 0.55);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    user-select: none;
  }
  /* Same as the site's CTAs (.h-hero-cta--fixed): no hover change — a
     white beam runs round the border and a glare sweeps across. */
  .cp-next {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(var(--c-cream) / 0.18);
    border-radius: 0;
    background: rgb(var(--c-cream) / 0.02);
    color: rgb(var(--c-cream) / 0.8);
    box-shadow: inset 0 1px 0 rgb(var(--c-cream) / 0.04), 0 8px 24px rgb(var(--c-bg) / 0.25);
    transition: color 0.3s ease, transform 0.15s ease;
  }
  .cp-next:active { transform: scale(0.97); }
  .cp-next::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(-35deg, transparent 25%, rgba(242, 237, 232, 0.13) 50%, transparent 75%);
    transform: translateX(-160%);
    animation: cp-glare 5s ease-in-out 2.5s infinite;
  }
  @keyframes cp-glare {
    0% { transform: translateX(-160%); }
    22%, 100% { transform: translateX(160%); }
  }
  .cp-beam {
    position: absolute;
    inset: 0;
    padding: 1px;
    z-index: 1;
    pointer-events: none;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    transition: opacity 0.3s ease;
  }
  .cp-beam::before {
    content: '';
    position: absolute;
    inset: -200%;
    background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255, 255, 255, 0.12) 30deg, rgba(255, 255, 255, 0.55) 60deg, rgba(255, 255, 255, 0.12) 90deg, transparent 130deg, transparent 360deg);
    animation: cp-beam-spin 4s linear infinite;
  }
  @keyframes cp-beam-spin { to { transform: rotate(360deg); } }
  .cp-next__label { position: relative; z-index: 3; white-space: nowrap; }
  /* Dims until the step's required fields are filled (still clickable, so a
     press explains what's missing). */
  .cp-next.is-waiting { color: rgb(var(--c-cream) / 0.35); }
  .cp-next.is-waiting .cp-beam { opacity: 0.35; }
  .cp-next:disabled { opacity: 0.55; cursor: progress; }

  /* ── Copy + sent ───────────────────────────────────────────────────── */
  .cp-big-email {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.5rem, min(4.2vw, 7vh), 3.6rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    user-select: all;
    color: rgb(var(--c-cream));
  }
  .cp-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 1rem;
    color: rgb(var(--c-cream) / 0.6);
  }
  .cp-links { display: flex; gap: 1.6rem; flex-wrap: wrap; justify-content: center; }
  .cp-link {
    padding: 0 0 0.2rem;
    background: none;
    border: 0;
    border-bottom: 1px solid rgb(var(--c-cream) / 0.25);
    cursor: pointer;
    font-family: var(--f-body);
    font-size: 0.95rem;
    color: rgb(var(--c-cream) / 0.7);
    text-decoration: none;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .cp-link:hover { color: rgb(var(--c-cream)); border-color: rgb(var(--c-cream) / 0.7); }
  .cp-done-text {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--c-cream) / 0.6);
  }

  /* ── Tablet / phone ────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .cp-stage { padding-top: clamp(6rem, 13vh, 8rem); padding-bottom: clamp(7rem, 13vh, 8.5rem); }
    /* Faint full-width ambient glow: no clear side column to burn in. */
    #contact-flame-canvas.is-lit { opacity: 0.16; }
    #contact-flame-canvas {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 80%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 80%, transparent 100%);
    }
    .cp-title { font-size: clamp(2.6rem, 11vw, 6rem); }
  }
  @media (max-width: 640px) {
    .cp-chip span { padding: 0.85rem 1.2rem; }
    .cp-chips--intent { grid-template-columns: 1fr; width: 100%; }
    .cp-chips--intent .cp-chip span { width: 100%; box-sizing: border-box; padding: 1.15rem 1.2rem; font-size: 1rem; }
    /* ≥16px, so iOS Safari doesn't zoom the page on focus */
    .cp-steps input[type="text"],
    .cp-steps input[type="email"] { font-size: 1.3rem; }
    .cp-steps textarea { font-size: 1.1rem; }
    .cp-controls { width: 100%; }
    .cp-controls > * { flex: 1 1 0; min-width: 0; padding: 0 0.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cp-next::before,
    .cp-beam::before,
    .cp-dot { animation: none; }
    #contact-flame-canvas { transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { afterPageTransition, titleIn, supportIn, subpageMode } from '../utils/afterPageTransition';
  import { sendContactEmail } from '../utils/sendContactEmail';
  import { initFlameCanvas } from '../utils/flameCanvas';
  import { copyContactEmail } from '../utils/copyEmail';
  import { BOOKING_URL, CONTACT_EMAIL } from '../utils/contactLinks';

  const EMAIL = CONTACT_EMAIL;
  type Step = 'intent' | 'name' | 'services' | 'budget' | 'message' | 'email' | 'copy' | 'call' | 'done';
  type Intent = 'project' | 'hello' | 'copy' | 'call';
  const PATHS: Record<Intent, Step[]> = {
    project: ['intent', 'name', 'services', 'budget', 'message', 'email'],
    hello: ['intent', 'name', 'message', 'email'],
    copy: ['intent', 'copy'],
    call: ['intent', 'call'],
  };
  const TITLES: Record<Intent, string> = { project: 'Start a project', hello: 'Quick word', copy: 'Copy my email', call: 'Book a call' };

  let _abort: AbortController | null = null;

  function initContact() {
    const page = document.getElementById('contact-page');
    const form = document.getElementById('cp-form') as HTMLFormElement | null;
    if (!page || !form) return;

    _abort?.abort();
    _abort = new AbortController();
    const signal = _abort.signal;

    const stage = document.getElementById('cp-stage')!;
    const canvas = document.getElementById('contact-flame-canvas') as HTMLCanvasElement | null;
    if (canvas) initFlameCanvas(canvas, stage);

    const steps = {} as Record<Step, HTMLElement>;
    form.querySelectorAll<HTMLElement>('.cp-step').forEach((s) => { steps[s.dataset.id as Step] = s; });
    const controls = document.getElementById('cp-controls')!;
    const backBtn = document.getElementById('cp-back') as HTMLButtonElement;
    const nextBtn = document.getElementById('cp-next') as HTMLButtonElement;
    const nextLabel = document.getElementById('cp-next-label')!;
    const countEl = document.getElementById('cp-count')!;
    const progress = document.getElementById('cp-progress')!;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const D = reduce ? 0.01 : 1;
    let intent: Intent | null = null;
    let index = 0;
    let busy = false;
    let sent = false;
    let queued: number | 'restart' = 0;

    const path = (): Step[] => (intent ? PATHS[intent] : ['intent']);
    const currentId = (): Step => (sent ? 'done' : path()[index]);

    /* ── Rendering ── */
    function syncChrome() {
      const p = path();
      const id = currentId();
      const questions = p.length - 1;
      // Controls only exist inside a path; copy/done have their own links.
      controls.style.display = id === 'intent' || id === 'copy' || id === 'call' || id === 'done' ? 'none' : 'flex';
      countEl.textContent = `${index} / ${questions}`;
      nextLabel.textContent = id === 'email' ? 'Send' : 'Next';
      updateWaiting();
      const pct = id === 'done' || id === 'copy' || id === 'call' ? 1 : intent ? index / questions : 0;
      gsap.to(progress, { scaleX: pct, duration: 0.7 * D, ease: 'power3.out' });

      const meta = steps[id].querySelector<HTMLElement>('[data-meta]');
      if (meta && intent) meta.textContent = TITLES[intent];
      steps.name.querySelector<HTMLElement>('[data-only="project"]')!.style.display = intent === 'project' ? '' : 'none';
      steps.message.querySelectorAll<HTMLElement>('[data-q]').forEach((q) => { q.style.display = q.dataset.q === intent ? '' : 'none'; });
      steps.message.querySelector('textarea')!.placeholder = intent === 'project' ? 'Context, goals, timing, links…' : 'Say hi…';
    }

    function show(fromId: Step, toId: Step, dir: number) {
      const from = steps[fromId];
      const to = steps[toId];
      busy = true;
      const release = () => {
        if (!busy) return;
        busy = false;
        const f = to.querySelector<HTMLElement>('input[type="text"], input[type="email"], textarea');
        if (f && window.matchMedia('(hover: hover)').matches) f.focus({ preventScroll: true });
        if (queued) {
          const q = queued;
          queued = 0;
          if (q === 'restart') restart(); else go(q);
        }
      };
      const tl = gsap.timeline({ onComplete: release, onInterrupt: release })
        .to([from, controls], { autoAlpha: 0, y: -30 * dir, filter: 'blur(8px)', duration: 0.28 * D, ease: 'power2.in' })
        .add(() => {
          from.classList.remove('is-active');
          // Not clearProps:'all' — that also kills this timeline while `from`
          // is still one of its tween targets.
          gsap.set(from, { clearProps: 'opacity,visibility,transform,filter' });
          to.classList.add('is-active');
          syncChrome();
          if (window.scrollY > 0) {
            const lenis = (window as any).__lenis;
            if (lenis) lenis.scrollTo(0, { immediate: true }); else window.scrollTo(0, 0);
          }
        })
        .fromTo(to.children, { autoAlpha: 0, y: 30 * dir, filter: 'blur(8px)' },
          { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.5 * D, ease: 'power3.out', stagger: 0.05, clearProps: 'filter,transform' })
        .fromTo(controls, { autoAlpha: 0, y: 30 * dir, filter: 'blur(8px)' },
          { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.45 * D, ease: 'power3.out', clearProps: 'filter,transform' }, '-=0.35');
      // Safety net: never leave the form locked.
      setTimeout(release, tl.duration() * 1000 + 120);
    }

    // Presses during a transition run once the step has landed.
    function go(dir: number) {
      if (busy) { queued = dir; return; }
      const from = currentId();
      if (dir > 0 && !validate(from)) return;
      if (dir > 0 && from === 'email') { void submit(); return; }
      const nextIndex = index + dir;
      if (nextIndex < 0 || nextIndex >= path().length) return;
      index = nextIndex;
      const to = currentId();
      if (to === 'copy') void copyEmail(false);
      show(from, to, dir);
    }

    function restart() {
      if (busy) { queued = 'restart'; return; }
      const from = currentId();
      form!.reset();
      form!.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      intent = null; index = 0; sent = false; queued = 0;
      show(from, 'intent', -1);
    }

    /* ── Validation ── */
    function setError(step: HTMLElement, on: boolean) {
      const err = step.querySelector<HTMLElement>('[data-error]');
      if (err) gsap.to(err, { opacity: on ? 1 : 0, y: on ? 0 : -4, duration: 0.25 });
    }
    function validate(id: Step) {
      const step = steps[id];
      let ok = true;
      if (id === 'intent') {
        ok = !!form!.querySelector('input[name="intent"]:checked');
      } else {
        step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((el) => {
          const v = el.value.trim();
          const bad = !v || (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v));
          el.classList.toggle('is-invalid', bad);
          if (bad) {
            ok = false;
            gsap.fromTo(el, { x: -6 }, { x: 0, duration: 0.5 * D, ease: 'elastic.out(1, 0.35)' });
          }
        });
      }
      setError(step, !ok);
      return ok;
    }
    // Next looks inactive while the step's required fields are empty.
    function updateWaiting() {
      const step = steps[currentId()];
      const empty = Array.from(step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]'))
        .some((el) => !el.value.trim());
      nextBtn.classList.toggle('is-waiting', empty);
    }
    form.addEventListener('input', (e) => {
      updateWaiting();
      const t = e.target as HTMLElement;
      t.classList.remove('is-invalid');
      const step = t.closest<HTMLElement>('.cp-step');
      if (step) setError(step, false);
    }, { signal });

    /* ── Intent: choosing moves straight on ── */
    // 'click', not 'change': after Back, the same (still checked) option
    // has to work again, and re-clicking a checked radio fires no change.
    form.querySelectorAll<HTMLInputElement>('input[name="intent"]').forEach((r) => {
      r.addEventListener('click', () => {
        intent = r.value as Intent;
        setError(steps.intent, false);
        // Opened right here, inside the click, so it isn't blocked as a popup.
        if (intent === 'call') window.open(BOOKING_URL, '_blank', 'noopener,noreferrer');
        setTimeout(() => { if (currentId() === 'intent') go(1); }, 260);
      }, { signal });
    });

    /* ── Controls ── */
    form.addEventListener('submit', (e) => { e.preventDefault(); go(1); }, { signal });
    backBtn.addEventListener('click', () => go(-1), { signal });
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const t = e.target as HTMLElement;
      // In the textarea it's Cmd/Ctrl+Enter; plain Enter adds a line.
      if (t.tagName === 'TEXTAREA') {
        if (e.metaKey || e.ctrlKey) { e.preventDefault(); go(1); }
        return;
      }
      if (t.tagName === 'INPUT') { e.preventDefault(); go(1); }
    }, { signal });
    form.querySelectorAll('[data-restart]').forEach((b) => b.addEventListener('click', restart, { signal }));

    /* ── Copy email ── */
    const copyText = document.getElementById('cp-copy-text')!;
    // Shared with the HUD dock: toast above MENU + inline status here.
    async function copyEmail(again: boolean) {
      const ok = await copyContactEmail(null);
      copyText.textContent = ok
        ? (again ? 'Copied again' : 'Copied to your clipboard')
        : "Couldn't copy automatically — select the address above.";
      if (!ok) {
        const range = document.createRange();
        range.selectNodeContents(document.getElementById('cp-big-email')!);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      if (ok && again) gsap.fromTo(copyText.parentElement, { opacity: 0.2 }, { opacity: 1, duration: 0.5 });
    }
    document.getElementById('cp-copy-again')?.addEventListener('click', () => { void copyEmail(true); }, { signal });

    /* ── Submit ── */
    async function submit() {
      const data = new FormData(form!);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      nextBtn.disabled = true;
      nextLabel.textContent = 'Sending…';
      const ok = await sendContactEmail({
        name,
        email,
        message: String(data.get('message') || '').trim(),
        ...(intent === 'project' ? {
          company: String(data.get('company') || '').trim() || undefined,
          service: data.getAll('service').map(String).join(', ') || undefined,
          budget: String(data.get('budget') || '') || undefined,
        } : {}),
      });
      nextBtn.disabled = false;
      if (!ok) {
        nextLabel.textContent = 'Send';
        const err = steps.email.querySelector<HTMLElement>('[data-error]');
        if (err) err.textContent = `Something went wrong — please email ${EMAIL}.`;
        setError(steps.email, true);
        return;
      }
      document.getElementById('cp-done-name')!.textContent = `${name.split(' ')[0] || 'friend'}.`;
      document.getElementById('cp-done-text')!.textContent = intent === 'project'
        ? `I'll read your brief properly and get back to you at ${email} within 24 hours.`
        : `I'll get back to you at ${email} within 24 hours.`;
      const from = currentId();
      sent = true;
      show(from, 'done', 1);
      // The flame flares up for a moment as the message goes out.
      // (CSS transition off meanwhile, so it doesn't fight the tween.)
      if (canvas && !reduce) {
        const base = parseFloat(getComputedStyle(canvas).opacity) || 0.5;
        gsap.timeline()
          .set(canvas, { transition: 'none' })
          .to(canvas, { opacity: Math.min(1, base * 1.9), duration: 0.5, ease: 'power2.out' })
          .to(canvas, { opacity: base, duration: 1.6, ease: 'power2.inOut', clearProps: 'opacity,transition' });
      }
    }

    /* ── Entrance ── */
    syncChrome();
    const words = page.querySelectorAll<HTMLElement>('.cp-title__word');
    const intro = page.querySelector<HTMLElement>('.cp-intro');
    afterPageTransition(() => {
      const tl = titleIn(gsap.timeline({ defaults: { ease: 'power4.out' } }), words, 0, D);
      // Mobile: the question and options follow once the title has found
      // focus (same focus pull); desktop keeps its earlier, quicker cue.
      const isMob = window.matchMedia('(max-width: 1024px)').matches;
      // Repeat / back visits (subpageMode) skip the choreography.
      const mode = subpageMode();
      if (isMob || mode !== 'full') {
        gsap.set(intro, { y: 16 });
        supportIn(tl, intro, 1.6 * D, D);
      } else {
        tl.fromTo(intro, { opacity: 0, y: 16, filter: 'blur(8px)' },
          { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9 * D, ease: 'power3.out', clearProps: 'filter,transform' }, 0.55);
      }
      // The flame comes up last, once the title and options have landed.
      tl.add(() => canvas?.classList.add('is-lit'), reduce || mode === 'none' ? 0 : mode === 'short' ? 0.5 : isMob ? 2.6 : 1.35);
    });
  }

  document.addEventListener('astro:page-load', initContact);
  document.addEventListener('astro:before-swap', () => {
    _abort?.abort();
    _abort = null;
  });
</script>
