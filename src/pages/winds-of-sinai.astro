---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
---

<Layout title="Winds Of Sinai — Prime Triskelion" description="Case study: Winds Of Sinai — branding, web design and development by Prime Triskelion.">

  <main class="wos-page">

    <!-- ═══ HERO (mobile only) ═══ -->
    <section class="wos-hero">
      <div class="wos-inner wos-hero__inner">
        <div class="wos-hero__content">
          <div class="wos-hero__top">
            <span class="wos-label wos-label--inline">Case Study</span>
            <span class="wos-hero__dot" aria-hidden="true">·</span>
            <span class="wos-label wos-label--inline wos-label--dim">2025</span>
            <span class="wos-hero__dot" aria-hidden="true">·</span>
            <span class="wos-label wos-label--inline wos-label--dim">Branding &amp; Web</span>
          </div>
          <h1 class="wos-hero__title">Winds<br/>Of Sinai</h1>
          <p class="wos-hero__desc">Full brand identity and website for a premium desert travel &amp; experiences brand rooted in the Sinai Peninsula.</p>
          <div class="wos-hero__btns">
            <div class="h-hero-cta-wrap">
              <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
              <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
              <a href="https://windsofsinai.com" class="h-hero-cta h-hero-cta--fixed" target="_blank" rel="noopener noreferrer">
                <span class="hud-spin-border"></span>
                <span class="h-hero-cta__text">Visit Website</span>
              </a>
            </div>
            <div class="h-hero-cta-wrap">
              <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
              <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
              <a href="#contact-cta" class="h-hero-cta h-hero-cta--fixed">
                <span class="hud-spin-border"></span>
                <span class="h-hero-cta__text">Let's build</span>
              </a>
            </div>
          </div>
        </div>
        <div class="wos-hero__visual">
          <div class="browser-frame">
            <div class="browser-frame__bar">
              <div class="browser-frame__dots"><span></span><span></span><span></span></div>
              <div class="browser-frame__url">windsofsinai.com</div>
            </div>
            <div class="browser-frame__screen browser-frame__screen--tall">
              <div class="browser-frame__ph">Project Preview</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ CINEMATIC HERO (desktop only) ═══ -->
    <section class="wos-cin" id="wos-cin">
      <h1 class="wos-cin__sr">Winds Of Sinai — Case Study</h1>
      <div class="wos-cin__image" aria-hidden="true">
        <img src="https://picsum.photos/seed/sinai/800/1200?grayscale" alt="" draggable="false">
      </div>
      <div class="wos-cin__texts" aria-hidden="true">
        <span class="wos-cin__l">WINDS OF</span>
        <span class="wos-cin__r">SINAI</span>
      </div>
      <!-- Bottom overlay: widoczny od razu, nie czeka na scroll -->
      <div class="wos-cin__bottom">
        <div class="wos-cin__meta">
          <span class="wos-label wos-label--inline">Case Study</span>
          <span class="wos-dot" aria-hidden="true">·</span>
          <span class="wos-label wos-label--inline wos-label--dim">2025</span>
          <span class="wos-dot" aria-hidden="true">·</span>
          <span class="wos-label wos-label--inline wos-label--dim">Branding &amp; Web</span>
        </div>
        <h2 class="wos-cin__title">Winds<br>Of Sinai</h2>
        <p class="wos-cin__desc">Full brand identity and website for a premium desert travel &amp; experiences brand rooted in the Sinai Peninsula.</p>
        <div class="wos-cin__btns">
          <div class="h-hero-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="https://windsofsinai.com" class="h-hero-cta h-hero-cta--fixed" target="_blank" rel="noopener noreferrer">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Visit Website</span>
            </a>
          </div>
          <div class="h-hero-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="#contact-cta" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Let's build</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ STICKY STACK ═══ -->
    <div class="wos-stack">

      <section class="wos-sec">
        <div class="wos-inner">
          <span class="wos-label">01 / 03</span>
          <h2 class="wos-sec__title">The<br/><em>challenge.</em></h2>
          <p class="wos-sec__body">A travel brand with deep roots in Sinai's landscape and culture needed an identity that could compete globally — premium, evocative, and trusted — without losing its authentic desert soul.</p>
        </div>
      </section>

      <section class="wos-sec wos-sec--mid">
        <div class="wos-inner">
          <span class="wos-label">02 / 03</span>
          <h2 class="wos-sec__title">How we<br/><em>approached it.</em></h2>
          <p class="wos-sec__body">I started with a brand sprint — mood boards, competitor mapping, and tone-of-voice workshops. The visual language was built around sand, silence, and scale: muted earth palettes, wide-body type, and considered negative space.</p>
        </div>
      </section>

      <section class="wos-sec">
        <div class="wos-inner">
          <span class="wos-label">03 / 03</span>
          <h2 class="wos-sec__title">What we<br/><em>delivered.</em></h2>
          <ul class="wos-deliverables">
            <li class="wos-del"><span class="wos-del__dot"></span>Logo System &amp; Brand Identity</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Color Palette &amp; Typography</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Web Design (Figma)</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Frontend Development (Astro)</li>
            <li class="wos-del"><span class="wos-del__dot"></span>SEO &amp; Performance</li>
          </ul>
        </div>
      </section>

    </div>

    <!-- ═══ MOBILE PROCESS (replaces sticky stack on small screens) ═══ -->
    <div class="wos-process-m" aria-label="Project process">
      <div class="wos-inner">

        <div class="wos-pm__item">
          <span class="wos-label">01 / 03</span>
          <h2 class="wos-pm__title">The<br/><em>challenge.</em></h2>
          <p class="wos-pm__body">A travel brand with deep roots in Sinai's landscape and culture needed an identity that could compete globally — premium, evocative, and trusted — without losing its authentic desert soul.</p>
        </div>

        <div class="wos-pm__item">
          <span class="wos-label">02 / 03</span>
          <h2 class="wos-pm__title">How we<br/><em>approached it.</em></h2>
          <p class="wos-pm__body">I started with a brand sprint — mood boards, competitor mapping, and tone-of-voice workshops. The visual language was built around sand, silence, and scale: muted earth palettes, wide-body type, and considered negative space.</p>
        </div>

        <div class="wos-pm__item wos-pm__item--last">
          <span class="wos-label">03 / 03</span>
          <h2 class="wos-pm__title">What we<br/><em>delivered.</em></h2>
          <ul class="wos-deliverables">
            <li class="wos-del"><span class="wos-del__dot"></span>Logo System &amp; Brand Identity</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Color Palette &amp; Typography</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Web Design (Figma)</li>
            <li class="wos-del"><span class="wos-del__dot"></span>Frontend Development (Astro)</li>
            <li class="wos-del"><span class="wos-del__dot"></span>SEO &amp; Performance</li>
          </ul>
        </div>

      </div>
    </div>

    <!-- ═══ SKEWED BROWSER FRAMES ═══ -->
    <section class="skew-sec">
      <div class="skew-sec__inner">

        <div class="skew-sec__sticky">
          <h2 class="skew-sec__heading">Brand<br/>identity<br/>in motion.</h2>
          <p class="skew-sec__sub">Logo, color system, typography, and web screens from the Winds Of Sinai project.</p>
        </div>

        <div class="skew-sec__cards">

          <figure class="skew-fig skew-fig--neg">
            <div class="browser-frame">
              <div class="browser-frame__bar">
                <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                <div class="browser-frame__url">windsofsinai.com</div>
              </div>
              <div class="browser-frame__screen">
                <div class="browser-frame__ph">Homepage</div>
              </div>
            </div>
          </figure>

          <figure class="skew-fig skew-fig--pos">
            <div class="browser-frame">
              <div class="browser-frame__bar">
                <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                <div class="browser-frame__url">windsofsinai.com/experiences</div>
              </div>
              <div class="browser-frame__screen">
                <div class="browser-frame__ph">Experiences</div>
              </div>
            </div>
          </figure>

          <figure class="skew-fig skew-fig--neg">
            <div class="browser-frame">
              <div class="browser-frame__bar">
                <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                <div class="browser-frame__url">windsofsinai.com/about</div>
              </div>
              <div class="browser-frame__screen">
                <div class="browser-frame__ph">About</div>
              </div>
            </div>
          </figure>

          <figure class="skew-fig skew-fig--pos">
            <div class="browser-frame">
              <div class="browser-frame__bar">
                <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                <div class="browser-frame__url">windsofsinai.com/contact</div>
              </div>
              <div class="browser-frame__screen">
                <div class="browser-frame__ph">Contact</div>
              </div>
            </div>
          </figure>

        </div>
      </div>
    </section>

    <!-- ═══ FULL-WIDTH SHOWCASE ═══ -->
    <section class="showcase-sec">
      <div class="showcase-header wos-inner">
        <h2 class="showcase-title">Every screen.<br/><em>Pixel perfect.</em></h2>
      </div>

      <!-- DESKTOP: horizontal scroll via GSAP ScrollTrigger -->
      <div class="scr-outer">
        <div class="scr-sticky">
          <div class="scr-track">

            <div class="scr-slide">
              <div class="scr-slide__meta">
                <span class="showcase-num">01</span>
                <span class="showcase-desc">Homepage — above the fold</span>
              </div>
              <div class="browser-frame browser-frame--scr">
                <div class="browser-frame__bar">
                  <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                  <div class="browser-frame__url">windsofsinai.com</div>
                </div>
                <div class="browser-frame__screen browser-frame__screen--tall">
                  <div class="browser-frame__ph">Desktop — Homepage</div>
                </div>
              </div>
            </div>

            <div class="scr-slide">
              <div class="scr-slide__meta">
                <span class="showcase-num">02</span>
                <span class="showcase-desc">Mobile — homepage</span>
              </div>
              <div class="device-ph scr-device-single"></div>
            </div>

            <div class="scr-slide">
              <div class="scr-slide__meta">
                <span class="showcase-num">03</span>
                <span class="showcase-desc">Mobile — experiences</span>
              </div>
              <div class="device-ph scr-device-single"></div>
            </div>

            <div class="scr-slide">
              <div class="scr-slide__meta">
                <span class="showcase-num">04</span>
                <span class="showcase-desc">Experiences page</span>
              </div>
              <div class="browser-frame browser-frame--scr">
                <div class="browser-frame__bar">
                  <div class="browser-frame__dots"><span></span><span></span><span></span></div>
                  <div class="browser-frame__url">windsofsinai.com/experiences</div>
                </div>
                <div class="browser-frame__screen browser-frame__screen--tall">
                  <div class="browser-frame__ph">Desktop — Experiences</div>
                </div>
              </div>
            </div>

          </div><!-- /scr-track -->

          <div class="scr-progress" aria-hidden="true">
            <div class="scr-progress__fill"></div>
          </div>
        </div>
      </div>

      <!-- MOBILE: prosty układ pionowy -->
      <div class="scr-mobile">
        <div class="showcase-item">
          <div class="showcase-item__label wos-inner">
            <span class="showcase-num">01</span>
            <span class="showcase-desc">Homepage — above the fold</span>
          </div>
          <div class="browser-frame browser-frame--wide">
            <div class="browser-frame__bar">
              <div class="browser-frame__dots"><span></span><span></span><span></span></div>
              <div class="browser-frame__url">windsofsinai.com</div>
            </div>
            <div class="browser-frame__screen browser-frame__screen--tall">
              <div class="browser-frame__ph">Desktop — Homepage</div>
            </div>
          </div>
        </div>

        <div class="showcase-item">
          <div class="showcase-item__label wos-inner">
            <span class="showcase-num">02</span>
            <span class="showcase-desc">Mobile — homepage</span>
          </div>
          <div class="showcase-devices wos-inner">
            <div class="device-ph"></div>
          </div>
        </div>

        <div class="showcase-item">
          <div class="showcase-item__label wos-inner">
            <span class="showcase-num">03</span>
            <span class="showcase-desc">Mobile — experiences</span>
          </div>
          <div class="showcase-devices wos-inner">
            <div class="device-ph"></div>
          </div>
        </div>

        <div class="showcase-item">
          <div class="showcase-item__label wos-inner">
            <span class="showcase-num">04</span>
            <span class="showcase-desc">Experiences page</span>
          </div>
          <div class="browser-frame browser-frame--wide">
            <div class="browser-frame__bar">
              <div class="browser-frame__dots"><span></span><span></span><span></span></div>
              <div class="browser-frame__url">windsofsinai.com/experiences</div>
            </div>
            <div class="browser-frame__screen browser-frame__screen--tall">
              <div class="browser-frame__ph">Desktop — Experiences</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats row -->
      <div class="showcase-stats wos-inner">
        <div class="showcase-stat">
          <strong>98</strong>
          <em>PageSpeed</em>
        </div>
        <div class="showcase-stat__sep"></div>
        <div class="showcase-stat">
          <strong>3</strong>
          <em>Languages</em>
        </div>
        <div class="showcase-stat__sep"></div>
        <div class="showcase-stat">
          <strong>100%</strong>
          <em>Responsive</em>
        </div>
        <div class="showcase-stat__sep"></div>
        <div class="showcase-stat">
          <strong>A+</strong>
          <em>Accessibility</em>
        </div>
      </div>

    </section>

    <!-- ═══ FOOTER CTA ═══ -->
    <CtaSection />

  </main>

</Layout>

<style>
  /* ─────────────────────────────────────────
     BASE
  ───────────────────────────────────────── */
  .wos-page {
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }
  .wos-inner {
    width: min(100%, var(--site-max-width));
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    box-sizing: border-box;
  }

  /* Labels */
  .wos-label {
    font-family: var(--f-body);
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgb(var(--c-red) / 0.65);
    display: block;
    margin-bottom: 1.5rem;
  }
  .wos-label--dim { color: rgb(var(--c-cream) / 0.22); margin-bottom: 0; }

  /* ─────────────────────────────────────────
     HERO — mobile only (hidden on desktop)
  ───────────────────────────────────────── */
  .wos-hero {
    display: none;
    min-height: 100vh;
    min-height: 100svh;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    align-items: center;
  }
  .wos-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
    padding-top: clamp(6rem, 11vh, 9rem);
    padding-bottom: clamp(4rem, 8vh, 6rem);
    box-sizing: border-box;
    width: 100%;
  }
  .wos-hero__top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: clamp(1.2rem, 2.5vh, 2rem);
    flex-wrap: wrap;
  }
  .wos-hero__dot {
    color: rgba(255,255,255,0.2);
    font-size: 10px;
  }
  .wos-hero__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 7vw, 9rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 0.88;
    color: rgb(var(--c-cream));
    margin: 0 0 clamp(1.5rem, 3vh, 2.5rem);
  }
  .wos-hero__desc {
    font-family: var(--f-body);
    font-size: clamp(0.88rem, 1.1vw, 1rem);
    font-weight: 300;
    line-height: 1.7;
    color: rgb(var(--c-cream) / 0.45);
    max-width: 42ch;
    margin: 0 0 clamp(2rem, 4vh, 3rem);
  }
  .wos-hero__btns {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .wos-hero__visual { width: 100%; }

  /* Same FOUC guard as the desktop cinematic hero below — initHeroReveal()
     is what hides these via gsap.set() before fading them in, and that
     script can lag first paint after a navigation. */
  .wos-hero__top,
  .wos-hero__title,
  .wos-hero__desc,
  .wos-hero__btns,
  .wos-hero__visual {
    opacity: 0;
  }

  /* ─────────────────────────────────────────
     CINEMATIC HERO — desktop only
  ───────────────────────────────────────── */
  .wos-cin {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: rgb(var(--c-bg));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wos-cin::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 70vh;
    background: linear-gradient(to bottom, transparent 0%, rgb(var(--c-bg) / 0.75) 40%, rgb(var(--c-bg)) 72%);
    pointer-events: none;
    z-index: 2;
  }
  .wos-cin__sr {
    position: absolute;
    width: 1px; height: 1px;
    clip: rect(0,0,0,0);
    overflow: hidden;
    white-space: nowrap;
    border: 0;
  }
  .wos-cin__image {
    position: absolute;
    right: 0;
    top: 0;
    width: 54%;
    height: 100%;
    z-index: 1;
    border-radius: 0;
    overflow: hidden;
    will-change: transform;
    pointer-events: none;
    background: rgb(var(--c-bg));
    /* Hidden by default so it never flashes fully visible before
       initCinematic()'s gsap.set() runs on astro:page-load — that script
       execution isn't guaranteed to beat first paint after a view
       transition, so without this the image (and bottom text below) can
       briefly appear at full opacity, overlapping the centered WINDS/OF
       SINAI word split, before JS catches up and hides them again. */
    opacity: 0;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 26%, black 68%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 18%, black 62%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, black 26%, black 68%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 18%, black 62%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-composite: intersect;
  }
  .wos-cin__image::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgb(var(--c-red) / 0.05) 0%, transparent 55%),
      repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px),
      repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px);
    pointer-events: none;
    z-index: 2;
  }
  .wos-cin__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .wos-cin__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 4.5vw, 5.5rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: rgb(var(--c-cream));
    margin: 0;
  }
  .wos-cin__texts {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5vw;
    pointer-events: none;
    width: 100%;
  }
  .wos-cin__l,
  .wos-cin__r {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 8.5vw;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
    white-space: nowrap;
    will-change: transform;
    line-height: 1;
  }

  /* Bottom overlay — widoczny od razu podczas animacji */
  .wos-cin__bottom {
    position: absolute;
    bottom: clamp(16rem, 30vh, 22rem);
    left: var(--site-gutter, 2rem);
    width: calc(42% - var(--site-gutter, 2rem));
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  /* Same FOUC guard as .wos-cin__image above — these are only meant to be
     visible once the scroll-pinned reveal runs, but gsap.set() is what
     hides them and that script can lag first paint after a navigation. */
  .wos-cin__bottom .wos-cin__meta,
  .wos-cin__bottom .wos-cin__title,
  .wos-cin__bottom .wos-cin__desc,
  .wos-cin__bottom .wos-cin__btns {
    opacity: 0;
  }
  .wos-cin__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .wos-dot {
    color: rgba(255,255,255,0.2);
    font-size: 11px;
  }
  .wos-label--inline { display: inline; margin-bottom: 0; }
  .wos-cin__desc {
    font-family: var(--f-body);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--c-cream) / 0.68);
    max-width: 44ch;
