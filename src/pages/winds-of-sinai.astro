<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { isSafari } from '../utils/isSafari';

  gsap.registerPlugin(ScrollTrigger);

  let _lenis: InstanceType<typeof Lenis> | null = null;
  let _lenisRaf: ((time: number) => void) | null = null;
  let _cinST: ReturnType<typeof ScrollTrigger.create> | null = null;

  // ── Mobile: stary hero reveal (blur-in on load) ──
  function initHeroReveal() {
    const els = [
      document.querySelector<HTMLElement>('.wos-hero__top'),
      document.querySelector<HTMLElement>('.wos-hero__title'),
      document.querySelector<HTMLElement>('.wos-hero__desc'),
      document.querySelector<HTMLElement>('.wos-hero__btns'),
      document.querySelector<HTMLElement>('.wos-hero__visual'),
    ].filter((el): el is HTMLElement => !!el);
    if (!els.length) return;

    gsap.set(els, { opacity: 0, y: 10, filter: 'blur(8px)' });
    gsap.to(els, {
      opacity: 1, y: 0, filter: 'blur(0px)',
      duration: 0.65, stagger: 0.13, ease: 'power3.out', delay: 0.18,
    });
  }

  // ── Desktop: cinematic pinned animation ──
  function initCinematic() {
    const section = document.getElementById('wos-cin');
    if (!section) return;

    const wordL = section.querySelector<HTMLElement>('.wos-cin__l');
    const wordR = section.querySelector<HTMLElement>('.wos-cin__r');
    const image = section.querySelector<HTMLElement>('.wos-cin__image');
    if (!wordL || !wordR || !image) return;

    const bottom = section.querySelector<HTMLElement>('.wos-cin__bottom');
    const bottomEls = bottom
      ? Array.from(bottom.querySelectorAll<HTMLElement>('.wos-cin__meta, .wos-cin__title, .wos-cin__desc, .wos-cin__btns'))
      : [];

    gsap.set(wordL, { x: '0vw', y: 0 });
    gsap.set(wordR, { x: '0vw', y: 0 });
    gsap.set(image, { opacity: 0, scale: 0.9, yPercent: 4 });
    if (bottomEls.length) gsap.set(bottomEls, { opacity: 0, y: 28, filter: 'blur(8px)' });

    const tl = gsap.timeline()
      .to(wordL, { x: '-42vw', opacity: 0, ease: 'power3.out', duration: 0.75 }, 0)
      .to(wordR, { x:  '42vw', opacity: 0, ease: 'power3.out', duration: 0.75 }, 0)
      .to(image, { opacity: 1, scale: 1.06, yPercent: 0, ease: 'power2.out' }, 0.05);

    if (bottomEls.length) {
      tl.to(bottomEls, {
        opacity: 1, y: 0, filter: 'blur(0px)',
        stagger: 0.1, ease: 'power3.out',
      }, 0.48);
    }

    _cinST = ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: '+=140%',
      scrub: 1.2,
      pin: true,
      invalidateOnRefresh: true,
      animation: tl,
    });
  }

  function initScreensScroll() {
    if (window.matchMedia('(max-width: 1024px)').matches) return;
    const outer   = document.querySelector<HTMLElement>('.scr-outer');
    const track   = document.querySelector<HTMLElement>('.scr-track');
    const fill    = document.querySelector<HTMLElement>('.scr-progress__fill');
    if (!outer || !track) return;
    const dist = () => window.innerWidth * 3; // 4 slides − 1
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: outer,
        start: 'top top',
        end: () => `+=${dist()}`,
        scrub: 1,
        pin: true,
        invalidateOnRefresh: true,
      },
    });
    tl.to(track,   { x: () => -dist(), ease: 'none' });
    if (fill)    tl.to(fill,    { scaleX: 1,    ease: 'none'      }, '<');
  }

  function initPage() {
    const gridLines = document.getElementById('grid-lines');
    if (gridLines) gridLines.style.visibility = 'hidden';

    // 1. Lenis musi być przed ScrollTrigger, żeby sync działał poprawnie
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    // Mobile Safari specifically: skip Lenis entirely. This page's
    // ScrollTrigger-pinned sections (sticky stack, horizontal galleries)
    // still work without it — ScrollTrigger tracks native window scroll on
    // its own by default, the lenis.on('scroll', ScrollTrigger.update) sync
    // below only exists to keep it aware of Lenis's own virtual scroll
    // position while Lenis is intercepting scroll, which isn't happening
    // here anyway. Safari's compositor handles a competing scroll-linked
    // rAF loop worse than Chromium's, which was reading as jank on this
    // page specifically.
    if (!(isTouch && isSafari())) {
      _lenis = new Lenis(isTouch ? {
        duration: 0.7,
        easing: (t: number) => 1 - Math.pow(1 - t, 2.4),
        smoothWheel: false,
        touchMultiplier: 1.8,
      } : {
        duration: 2.4,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        wheelMultiplier: 0.65,
      });
      (window as any).__lenis = _lenis;

      // Poprawny sync Lenis ↔ ScrollTrigger (oficjalny pattern z docs Lenis)
      _lenis.on('scroll', ScrollTrigger.update);
      _lenisRaf = (time: number) => { _lenis!.raf(time * 1000); };
      gsap.ticker.add(_lenisRaf);
      gsap.ticker.lagSmoothing(0);
    } else {
      (window as any).__lenis = null;
      (window as any).__lenisHandled = true;
    }

    // 2. Animacje — mobile/desktop rozdzielone jak w CSS
    const isMob = window.matchMedia('(max-width: 1024px)').matches;
    if (isMob) {
      initHeroReveal();
    } else {
      initCinematic();
      initScreensScroll();
    }
    document.addEventListener('astro:before-swap', () => {
      const gl = document.getElementById('grid-lines');
      if (gl) gl.style.visibility = '';
      if (_lenisRaf) { gsap.ticker.remove(_lenisRaf); _lenisRaf = null; }
      _lenis?.destroy();
      _lenis = null;
      (window as any).__lenis = null;
      _cinST?.kill();
      _cinST = null;
      ScrollTrigger.getAll().forEach(st => st.kill());
    }, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('wos-cin')) initPage();
  });
</script>
