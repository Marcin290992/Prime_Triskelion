---
// The projects index: a ribbon of curved cards (WebGL, three.js; src/lib/zen/, adapted from the licensed CodegridPRO
// "Zen Obasi" slider) in our colours and type. Wheel, drag, keys and the arrows move it on a spring; opening a card
// plays our light beam over its picture and then the project page (it leaves `pt-from-slider` for that page, which then
// starts with the picture already in place). Titles, categories, years and pictures come from src/data/projects.ts.
// The earlier list page is kept as src/pages/_projects-list.astro (not routed).
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { projects, hrefOf } from '../../data/projects';

const slides = await Promise.all(
	projects.map(async (p) => ({
		name: p.title,
		meta: `${p.categories[0]} · ${p.year}`,
		slug: p.slug,
		img: (await getImage({ src: p.card, width: 1600 })).src,
		href: p.detail ? hrefOf(p) : '',
	}))
);
---

<Layout title="Projects — Prime Triskelion" description="Selected work by Prime Triskelion — brand identity, web design, motion and digital strategy.">
	<main id="pz-page">
		<div class="pz-slider" id="pz-slider"></div>
		<canvas class="pz-beam" id="pz-beam"></canvas>
		<div class="pz-info">
			<div class="pz-left">
				<p class="pz-meta" id="pz-meta"></p>
				<p class="pz-title" id="pz-title"></p>
			</div>
			<div class="pz-nav" id="pz-nav">
				<p class="pz-cue">Scroll or drag</p>
			</div>
			<div class="pz-arrows">
				<div class="h-hero-cta-wrap pz-arrowwrap">
						<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
						<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
						<button type="button" class="h-hero-cta nav-cta h-hero-cta--fixed h-hero-cta--primary pz-arrow" data-dir="-1" aria-label="Previous project">
							<span class="hud-spin-border"></span>
							<span class="h-hero-cta__text"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></span>
						</button>
					</div>
				<div class="h-hero-cta-wrap pz-arrowwrap">
						<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
						<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
						<button type="button" class="h-hero-cta nav-cta h-hero-cta--fixed h-hero-cta--primary pz-arrow" data-dir="1" aria-label="Next project">
							<span class="hud-spin-border"></span>
							<span class="h-hero-cta__text"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
						</button>
					</div>
			</div>
			<p class="pz-count" id="pz-count"></p>
		</div>
		<button class="pz-back" id="pz-back" type="button">Back ✕</button>
	</main>
	<script id="pz-data" type="application/json" set:html={JSON.stringify(slides)}></script>
</Layout>

<style is:global>
	html.pz-lock, html.pz-lock body { overflow: hidden !important; height: 100%; }
	html.pz-lock #site-footer { display: none !important; }
	html.pz-lock #hud-location { display: none !important; }
	/* the engine reads this for its background */
	html.pz-lock { --base-300: #000; }
</style>

<style>
	#pz-page { position: fixed; inset: 0; z-index: 5; background: #000; color: rgb(var(--c-cream)); overflow: hidden; }
	.pz-slider { position: absolute; inset: 0; cursor: grab; touch-action: none; user-select: none; }
	.pz-slider.is-clickable, .pz-slider.is-expanded { cursor: pointer; }
	.pz-slider.is-dragging { cursor: grabbing; }
	.pz-slider :global(canvas) { display: block; }
	.pz-beam { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 6; opacity: 0; pointer-events: none; }
	.pz-info {
		position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; pointer-events: none;
		display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem;
		padding: 0 var(--site-gutter) 8rem;
		font-family: var(--f-body);
	}
	/* a soft floor under the text, so the name reads over the neighbouring cards */
	.pz-info::before {
		content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 13rem; z-index: -1; pointer-events: none;
		background: linear-gradient(0deg, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.32) 45%, transparent 100%);
	}
	.pz-left { position: relative; display: grid; gap: 0.45rem; min-width: 0; }
	/* a dark pool right behind the name and the line: they sit over the bright, grainy neighbour card, and the red line
	   in particular does not hold there without it */
	.pz-left::before {
		content: ''; position: absolute; z-index: -1; pointer-events: none; inset: -3.6rem -6rem -3rem -4.5rem;
		background: radial-gradient(ellipse closest-side at 50% 52%, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.7) 40%, rgb(0 0 0 / 0.3) 72%, transparent 100%);
	}
	.pz-meta {
		margin: 0; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(var(--c-red));
	}
	.pz-title {
		margin: 0; font-family: var(--f-display); font-weight: 700; text-transform: uppercase; letter-spacing: -0.02em; line-height: 0.92;
		font-size: clamp(1.15rem, 1.7vw, 1.7rem); color: rgb(var(--c-cream)); text-shadow: 0 4px 40px rgb(0 0 0 / 0.55);
	}
	/* the name and line come in out of blur each time the project changes (script adds .is-swap) */
	.pz-title, .pz-meta { transition: opacity 0.5s ease, filter 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
	.pz-left.is-swap .pz-title, .pz-left.is-swap .pz-meta { opacity: 0; filter: blur(10px); transform: translateY(10px); transition: none; }
	.pz-count {
		display: none;
		margin: 0; justify-self: end; font-variant-numeric: tabular-nums; letter-spacing: 0.12em; font-size: 0.95rem; color: rgb(var(--c-cream) / 0.85);
	}

	/* the way to move: arrows, one tick per project, and a line saying how */
	.pz-nav {
		position: absolute; left: 50%; bottom: 8rem; transform: translateX(-50%);
		display: grid; justify-items: center; gap: 0.7rem; pointer-events: none;
	}
	.pz-arrows { display: flex; gap: 0.5rem; pointer-events: auto; }
	/* Prev / next: the very button of Client Stories on the home page (h-hero-cta, the --fixed / nav-cta / --primary
	   variant: the turning border beam and the periodic glare, see global.css), square, with an arrow in place of the label. */
	.pz-arrowwrap { width: 48px; max-width: none; flex: none; }
	.pz-arrow { width: 48px; height: 48px; min-height: 48px; padding: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
	.pz-arrow :global(.h-hero-cta__text) { display: flex; align-items: center; justify-content: center; line-height: 0; }
	.pz-arrow :global(svg) { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
	@media (hover: hover) {
		.pz-arrow[data-dir='-1']:hover :global(svg) { transform: translateX(-3px); }
		.pz-arrow[data-dir='1']:hover :global(svg) { transform: translateX(3px); }
	}
	.pz-arrow:focus:not(:focus-visible) { outline: none; }
	.pz-ticks { display: flex; align-items: center; gap: 0.35rem; }
	.pz-tick { width: 2.6rem; height: 1.8rem; display: grid; align-items: center; cursor: pointer; background: none; border: 0; padding: 0; }
	.pz-tick span { display: block; height: 2px; background: rgb(var(--c-cream) / 0.28); transition: background 0.4s ease, height 0.3s ease; }
	.pz-tick:hover span { background: rgb(var(--c-cream) / 0.6); }
	.pz-tick.is-active span { background: rgb(var(--c-red)); height: 3px; }
	.pz-cue {
		margin: 0; font-size: 0.7rem; letter-spacing: 0.34em; text-transform: uppercase; color: rgb(var(--c-cream) / 0.78);
		transition: opacity 0.8s ease;
	}
	.pz-nav.is-used .pz-cue { opacity: 0; }
	.pz-back {
		position: absolute; top: 5.2rem; right: var(--site-gutter); z-index: 8; opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
		background: none; color: rgb(var(--c-cream)); border: 1px solid rgb(var(--c-cream) / 0.35); padding: 0.7rem 1.1rem;
		font-size: 0.75rem; letter-spacing: 0.28em; text-transform: uppercase; cursor: pointer;
	}
	#pz-page.is-beamed .pz-back { opacity: 1; pointer-events: auto; }
	@media (max-width: 1000px) {
		.pz-info { padding-bottom: 7.5rem; }
		.pz-nav { bottom: 11rem; left: var(--site-gutter); transform: none; justify-items: start; }
		.pz-cue { display: none; }
		.pz-arrows { display: none; }
		.pz-tick { width: 2rem; }
	}

</style>

<script>
	import gsap from 'gsap';
	import { navigate } from 'astro:transitions/client';
	import { SliderEngine } from '../../lib/zen/SliderEngine.js';
	import { createBeamSlides } from '../../utils/beamSlides';

	let cleanup: (() => void) | null = null;
	let pauseNow: (() => void) | null = null;

	// the Zen Obasi defaults (Slider.jsx), unchanged except the grain a touch calmer
	const CONFIG = {
		breakpoints: { mobile: 600, tablet: 1000 },
		// touch screens (phones, tablets): a lower pixel ratio and smaller textures and fluid, so the page does not starve
		// the compositor (the menu beam and the page transition stuttered on a phone)
		fov: 45, distance: 5, maxPixelRatio: matchMedia('(pointer: coarse)').matches ? 1.5 : 2, textureSize: matchMedia('(pointer: coarse)').matches ? 1200 : 1600,
		slide: { aspect: { mobile: 2 / 3, desktop: 1.5 }, cornerRadius: 0.015, height: { mobile: 0.55, tablet: 0.5, desktop: 0.65 }, maxWidth: 0.75, gap: 0.05, span: 1.6, segments: [48, 1] },
		scroll: { spring: 8, dragSpring: 45, friction: 2, coast: 1, snapDuration: 0.8, glideDuration: 2.4, minDuration: 0.2, wheel: 1.8, wheelMax: 160, drag: 1.3, snapThreshold: 0.05, snapDelay: 150, keySpring: 6.5, keyQueue: 4, keyKick: 0.7, tapDistance: 6, tapSpeed: 0.5 },
		motion: { velocityMax: 10, velocityEase: 5, zoomOut: 0.5 },
		panorama: { radius: 1, side: -1, scale: 1, speedRadius: 0.5 },
		scene: { streak: 0.025, rgbShift: 0.025, parallax: 0.025, shading: 0.25, backside: 0.4, fogDepth: 8, fogStrength: 0.85, nearFade: 1.5 },
		edges: { blur: { tablet: 0.02, desktop: 0.035 }, aberration: { tablet: 0.01, desktop: 0.035 }, zone: 0.35, shimmer: 0.0075, shimmerScale: 10, shimmerSpeed: 5, shimmerZone: 0.25 },
		fluid: { brushSize: 25, brushStrength: 0.5, distortion: 120, decay: 0.98, trail: 0.8, stopDecay: 0.85, resolution: matchMedia('(pointer: coarse)').matches ? 0.25 : 0.5, still: matchMedia('(pointer: coarse)').matches },
		grain: { amount: 0.11, blend: 0.1 },
		pointer: { parallax: 0.5, vertical: 0.6, image: 0.008, ease: 3 },
		expand: { duration: 1.2, ease: 'power4.inOut', zoom: 1.4, skip: true },
		intro: {
			delay: 0.5, duration: 4, ease: 'power3.out',
			noise: { scale: 1.1, speed: 0.4, spread: 0.45, warp: 3.5, twist: 1.5 },
			edge: { coreWidth: 0.002, coreIntensity: 3, midWidth: 0.03, midIntensity: 0.55, outerWidth: 0.35, outerIntensity: 0.26, haloWidth: 0.04, fringe: 0.0005, aberration: 0.004, streaks: 0.8, grain: 0.75 },
		},
	};

	function init() {
		const page = document.getElementById('pz-page');
		const host = document.getElementById('pz-slider');
		if (!page || !host) return;
		const slides: Array<{ name: string; meta: string; slug: string; img: string; href: string }> = JSON.parse(document.getElementById('pz-data')!.textContent || '[]');
		const titleEl = document.getElementById('pz-title')!;
		const metaEl = document.getElementById('pz-meta')!;
		const nav = document.getElementById('pz-nav')!;
		const left = page.querySelector<HTMLElement>('.pz-left')!;
		const ticks = Array.from(page.querySelectorAll<HTMLElement>('.pz-tick'));
		const countEl = document.getElementById('pz-count')!;
		const beamCanvas = document.getElementById('pz-beam') as HTMLCanvasElement;
		const back = document.getElementById('pz-back')!;
		const info = page.querySelector<HTMLElement>('.pz-info')!;
		document.documentElement.classList.add('pz-lock');

		let beam: ReturnType<typeof createBeamSlides> = null;
		const touch = matchMedia('(pointer: coarse)').matches;

		// Opening a card: the card has grown to the whole screen; our beam of light then sweeps that same picture in, and the
		// project page follows (a placeholder with no page stays on the beam until Back).
		const openProject = async (index: number) => {
			const { img, href } = slides[index];
			const el = new Image();
			el.src = img;
			await el.decode().catch(() => {});
			// the ribbon is going out and the beam takes over: stop drawing the ribbon (on a phone two WebGL scenes at once, and
			// a CSS blur over a full-screen canvas, starved the compositor: the menu's beam stuttered)
			if (href) engine.pause();   // (a placeholder with no page stays here: the ribbon must still be there on Back)
			beam?.destroy();
			beam = createBeamSlides(beamCanvas, [el], undefined, [0, 1], { variant: [0.35, 1] });
			// B: no growing card. The ribbon and its text go out in blur and the dark, our light sweeps the project's picture in
			// full screen, and the page follows with the picture already in place.
			host.style.pointerEvents = 'none';
			gsap.to(host, touch ? { opacity: 0, duration: 0.45, ease: 'sine.inOut' } : { opacity: 0, filter: 'blur(14px)', duration: 0.45, ease: 'sine.inOut' });
			gsap.to(info, { opacity: 0, duration: 0.3 });
			gsap.fromTo(beamCanvas, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: 'sine.inOut' });
			const pos = { v: 0 };
			gsap.to(pos, {
				v: 1, delay: 0.3, duration: 1.3, ease: 'power2.inOut',
				onUpdate: () => beam?.setPos(pos.v),
				onComplete: () => {
					if (href) { try { sessionStorage.setItem('pt-from-slider', '1'); } catch { /* private mode */ } navigate(href); }
					else page.classList.add('is-beamed');
				},
			});
		};
		const closeBeam = () => {
			page.classList.remove('is-beamed');
			gsap.to(beamCanvas, { opacity: 0, duration: 0.5, onComplete: () => { beam?.destroy(); beam = null; } });
			gsap.to(host, { opacity: 1, filter: 'blur(0px)', duration: 0.6, delay: 0.2, onComplete: () => { host.style.filter = ''; host.style.pointerEvents = ''; } });
			gsap.to(info, { opacity: 1, duration: 0.5, delay: 0.3 });
		};
		back.addEventListener('click', closeBeam);

		// The engine writes the name into #pz-title whenever the project in the middle changes: the line under it, the ticks
		// and the change of name (out of blur) follow from that.
		const key = (e: string) => dispatchEvent(new KeyboardEvent('keydown', { key: e }));
		let current = 0;
		const onTitle = () => {
			const i = slides.findIndex((sl) => sl.name === titleEl.textContent);
			if (i < 0) return;
			current = i;
			metaEl.textContent = slides[i].meta;
			ticks.forEach((t, k) => t.classList.toggle('is-active', k === i));
			left.classList.add('is-swap');
			void left.offsetWidth;
			left.classList.remove('is-swap');
		};
		const mo = new MutationObserver(onTitle);
		mo.observe(titleEl, { childList: true, characterData: true, subtree: true });
		const n = slides.length;
		page.querySelectorAll<HTMLElement>('.pz-arrow').forEach((b) => b.addEventListener('click', () => key(b.dataset.dir === '1' ? 'ArrowRight' : 'ArrowLeft')));
		ticks.forEach((t) => t.addEventListener('click', () => {
			let d = Number(t.dataset.i) - current;
			if (d > n / 2) d -= n; else if (d < -n / 2) d += n;
			for (let k = 0; k < Math.abs(d); k++) key(d > 0 ? 'ArrowRight' : 'ArrowLeft');
		}));
		const used = () => nav.classList.add('is-used');
		addEventListener('wheel', used, { once: true, passive: true });
		addEventListener('pointerdown', used, { once: true });
		addEventListener('keydown', used, { once: true });

		const engine = new SliderEngine(host, CONFIG, {
			slides,
			titleElement: titleEl,
			counterElement: countEl,
			onExpand: () => {},
			onOpen: openProject,
		});

		pauseNow = () => engine.pause();
		cleanup = () => {
			// Stop at once (no drawing, no listeners); the heavy teardown (textures, render targets, forcing the context to
			// go) waits until the page swap is over, so it does not sit in the middle of the transition.
			engine.pause();
			window.setTimeout(() => engine.dispose(), 600);
			mo.disconnect();
			beam?.destroy();
			gsap.killTweensOf([beamCanvas, host, info]);
			back.removeEventListener('click', closeBeam);
			document.documentElement.classList.remove('pz-lock');
		};
	}

	document.addEventListener('astro:page-load', () => { cleanup?.(); cleanup = null; init(); });
	// On a touch screen the ribbon stops drawing the moment a navigation starts (before the next page is even fetched), so the
	// GPU is free for the page transition and the menu's beam.
	document.addEventListener('astro:before-preparation', () => { if (matchMedia('(pointer: coarse)').matches) pauseNow?.(); });
	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; pauseNow = null; });
</script>
