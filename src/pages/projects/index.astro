---
// The projects page, in the language of the home page: the light, big names that come up out of
// blur one after another (the "ghost train" of the services), and behind each name its picture, out of the same blur.
// Same data as the case-study pages. (The earlier window-by-window list is in git history.)
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { getImage } from 'astro:assets';
import { projects as data, hrefOf } from '../../data/projects';

const projects = await Promise.all(
  data.map(async (p) => {
    const local = typeof p.card !== 'string';
    const img = local ? (await getImage({ src: p.card, width: 2000 })).src : (p.card as string);
    return { slug: hrefOf(p), title: p.title, categories: p.categories, year: p.year, img };
  })
);
const total = String(projects.length).padStart(2, '0');
---
<Layout title="Projects — Prime Triskelion" description="Selected work by Prime Triskelion — brand identity, web design, motion and digital strategy.">
  <main id="pp-page">
    <!-- The header goes out the way the home page's hero does (scrubbed by the scroll, on every device): the light goes out,
         the type goes into the 5.5px blur, the screen darkens, and the names and pictures come up out of that dark. -->
    <div id="pp-pin">
    <header class="pp-hero" data-side-rays="0.22,0.55" data-side-rays-desktop="1.45">
      <h1 class="pp-title">My <em>Projects.</em></h1>
    </header>
    </div>

    <section class="pp-train" id="projects-list" aria-label="Projects">
      <!-- The pictures: pinned behind the names, each comes up out of blur when its name is in the middle. -->
      <div class="pp-stage">
        <canvas class="pp-canvas"></canvas>
        <!-- the same pictures as ordinary images: they are the textures of the canvas (the home page's beam, utils/beamSlides.ts) and the cross-fade without WebGL -->
        {projects.map((p) => <img class="pp-pic" src={p.img} alt="" crossorigin="anonymous" loading="eager" />)}
        <div class="pp-shade"></div>
        <!-- The type stays in the middle of the screen, as on the home page's Selected work: the scroll only moves the light
             from picture to picture; each project's name, tags and button come in out of the blur, on the clock, when the
             light lands on its picture, and go out when the next beam starts. Nothing here rides up with the scroll. -->
        <div class="pp-slides">
          {projects.map((p) => (
            <div class="pp-slide">
              <a class="pp-name" href={p.slug}>{p.title}</a>
              <span class="pp-meta">
                <span>{p.categories.join(' · ')}</span>
                <span class="pp-meta__dot"></span>
                <span>{p.year}</span>
              </span>
              <!-- the site's own button (as START A PROJECT and Explore) -->
              <div class="h-hero-cta-wrap pp-cta">
                <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
                <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
                <a href={p.slug} class="h-hero-cta h-hero-cta--fixed">
                  <span class="hud-spin-border"></span>
                  <span class="h-hero-cta__text">View project</span>
                </a>
              </div>
            </div>
          ))}
        </div>
        <div class="pp-count"><span class="pp-count__n">01</span> / {total}</div>
      </div>

      <ul class="pp-list" aria-hidden="true">
        {projects.map(() => <li class="pp-row"></li>)}
      </ul>
    </section>
  </main>
  <CtaSection />
</Layout>

<style>
  #pp-page { background: rgb(var(--c-bg)); color: rgb(var(--c-cream)); }

  /* The title sits in the light, low on the left; the names begin right under it. */
  @media (prefers-reduced-motion: no-preference) {
    #pp-pin { position: relative; height: calc(var(--app-stable-vh, 1svh) * 138); }
    /* phones and tablets: a shorter exit, and the first picture is already coming up while the header goes out */
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) { #pp-pin { height: calc(var(--app-stable-vh, 1svh) * 122); } }
    #pp-pin > .pp-hero { position: sticky; top: 0; }
  }
  .pp-hero {
    position: relative;
    height: 100vh;
    height: calc(var(--app-stable-vh, 1svh) * 100);
    display: flex;
    /* the title stands in the middle of the screen, in the light (low on the left it was out of the falling rays) */
    align-items: center;
    padding: clamp(5rem, 10vh, 8rem) var(--site-gutter) clamp(5rem, 10vh, 8rem);
    box-sizing: border-box;
  }
  /* Hidden from the first paint (the entrance brings it in once the page transition is over): it used to show, blink
     out when the script took over, and only then come in. */
  .pp-title {
    opacity: 0;
    filter: blur(18px);
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(3.2rem, 8vw, 8.5rem);
    letter-spacing: -0.01em;
    line-height: 0.92;
    text-transform: uppercase;
  }
  .pp-title em { font-style: normal; color: rgb(var(--c-red)); }

  /* pulled up under the end of the pin: the first picture and name are already coming up out of the dark while the
     header is still going out, with no empty black stretch between the two */
  .pp-train { position: relative; margin-top: calc(var(--app-stable-vh, 1svh) * -34); }

  /* ── the pictures, pinned for the whole list ── */
  .pp-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }
  .pp-pic {
    position: absolute;
    visibility: hidden;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity, filter, transform;
  }
  /* the picture is only ever a dim light behind the type: dark at the edges, readable in the middle */
  .pp-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 75% at 50% 46%, transparent 45%, rgba(0,0,0,0.5) 100%);
  }
  /* the canvas over the plain images (which are only the cross-fade when WebGL is missing or lost) */
  .pp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 1; }
  .pp-shade { z-index: 2; }
  .pp-count { z-index: 3; }
  .pp-stage--fallback .pp-canvas { display: none; }
  .pp-count {
    position: absolute;
    left: var(--site-gutter);
    bottom: clamp(1.5rem, 5vh, 3rem);
    font-family: var(--f-body);
    font-weight: 300;
    font-size: clamp(0.75rem, 1vw, 0.9rem);
    letter-spacing: 0.38em;
    color: rgb(var(--c-cream) / 0.7);
  }
  .pp-count__n { color: rgb(var(--c-cream)); }

  /* ── the names: one per screen-ish, up out of blur, sharp in the middle, out at the top ── */
  /* the list is only the scroll distance (one stop per picture); the type is in the stage */
  .pp-list { position: relative; z-index: 2; list-style: none; margin: 0; padding: 4vh 0 18vh; pointer-events: none; }
  .pp-row { min-height: 78vh; }
  .pp-slides { position: absolute; inset: 0; display: grid; place-items: center; z-index: 3; }
  .pp-slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.8rem, 2vh, 1.4rem);
    padding: 0 var(--site-gutter);
    color: rgb(var(--c-cream));
    text-decoration: none;
    text-align: center;
    /* the site's blur-in (as the Selected work text): in out of the blur and a small rise, on the clock; out quicker */
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    filter: blur(5.5px);
    pointer-events: none;
    transition: opacity 0.45s ease, filter 0.5s ease, transform 0.5s ease, visibility 0s linear 0.5s;
  }
  .pp-slide.in {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
    pointer-events: auto;
    transition: opacity 0.8s ease, filter 1s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }
  .pp-count { z-index: 4; }
  .pp-name {
    text-shadow: 0 2px 30px rgba(0,0,0,0.55);
    color: inherit;
    text-decoration: none;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3rem, min(11vw, 17vh), 13rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }
  .pp-meta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--f-body);
    font-weight: 300;
    font-size: clamp(0.75rem, 1.1vw, 0.9rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.8);
  }
  .pp-meta__dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(var(--c-red)); }
  /* The button: the site's (.h-hero-cta), small, on dark glass so it reads over any picture. */
  .pp-cta { width: auto !important; max-width: none !important; margin: 0.4rem 0 0; }
  .pp-cta .h-hero-cta {
    --cta-bg: rgb(0 0 0 / 0.72);
    min-height: 46px;
    min-width: 11rem;
    padding: 0.7rem 1.8rem;
  }
  @media (prefers-reduced-motion: reduce) { .pp-title { opacity: 1; filter: none; } }

  @media (max-width: 720px) {
    .pp-row { min-height: 70vh; }
    .pp-meta { flex-wrap: wrap; justify-content: center; gap: 0.4rem 0.9rem; letter-spacing: 0.22em; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';
  import { afterPageTransition, titleIn } from '../../utils/afterPageTransition';
  const smooth = (t: number) => { t = Math.max(0, Math.min(1, t)); return t * t * (3 - 2 * t); };
  let off: (() => void) | null = null;
  document.addEventListener('astro:before-swap', () => { off?.(); off = null; });

  // The names are the same ghost train as the services (by where each is on the screen, nothing timed, the same on the
  // way back). The pictures are the home page's own beam (utils/beamSlides.ts, WebGL): one number, pos, 0 = the dark,
  // a whole number = that picture standing still, between two = the band of light sweeping one into the next.
  function initPreview() {
    off?.();
    const page = document.getElementById('pp-page');
    if (!page) return;
    const rows = Array.from(page.querySelectorAll<HTMLElement>('.pp-row'));
    const pics = Array.from(page.querySelectorAll<HTMLImageElement>('.pp-pic'));
    const stage = page.querySelector<HTMLElement>('.pp-stage');
    const canvas = page.querySelector<HTMLCanvasElement>('.pp-canvas');
    const num = page.querySelector<HTMLElement>('.pp-count__n');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const BLUR = 5.5; // the same as every other going-out on the site

    // ── The header's exit: the home page's hero method (scrubbed by the scroll, on every device) ──
    const pin = page.querySelector<HTMLElement>('#pp-pin');
    const head = pin?.querySelector<HTMLElement>('.pp-hero') ?? null;
    let veil: HTMLElement | null = null, blurL: HTMLElement | null = null;
    if (pin && head && !reduce) {
      // two layers right after the pin: over the header, under the train (which comes later in the page): the blur first
      // (it softens what is behind it), the black after
      const mk = (css: string) => {
        const el = document.createElement('div');
        el.setAttribute('aria-hidden', 'true');
        el.style.cssText = 'position:fixed;inset:0;pointer-events:none;visibility:hidden;' + css;
        return el;
      };
      blurL = mk('');
      veil = mk('background:#000;opacity:0;');
      pin.after(blurL, veil);
    }
    const headExit = () => {
      if (!pin || !head || !veil || !blurL) return;
      const range = Math.max(1, pin.offsetHeight - head.offsetHeight);
      const y = window.scrollY;
      const p = y / range;
      const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
      const light = 1 - smooth(clamp01((p - 0.0) / 0.34));
      const bk = smooth(clamp01((p - 0.0) / 0.38));
      const a = smooth(clamp01((p - 0.2) / 0.5));
      const live = y < pin.offsetTop + pin.offsetHeight;
      const cv = head.querySelector<HTMLElement>('canvas');
      if (cv) cv.style.filter = light < 0.999 ? `brightness(${light.toFixed(3)})` : '';
      blurL.style.visibility = bk > 0 && live ? 'visible' : 'hidden';
      blurL.style.backdropFilter = blurL.style.webkitBackdropFilter = bk > 0 ? `blur(${(bk * 5.5).toFixed(1)}px)` : '';
      veil.style.visibility = a > 0 && live ? 'visible' : 'hidden';
      veil.style.opacity = a.toFixed(3);
    };

    let beam: BeamSlides | null = null;
    let plain = false;   // the plain images carry the pictures (no WebGL, or the context was lost)
    const fallback = () => { plain = true; stage?.classList.add('pp-stage--fallback'); pics.forEach((p) => { p.style.visibility = 'visible'; }); };
    if (reduce || !canvas) fallback();
    else { beam = createBeamSlides(canvas, pics, fallback, [0, 1]); if (!beam) fallback(); }

    // ── Choosing a project: the type goes out first, one piece after another (the name, the tags, the button, the
    // counter), each into a light blur, so the picture stands alone for a moment; only then the page transition starts
    // (the click is let through again once the cascade is over, so the site's own transition handles it as usual).
    let leaving = false;
    let letThrough = false;
    const onPick = (e: MouseEvent) => {
      if (letThrough || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('.pp-slide .pp-name, .pp-slide .pp-cta a');
      if (!a || !page.contains(a)) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (leaving) return;
      leaving = true;
      const link = a.closest<HTMLElement>('.pp-slide');
      const parts = link ? [link.querySelector('.pp-name'), link.querySelector('.pp-meta'), link.querySelector('.pp-cta')].filter(Boolean) as HTMLElement[] : [];
      const tl = gsap.timeline({ onComplete: () => { letThrough = true; a.click(); } });
      tl.to(parts, { opacity: 0, filter: `blur(${BLUR}px)`, y: -10, duration: 0.55, ease: 'power2.inOut', stagger: 0.13 });
      if (num) tl.to(num.parentElement, { opacity: 0, filter: `blur(${BLUR}px)`, duration: 0.5, ease: 'power2.inOut' }, 0.1);
      if (reduce) { tl.progress(1); }
    };
    document.addEventListener('click', onPick, true);

    // ── Phones and tablets: the scroll mechanism of the home page's Selected work ──
    //  1. the light has a top speed (about one picture in 0.8 s, up to 2x when it is far behind), so a hard fling cannot
    //     rush through the pictures; a slow drag is followed exactly;
    //  2. one gesture moves the page at most one name on from where it began, its momentum cut at that stop; every new
    //     touch is a new gesture;
    //  3. when the scroll goes quiet, the page glides on to the nearest name (a long, soft glide), a third of the way is
    //     enough to commit to the next one.
    const coarse = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
    const SPEED = 1.2;
    let posTarget = 0, posShown = 0, limRaf = 0, limT = 0;
    const limTick = (now: number) => {
      limRaf = 0;
      const dt = Math.min(0.1, (now - limT) / 1000);
      limT = now;
      const d = posTarget - posShown;
      const m = SPEED * (1 + Math.max(0, Math.min(1, (Math.abs(d) - 0.7) / 1.5))) * dt;
      posShown = Math.abs(d) <= m ? posTarget : posShown + Math.sign(d) * m;
      beam?.setPos(posShown);
      if (posShown !== posTarget) limRaf = requestAnimationFrame(limTick);
    };
    const setBeam = (v: number) => {
      posTarget = v;
      if (!coarse) { beam?.setPos(v); return; }
      // coming up out of the dark (the first picture) follows the scroll directly: a speed limit there only made the dark
      // after the header last longer; the limit is for moving between pictures
      if (v <= 1 && posShown <= 1) { posShown = v; beam?.setPos(v); return; }
      if (!limRaf && posShown !== posTarget) { limT = performance.now(); limRaf = requestAnimationFrame(limTick); }
    };
    let snapOff = () => {};
    let lenisWait = 0, lenisTries = 0;
    const setupSnap = (lenis: any) => {
      const vh = () => window.innerHeight;
      const stop = (k: number) => { const r = rows[k]; return r.getBoundingClientRect().top + window.scrollY + r.offsetHeight / 2 - vh() / 2; };
      const last = rows.length - 1;
      const IDLE = 240, DEPART = 0.35;
      let snapping = false, timer = 0, fail = 0, anchor = -1;
      // the list's own stretch: above it (the header) and below it (the closing screen and the footer) the scroll is plain
      const inList = (y: number) => y >= stop(0) - 0.6 * vh() && y <= stop(last) + 0.3 * vh();
      const nearest = (y: number) => { let b = 0; for (let k = 1; k <= last; k++) if (Math.abs(stop(k) - y) < Math.abs(stop(b) - y)) b = k; return b; };
      const settle = (t: number) => 0.5 - 0.5 * Math.cos(Math.PI * t);
      const move = (k: number, y: number) => {
        snapping = true;
        clearTimeout(fail);
        fail = window.setTimeout(() => { snapping = false; }, 4000);   // never stay stuck
        lenis.scrollTo(stop(k), { duration: 1.7 + Math.min(0.8, Math.abs(stop(k) - y) / vh()), easing: settle, force: true, onComplete: () => { clearTimeout(fail); snapping = false; } });
      };
      const decide = () => {
        timer = 0;
        if (snapping || document.documentElement.classList.contains('pt-restoring')) return;
        if (lenis.isStopped) { anchor = -1; return; }
        if (lenis.isTouching) { timer = window.setTimeout(decide, 80); return; }
        const y = lenis.scroll;
        if (!inList(y)) { anchor = -1; return; }   // plain scroll outside the list
        let lo = 0;
        for (let i = 1; i < last; i++) if (y >= stop(i)) lo = i;
        let k: number;
        if (y <= stop(0)) k = 0;
        else if (y >= stop(last)) k = last;
        else {
          const f = Math.max(0, Math.min(1, (y - stop(lo)) / (stop(lo + 1) - stop(lo))));
          const forward = lenis.direction >= 0;
          k = f < 0.002 ? lo : f > 0.998 ? lo + 1 : forward ? (f >= DEPART ? lo + 1 : lo) : (f <= 1 - DEPART ? lo : lo + 1);
        }
        if (anchor >= 0) k = Math.max(Math.max(anchor - 1, 0), Math.min(Math.min(anchor + 1, last), k));
        anchor = -1;
        if (Math.abs(stop(k) - y) < 1) return;
        move(k, y);
      };
      const onLenisScroll = () => {
        if (snapping) return;
        if (anchor === -1) anchor = inList(lenis.scroll) ? nearest(lenis.scroll) : -2;
        if (anchor >= 0 && !lenis.isStopped) {
          // one gesture moves the page at most one name on: the finger's momentum is cut at that stop
          const y = lenis.scroll;
          const hi = anchor + 1 <= last ? stop(anchor + 1) : Infinity;
          const lo = anchor - 1 >= 0 ? stop(anchor - 1) : -Infinity;
          const edge = y > hi + 1 ? hi : y < lo - 1 ? lo : null;
          if (edge !== null) lenis.scrollTo(edge, { immediate: true, force: true });
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(decide, IDLE);
      };
      // every new touch is a new gesture, and takes over a glide still running
      const onTouchStart = () => {
        if (lenis.isStopped) return;
        // the name the page stands on where the finger lands (not where the first scroll event happens to be)
        anchor = inList(lenis.scroll) ? nearest(lenis.scroll) : -2;
        if (snapping) { snapping = false; clearTimeout(fail); }
        window.clearTimeout(timer);
      };
      lenis.on('scroll', onLenisScroll);
      window.addEventListener('touchstart', onTouchStart, { passive: true });
      snapOff = () => { lenis.off?.('scroll', onLenisScroll); window.removeEventListener('touchstart', onTouchStart); window.clearTimeout(timer); window.clearTimeout(fail); };
    };
    const attachLenis = () => {
      const l = (window as any).__lenis;
      if (l) { setupSnap(l); return; }
      if (++lenisTries < 180) lenisWait = requestAnimationFrame(attachLenis);
    };
    if (coarse && !reduce) attachLenis();

    const slides = Array.from(page.querySelectorAll<HTMLElement>('.pp-slide'));
    let activeText = -1;
    const place = () => {
      const vh = window.innerHeight;
      const cs = rows.map((row) => { const r = row.getBoundingClientRect(); return (r.top + r.height / 2) / vh; });
      // pos: the first picture comes up out of the dark as the first name rises; then between two names the light sweeps
      let pos: number;
      if (cs[0] > 0.5) {
        // The first picture: pos is 0 (all dark, the beam not yet begun) until the stage is fully up, and only then runs 0 -> 1
        // to the first name, so the beam always starts from the corner, never part-way across.
        const hero0 = page.querySelector<HTMLElement>('.pp-hero');
        const y0 = (hero0 ? hero0.offsetHeight : vh) * 0.16;
        const r0 = rows[0].getBoundingClientRect();
        const y1 = r0.top + window.scrollY + r0.height / 2 - vh / 2;   // the scroll where the first name is in the middle
        pos = Math.max(0, Math.min(1, (window.scrollY - y0) / Math.max(1, y1 - y0)));
      }
      else {
        let i = 0;
        while (i < rows.length - 1 && cs[i + 1] <= 0.5) i++;
        if (i >= rows.length - 1) pos = rows.length;
        else {
          const t = (0.5 - cs[i]) / (cs[i + 1] - cs[i]);
          pos = i + 1 + Math.max(0, Math.min(1, (t - 0.12) / 0.76)); // a name stands still on a picture at rest
        }
      }
      setBeam(pos);
      headExit();
      // The type follows the beam: it changes where the beam crosses the middle of the screen (half way through a step),
      // not when the beam starts.
      const dest = Math.round(pos);
      const nowText = dest >= 1 && dest <= rows.length ? dest - 1 : -1;
      if (nowText !== activeText) {
        activeText = nowText;
        slides.forEach((el, i) => el.classList.toggle('in', i === nowText));
      }
      if (!beam || plain) rows.forEach((_, i) => { const pic = pics[i]; if (pic) pic.style.opacity = (smooth(1 - Math.abs(pos - (i + 1)) / 0.6) * 0.9).toFixed(3); });
      // The stage is black at pos 0, so it must not ride up over the hero as a dark band (the scroll would show). It
      // stays invisible while the header goes out in place (light, blur, dim: see sideRays.js) and comes up out of that
      // dark, in place, just before the first name is due.
      if (stage) {
        const hero = page.querySelector<HTMLElement>('.pp-hero');
        const q = hero ? window.scrollY / Math.max(1, hero.offsetHeight) : 1;
        // after the last name the picture goes out into the dark on its own (the last project is out before the closing
        // screen's type comes up), whatever the way the page is scrolled
        const lastC = cs[cs.length - 1];
        const out = 1 - smooth((0.5 - lastC) / 0.22);
        const so = smooth((q - 0.03) / 0.13) * out;
        stage.style.opacity = so.toFixed(3);
        stage.style.visibility = so < 0.003 ? 'hidden' : '';
        // Until the section has reached the top, the stage would ride up with it (its picture rising from below): hold it
        // on the spot instead (fixed; it takes no room in the flow either way), the sticky takes over at the very same place.
        const held = (page.querySelector('.pp-train') as HTMLElement).getBoundingClientRect().top > 0;
        stage.style.position = held ? 'fixed' : '';
        stage.style.top = held ? '0' : '';
        stage.style.left = held ? '0' : '';
        stage.style.width = held ? '100%' : '';
      }
      if (num && nowText >= 0) num.textContent = String(nowText + 1).padStart(2, '0');
    };

    if (reduce) {
      slides.forEach((el) => { el.style.opacity = '1'; el.style.visibility = 'visible'; el.style.transform = 'none'; el.style.filter = 'none'; el.style.pointerEvents = 'auto'; });
      if (pics[0]) pics[0].style.opacity = '0.9';
      return;
    }
    let ticking = false;
    const onScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; place(); }); };
    const onResize = () => { beam?.resize(); onScroll(); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    place();
    const title = page.querySelector('.pp-title');
    // the site's own title entrance, after the page transition (the same as the other pages)
    if (title) afterPageTransition(() => { titleIn(gsap.timeline({ defaults: { ease: 'power4.out' } }), [title]); });
    off = () => { window.removeEventListener('scroll', onScroll); window.removeEventListener('resize', onResize); beam?.destroy(); beam = null; veil?.remove(); blurL?.remove(); document.removeEventListener('click', onPick, true); snapOff(); cancelAnimationFrame(lenisWait); cancelAnimationFrame(limRaf); };
  }
  document.addEventListener('astro:page-load', initPreview);
</script>
