---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { projects, hrefOf } from '../../data/projects';

// The project index: the names as a list, the picture of the active one full-screen behind it (the same light that
// moves between the pictures on the home page). Titles, tags, years and pictures come from src/data/projects.ts, the
// file the /projects/[slug] case studies read too. `full` is the 2400px picture the case-study entrance opens from.
const items = await Promise.all(
	projects.map(async (p, i) => ({
		num: String(i + 1).padStart(2, '0'),
		href: hrefOf(p),
		live: Boolean(p.detail),
		title: p.title,
		categories: p.categories,
		year: p.year,
		card: p.card,
		focus: p.focus ?? 0.5,
		full: (await getImage({ src: p.card, width: 2400 })).src,
	}))
);
const total = String(items.length).padStart(2, '0');
---

<Layout
	title="Projects — Prime Triskelion"
	description="Selected work by Prime Triskelion — brand identity, web design, motion and digital strategy."
>
	<main id="projects-page">

		<header class="proj-header" data-side-rays data-rays-pin data-stage-header>
			<h1 class="proj-title">
				<span class="proj-title__line"><span class="proj-title__word">My</span></span>
				<span class="proj-title__line"><span class="proj-title__word"><em>Projects.</em></span></span>
			</h1>
			<p class="proj-header__lead">Brand identities, websites and motion — a selection of recent work, from first idea to launch.</p>
		</header>

		<section id="projects-index" class="pj" data-after-hero aria-label="Projects">

			<!-- The picture of the active project fills the screen: WebGL light between the pictures, or (no WebGL, reduced
			     motion) the same images cross-fading. -->
			<div class="pj__stage" aria-hidden="true">
				<canvas class="pj__canvas"></canvas>
				{items.map((p) => (
					<Image class="pj__img" src={p.card} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="async" data-fx={p.focus} />
				))}
				<div class="pj__shade"></div>
			</div>

			<div class="pj__inner">
				<ol class="pj__list">
					{items.map((p) => (
						<li class="pj__item">
							{p.live ? (
								<a class="pj__row" href={p.href} data-case data-case-src={p.full} data-case-shade=".pj__shade" data-case-fade=".pj__inner">
									<span class="pj__num" data-total={total}>{p.num}</span>
									<span class="pj__name" data-text={p.title}>{p.title}</span>
									<span class="pj__meta">
										<span class="pj__tags">{p.categories.join(' · ')}</span>
										<span class="pj__year">{p.year}</span>
										<span class="pj__go">View project ↗</span>
									</span>
									<!-- The case-study entrance grows from this picture (desktop only, see pageTransitions.ts). Its crop is the canvas's (the picture's focus: x = focus, y = 0.4 from the bottom = 60% from the top). -->
									<Image class="pj__thumb" src={p.card} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="lazy" decoding="async" style={`object-position: ${p.focus * 100}% 60%`} />
								</a>
							) : (
								<div class="pj__row pj__row--soon">
									<span class="pj__num" data-total={total}>{p.num}</span>
									<span class="pj__name" data-text={p.title}>{p.title}</span>
									<span class="pj__meta">
										<span class="pj__tags">{p.categories.join(' · ')}</span>
										<span class="pj__year">{p.year}</span>
										<span class="pj__go">Case study soon</span>
									</span>
								</div>
							)}
						</li>
					))}
				</ol>
				<p class="pj__count" aria-hidden="true"><span id="pj-current">01</span> / {String(items.length).padStart(2, '0')}</p>
			</div>
		</section>

	</main>
	<CtaSection />
</Layout>

<style>
	#projects-page {
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}

	/* ── header: the title alone on the first screen ── */
	.proj-header {
		position: relative;
		height: 100vh;
		height: 100dvh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: clamp(8rem, 16vh, 14rem) var(--site-gutter) clamp(8rem, 18vh, 13rem);
		box-sizing: border-box;
	}
	.proj-title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		letter-spacing: -0.01em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.proj-title__line { display: block; padding-bottom: 0.08em; }
	.proj-title__word { display: block; opacity: 0; filter: blur(18px); }
	.proj-title em { font-style: normal; color: rgb(var(--c-red)); }
	/* phones and tablets only (same style as Services' .svc-hero__lead) */
	.proj-header__lead {
		display: none;
		font-family: var(--f-body);
		font-weight: 300;
		font-size: clamp(0.95rem, 1.1vw, 1.15rem);
		line-height: 1.55;
		letter-spacing: 0.01em;
		color: rgb(var(--c-cream) / 0.82);
		max-width: 34ch;
		margin: clamp(1.2rem, 2vw, 1.8rem) 0 0;
		opacity: 0;
		transform: translateY(10px);
	}

	/* ── the index (shared by every layout) ── */
	.pj {
		position: relative;
		background: rgb(var(--c-bg));
	}
	.pj__stage {
		position: absolute;
		overflow: hidden;
		background: #000;
	}
	.pj__canvas,
	.pj__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* the pictures are the canvas's textures; they only show (cross-fading) without WebGL */
	.pj__img { object-fit: cover; visibility: hidden; opacity: 0; }
	.pj--fallback .pj__img { visibility: visible; }
	.pj--fallback .pj__canvas { display: none; }
	.pj__shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.pj__inner {
		position: relative;
		z-index: 2;
		box-sizing: border-box;
	}
	.pj__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.pj__row {
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}
	.pj__row--soon { cursor: default; }
	.pj__row:focus-visible { outline: 1px solid rgb(var(--c-cream) / 0.5); outline-offset: 4px; }

	.pj__num {
		font-family: var(--f-body);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--c-cream) / 0.4);
		transition: color 0.6s ease;
	}
	.pj__name {
		font-family: var(--f-display);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.34);
		transition: color 0.6s ease;
	}
	.pj__meta {
		display: flex;
		font-family: var(--f-body);
		font-weight: 300;
		font-size: clamp(0.7rem, 0.9vw, 0.9rem);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.4);
		transition: color 0.6s ease;
	}
	.pj__go {
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.pj__row.is-active .pj__num { color: rgb(var(--c-red)); }
	.pj__row.is-active .pj__meta { color: rgb(var(--c-cream) / 0.85); }
	.pj__row.is-active .pj__go { opacity: 1; transform: none; }

	.pj__thumb {
		position: fixed;
		object-fit: cover;
		visibility: hidden;
		pointer-events: none;
	}
	.pj__count {
		position: absolute;
		margin: 0;
		font-family: var(--f-body);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--c-cream) / 0.55);
	}

	/* ── desktop: the picture of the active project on the left, the list on a clean dark ground on the right ──
	   Nothing lies over the picture, so picture and text never compete. The picture falls away to the page's black on its
	   inner edge, top and bottom (no frame, no shadow). To put the picture on the right: swap `left` / `right` below and in
	   the shade's gradient. */
	@media (min-width: 1025px) and (not ((hover: none) and (pointer: coarse))) {
		.pj {
			height: 100vh;
			height: 100svh;
			min-height: 36rem;
		}
		.pj__stage {
			inset: 0 auto 0 0;
			width: 56%;
		}
		.pj__shade {
			background:
				linear-gradient(90deg, transparent 52%, rgb(var(--c-bg)) 100%),
				linear-gradient(180deg, rgb(var(--c-bg)) 0%, transparent 16%, transparent 80%, rgb(var(--c-bg)) 100%),
				linear-gradient(0deg, rgb(0 0 0 / 0.18), rgb(0 0 0 / 0.18));
		}
		.pj__inner {
			height: 100%;
			display: flex;
			align-items: center;
			padding: 0 var(--site-gutter) 0 58%;
		}
		.pj__list { width: 100%; }
		.pj__item { border-top: 1px solid rgb(var(--c-cream) / 0.14); }
		.pj__item:last-child { border-bottom: 1px solid rgb(var(--c-cream) / 0.14); }

		.pj__row {
			display: grid;
			grid-template-columns: 3rem 1fr;
			column-gap: 0.5rem;
			row-gap: 0.6rem;
			align-items: baseline;
			padding: clamp(1.1rem, 3vh, 2rem) 0;
		}
		.pj__num { grid-column: 1; grid-row: 1; }
		.pj__name {
			grid-column: 2;
			grid-row: 1;
			position: relative;
			font-size: clamp(2rem, 3.4vw, 4.4rem);
		}
		/* the active name fills with the accent from the left */
		.pj__name::after {
			content: attr(data-text);
			position: absolute;
			inset: 0;
			color: rgb(var(--c-red));
			clip-path: inset(0 100% 0 0);
			transition: clip-path 0.8s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.pj__row.is-active .pj__name::after { clip-path: inset(0 0 0 0); }
		.pj__meta {
			grid-column: 2;
			grid-row: 2;
			flex-wrap: wrap;
			gap: 0.35rem 1.4rem;
		}
		/* the case-study entrance grows from the picture, which is this panel (desktop only, see pageTransitions.ts) */
		.pj__thumb { left: 0; top: 0; width: 56vw; height: 100vh; }
		.pj__count { right: var(--site-gutter); bottom: clamp(5.5rem, 12vh, 8rem); }
	}

	/* ── phones and tablets: one project per screen, the way Selected work is on the home page ──
	   The index is a tall zone with a pinned (sticky) picture and a pinned layer of text. On touch the stage
	   (utils/workStage.ts) steps it: one gesture = one project. Elsewhere (a narrow window, reduced motion) the scroll drives it. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.proj-header {
			height: 100svh;
			height: calc(var(--app-stable-vh, 1svh) * 100);
			min-height: unset;
			justify-content: center;
			padding-top: 5rem;
			padding-bottom: 1.5rem;
		}
		.proj-header__lead { display: block; }
		/* with the stage the header is step 0 of it: a layer in the pinned text layer, over the dark stage */
		.proj-header.proj-header--staged {
			position: absolute;
			inset: 0;
			height: auto;
			z-index: 3;
			pointer-events: none;
		}

		.pj {
			height: calc(var(--app-stable-vh, 1svh) * 100 * var(--screens, 3));
			min-height: 0;
		}
		.pj__stage,
		.pj__inner {
			position: sticky;
			inset: auto;
			top: 0;
			height: 100svh;
			height: calc(var(--app-stable-vh, 1svh) * 100);
		}
		.pj__shade {
			background:
				linear-gradient(0deg, rgb(var(--c-bg)) 0%, rgb(var(--c-bg) / 0.92) 8%, transparent 26%),
				linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.55) 32%, rgb(0 0 0 / 0.08) 62%),
				linear-gradient(180deg, rgb(var(--c-bg)) 0%, transparent 18%);
		}
		.pj__inner {
			display: block;
			margin-top: calc(var(--app-stable-vh, 1svh) * -100);
			padding: 0;
		}

		/* the projects' texts stack at the bottom; the one on screen comes in (and the others leave) on the clock */
		.pj__list { position: absolute; inset: 0; width: auto; }
		.pj__item,
		.pj__item:last-child {
			position: absolute;
			left: var(--site-gutter);
			right: var(--site-gutter);
			bottom: 8rem;
			border: 0;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(14px);
			transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
		}
		.pj__item.is-active {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
			transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
		}
		.pj__row {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
			padding: 0;
		}
		.pj__num { order: 0; color: rgb(var(--c-red)); }
		.pj__num::after { content: ' / ' attr(data-total); color: rgb(var(--c-cream) / 0.45); }
		.pj__name {
			order: 1;
			font-size: clamp(2.4rem, 11.5vw, 4.4rem);
			color: rgb(var(--c-cream));
			text-shadow: 0 1px 2px rgb(0 0 0 / 0.9), 0 0 18px rgb(0 0 0 / 0.7);
		}
		.pj__meta {
			order: 2;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.4rem 1.1rem;
			font-size: 0.72rem;
			color: rgb(var(--c-cream) / 0.8);
		}
		.pj__go { opacity: 1; transform: none; color: rgb(var(--c-cream)); }
		.pj__thumb, .pj__count { display: none; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { createBeamSlides } from '../../utils/beamSlides';
	import { createWorkStage, type WorkStage } from '../../utils/workStage';
	import { afterPageTransition, revealAfterHero, titleIn, supportIn, subpageMode } from '../../utils/afterPageTransition';

	gsap.registerPlugin(ScrollTrigger);

	const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
	const smooth = (v: number) => { v = clamp(v); return v * v * (3 - 2 * v); };
	const inOutSine = (t: number) => 0.5 - 0.5 * Math.cos(Math.PI * t);
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let cleanup: (() => void) | null = null;

	function initHeader() {
		const titleWords = document.querySelectorAll<HTMLElement>('.proj-title__word');
		const lead = document.querySelector<HTMLElement>('.proj-header__lead');
		const mode = subpageMode();
		const narrow = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
		afterPageTransition(() => {
			const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
			titleIn(tl, titleWords);
			if (narrow || mode !== 'full') supportIn(tl, lead, 1.3);
			else if (lead) tl.to(lead, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, 0.5);
			revealAfterHero();
		});
	}

	// The index. One number, `pos`, is the light between the pictures: 0 = dark (with the stage, the header), k = project k.
	//   Desktop: the pointer (or the keyboard focus) on a row chooses the project; the light moves there on the clock.
	//   Phones and tablets: the page is a tall zone (see the CSS). On touch the stage (utils/workStage.ts) steps it, one gesture =
	//   one project; the scroll position only brings the stage in and out. Elsewhere (a narrow window with a mouse, reduced
	//   motion) the scroll drives the light directly.
		function initIndex() {
		const root = document.getElementById('projects-index');
		if (!root) return;
		const canvas = root.querySelector<HTMLCanvasElement>('.pj__canvas')!;
		const stage = root.querySelector<HTMLElement>('.pj__stage')!;
		const images = Array.from(root.querySelectorAll<HTMLImageElement>('.pj__img'));
		const items = Array.from(root.querySelectorAll<HTMLElement>('.pj__item'));
		const rows = Array.from(root.querySelectorAll<HTMLElement>('.pj__row'));
		const current = document.getElementById('pj-current');
		const N = items.length;
		const narrow = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
		const stageMode = narrow && !reduced();   // one gesture (swipe, wheel, key) = one project

		const fallback = () => root.classList.add('pj--fallback');
		const beam = reduced() ? null : createBeamSlides(canvas, images, fallback, [0, 1], { vary: true });
		if (!beam) fallback();

		let pos = 0, active = -1;
		const place = (p: number) => {
			pos = p;
			beam?.setPos(p);
			if (root.classList.contains('pj--fallback')) {
				images.forEach((im, k) => { im.style.opacity = (1 - smooth((Math.abs(p - (k + 1)) - 0.1) / 0.5)).toFixed(3); });
			}
		};
		// which project's text is on screen
		const mark = (i: number) => {
			if (i === active) return;
			active = i;
			items.forEach((el, k) => el.classList.toggle('is-active', k === i));
			rows.forEach((r, k) => {
				r.classList.toggle('is-active', k === i);   // the desktop list's highlight (the phone layout styles the item)
				if (k === i) r.setAttribute('aria-current', 'true'); else r.removeAttribute('aria-current');
			});
			if (current) current.textContent = String(i + 1).padStart(2, '0');
		};

		const offs: Array<() => void> = [];
		let tweenRaf = 0, waitRaf = 0, stageObj: WorkStage | null = null;

		if (!narrow) {
			// ── desktop: the pointer chooses; the light goes straight from the picture on screen to the chosen one ──
			// (frames: 0 = dark, k = project k). A transition runs between two frames only, so a jump from 1 to 3 does not pass 2.
			let shown = 0;   // the frame fully on screen
			let run: { from: number; to: number; e0: number; t0: number; ms: number } | null = null;
			let pending = -1;   // a choice made while a transition runs: it starts once that one has landed
			const mixAt = (from: number, to: number, e: number) => {
				const lo = Math.min(from, to), hi = Math.max(from, to);
				const p = to > from ? e : 1 - e;   // going back retraces the way it came
				beam?.setMix(lo, hi, p);
				if (root.classList.contains('pj--fallback')) {
					images.forEach((im, k) => { im.style.opacity = k + 1 === lo ? (1 - smooth(p)).toFixed(3) : k + 1 === hi ? smooth(p).toFixed(3) : '0'; });
				}
			};
			const land = (frame: number) => { shown = frame; run = null; place(frame); };
			const advance = (now: number) => {
				if (!run) return;
				const t = Math.min(1, (now - run.t0) / run.ms);
				mixAt(run.from, run.to, run.e0 + (1 - run.e0) * inOutSine(t));
				if (t < 1) { tweenRaf = requestAnimationFrame(advance); return; }
				tweenRaf = 0;
				const to = run.to;
				land(to);
				const next = pending;
				pending = -1;
				if (next >= 0 && next !== to) begin(next);
			};
			const begin = (to: number) => {
				run = { from: shown, to, e0: 0, t0: performance.now(), ms: 1200 };
				tweenRaf = requestAnimationFrame(advance);
			};
			const goto = (frame: number) => {
				if (reduced()) { land(frame); return; }
				if (!run) { if (frame !== shown) begin(frame); return; }
				if (frame === run.to) { pending = -1; return; }
				const now = performance.now(), t = Math.min(1, (now - run.t0) / run.ms);
				const e = run.e0 + (1 - run.e0) * inOutSine(t);   // how far the running transition has got
				if (frame === run.from) {
					// back to where it came from: retrace the rest of the way
					run = { from: run.to, to: run.from, e0: 1 - e, t0: now, ms: 600 };
					pending = -1;
				} else {
					// a third picture: hurry the running one to its end (the picture does not jump), then go on to the new one
					run = { from: run.from, to: run.to, e0: e, t0: now, ms: 200 };
					pending = frame;
				}
			};
			const choose = (i: number) => { if (i !== active) { mark(i); goto(i + 1); } };
			// only a real pointer movement chooses (the page scrolling under a still cursor must not), and only once the pointer
			// has stayed on the row a moment: sweeping across rows 2 on the way to 3 must not start row 2
			let px = -1, py = -1, intent = 0;
			rows.forEach((r, i) => {
				const move = (e: PointerEvent) => {
					if (e.clientX === px && e.clientY === py) return;
					px = e.clientX; py = e.clientY;
					window.clearTimeout(intent);
					if (i !== active) intent = window.setTimeout(() => choose(i), 130);
				};
				const focus = () => choose(i);
				r.addEventListener('pointermove', move);
				r.addEventListener('focus', focus);
				offs.push(() => { r.removeEventListener('pointermove', move); r.removeEventListener('focus', focus); window.clearTimeout(intent); });
			});
			// the first picture comes up out of the dark as the index comes into view
			const io = new IntersectionObserver((entries) => {
				if (entries.some((e) => e.isIntersecting) && active < 0) choose(0);
			}, { threshold: 0.4 });
			io.observe(root);
			offs.push(() => io.disconnect());
		} else {
			// ── phones and tablets: a tall zone, one step per gesture ──
			// With the stage the header ("My Projects.") is step 0 of it, in the pinned layer (moved there below), and the projects
			// are steps 1 .. N: one swipe takes the page from the header to project 1. Without it (reduced motion) the header stays
			// where it is and the projects are steps 0 .. N - 1 of a zone that follows it.
			const staged = stageMode;
			const header = document.querySelector<HTMLElement>('.proj-header');
			const inner = root.querySelector<HTMLElement>('.pj__inner')!;
			if (staged && header) {
				inner.prepend(header);
				header.classList.add('proj-header--staged');
				root.removeAttribute('data-after-hero');   // the header is inside: it must not wait for revealAfterHero
			}
			const first = staged ? 0 : 1;                 // the light's position at the zone's first step
			const steps = N - first;                      // the stage's steps after step 0: staged N (the header + N projects), plain N - 1
			const LEAD = staged ? 0 : 0.14, PER = 0.36, HOLD = 0.4;   // screens of scroll
			const length = LEAD + PER * (steps + HOLD);
			root.style.setProperty('--screens', String(length + 1));

			// the header goes out as the first light comes in
			const showHeader = (p: number) => {
				if (!staged || !header) return;
				const h = 1 - smooth(p / 0.45);
				header.style.opacity = h.toFixed(3);
				header.style.transform = h >= 0.999 ? '' : `translate3d(0, ${((1 - h) * -18).toFixed(1)}px, 0)`;
				header.style.visibility = h <= 0.001 ? 'hidden' : '';
				header.classList.toggle('rays-off', h <= 0.001);   // its light stops drawing when it is gone
			};

			// the project whose text is on screen: the one the light is going TO (at rest the one on screen)
			let lastPos = first, forward = true;
			const follow = (p: number) => {
				place(p);
				showHeader(p);
				if (p !== lastPos) { forward = p > lastPos; lastPos = p; }
				const near = Math.round(p);
				const dest = Math.abs(p - near) < 0.05 ? near : forward ? Math.ceil(p) : Math.floor(p);
				mark(dest >= 1 ? Math.min(dest, N) - 1 : -1);
			};
			follow(first);

			// outside the stage's hands the scroll position gives the light (the way it was left: above the zone the first step,
			// below it the last); with no stage it is followed continuously
			function setFrom(progress: number) {
				if (stageObj?.holding()) return;
				if (stageMode) { follow(progress > 0.5 ? N : first); return; }
				follow(1 + clamp((progress * length - LEAD) / PER, 0, steps));
			}
			const trigger = ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
				onUpdate: (s) => setFrom(s.progress), onRefresh: (s) => setFrom(s.progress) });
			const unit = () => (trigger.end - trigger.start) / length;
			const stop = (k: number) => trigger.start + (LEAD + PER * k) * unit();   // where step k rests

			const attach = () => {
				const lenis = (window as any).__lenis;
				if (!lenis) { if (++tries < 180) waitRaf = requestAnimationFrame(attach); return; }
				stageObj = createWorkStage({
					n: steps, lenis, trigger, stop, unit,
					anchoredTop: staged,                      // the zone starts at the top of the page: nothing above step 0
					setPos: (p) => follow(first + p),
					syncFromScroll: () => setFrom(trigger.progress),
				});
			};
			let tries = 0;
			if (stageMode) attach();
			// the keys step the stage too, while it holds the page
			const onKey = (e: KeyboardEvent) => {
				if (!stageObj?.holding()) return;
				const t = e.target as HTMLElement | null;
				if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
				if (['ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); stageObj.step(1); }
				else if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); stageObj.step(-1); }
			};
			window.addEventListener('keydown', onKey);
			offs.push(() => { window.removeEventListener('keydown', onKey); trigger.kill(); });
		}

		const ro = new ResizeObserver(() => beam?.resize());
		ro.observe(stage);

		cleanup = () => {
			cancelAnimationFrame(tweenRaf);
			cancelAnimationFrame(waitRaf);
			stageObj?.destroy();
			offs.forEach((fn) => fn());
			ro.disconnect();
			beam?.destroy();
		};
	}

	document.addEventListener('astro:page-load', () => {
		cleanup?.();
		cleanup = null;
		if (!document.getElementById('projects-page')) return;
		initHeader();
		initIndex();
	});
	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
