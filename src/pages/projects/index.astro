---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { getImage } from 'astro:assets';
import { projects as data, hrefOf } from '../../data/projects';

// Titles, tags, years and card pictures come from src/data/projects.ts (the same
// file the /projects/[slug] case-study pages read). A local card picture can be
// a 7360px-wide source, so getImage() pre-generates a downscaled one for the card
// and a 2400px one for the full-screen case-study entrance (data-case-src).
// Placeholders keep their remote URL (no `full`).
const projects = await Promise.all(
  data.map(async (p) => {
    const local = typeof p.card !== 'string';
    const img = local ? (await getImage({ src: p.card, width: 900, height: 1200 })).src : (p.card as string);
    const full = local ? (await getImage({ src: p.card, width: 2400 })).src : undefined;
    return { slug: hrefOf(p), title: p.title, categories: p.categories, year: p.year, img, full, bg: p.bg, speed: p.speed };
  })
);
---

<Layout
  title="Projects — Prime Triskelion"
  description="Selected work by Prime Triskelion — brand identity, web design, motion and digital strategy."
>
  <main id="projects-page">

    <!-- Brief header -->
    <header class="proj-header" data-side-rays data-rays-pin>
      <h1 class="proj-title">
        <span class="proj-title__line"><span class="proj-title__word">My</span></span>
        <span class="proj-title__line"><span class="proj-title__word"><em>Projects.</em></span></span>
      </h1>
      <p class="proj-header__lead">Brand identities, websites and motion — a selection of recent work, from first idea to launch.</p>
    </header>

    <!-- Mask reveal sections -->
    <div data-after-hero id="projects-list">
    {projects.map((p) => (
      <section
        class="proj-section"
        style={`--bg: ${p.bg}`}
        aria-label={p.title}
      >
        <a class="proj-inner" href={p.slug} data-case data-case-src={p.full}>

          <!-- Giant bg text -->
          <span class="proj-bg-text" data-speed={p.speed} aria-hidden="true">
            {p.title}
          </span>

          <!-- Project image -->
          <div class="proj-img-wrap" data-case-media>
            {p.img
              ? <img src={p.img} alt={p.title} crossorigin="anonymous" />
              : (
                <div class="proj-img-ph"></div>
              )
            }
          </div>

          <!-- Bottom info bar -->
          <div class="proj-foot">
            <div class="proj-foot__left">
              <span class="proj-foot__name">{p.title}</span>
            </div>
            <div class="proj-foot__center">
              {p.categories.map((c) => <span class="proj-foot__tag">{c}</span>)}
            </div>
            <div class="proj-foot__right">
              <span class="proj-foot__year">{p.year}</span>
            </div>
          </div>

        </a>
      </section>
    ))}
    </div>

  </main>
  <CtaSection />
</Layout>

<style>
  #projects-page {
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }

  /* â•â• HEADER â•â• */
  .proj-header {
    position: relative;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(8rem, 16vh, 14rem) var(--site-gutter) clamp(8rem, 18vh, 13rem);
    box-sizing: border-box;
  }

  .proj-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 8.5rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 0.9;
    color: rgb(var(--c-cream));
  }
  .proj-title__line { display: block; padding-bottom: 0.08em; }
  .proj-title__word { display: block; opacity: 0; filter: blur(18px); }
  .proj-title em { font-style: normal; color: rgb(var(--c-red)); }
  /* Mobile only for now (placeholder copy) — same style as Services'
     .svc-hero__lead. */
  .proj-header__lead {
    display: none;
    font-family: var(--f-body);
    font-weight: 300;
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: rgb(var(--c-cream) / 0.82);
    max-width: 34ch;
    margin: clamp(1.2rem, 2vw, 1.8rem) 0 0;
    opacity: 0;
    transform: translateY(10px);
  }


  /* â•â• MASK SECTION â•â• */
  .proj-section {
    position: relative;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
    background: var(--bg, rgb(var(--c-bg)));
    transition: background-color 0.6s ease;
    /* Mask for the fixed .proj-inner below — clip-path (unlike overflow)
       also clips position:fixed descendants, so each section is a window
       onto its own viewport-pinned panel. No transform here: it would
       turn the section into the containing block and un-fix the inner. */
    clip-path: inset(0);
  }

  /* â•â• INNER (fixed, masked by section) â•â• */
  /* Pinned to the viewport, masked by the section. Used to be
     position:absolute + a rAF loop writing translateY(-rect.top) every
     frame to fake this — unsynchronised with Lenis's scroll write, so on
     desktop Safari the panel lagged the section by a frame and visibly
     jumped while scrolling. Real position:fixed moves with the scroll in
     the same composited frame. */
  .proj-inner {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* â•â• BG TEXT â•â• */
  .proj-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(6rem, 17vw, 21rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    color: rgb(var(--c-cream) / 0.055);
    white-space: nowrap;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  /* â•â• IMAGE â•â• */
  .proj-img-wrap {
    position: relative;
    width: clamp(260px, 42vw, 680px);
    height: clamp(180px, 52vh, 480px);
    z-index: 2;
    overflow: hidden;
    box-shadow: 0 40px 90px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.05);
  }
  .proj-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Image placeholder */
  .proj-img-ph {
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px),
      repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px),
      linear-gradient(160deg, #141418 0%, #0e0e12 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Gradient pod stopkÄ… — kontrast na desktopie */
  .proj-inner::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 55%;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.25) 45%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* â•â• FOOTER INFO â•â• */
  .proj-foot {
    position: absolute;
    bottom: clamp(7rem, 13vh, 10rem);
    left: var(--site-gutter);
    right: var(--site-gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-end;
    gap: 1rem;
    z-index: 3;
  }

  .proj-foot__left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .proj-foot__name {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.5vw, 6rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    color: rgb(var(--c-cream));
  }

  .proj-foot__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .proj-foot__tag {
    font-family: var(--f-body);
    font-size: clamp(0.75rem, 1vw, 1rem);
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.7);
    white-space: nowrap;   /* a category never breaks across two lines */
  }

  /* In a row (laptop and mobile layouts below) the tags are told apart by
     a dot; stacked in a column (big screens) they don't need one. */
  .proj-foot__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .proj-foot__year {
    font-family: var(--f-body);
    font-size: clamp(0.75rem, 1vw, 1rem);
    font-weight: 300;
    letter-spacing: 0.2em;
    color: rgb(var(--c-cream) / 0.65);
  }

  /* There is no hover change on a project window (no lean, no glow, no brighter text): a window arrives under a pointer
     that is already over it, and the painted frame of the beam has the resting look, so any change here showed up as
     a flash right after the arrival. (The enter/leave focus pull is scroll-driven, in the script below.) */

  /* â•â• MOBILE / TABLET â•â• */
  /* Laptop 1025–1600px */
  @media (min-width: 1025px) and (hover: hover) and (max-width: 1600px), (min-width: 1025px) and (pointer: fine) and (max-width: 1600px) {
    .proj-foot {
      bottom: clamp(5.5rem, 11vh, 8rem);
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem 2vw;
      align-items: center;
    }
    .proj-foot__name {
      font-size: clamp(1.8rem, 3.2vw, 4rem);
    }
    .proj-foot__center {
      flex-direction: row;
      flex-wrap: nowrap;   /* always one row, side by side */
      justify-content: center;
      gap: 0.3rem 1rem;
    }
    .proj-foot__tag + .proj-foot__tag::before { content: '·'; margin-right: 1rem; opacity: 0.6; }
    .proj-foot__right {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 1.2rem;
    }
  }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    /* Header — tytuÅ‚ od razu widoczny na wejÅ›ciu */
    /* Cinematic first screen: the title alone, vertically centred, the
       cards only on scroll. Sized off the stable --app-stable-vh (set once
       in Layout.astro) so the URL bar can't resize it mid-scroll. */
    .proj-header {
      /* A whole screen: the title has it to itself, no card peeks in below. */
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      min-height: unset;
      justify-content: center;
      padding-top: 5rem;
      padding-bottom: 1.5rem;
    }
    .proj-header__lead { display: block; }

    /* Same scene as desktop: each project a full screen, its photo and title
       pinned to the viewport and revealed through the section's window as
       the page scrolls (the blur-in and parallax run in the script below).
       Sized off the stable --app-stable-vh so the browser bar can't resize
       it mid-scroll. */
    .proj-section {
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
    }
    .proj-inner {
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      box-sizing: border-box;
      /* The photo is centred in the free space between the logo (top) and
         the name / tags / MENU block (bottom), not in the whole screen. */
      padding: clamp(4.5rem, calc(var(--app-stable-vh, 1svh) * 10), 6rem) 0 clamp(11rem, calc(var(--app-stable-vh, 1svh) * 26), 13rem);
    }
    .proj-bg-text { font-size: clamp(5rem, 24vw, 21rem); }
    .proj-img-wrap {
      width: clamp(240px, 72vw, 680px);
      height: clamp(180px, 50svh, 520px);
      height: clamp(180px, calc(var(--app-stable-vh, 1svh) * 50), 520px);
    }
    /* Name and year on one line, the tags under — above the bottom MENU button. */
    .proj-foot {
      bottom: 6.5rem;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 0.6rem 1rem;
    }
    .proj-foot__left { grid-column: 1; grid-row: 1; }
    .proj-foot__name { font-size: clamp(1.9rem, 8.5vw, 3.6rem); }
    .proj-foot__center {
      grid-column: 1 / 3;
      grid-row: 2;
      flex-direction: row;
      flex-wrap: nowrap;   /* the three categories are always side by side in ONE row, never broken */
      align-items: center;
      justify-content: flex-start;
      gap: 0 clamp(0.45rem, 2.4vw, 0.9rem);
    }
    .proj-foot__center .proj-foot__tag { font-size: clamp(7.5px, 2.5vw, 12px); letter-spacing: clamp(0.08em, 0.5vw, 0.2em); }
    .proj-foot__right { grid-column: 2; grid-row: 1; align-items: flex-end; }
    .proj-foot__tag + .proj-foot__tag::before { content: '·'; margin-right: clamp(0.45rem, 2.4vw, 0.9rem); opacity: 0.6; }
    @media (min-width: 700px) {
      .proj-img-wrap { width: clamp(420px, 56vw, 680px); }
      .proj-foot__name { font-size: clamp(2.4rem, 5vw, 4rem); }
    }

  }
</style>

<script>
  import gsap from 'gsap';
  import { afterPageTransition, revealAfterHero, titleIn, supportIn, subpageMode } from '../../utils/afterPageTransition';
  import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';

  function initProjectsPage() {
    if (!document.getElementById('projects-page')) return;

    // â”€â”€ Header entrance â”€â”€
    const titleWords = document.querySelectorAll<HTMLElement>('.proj-title__word');
    const lead = document.querySelector<HTMLElement>('.proj-header__lead');
    const mode = subpageMode();
    const isMob = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;

    afterPageTransition(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      titleIn(tl, titleWords);
      if (isMob || mode !== 'full') supportIn(tl, lead, 1.3);
      else if (lead) tl.to(lead, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, 0.5);
      revealAfterHero();
    });


    // â”€â”€ Bg-text parallax (the mask itself is pure CSS) â”€â”€
    const reduce_ = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Cache references once — never query DOM inside the render loop
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('.proj-section')
    ).map(sec => ({
      sec,
      bgText:  sec.querySelector<HTMLElement>('.proj-bg-text'),
      foot:    sec.querySelector<HTMLElement>('.proj-foot'),
      img:     sec.querySelector<HTMLElement>('.proj-img-wrap img'),
      speed:   parseFloat(sec.querySelector<HTMLElement>('.proj-bg-text')?.dataset.speed ?? '1'),
    }));

    // Phones/tablets: the last card, once it fills the screen, stops being
    // pinned and scrolls on with the page.
    const lastSec = document.querySelector<HTMLElement>('.proj-section:last-child');
    // The last project sinks into black as its window closes (an overlay in the
    // page colour on that section), so the CTA arrives on a dark screen.
    const sink = document.createElement('div');
    sink.setAttribute('aria-hidden', 'true');
    sink.style.cssText = 'position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;background:rgb(var(--c-bg));';
    // (in the pinned panel, the same layer as the photo — in the section they
    // rounded differently and a 1px sliver of the photo showed at the edge)
    lastSec?.querySelector('.proj-inner')?.appendChild(sink);
    // The first project is the mirror of that: it comes up out of the dark as
    // its window opens under the header.
    const firstSec = document.querySelector<HTMLElement>('.proj-section');
    const rise = sink.cloneNode() as HTMLElement;
    rise.style.opacity = '1';
    firstSec?.querySelector('.proj-inner')?.appendChild(rise);
    // However the page is arrived at already scrolled to the list (a link to #projects-list, or the browser's Back
    // button, which puts the scroll position back a moment AFTER the page has started), the first project is in its
    // window at once and the scroll alone would show its photo at full strength: a hard cut. So the first photo always
    // starts under the dark and comes up out of it on the clock (softly, like everything that arrives on a page). Seen
    // from the top of the page it changes nothing: the project is far below the fold until the scroll gets there.
    // It is counted frame by frame in the render loop below, each frame at most 50 ms (not by GSAP's clock: after a
    // long first frame, which a page restored by the Back button often has, that clock jumps ahead by the whole
    // stall and the soft entrance was over in a single frame, so it still looked like a cut).
    const entry = { v: reduce_ ? 0 : 1 };
    let entryT = 0;
    let entryGo = false;
    let entryLast = performance.now();
    if (!reduce_) afterPageTransition(() => { entryGo = true; });
    let raf = 0;
    // As a card's window opens (and closes again) its title block comes out
    // of a blur and its photo settles from a hair oversized — scroll-driven,
    // so it follows the wheel exactly. Only the small text block is filtered
    // (never the big photo), the photo gets a transform.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const FOOT_BLUR = 8;      // px, at fully hidden
    const IMG_SETTLE = 0.08;  // scale above 1, at fully hidden
    const smooth = (a: number, b: number, x: number) => {
      const t = Math.max(0, Math.min(1, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    // The very beam of the home page's Selected Work (utils/beamSlides.ts, the same shader) between two projects. Each
    // project's window is painted once into a frame (the dark of its page, the big word, the photo, the name and the
    // categories, laid out exactly as the window shows them); while the next window comes up the screen, one fixed
    // WebGL canvas plays the beam from the frame of the project that leaves to the frame of the one that arrives,
    // scrubbed by how far the window has risen (so it follows the wheel or the finger exactly, nothing is pinned
    // or held). The canvas is shown only for those moments; at rest the page is the plain windows as before.
    let beam: BeamSlides | null = null;
    let beamCanvas: HTMLCanvasElement | null = null;
    let frameUrls: string[] = [];
    let beamOn = false;
    let built = 0;
    const RANGE: [number, number] = [0.08, 0.92];

    const paintFrame = (sec: HTMLElement, W: number, H: number, k: number) => {
      const c = document.createElement('canvas');
      c.width = Math.round(W * k); c.height = Math.round(H * k);
      const g = c.getContext('2d');
      if (!g) return null;
      g.scale(k, k);
      // (the style the colour script wrote, not the computed one: that is still part way through its 0.6s transition)
      g.fillStyle = sec.style.backgroundColor || getComputedStyle(sec).backgroundColor || '#05050a';
      g.fillRect(0, 0, W, H);
      const text = (el: Element | null) => {
        if (!el) return;
        const cs = getComputedStyle(el);
        let t = (el.textContent || '').trim();
        if (cs.textTransform === 'uppercase') t = t.toUpperCase();
        const r = el.getBoundingClientRect();
        g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        (g as any).letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
        g.textBaseline = 'alphabetic';
        g.textAlign = 'left';
        g.fillStyle = cs.color;
        const m = g.measureText(t);
        // CSS centres the font's own ascent+descent in the line box
        const fa = Math.round(m.fontBoundingBoxAscent), fd = Math.round(m.fontBoundingBoxDescent);   // (the browser lays text out on whole-pixel metrics)
        const y = r.top + (r.height - (fa + fd)) / 2 + fa - 1;   // (measured against the live text: the canvas baseline sits 1px low)
        // a category after the first has its dot (::before) inside its box: the word itself sits at the right end
        const dot = el.classList.contains('proj-foot__tag') && el.previousElementSibling;
        g.fillText(t, dot ? r.right - m.width : r.left, y);
        if (dot) { g.globalAlpha = 0.6; g.fillText('·', r.left, y); g.globalAlpha = 1; }
      };
      // the big word behind the photo (centred: its parallax is only a few pixels)
      const bg = sec.querySelector('.proj-bg-text');
      if (bg) {
        const cs = getComputedStyle(bg);
        g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        (g as any).letterSpacing = cs.letterSpacing;
        g.textAlign = 'center'; g.textBaseline = 'alphabetic';
        g.fillStyle = 'rgba(245,240,230,0.06)';
        const bt = (bg.textContent || '').trim().toUpperCase();
        const bm = g.measureText(bt);
        { const fa = Math.round(bm.fontBoundingBoxAscent), fd = Math.round(bm.fontBoundingBoxDescent); g.fillText(bt, W / 2, H / 2 + (fa - fd) / 2 - 1); }
      }
      // the shade under the foot
      const sh = g.createLinearGradient(0, H, 0, H * 0.45);
      sh.addColorStop(0, 'rgba(0,0,0,0.72)'); sh.addColorStop(0.45, 'rgba(0,0,0,0.25)'); sh.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = sh; g.fillRect(0, H * 0.45, W, H * 0.55);
      // the photo, cover-fitted into its frame
      const wrap = sec.querySelector<HTMLElement>('.proj-img-wrap');
      const img = sec.querySelector<HTMLImageElement>('.proj-img-wrap img');
      if (wrap && img && img.naturalWidth) {
        const br = wrap.getBoundingClientRect();
        // the layout size, whatever transform the frame has at the moment
        const rw = wrap.offsetWidth, rh = wrap.offsetHeight;
        const r = { left: br.left + (br.width - rw) / 2, top: br.top + (br.height - rh) / 2, width: rw, height: rh };
        g.save();
        g.shadowColor = 'rgba(0,0,0,0.85)'; g.shadowBlur = 90; g.shadowOffsetY = 40;
        g.fillStyle = '#000'; g.fillRect(r.left, r.top, r.width, r.height);
        g.restore();
        const s = Math.max(r.width / img.naturalWidth, r.height / img.naturalHeight);
        const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
        g.save();
        g.beginPath(); g.rect(r.left, r.top, r.width, r.height); g.clip();
        g.drawImage(img, r.left + (r.width - dw) / 2, r.top + (r.height - dh) / 2, dw, dh);
        g.restore();
      }
      text(sec.querySelector('.proj-foot__name'));
      sec.querySelectorAll('.proj-foot__tag').forEach((t) => text(t));
      text(sec.querySelector('.proj-foot__year'));
      return c;
    };

    let curW = 0;
    let curH = 0;
    const teardownBeam = () => {
      beam?.destroy(); beam = null;
      beamCanvas?.remove(); beamCanvas = null;
      frameUrls.forEach((u) => URL.revokeObjectURL(u)); frameUrls = [];
      beamOn = false;
    };

    // A new set of frames is made in the background and takes over only when it is ready AND no transition is playing:
    // the beam that is there goes on working until then (on a phone the address bar sliding away resizes the page all the
    // time, and tearing the beam down for every resize left the list without it, or with a frame of the wrong shape).
    const buildBeam = async () => {
      if (reduce) return;
      const mine = ++built;
      try { await document.fonts.ready; } catch { /* ignore */ }
      await Promise.all(panels.map(({ sec }) => {
        const im = sec.querySelector<HTMLImageElement>('.proj-img-wrap img');
        return !im || im.complete ? Promise.resolve() : new Promise((res) => { im.addEventListener('load', res, { once: true }); im.addEventListener('error', res, { once: true }); });
      }));
      await new Promise((res) => setTimeout(res, 120));   // (the colour script below has tinted every window by now)
      if (mine !== built) return;
      // the size of the panel the windows are drawn on (not innerHeight: on a phone that is not the height of the panel)
      const inner = panels[0].sec.querySelector<HTMLElement>('.proj-inner');
      const W = inner?.clientWidth || window.innerWidth, H = inner?.clientHeight || window.innerHeight;
      const k = Math.min(window.devicePixelRatio || 1, 1.5);
      const urls: string[] = [];
      const imgs: HTMLImageElement[] = [];
      const drop = () => urls.forEach((u) => URL.revokeObjectURL(u));
      for (const { sec } of panels) {
        const c = paintFrame(sec, W, H, k);
        if (!c) { drop(); return; }
        const blob: Blob | null = await new Promise((res) => c.toBlob(res, 'image/png'));
        if (!blob) { drop(); return; }
        const url = URL.createObjectURL(blob);
        urls.push(url);
        const im = new Image();
        im.src = url;
        imgs.push(im);
      }
      if (mine !== built) { drop(); return; }
      const cv = document.createElement('canvas');
      cv.setAttribute('aria-hidden', 'true');
      // exactly the size of the frames (never stretched to a viewport that has changed since)
      cv.style.cssText = `position:fixed;left:0;top:0;width:${W}px;height:${H}px;z-index:45;pointer-events:none;opacity:0;visibility:hidden`;
      document.body.appendChild(cv);
      const bs = createBeamSlides(cv, imgs, () => { if (beamCanvas === cv) { beamOn = false; cv.style.visibility = 'hidden'; } }, RANGE, false);
      if (!bs) { cv.remove(); drop(); return; }
      const swap = () => {
        if (mine !== built) { bs.destroy(); cv.remove(); drop(); return; }
        if (beamOn) { setTimeout(swap, 150); return; }   // not in the middle of a transition
        teardownBeam();
        beamCanvas = cv; beam = bs; frameUrls = urls; curW = W; curH = H;
        (window as any).__beamReadyAt = performance.now();
      };
      swap();
    };

    // enter: the window that is coming in (-1: none), opening: 0 at the foot .. 1 at the top
    const seat = (enter: number, opening: number) => {
      if (!beam || !beamCanvas) return;
      // (the first project comes up out of the header and the dark, not from another project)
      const on = enter >= 1 && opening > 0.001 && opening < 0.9995;
      if (!on) {
        if (beamOn) { beamOn = false; beamCanvas.style.opacity = '0'; beamCanvas.style.visibility = 'hidden'; }
        return;
      }
      // (a beam that is only just ready, or comes back after a resize, never joins a transition half way: it waits for the next)
      if (!beamOn && opening > 0.06) return;
      if (!beamOn) { beamOn = true; beamCanvas.style.visibility = 'visible'; }
      beam.setPos(enter + opening);
      // melts in as the beam starts (the window that leaves is standing still, so this hides nothing). It does NOT melt
      // out: the live window is still rising under the canvas until the very end, so a cross-fade there showed two
      // copies of the photo and of the text, one sliding into the other. The painted frame equals the live window
      // at rest, so the switch at the very end is a cut between two identical pictures.
      beamCanvas.style.opacity = smooth(0.001, 0.004, opening).toFixed(3);   // (a few pixels of scroll: the big word of the window that leaves drifts with the scroll, the painted one does not, so a long melt-in showed the two)
    };
    buildBeam();
    let rzT = 0;
    const onResize = () => {
      clearTimeout(rzT);
      rzT = window.setTimeout(() => {
        // only a real change of the panel's size makes new frames (a few pixels do not)
        const inner = panels[0].sec.querySelector<HTMLElement>('.proj-inner');
        if (inner && Math.abs(inner.clientWidth - curW) < 3 && Math.abs(inner.clientHeight - curH) < 3) return;
        buildBeam();
      }, 400);
    };
    window.addEventListener('resize', onResize);

    function render() {
      const vh = window.innerHeight;
      {
        const now = performance.now();
        const dt = Math.min(0.05, (now - entryLast) / 1000);
        entryLast = now;
        if (entryGo && entry.v > 0) {
          entryT += dt;
          const k = Math.max(0, Math.min(1, (entryT - 0.1) / 1.9));
          entry.v = 1 - (0.5 - 0.5 * Math.cos(Math.PI * k));   // in-out sine
        }
      }
      let opening = -1;   // how far up the screen the window that is coming in has come (0 at the foot, 1 at the top)
      let enter = -1;
      let seamTop = 0;
      let pi = -1;
      for (const { sec, bgText, foot, img, speed } of panels) {
        pi++;
        const rect = sec.getBoundingClientRect();
        if (rect.top > 0 && rect.top < vh) { opening = 1 - rect.top / vh; enter = pi; seamTop = rect.top; }

        if (sec === lastSec && !reduce) {
          const left = Math.max(0, Math.min(1, rect.bottom / vh));
          const d = rect.top <= 0 ? 1 - smooth(0.3, 1.0, left) : 0;
          sink.style.opacity = d.toFixed(3);
        }

        if (sec === firstSec && !reduce) {
          const shown = Math.max(0, Math.min(1, (vh - rect.top) / vh));
          const d = rect.top > 0 ? 1 - smooth(0.4, 1.0, shown) : 0;
          rise.style.opacity = Math.max(d, entry.v).toFixed(3);
        }

        if (rect.top > vh || rect.bottom < 0) continue;

        if (bgText) {
          bgText.style.transform =
            `translate(calc(-50% + ${rect.top * speed * 0.12}px), -50%)`;
        }

        if (!reduce) {
          // How much of the screen this card's window covers: 0 → 1 as it
          // opens, 1 → 0 as the next one closes it.
          const f = (Math.min(rect.bottom, vh) - Math.max(rect.top, 0)) / vh;
          if (foot) {
            const t = smooth(0.4, 0.92, f);
            foot.style.opacity = t.toFixed(3);
            foot.style.filter = `blur(${((1 - t) * FOOT_BLUR).toFixed(2)}px)`;
          }
          if (img) img.style.transform = `scale(${(1 + (1 - smooth(0, 1, f)) * IMG_SETTLE).toFixed(4)})`;
        }
      }
      seat(enter, opening);
      raf = requestAnimationFrame(render);
    }

    raf = requestAnimationFrame(render);

    // â”€â”€ Dominant colour extraction â”€â”€
    const canvas = document.createElement('canvas');
    canvas.width = 40;
    canvas.height = 40;
    const ctx = canvas.getContext('2d');

    if (ctx) {
      document.querySelectorAll<HTMLElement>('.proj-section').forEach(sec => {
        const img = sec.querySelector<HTMLImageElement>('.proj-img-wrap img');
        if (!img) return;

        const extract = () => {
          try {
            ctx.clearRect(0, 0, 40, 40);
            ctx.drawImage(img, 0, 0, 40, 40);
            const px = ctx.getImageData(0, 0, 40, 40).data;
            let r = 0, g = 0, b = 0;
            const n = px.length / 4;
            for (let i = 0; i < px.length; i += 4) {
              r += px[i]; g += px[i + 1]; b += px[i + 2];
            }
            // Darken to ~10% — rich but very dark tinted bg
            const d = 0.1;
            sec.style.backgroundColor =
              `rgb(${Math.round(r/n*d)},${Math.round(g/n*d)},${Math.round(b/n*d)})`;
          } catch {
            // CORS blocked — keep existing --bg
          }
        };

        img.complete ? extract() : img.addEventListener('load', extract, { once: true });
      });
    }

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      built++;
      window.removeEventListener('resize', onResize);
      teardownBeam();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initProjectsPage);
</script>

