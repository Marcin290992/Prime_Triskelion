---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { Image } from 'astro:assets';
import { withPages, nextOf } from '../../data/projects';

export function getStaticPaths() {
  return withPages.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const d = project.detail!;
const next = nextOf(project.slug);
const [line1, line2] = d.titleLines;
---

<Layout title={`${project.title} — Prime Triskelion`} description={`Case study: ${project.title} — ${d.short.toLowerCase()} by Prime Triskelion.`}>

  <main class="wos-page">

    <!-- ═══ CINEMATIC HERO (desktop only) ═══ -->
    <section class="wos-cin" id="wos-cin">
      <h1 class="wos-cin__sr">{project.title} — Case Study</h1>
      <div class="wos-cin__image" aria-hidden="true">
        <img src={d.heroImage} alt="" draggable="false">
      </div>
      <div class="wos-cin__texts" aria-hidden="true">
        <span class="wos-cin__l"><span class="wos-cin__w">{d.heroWords[0]}</span></span>
        <span class="wos-cin__r"><span class="wos-cin__w">{d.heroWords[1]}</span></span>
      </div>
      <!-- Bottom overlay: visible at once, does not wait for scroll -->
      <div class="wos-cin__bottom">
        <div class="wos-cin__meta">
          <span class="wos-label wos-label--inline">Case Study</span>
          <span class="wos-dot" aria-hidden="true">·</span>
          <span class="wos-label wos-label--inline wos-label--dim">{project.year}</span>
          <span class="wos-dot" aria-hidden="true">·</span>
          <span class="wos-label wos-label--inline wos-label--dim">{d.short}</span>
        </div>
        <h2 class="wos-cin__title">{line1}<br>{line2}</h2>
        <p class="wos-cin__desc">{d.summary}</p>
        <div class="wos-cin__btns">
          {d.url && (
            <div class="h-hero-cta-wrap">
              <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
              <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
              <a href={d.url} class="h-hero-cta h-hero-cta--fixed" target="_blank" rel="noopener noreferrer">
                <span class="hud-spin-border"></span>
                <span class="h-hero-cta__text">Visit Website</span>
              </a>
            </div>
          )}
          <div class="h-hero-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="#contact-cta" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Let's build</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PROJECT DETAIL (Trionn-style): sticky panel left, gallery right ═══ -->
    <section class="wos-pd" id="wos-pd">
      <div class="wos-inner wos-pd__grid">

        <aside class="wos-pd__side">
          <div class="wos-pd__side-inner" id="wos-stage">
            <!-- phone/tablet: the title alone on black, laid over the panel; scroll blurs it away
                 and the panel comes up out of blur in the same place -->
            <div class="wos-splash" aria-hidden="true">
              <span class="wos-splash__title">{line1}<br/>{line2}</span>
            </div>
            <div class="wos-pd__top">
              <div class="wos-pd__topbar">
                <a href="/projects/" class="wos-pd__link">Back to projects</a>
                {d.url && (
                  <a href={d.url} class="wos-pd__live wos-pd__live--top" target="_blank" rel="noopener noreferrer" aria-label="Visit the live website"><span class="wos-pd__live-dot" aria-hidden="true"></span>Live</a>
                )}
              </div>
              <div class="wos-pd__meta">
                <span class="wos-label wos-label--inline">Case Study</span>
                <span class="wos-dot" aria-hidden="true">·</span>
                <span class="wos-label wos-label--inline wos-label--dim">{project.year}</span>
                <span class="wos-dot" aria-hidden="true">·</span>
                <span class="wos-label wos-label--inline wos-label--dim">{d.short}</span>
              </div>
              <h2 class="wos-pd__title">{line1}<br/>{line2}</h2>
              <p class="wos-pd__sub">{d.summary}</p>
              <ul class="wos-pd__cats">
                {project.categories.map((c) => <li>{c}</li>)}
              </ul>
            </div>

            <div class="wos-pd__tabs" id="wos-pd-tabs">
              <div class="wos-pd__tabrow" role="tablist">
                {d.tabs.map((t, i) => (
                  <button type="button" role="tab" class={`wos-pd__tab${i === 0 ? ' is-active' : ''}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}<span class="wos-pd__bar"></span></button>
                ))}
              </div>
              <div class="wos-pd__panels">
                {d.tabs.map((t, i) => (
                  <div class={`wos-pd__panel${i === 0 ? ' is-active' : ''}`} role="tabpanel">
                    {t.list ? <ul>{t.list.map((l) => <li>{l}</li>)}</ul> : <p>{t.text}</p>}
                  </div>
                ))}
              </div>
            </div>

            <div class="wos-pd__nav">
              <a href="/projects/" class="wos-pd__link wos-pd__link--back">Back to projects</a>
              {d.url && (
                <a href={d.url} class="wos-pd__live" target="_blank" rel="noopener noreferrer" aria-label="Visit the live website"><span class="wos-pd__live-dot" aria-hidden="true"></span>Live</a>
              )}
            </div>
          </div>
        </aside>

        <div class="wos-pd__gallery" id="wos-pd-gallery">
          {d.gallery.map((row, ri) =>
            row.length === 2 ? (
              <div class="wos-pd__row">
                {row.map((g) => (
                  <div class="wos-pd__img" style={`aspect-ratio: ${g.ratio};`}>
                    <Image src={g.img} alt={g.alt ?? ''} widths={[600, 900]} sizes="(min-width: 1025px) 31vw, 50vw" loading="lazy" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="wos-pd__img" style={`aspect-ratio: ${row[0].ratio};`}>
                <Image src={row[0].img} alt={row[0].alt ?? ''} widths={[900, 1400]} sizes="(min-width: 1025px) 62vw, 100vw" loading={ri === 0 ? 'eager' : 'lazy'} />
              </div>
            )
          )}

          {next && (
            <a class="wos-pd__next" href={`/projects/${next.slug}/`}>
              <span class="wos-pd__next-label">Next project</span>
              <span class="wos-pd__next-title">{next.title}</span>
            </a>
          )}
        </div>

      </div>
    </section>

    <!-- ═══ FOOTER CTA ═══ -->
    <CtaSection />

  </main>

</Layout>

<style>
  /* ─────────────────────────────────────────
     BASE
  ───────────────────────────────────────── */
  .wos-page {
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }
  .wos-inner {
    width: min(100%, var(--site-max-width));
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    box-sizing: border-box;
  }

  /* Labels */
  .wos-label {
    font-family: var(--f-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgb(var(--c-red) / 0.92);
    display: block;
    margin-bottom: 1.5rem;
  }
  .wos-label--dim { color: rgb(var(--c-cream) / 0.8); margin-bottom: 0; }

  /* ─────────────────────────────────────────
     CINEMATIC HERO — desktop only
  ───────────────────────────────────────── */
  .wos-cin {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: rgb(var(--c-bg));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wos-cin::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 70vh;
    background: linear-gradient(to bottom, transparent 0%, rgb(var(--c-bg) / 0.75) 40%, rgb(var(--c-bg)) 72%);
    pointer-events: none;
    z-index: 2;
  }
  .wos-cin__sr {
    position: absolute;
    width: 1px; height: 1px;
    clip: rect(0,0,0,0);
    overflow: hidden;
    white-space: nowrap;
    border: 0;
  }
  .wos-cin__image {
    position: absolute;
    right: 0;
    top: 0;
    width: 54%;
    height: 100%;
    z-index: 1;
    border-radius: 0;
    overflow: hidden;
    will-change: transform;
    pointer-events: none;
    background: rgb(var(--c-bg));
    /* Hidden by default so it never flashes fully visible before
       initCinematic()'s gsap.set() runs on astro:page-load — that script
       execution isn't guaranteed to beat first paint after a view
       transition, so without this the image (and bottom text below) can
       briefly appear at full opacity, overlapping the centered WINDS/OF
       SINAI word split, before JS catches up and hides them again. */
    opacity: 0;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 26%, black 68%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 18%, black 62%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, black 26%, black 68%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 18%, black 62%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-composite: intersect;
  }
  .wos-cin__image::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgb(var(--c-red) / 0.05) 0%, transparent 55%),
      repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px),
      repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.025) 39px, rgba(255,255,255,0.025) 40px);
    pointer-events: none;
    z-index: 2;
  }
  .wos-cin__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .wos-cin__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 4.5vw, 5.5rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: rgb(var(--c-cream));
    margin: 0;
  }
  .wos-cin__texts {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5vw;
    pointer-events: none;
    width: 100%;
  }
  .wos-cin__l,
  .wos-cin__r {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 8.5vw;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
    white-space: nowrap;
    will-change: transform;
    line-height: 1;
  }

  /* Entrance (titleIn, same focus pull as the other pages' titles) runs
     on these inner spans — the outer ones belong to the scroll split,
     which scrubs their own x and opacity. */
  .wos-cin__w { display: inline-block; opacity: 0; filter: blur(18px); }

  /* Bottom overlay — widoczny od razu podczas animacji */
  .wos-cin__bottom {
    position: absolute;
    bottom: clamp(16rem, 30vh, 22rem);
    left: var(--site-gutter, 2rem);
    width: calc(42% - var(--site-gutter, 2rem));
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  /* Same FOUC guard as .wos-cin__image above — these are only meant to be
     visible once the scroll-pinned reveal runs, but gsap.set() is what
     hides them and that script can lag first paint after a navigation. */
  .wos-cin__bottom .wos-cin__meta,
  .wos-cin__bottom .wos-cin__title,
  .wos-cin__bottom .wos-cin__desc,
  .wos-cin__bottom .wos-cin__btns {
    opacity: 0;
  }
  .wos-cin__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .wos-dot {
    color: rgba(255,255,255,0.45);
    font-size: 11px;
  }
  .wos-label--inline { display: inline; margin-bottom: 0; }
  .wos-cin__desc {
    font-family: var(--f-body);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--c-cream) / 0.82);
    max-width: 44ch;
    margin: 0;
  }
  .wos-cin__btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .wos-cin { display: none; }
  }

  /* ─── Cinematic: małe laptopy (1025–1440px) ─── */
  @media (min-width: 1025px) and (hover: hover) and (max-width: 1440px), (min-width: 1025px) and (pointer: fine) and (max-width: 1440px) {
    .wos-cin__image { width: 52%; }
    .wos-cin__bottom {
      width: calc(44% - var(--site-gutter, 2rem));
    }
    .wos-cin__title { font-size: clamp(2.4rem, 3.8vw, 4.5rem); }
  }

  /* ─── Cinematic: krótkie ekrany (laptopy 768px high) ─── */
  @media (min-width: 1025px) and (hover: hover) and (max-height: 800px), (min-width: 1025px) and (pointer: fine) and (max-height: 800px) {
    .wos-cin__bottom {
      gap: 0.85rem;
    }
    .wos-cin__title { font-size: clamp(2rem, 3vw, 3.5rem); }
    .wos-cin__desc { font-size: clamp(0.82rem, 1vw, 0.95rem); }
    .wos-cin__l, .wos-cin__r { font-size: 7vw; }
  }

  /* ─────────────────────────────────────────
     HERO BUTTONS
     Both now use the shared .h-hero-cta / .h-hero-cta--fixed CTA (global.css)
     — identical to the pre-footer "Start a project" button. Nothing
     page-local needed; global.css handles the mobile full-width rule.
  ───────────────────────────────────────── */

  /* ─────────────────────────────────────────
     PROJECT DETAIL — sticky panel + gallery (after the hero)
  ───────────────────────────────────────── */
  .wos-pd { background: rgb(var(--c-bg)); position: relative; }
  .wos-pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: 5.75rem;
    padding-bottom: 6.25rem;
  }
  .wos-pd__grid.wos-inner { width: 100%; max-width: none; padding-inline: 1.75rem; }
  .wos-pd__side, .wos-pd__gallery { grid-column: 1 / -1; min-width: 0; }
  .wos-pd__panels { grid-template-columns: minmax(0, 1fr); }
  .wos-pd__gallery { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 4rem; }
  .wos-pd__side-inner { display: flex; flex-direction: column; }

  .wos-pd__link {
    font-family: var(--f-body);
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.85);
    text-decoration: none;
    transition: color 0.3s;
  }
  .wos-pd__link:hover { color: rgb(var(--c-red)); }
  .wos-pd__meta { display: none; } /* desktop: the cinematic hero already says it */
  .wos-pd__topbar { display: none; } /* phone: back link and Live are in the bottom row */
  .wos-pd__live {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--f-body); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgb(var(--c-cream)); text-decoration: none;
    transition: color 0.3s;
  }
  .wos-pd__live:hover { color: rgb(var(--c-red)); }
  .wos-pd__live-dot {
    width: 7px; height: 7px; background: rgb(var(--c-red)); flex-shrink: 0;
    animation: wosLive 1.6s ease-in-out infinite;
  }
  @keyframes wosLive { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  .wos-pd__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 4.2vw, 4.4rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 0.92;
    color: rgb(var(--c-cream));
  }
  .wos-pd__sub {
    margin: 1.25rem 0 0;
    max-width: 24rem;
    font-family: var(--f-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--c-cream) / 0.7);
  }
  .wos-pd__cats, .wos-pd__panel ul { list-style: none; padding: 0; margin: 0; }
  .wos-pd__cats { margin-top: 1.75rem; }
  .wos-pd__cats li, .wos-pd__panel li {
    display: flex; gap: 0.4rem;
    font-family: var(--f-body); font-weight: 300; font-size: 0.95rem; line-height: 1.7;
    color: rgb(var(--c-cream) / 0.82);
  }
  .wos-pd__cats li::before, .wos-pd__panel li::before { content: '·'; color: rgb(var(--c-red) / 0.85); }

  .wos-pd__tabs { margin-top: 3.5rem; }
  .wos-pd__tabrow { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .wos-pd__tab {
    position: relative; padding: 0 0 0.5rem; background: none; border: 0; cursor: pointer;
    font-family: var(--f-body); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgb(var(--c-cream)); opacity: 0.4; transition: opacity 0.3s;
  }
  .wos-pd__tab:hover, .wos-pd__tab.is-active { opacity: 1; }
  .wos-pd__tab::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: rgb(var(--c-cream) / 0.25); transform: scaleX(0); transform-origin: left; transition: transform 0.4s;
  }
  .wos-pd__tab.is-active::after { transform: scaleX(1); }
  .wos-pd__bar {
    position: absolute; left: 0; bottom: 0; z-index: 1; width: 100%; height: 1px;
    background: rgb(var(--c-red)); transform: scaleX(0); transform-origin: left;
  }
  .wos-pd__tab.is-active .wos-pd__bar { animation: wosPdBar var(--wos-pd-ms, 6000ms) linear forwards; }
  /* While the tabs are held (hover / touch) the timer stops: the active tab's line stays full red. */
  /* Phone/tablet: the timer waits until the panel has come up out of blur. */
  .wos-pd__tabs.is-waiting .wos-pd__bar { animation: none; transform: scaleX(0); }
  .wos-pd__tabs.is-paused .wos-pd__tab.is-active .wos-pd__bar { animation: none; transform: scaleX(1); }
  @keyframes wosPdBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .wos-pd__panels { margin-top: 1.5rem; display: grid; }
  .wos-pd__panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 0.5s, transform 0.5s, visibility 0s 0.5s; }
  .wos-pd__panel.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .wos-pd__panel p {
    margin: 0; max-width: 28rem;
    font-family: var(--f-body); font-size: 1rem; font-weight: 300; line-height: 1.7;
    color: rgb(var(--c-cream) / 0.82);
  }

  .wos-pd__nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 3rem; padding-top: 1rem; border-top: 1px solid rgb(var(--c-cream) / 0.14);
  }
  .wos-pd__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .wos-pd__img {
    position: relative; overflow: hidden; border-radius: 0.5rem; background: #111114;
    opacity: 0; transform: translateY(2.5rem);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.2s ease;
  }
  .wos-pd__img :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.12); transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wos-pd__img.is-in { opacity: 1; transform: none; }
  .wos-pd__img.is-in :global(img) { transform: none; }

  .wos-pd__next {
    display: flex; flex-direction: column; gap: 0.6rem; margin-top: 2rem;
    padding: 2rem 0 0; border-top: 1px solid rgb(var(--c-cream) / 0.14); text-decoration: none;
  }
  .wos-pd__next-label { font-family: var(--f-body); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: rgb(var(--c-cream) / 0.6); }
  .wos-pd__next-title {
    font-family: var(--f-display); font-weight: 700; text-transform: uppercase; line-height: 0.95;
    font-size: clamp(2.2rem, 6vw, 5rem); color: rgb(var(--c-cream)); transition: color 0.3s;
  }
  .wos-pd__next:hover .wos-pd__next-title { color: rgb(var(--c-red)); }

  @media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
    .wos-pd__grid { padding-top: 0; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; }
    .wos-pd__side { grid-column: 1 / span 4; }
    .wos-pd__gallery { grid-column: 5 / span 8; margin-top: 0; padding-top: clamp(6.5rem, 12vh, 7.5rem); }
    .wos-pd__side-inner {
      position: sticky; top: 0; height: 100vh; height: 100svh;
      /* Bottom clears the fixed blur band, so the last row stays readable. */
      padding-top: clamp(6.5rem, 12vh, 7.5rem); padding-bottom: clamp(6.5rem, 13vh, 8rem); box-sizing: border-box;
    }
    .wos-pd__topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding-bottom: 0.9rem; margin-bottom: clamp(1.25rem, 3.5vh, 2.5rem);
      border-bottom: 1px solid rgb(var(--c-cream) / 0.14);
    }
    .wos-pd__tabs { margin-top: clamp(1.5rem, 4.5vh, 3rem); }
    .wos-pd__title { font-size: clamp(2.2rem, min(3.4vw, 6.2vh), 3.8rem); }
    .wos-pd__title + .wos-pd__sub { margin-top: clamp(0.75rem, 2vh, 1.25rem); }
    .wos-pd__cats { margin-top: clamp(1rem, 2.5vh, 1.75rem); }
    .wos-pd__nav { display: none; } /* desktop: the back link is at the top, nothing sits in the bottom blur band */
  }
  /* Low laptop screens: shorter panel, so the tab text stays above the bottom blur band. */
  @media (min-width: 1025px) and (max-height: 760px) { .wos-pd__sub { display: none; } }
  @media (min-width: 1025px) and (max-height: 680px) { .wos-pd__cats { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .wos-pd__img, .wos-pd__img :global(img) { opacity: 1; transform: none; transition: none; }
  }


  /* ─────────────────────────────────────────
     BROWSER FRAME
  ───────────────────────────────────────── */
  .browser-frame {
    background: #131318;
    border: 1px solid rgba(255,255,255,0.17);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.55), 0 4px 12px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);
    width: 100%;
  }
  .browser-frame__bar {
    background: #18181c;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    height: 34px;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  .browser-frame__dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }
  .browser-frame__dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
  }
  .browser-frame__dots span:nth-child(1) { background: rgba(255, 95, 86, 0.7); }
  .browser-frame__dots span:nth-child(2) { background: rgba(255, 189, 46, 0.7); }
  .browser-frame__dots span:nth-child(3) { background: rgba(39, 201, 63, 0.7); }
  .browser-frame__url {
    flex: 1;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    height: 20px;
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgb(var(--c-cream) / 0.8);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .browser-frame__screen {
    aspect-ratio: 16 / 10;
    background: linear-gradient(160deg, #1a1a20 0%, #121217 100%);
    display: grid;
    place-content: center;
    position: relative;
    overflow: hidden;
  }
  .browser-frame__screen--tall {
    aspect-ratio: 16 / 9;
  }
  .browser-frame__ph {
    font-family: var(--f-body);
    font-size: 12px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.72);
    position: relative;
    z-index: 1;
  }
  /* Ready for whenever a real screenshot fills these mockup placeholders
     instead of the flat gradient — not currently used by any markup here. */
  .browser-frame__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .browser-frame__screen::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgb(var(--c-red) / 0.03) 0%, transparent 60%),
      repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.015) 39px, rgba(255,255,255,0.015) 40px),
      repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.015) 39px, rgba(255,255,255,0.015) 40px);
  }

  /* Wide variant (full-width showcase) */
  .browser-frame--wide {
    border-radius: 12px;
    width: min(calc(100% - var(--site-gutter) * 2), calc(var(--site-max-width) - var(--site-gutter) * 2));
    margin-inline: auto;
  }
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .browser-frame--wide {
      border-radius: 12px;
      width: calc(100% - var(--site-gutter) * 2);
      margin-inline: var(--site-gutter);
    }
  }



  /* ─────────────────────────────────────────
     MOBILE — the desktop's scenes, on a finger scroll
     (Lenis drives touch scroll site-wide, see utils/touchLenis.ts)
  ───────────────────────────────────────── */
  .wos-splash { display: none; }
  .wos-splash__title { opacity: 0; display: block; }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    /* 1. The stage: one screen, the panel centred in it, the splash title laid over it. */
    .wos-pd__side-inner {
      position: relative;
      min-height: 100svh;
      min-height: calc(var(--app-stable-vh, 1svh) * 100);
      justify-content: center;
      box-sizing: border-box;
      padding: 5rem 0 6rem;
    }
    .wos-splash {
      position: absolute;
      /* One screen tall from the top of the stage, so the title is centred on the
         screen even when the panel under it is taller than the screen (small phones). */
      inset: 0 0 auto 0;
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgb(var(--c-bg));
      text-align: center;
      pointer-events: none;
    }
    .wos-splash__title {
      margin: 0;
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(3.2rem, 15vw, 7rem);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      line-height: 0.9;
      color: rgb(var(--c-cream));
    }

    /* The panel opens like the old hero: case-study line, title, description. */
    .wos-pd__title { font-size: clamp(3rem, 14vw, 5.5rem); margin-bottom: 1.25rem; }
    .wos-pd__meta { display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; margin-bottom: 1.25rem; }
    .wos-pd__meta .wos-label { font-size: 11px; letter-spacing: 0.2em; }
    .wos-pd__grid { padding-top: 0; }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { isSafari } from '../../utils/isSafari';
  import { afterPageTransition, revealAfterHero, titleIn, subpageMode, reducedMotion, syncTickerToScroll } from '../../utils/afterPageTransition';
  import { TOUCH_LENIS_OPTIONS } from '../../utils/touchLenis';

  gsap.registerPlugin(ScrollTrigger);

  let _lenis: InstanceType<typeof Lenis> | null = null;
  let _lenisRaf: ((time: number) => void) | null = null;
  let _cinST: ReturnType<typeof ScrollTrigger.create> | null = null;

  // ── Mobile/tablet: the title alone on black, laid over the panel (one pinned screen).
  // Scrolling blurs the title away, and the panel comes up out of blur in the same place ──
  function initSplash() {
    const stage = document.getElementById('wos-stage');
    const splash = stage?.querySelector<HTMLElement>('.wos-splash');
    const title = stage?.querySelector<HTMLElement>('.wos-splash__title');
    if (!stage || !splash || !title) return;

    const mode = subpageMode();
    if (mode === 'none' || reducedMotion()) gsap.set(title, { opacity: 1 });
    else {
      gsap.set(title, { opacity: 0, y: 10, filter: 'blur(8px)' });
      afterPageTransition(() => {
        gsap.to(title, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.65, ease: 'power3.out', delay: 0.18 });
      });
    }
    if (reducedMotion()) { splash.style.display = 'none'; return; }

    const items = stage.querySelectorAll<HTMLElement>('.wos-pd__meta, .wos-pd__title, .wos-pd__sub, .wos-pd__cats, .wos-pd__tabs');
    gsap.set(items, { opacity: 0, filter: 'blur(12px)' });

    // The tab timer may run only once the panel is fully out of blur (pin finished).
    const gate = (on: boolean) => {
      if ((window as any).__wosTabsGate === on) return;
      (window as any).__wosTabsGate = on;
      document.dispatchEvent(new CustomEvent('wos:tabs-gate', { detail: on }));
    };
    (window as any).__wosTabsGate = false;

    gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: stage, start: 'top top', end: '+=90%', scrub: 0.6, pin: true, invalidateOnRefresh: true,
        onUpdate: (self) => gate(self.progress >= 0.995),
      },
    })
      // Explicit start values: the entrance tween above is still running when this
      // is built, so a plain .to() would remember its blurred start and scroll back
      // to that blur instead of to a sharp title.
      .fromTo(title, { filter: 'blur(0px)' }, { filter: 'blur(16px)', duration: 0.5, ease: 'sine.in', immediateRender: false }, 0)
      .fromTo(title, { opacity: 1 }, { opacity: 0, duration: 0.5, ease: 'sine.inOut', immediateRender: false }, 0.2)
      .to(splash, { opacity: 0, duration: 0.4 }, 0.55)
      .to(items, { opacity: 1, filter: 'blur(0px)', stagger: 0.1, duration: 0.5, ease: 'sine.out' }, 0.6);
  }

  // ── Project detail: tabs that switch on their own (timer line under the active
  // tab), pause on hover; gallery pictures rise and un-zoom as they enter ──
  const PD_MS = 6000;
  function initProjectDetail() {
    const tabs = document.getElementById('wos-pd-tabs');
    if (tabs) {
      tabs.style.setProperty('--wos-pd-ms', `${PD_MS}ms`);
      const btns = Array.from(tabs.querySelectorAll<HTMLElement>('.wos-pd__tab'));
      const panels = Array.from(tabs.querySelectorAll<HTMLElement>('.wos-pd__panel'));
      let active = 0;
      let timer: number | undefined;
      const show = (i: number) => {
        active = i;
        btns.forEach((b, k) => {
          const on = k === i;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', String(on));
          if (on) {
            const bar = b.querySelector<HTMLElement>('.wos-pd__bar');
            if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
          }
        });
        panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
      };
      const arm = () => {
        window.clearTimeout(timer);
        if (reducedMotion() || !gateOpen || tabs.classList.contains('is-paused')) return;
        timer = window.setTimeout(() => { show((active + 1) % btns.length); arm(); }, PD_MS);
      };
      // Phone/tablet: wait for the panel to come out of blur (see initSplash).
      let gateOpen = (window as any).__wosTabsGate !== false;
      tabs.classList.toggle('is-waiting', !gateOpen);
      const onGate = (e: Event) => {
        gateOpen = (e as CustomEvent<boolean>).detail;
        tabs.classList.toggle('is-waiting', !gateOpen);
        window.clearTimeout(timer);
        if (gateOpen) { show(active); arm(); }
      };
      document.addEventListener('wos:tabs-gate', onGate);
      document.addEventListener('astro:before-swap', () => document.removeEventListener('wos:tabs-gate', onGate), { once: true });
      btns.forEach((b, i) => b.addEventListener('click', () => { show(i); arm(); }));
      tabs.addEventListener('mouseenter', () => { tabs.classList.add('is-paused'); window.clearTimeout(timer); });
      tabs.addEventListener('mouseleave', () => { tabs.classList.remove('is-paused'); show(active); arm(); });
      document.addEventListener('astro:before-swap', () => window.clearTimeout(timer), { once: true });
      arm();
    }

    const imgs = Array.from(document.querySelectorAll<HTMLElement>('.wos-pd__img'));
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -6% 0px' });
    imgs.forEach((el) => io.observe(el));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }


  // ── Desktop: cinematic pinned animation ──
  function initCinematic() {
    const section = document.getElementById('wos-cin');
    if (!section) return;

    const wordL = section.querySelector<HTMLElement>('.wos-cin__l');
    const wordR = section.querySelector<HTMLElement>('.wos-cin__r');
    const image = section.querySelector<HTMLElement>('.wos-cin__image');
    if (!wordL || !wordR || !image) return;

    const bottom = section.querySelector<HTMLElement>('.wos-cin__bottom');
    const bottomEls = bottom
      ? Array.from(bottom.querySelectorAll<HTMLElement>('.wos-cin__meta, .wos-cin__title, .wos-cin__desc, .wos-cin__btns'))
      : [];

    gsap.set(wordL, { x: '0vw', y: 0 });
    gsap.set(wordR, { x: '0vw', y: 0 });
    gsap.set(image, { opacity: 0, scale: 0.9, yPercent: 4 });
    if (bottomEls.length) gsap.set(bottomEls, { opacity: 0, y: 28, filter: 'blur(8px)' });

    // The title goes out where it stands, the way the home hero does: it goes
    // soft first and then fades into the dark (no sliding apart). Only then does
    // the page come up out of that dark — the picture, then the title, the line
    // and the buttons after it. All of it is scrubbed by the scroll.
    const tl = gsap.timeline({ defaults: { ease: 'none' } })
      .to([wordL, wordR], { filter: 'blur(16px)', duration: 0.6, ease: 'sine.in' }, 0)
      .to([wordL, wordR], { opacity: 0, duration: 0.6, ease: 'sine.inOut' }, 0.25)
      .to(image, { opacity: 1, scale: 1.06, yPercent: 0, ease: 'sine.inOut', duration: 0.9 }, 0.7);

    if (bottomEls.length) {
      tl.to(bottomEls, {
        opacity: 1, y: 0, filter: 'blur(0px)',
        stagger: 0.12, duration: 0.6, ease: 'sine.out',
      }, 1.15);
    }

    // Entrance: the word split focus-pulls in like every other page title.
    const words = section.querySelectorAll<HTMLElement>('.wos-cin__w');
    afterPageTransition(() => { titleIn(gsap.timeline(), words); });

    _cinST = ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: '+=140%',
      scrub: 1.2,
      pin: true,
      invalidateOnRefresh: true,
      animation: tl,
    });
  }


  function initPage() {
    // The sitewide column lines now run through this page too (they used to be
    // hidden here, because the page has its own fine grid backgrounds).
    // const gridLines = document.getElementById('grid-lines');
    // if (gridLines) gridLines.style.visibility = 'hidden';

    // 1. Lenis musi być przed ScrollTrigger, żeby sync działał poprawnie
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    // Touch uses the same Lenis as the rest of the site, Safari included
    // (see utils/touchLenis.ts).
    {
      _lenis = new Lenis(isTouch ? { ...TOUCH_LENIS_OPTIONS } : {
        // Narrow windows (phone/tablet widths) get a much lighter drag.
        lerp: window.matchMedia('(max-width: 1024px)').matches ? 0.16 : 0.06,
        smoothWheel: true,
        wheelMultiplier: window.matchMedia('(max-width: 1024px)').matches ? 0.8 : 0.75,
      });
      (window as any).__lenis = _lenis;

      // Poprawny sync Lenis ↔ ScrollTrigger (oficjalny pattern z docs Lenis)
      _lenis.on('scroll', ScrollTrigger.update);
      _lenisRaf = (time: number) => { _lenis!.raf(time * 1000); };
      gsap.ticker.add(_lenisRaf);
      syncTickerToScroll();
    }

    // 2. Animacje — mobile/desktop rozdzielone jak w CSS
    const isMob = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
    // Content below the hero fades in after it (mobile only, see
    // revealAfterHero) — called unconditionally so it can never stay hidden.
    afterPageTransition(() => revealAfterHero(550));
    (window as any).__wosTabsGate = undefined; // only the phone/tablet splash closes it
    if (isMob) {
      ScrollTrigger.config({ ignoreMobileResize: true });
      initSplash();
      initProjectDetail();
    } else {
      initCinematic();
      initProjectDetail();
    }
    document.addEventListener('astro:before-swap', () => {
      const gl = document.getElementById('grid-lines');
      if (gl) gl.style.visibility = '';
      if (_lenisRaf) { gsap.ticker.remove(_lenisRaf); _lenisRaf = null; }
      _lenis?.destroy();
      _lenis = null;
      (window as any).__lenis = null;
      _cinST?.kill();
      _cinST = null;
      ScrollTrigger.getAll().forEach(st => st.kill());
    }, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('wos-cin')) initPage();
  });
</script>
