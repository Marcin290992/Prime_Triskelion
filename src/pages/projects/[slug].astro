---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { Image } from 'astro:assets';
import { withPages, nextOf } from '../../data/projects';

export function getStaticPaths() {
  return withPages.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const d = project.detail!;
const next = nextOf(project.slug);
const [line1, line2] = d.titleLines;
---

<Layout title={`${project.title} — Prime Triskelion`} description={`Case study: ${project.title} — ${d.short.toLowerCase()} by Prime Triskelion.`}>
  <main class="cs">

    <!-- Hero: plain, in normal flow — nothing pinned, nothing JS-driven -->
    <section class="cs-hero">
      <div class="cs-wrap">
        <div class="cs-hero__top">
          <a href="/projects/" class="cs-link">Back to projects</a>
          {d.url && (
            <a href={d.url} class="cs-live" target="_blank" rel="noopener noreferrer">
              <span class="cs-live__dot" aria-hidden="true"></span>Live
            </a>
          )}
        </div>

        <p class="cs-meta">
          <span>Case Study</span><i aria-hidden="true">·</i><span>{project.year}</span><i aria-hidden="true">·</i><span>{d.short}</span>
        </p>

        <h1 class="cs-title">{line1}<br />{line2}</h1>
        <p class="cs-summary">{d.summary}</p>

        <ul class="cs-cats">
          {project.categories.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- Gallery -->
    <section class="cs-gallery">
      <div class="cs-wrap">
        {d.gallery.map((row, ri) => (
          <div class={`cs-row${row.length === 2 ? ' cs-row--pair' : ''}`}>
            {row.map((g) => (
              <div class="cs-img" style={`aspect-ratio: ${g.ratio};`}>
                <Image
                  src={g.img}
                  alt={g.alt ?? ''}
                  widths={[600, 900, 1400]}
                  sizes={row.length === 2 ? '(min-width: 1025px) 46vw, 50vw' : '(min-width: 1025px) 92vw, 100vw'}
                  loading={ri === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- Story: one column per tab, no tab switching needed -->
    <section class="cs-story">
      <div class="cs-wrap cs-story__grid">
        {d.tabs.map((t) => (
          <article class="cs-block">
            <h2 class="cs-block__h">{t.label}</h2>
            {t.list ? <ul class="cs-block__list">{t.list.map((l) => <li>{l}</li>)}</ul> : <p>{t.text}</p>}
          </article>
        ))}
      </div>
    </section>

    {next && (
      <a class="cs-next" href={`/projects/${next.slug}/`}>
        <span class="cs-next__label">Next project</span>
        <span class="cs-next__title">{next.title}</span>
      </a>
    )}

    <CtaSection />
  </main>
</Layout>

<style>
  .cs {
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }
  .cs-wrap {
    width: min(100%, var(--site-max-width));
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    box-sizing: border-box;
  }

  /* Hero */
  .cs-hero { padding-block: clamp(7rem, 16vh, 11rem) clamp(3rem, 8vh, 5rem); }
  .cs-hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    border-bottom: 1px solid rgb(var(--c-cream) / 0.12);
  }
  .cs-link, .cs-live, .cs-meta {
    font-family: var(--f-body);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .cs-link { color: rgb(var(--c-cream) / 0.7); text-decoration: none; transition: color 0.25s ease; }
  .cs-link:hover { color: rgb(var(--c-cream)); }
  .cs-live { display: inline-flex; align-items: center; gap: 0.6rem; color: rgb(var(--c-cream)); text-decoration: none; }
  .cs-live__dot { width: 6px; height: 6px; background: rgb(var(--c-red)); }
  .cs-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 1.5rem; color: rgb(var(--c-cream) / 0.55); }
  .cs-meta i { font-style: normal; }
  .cs-title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3.2rem, 11vw, 10rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .cs-summary {
    max-width: 38rem;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.6;
    color: rgb(var(--c-cream) / 0.7);
  }
  .cs-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .cs-cats li {
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(var(--c-cream) / 0.18);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.8);
  }

  /* Gallery */
  .cs-gallery { padding-block: clamp(1rem, 3vh, 2rem) clamp(3rem, 8vh, 6rem); }
  .cs-row { margin-bottom: clamp(0.75rem, 1.6vw, 1.5rem); }
  .cs-row--pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 1.6vw, 1.5rem); }
  .cs-row--pair .cs-img { margin: 0; }
  .cs-img { overflow: hidden; background: rgb(var(--c-cream) / 0.04); }
  .cs-img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Story */
  .cs-story { padding-block: clamp(2rem, 6vh, 4rem) clamp(4rem, 10vh, 7rem); border-top: 1px solid rgb(var(--c-cream) / 0.12); }
  .cs-story__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 4rem); padding-top: clamp(2rem, 5vh, 3.5rem); }
  .cs-block__h {
    margin: 0 0 1rem;
    font-family: var(--f-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--c-red));
  }
  .cs-block p, .cs-block__list { margin: 0; font-size: 1rem; line-height: 1.7; color: rgb(var(--c-cream) / 0.78); }
  .cs-block__list { padding: 0; list-style: none; }
  .cs-block__list li { padding-block: 0.45rem; border-bottom: 1px solid rgb(var(--c-cream) / 0.1); }

  /* Next project */
  .cs-next {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(3rem, 9vh, 6rem) var(--site-gutter);
    border-top: 1px solid rgb(var(--c-cream) / 0.12);
    color: inherit;
    text-decoration: none;
  }
  .cs-next__label { font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(var(--c-cream) / 0.55); }
  .cs-next__title { font-family: var(--f-display); font-weight: 700; font-size: clamp(2rem, 6vw, 5rem); line-height: 1; text-transform: uppercase; transition: color 0.3s ease; }
  .cs-next:hover .cs-next__title { color: rgb(var(--c-red)); }

  @media (max-width: 900px) {
    .cs-story__grid { grid-template-columns: 1fr; }
  }
</style>
