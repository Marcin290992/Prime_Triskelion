---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import SelectedWorkSection from '../components/sections/SelectedWorkSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import ShowcaseSection from '../components/sections/ShowcaseSection.astro';
import SplitCardsSection from '../components/sections/SplitCardsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
---

<Layout title="Prime Triskelion">
	<div id="hero-pin">
		<HeroSection />
	</div>
	<div id="hero-blur" aria-hidden="true"></div>
	<div id="hero-veil" aria-hidden="true"></div>
	<div class="relative" style="z-index:30">
		<canvas id="ambient-rays" aria-hidden="true"></canvas>
		<ManifestoSection />
		<ServicesSection />
		<SelectedWorkSection />
		<TestimonialsSection />
		<ShowcaseSection />
		<SplitCardsSection />
		<FaqSection />
		<CtaSection />
	</div>

	<style is:global>
		/* Desktop: the hero stays put for one more screen while it goes out
		   into the black (#hero-veil, driven by the script below), and the
		   manifesto is pulled up to start exactly where that ends — its words
		   come into focus on the spot instead of riding up from the bottom. */
		#hero-veil,
		#hero-blur {
			position: fixed;
			inset: 0;
			pointer-events: none;
			visibility: hidden;
		}
		/* Two layers, so the blur does not fade with the dark: the blur (it
		   softens whatever is behind it) comes up first, the black after. */
		#hero-blur { z-index: 19; }
		#hero-veil { z-index: 20; background: #000; opacity: 0; }
		/* Same on desktop, tablets and phones (a finger scroll drives it). */
		@media (prefers-reduced-motion: no-preference) {
			#hero-pin { position: relative; height: calc(var(--app-stable-vh) * 200); }
			/* Phones and tablets: a finger covers ground fast, so the hero's exit needs
			   less road (0.65 of a screen instead of one) before the black. */
			@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
				#hero-pin { height: calc(var(--app-stable-vh) * 165); }
			}
			#hero-pin > #hero { position: sticky; top: 0; }
			#manifesto { margin-top: calc(var(--app-stable-vh) * -100); pointer-events: none; }
			#manifesto > .sticky { opacity: 0; }
		}
	</style>

	<script>
		import gsap from 'gsap';
		// The hero's exit: scrolling through the pinned screen, the light (the
		// source) goes out first, then the veil darkens and blurs what is left
		// (it sits over the hero, under the manifesto); once it is black the
		// manifesto's stage is pinned and its line comes up out of the dark.
		let _heroExitOff: (() => void) | null = null;
		function initHeroExit() {
			_heroExitOff?.();
			const pin = document.getElementById('hero-pin');
			const hero = document.getElementById('hero');
			const veil = document.getElementById('hero-veil');
			const blur = document.getElementById('hero-blur');
			const rays = document.getElementById('rays-canvas');
			const man = document.getElementById('manifesto');
			const stage = man?.querySelector<HTMLElement>(':scope > .sticky');
			if (!pin || !hero || !veil || !blur || !man || !stage) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
			const smooth = (t: number) => t * t * (3 - 2 * t);
			let range = 1;
			let pinStart = 1;
			const measure = () => {
				range = Math.max(1, pin.offsetHeight - hero.offsetHeight);
				pinStart = man.getBoundingClientRect().top + window.scrollY;
			};
			// The light's own fade (see update): 1 = lit, 0 = out.
			const lightState = { v: 1 };
			let lightOff: boolean | null = null;
			const applyLight = () => {
				if (!rays) return;
				const dark = lightState.v <= 0.001;
				if (rays.dataset.dark !== (dark ? '1' : '')) {
					rays.dataset.dark = dark ? '1' : '';
					// Fully out: nothing to see, so the hero stops drawing it
					// (HeroSection's initRays listens) and starts again on the way back.
					rays.dispatchEvent(new CustomEvent('pt:rays-dark', { detail: dark }));
				}
				rays.style.filter = lightState.v < 0.999 ? `brightness(${lightState.v.toFixed(3)})` : '';
			};
			const setLight = (off: boolean) => {
				if (off === lightOff) return;
				const first = lightOff === null;
				lightOff = off;
				gsap.killTweensOf(lightState);
				if (first) { lightState.v = off ? 0 : 1; applyLight(); return; }
				gsap.to(lightState, { v: off ? 0 : 1, duration: off ? 1.4 : 1.2, ease: 'power2.out', onUpdate: applyLight });
			};
			let ticking = false;
			let lastY = window.scrollY;
			const update = () => {
				ticking = false;
				const y = window.scrollY;
				const goingUp = y < lastY - 0.5;
				lastY = y;
				const p = y / range;
				// The light goes first: it is the source of everything on screen.
				// It goes out (and comes back) on the clock — one slow fade of the
				// same length however fast you scroll — never scrubbed by the scroll.
				// Brightness, not opacity (the intro owns the canvas's opacity).
				// On the way back it is the other way round: the light comes back as soon as the type is sharp (the blur
				// starts at 0.30 of the exit), not only at the very top. The hero must never stand sharp and dark.
				if (rays) {
					if (lightOff === null) setLight(p > 0.02);
					else if (p <= 0.02) setLight(false);
					else if (goingUp && p <= 0.30) setLight(false);
					else if (!goingUp && p > 0.02) setLight(true);
				}
				// Three beats, one after the other: the light goes out first (0–0.35)
				// while the type is still sharp; only then does the rest go soft
				// (the blur layer, 0.30–0.70), and last it sinks into the dark (the
				// black layer, 0.55–0.95) — the same going-out as the manifesto's line.
				const bk = smooth(clamp01((p - 0.30) / 0.40));
				const a = smooth(clamp01((p - 0.55) / 0.40));
				const live = y < pinStart + window.innerHeight;
				blur.style.visibility = bk > 0 && live ? 'visible' : 'hidden';
				blur.style.backdropFilter = blur.style.webkitBackdropFilter = bk > 0 ? `blur(${(bk * 22).toFixed(1)}px)` : '';
				veil.style.visibility = a > 0 && live ? 'visible' : 'hidden';
				veil.style.opacity = a.toFixed(3);
				// The manifesto's line comes up slowly once its stage is pinned
				// (about 0.4 of a screen), before the words start to focus.
				const vh = window.innerHeight;
				stage.style.opacity = smooth(clamp01((y - pinStart) / (0.4 * vh))).toFixed(3);
			};
			const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
			const onResize = () => { measure(); onScroll(); };
			measure();
			update();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize, { passive: true });
			const late = window.setTimeout(onResize, 400); // after fonts / layout settle
			_heroExitOff = () => {
				gsap.killTweensOf(lightState);
				if (rays) rays.style.filter = '';
				window.clearTimeout(late);
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onResize);
				_heroExitOff = null;
			};
		}
		document.addEventListener('astro:page-load', initHeroExit);
		document.addEventListener('astro:before-swap', () => _heroExitOff?.());
	</script>

	<script>
		import { createAmbientRays } from '../utils/ambientRays';
		// The small light (every screen: the phone shader on touch, the hero's own on desktop). The hero's light has gone out
		// by the time the manifesto is pinned; here it comes back, smaller, as the words focus, stays through
		// Services and the dark before the first picture, and goes out where the beam begins (the Selected Work
		// script publishes that as window.__swAmbOut).
		let _ambientOff: (() => void) | null = null;
		function initAmbient() {
			_ambientOff?.();
			(window as any).__swAmbOut = 1;
			const el = document.getElementById('ambient-rays') as HTMLCanvasElement | null;
			const man = document.getElementById('manifesto');
			if (!el || !man) return;
			const rays = createAmbientRays(el);
			if (!rays) return;
			const smooth = (t: number) => { t = Math.max(0, Math.min(1, t)); return t * t * (3 - 2 * t); };
			let manStart = 0, ticking = false;
			const measure = () => { manStart = man.getBoundingClientRect().top + window.scrollY; };
			const update = () => {
				ticking = false;
				const vh = window.innerHeight;
				const ain = smooth((window.scrollY - manStart - 0.1 * vh) / (0.9 * vh));
				rays.setLevel(Math.min(ain, (window as any).__swAmbOut ?? 1));
			};
			const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
			const onResize = () => { measure(); rays.resize(); onScroll(); };
			measure(); update();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize, { passive: true });
			window.addEventListener('pt:amb', onScroll);
			const late = window.setTimeout(onResize, 500);
			_ambientOff = () => {
				window.clearTimeout(late);
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onResize);
				window.removeEventListener('pt:amb', onScroll);
				rays.destroy();
				_ambientOff = null;
			};
		}
		document.addEventListener('astro:page-load', initAmbient);
		document.addEventListener('astro:before-swap', () => _ambientOff?.());
	</script>

	<script>
		import gsap from 'gsap';
		import ScrollTrigger from 'gsap/ScrollTrigger';
		let _isTraverseNav = false;

		function initHome() {
			gsap.registerPlugin(ScrollTrigger);
			ScrollTrigger.config({ ignoreMobileResize: true });

			if (!_isTraverseNav) window.scrollTo(0, 0);

			requestAnimationFrame(() => ScrollTrigger.refresh());

			_isTraverseNav = false;
		}

		document.addEventListener('astro:before-swap', (event: any) => {
			const navType: string = event.navigationType ?? '';
			_isTraverseNav = navType === 'traverse';
			if (!_isTraverseNav) window.scrollTo(0, 0);
						});

		document.addEventListener('astro:page-load', () => {
			initHome();
		});
	</script>
</Layout>
