---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import SelectedWorkSection from '../components/sections/SelectedWorkSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import ShowcaseSection from '../components/sections/ShowcaseSection.astro';
import SplitCardsSection from '../components/sections/SplitCardsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
---

<Layout title="Prime Triskelion">
	<div id="hero-pin">
		<HeroSection />
	</div>
	<div id="hero-blur" aria-hidden="true"></div>
	<div id="hero-veil" aria-hidden="true"></div>
	<div class="relative" style="z-index:30">
		<ManifestoSection />
		<ServicesSection />
		<SelectedWorkSection />
		<TestimonialsSection />
		<ShowcaseSection />
		<SplitCardsSection />
		<FaqSection />
		<CtaSection />
	</div>

	<style is:global>
		/* Desktop: the hero stays put for one more screen while it goes out
		   into the black (#hero-veil, driven by the script below), and the
		   manifesto is pulled up to start exactly where that ends — its words
		   come into focus on the spot instead of riding up from the bottom. */
		#hero-veil,
		#hero-blur {
			position: fixed;
			inset: 0;
			pointer-events: none;
			visibility: hidden;
		}
		/* Two layers, so the blur does not fade with the dark: the blur (it
		   softens whatever is behind it) comes up first, the black after. */
		#hero-blur { z-index: 19; }
		#hero-veil { z-index: 20; background: #000; opacity: 0; }
		/* Same on desktop, tablets and phones (a finger scroll drives it). */
		@media (prefers-reduced-motion: no-preference) {
			#hero-pin { position: relative; height: calc(var(--app-stable-vh) * 200); }
			#hero-pin > #hero { position: sticky; top: 0; }
			#manifesto { margin-top: calc(var(--app-stable-vh) * -100); pointer-events: none; }
			#manifesto > .sticky { opacity: 0; }
		}
	</style>

	<script>
		import gsap from 'gsap';
		// The hero's exit: scrolling through the pinned screen, the light (the
		// source) goes out first, then the veil darkens and blurs what is left
		// (it sits over the hero, under the manifesto); once it is black the
		// manifesto's stage is pinned and its line comes up out of the dark.
		let _heroExitOff: (() => void) | null = null;
		function initHeroExit() {
			_heroExitOff?.();
			const pin = document.getElementById('hero-pin');
			const hero = document.getElementById('hero');
			const veil = document.getElementById('hero-veil');
			const blur = document.getElementById('hero-blur');
			const rays = document.getElementById('rays-canvas');
			const man = document.getElementById('manifesto');
			const stage = man?.querySelector<HTMLElement>(':scope > .sticky');
			if (!pin || !hero || !veil || !blur || !man || !stage) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			const touchy = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
			const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
			const smooth = (t: number) => t * t * (3 - 2 * t);
			let range = 1;
			let pinStart = 1;
			const measure = () => {
				range = Math.max(1, pin.offsetHeight - hero.offsetHeight);
				pinStart = man.getBoundingClientRect().top + window.scrollY;
			};
			// The exit runs on the CLOCK; the scroll only fires it. `exit.v` is its progress: 0 = the hero as it is,
			// 1 = black, with the manifesto coming up next. Three beats, one after the other, whatever the scroll does:
			// the light goes out first (0–0.35) while the type is still sharp, then the rest goes soft (the blur layer,
			// 0.30–0.70), last it sinks into the dark (the black layer, 0.55–0.95), and only then does the manifesto's
			// line come up. A slow drag, a wheel tick and a fling all play the same exit; a fast fling only plays it
			// faster (nothing is skipped), and any scroll back plays it in reverse.
			const exit = { v: 0 };
			let target: 0 | 1 | null = null;
			let tween: gsap.core.Tween | null = null;
			const DUR = 1.3;           // seconds for the whole exit
			const FAST = 2.5;          // a fling plays it this much faster
			const FIRE_AT = 0.12;      // of the pin: past this the exit goes
			const BACK_AT = 0.06;      // of the pin: back below this it winds back
			const applyLight = (light: number) => {
				if (!rays) return;
				const dark = light <= 0.001;
				if (rays.dataset.dark !== (dark ? '1' : '')) {
					rays.dataset.dark = dark ? '1' : '';
					// Fully out: nothing to see, so the hero stops drawing it
					// (HeroSection's initRays listens) and starts again on the way back.
					rays.dispatchEvent(new CustomEvent('pt:rays-dark', { detail: dark }));
				}
				// Brightness, not opacity (the intro owns the canvas's opacity).
				rays.style.filter = light < 0.999 ? `brightness(${light.toFixed(3)})` : '';
			};
			const render = () => {
				const y = window.scrollY;
				const vh = window.innerHeight;
				const P = exit.v;
				applyLight(1 - smooth(clamp01(P / 0.35)));
				const bk = smooth(clamp01((P - 0.30) / 0.40));
				const a = smooth(clamp01((P - 0.55) / 0.40));
				const live = y < pinStart + vh;
				// A fast scroll runs past the end of the hero's pin before the clock has finished: the hero would then be
				// carried up with the page, blurred but still moving. Hold it on the spot until the exit has reached the
				// black (then it is covered anyway and can go).
				// (Fixed, not a per-frame transform, which would trail the scroll by a frame and shake.)
				const hold = P < 0.999 && live && y > range;
				hero.style.position = hold ? 'fixed' : '';
				hero.style.top = hold ? '0' : '';
				hero.style.left = hold ? '0' : '';
				hero.style.width = hold ? '100%' : '';
				blur.style.visibility = bk > 0 && live ? 'visible' : 'hidden';
				blur.style.backdropFilter = blur.style.webkitBackdropFilter = bk > 0 ? `blur(${(bk * (touchy ? 9 : 22)).toFixed(1)}px)` : '';
				veil.style.visibility = a > 0 && live ? 'visible' : 'hidden';
				veil.style.opacity = a.toFixed(3);
				// Before its own pin the stage would ride up from the bottom of the screen: hold it on the spot, so it only
				// ever comes out of the dark, never scrolls in. Its line comes up only once the exit has reached the black
				// (P above 0.88), and slowly once the stage is pinned.
				// Fixed, not a transform worked out per frame: a transform follows the scroll a frame late and the line
				// shakes against the page. Fixed has no lag; at the pin start it hands over to its own sticky at the very
				// same place (the section's height is set, so nothing moves in the flow).
				if (y < pinStart) {
					stage.style.position = 'fixed';
					stage.style.top = '0';
					stage.style.left = '0';
				} else {
					stage.style.position = '';
					stage.style.top = '';
					stage.style.left = '';
				}
				// The line comes up on the clock too, out of the black, and stands there faint and blurred (its start state,
				// ManifestoSection): from there the scroll is the user's alone, it brings the words into focus.
				stage.style.opacity = smooth(clamp01((P - 0.88) / 0.12)).toFixed(3);
			};
			const go = (to: 0 | 1, fast: boolean) => {
				if (to === target) { if (fast && tween && tween.isActive()) tween.timeScale(FAST); return; }
				target = to;
				tween?.kill();
				const left = Math.abs(to - exit.v);
				if (left < 0.001) { exit.v = to; render(); return; }
				tween = gsap.to(exit, { v: to, duration: DUR * left, ease: 'none', onUpdate: render, onComplete: () => { tween = null; } });
				if (fast) tween.timeScale(FAST);
			};
			let ticking = false;
			let lastY = window.scrollY;
			let lastT = performance.now();
			const update = () => {
				ticking = false;
				const y = window.scrollY;
				const now = performance.now();
				const speed = Math.abs(y - lastY) / Math.max(1, now - lastT);   // px per ms
				lastY = y;
				lastT = now;
				const p = y / range;
				const want: 0 | 1 = y >= pinStart || p > FIRE_AT ? 1 : p < BACK_AT ? 0 : target ?? (p > (FIRE_AT + BACK_AT) / 2 ? 1 : 0);
				if (target === null) {
					// First look (a reload part-way down, or back from another page): no animation, just the state.
					target = want;
					exit.v = want;
				} else go(want, speed > 2);
				render();
			};
			const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
			const onResize = () => { measure(); onScroll(); };
			measure();
			update();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize, { passive: true });
			const late = window.setTimeout(onResize, 400); // after fonts / layout settle
			_heroExitOff = () => {
				tween?.kill();
				if (rays) rays.style.filter = '';
				stage.style.position = stage.style.top = stage.style.left = '';
				hero.style.position = hero.style.top = hero.style.left = hero.style.width = '';
				window.clearTimeout(late);
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onResize);
				_heroExitOff = null;
			};
		}
		document.addEventListener('astro:page-load', initHeroExit);
		document.addEventListener('astro:before-swap', () => _heroExitOff?.());
	</script>

	<script>
		import gsap from 'gsap';
		import ScrollTrigger from 'gsap/ScrollTrigger';
		let _isTraverseNav = false;

		function initHome() {
			gsap.registerPlugin(ScrollTrigger);
			ScrollTrigger.config({ ignoreMobileResize: true });

			if (!_isTraverseNav) window.scrollTo(0, 0);

			requestAnimationFrame(() => ScrollTrigger.refresh());

			_isTraverseNav = false;
		}

		document.addEventListener('astro:before-swap', (event: any) => {
			const navType: string = event.navigationType ?? '';
			_isTraverseNav = navType === 'traverse';
			if (!_isTraverseNav) window.scrollTo(0, 0);
						});

		document.addEventListener('astro:page-load', () => {
			initHome();
		});
	</script>
</Layout>
