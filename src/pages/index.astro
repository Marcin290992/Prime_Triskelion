---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import SelectedWorkSection from '../components/sections/SelectedWorkSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import ShowcaseSection from '../components/sections/ShowcaseSection.astro';
import MarqueeSection from '../components/sections/MarqueeSection.astro';
import SplitCardsSection from '../components/sections/SplitCardsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
---

<Layout title="Prime Triskelion">
	<div id="hero-pin">
		<HeroSection />
	</div>
	<div id="hero-blur" aria-hidden="true"></div>
	<div id="hero-veil" aria-hidden="true"></div>
	<div class="relative" style="z-index:30">
		<ManifestoSection />
		<SelectedWorkSection />
		<ServicesSection />
		<TestimonialsSection />
		<ShowcaseSection />
		<MarqueeSection />
		<SplitCardsSection />
		<FaqSection />
		<CtaSection />
	</div>

	<style is:global>
		/* Desktop: the hero stays put for one more screen while it goes out
		   into the black (#hero-veil, driven by the script below), and the
		   manifesto is pulled up to start exactly where that ends — its words
		   come into focus on the spot instead of riding up from the bottom. */
		#hero-veil,
		#hero-blur {
			position: fixed;
			inset: 0;
			pointer-events: none;
			visibility: hidden;
		}
		/* Two layers, so the blur does not fade with the dark: the blur (it
		   softens whatever is behind it) comes up first, the black after. */
		#hero-blur { z-index: 19; }
		#hero-veil { z-index: 20; background: #000; opacity: 0; }
		@media ((min-width: 1025px) and (hover: hover)) or ((min-width: 1025px) and (pointer: fine)) {
			@media (prefers-reduced-motion: no-preference) {
				#hero-pin { position: relative; height: calc(var(--app-stable-vh) * 200); }
				#hero-pin > #hero { position: sticky; top: 0; }
				#manifesto { margin-top: calc(var(--app-stable-vh) * -100); pointer-events: none; }
				#manifesto > .sticky { opacity: 0; }
			}
		}
	</style>

	<script>
		// The hero's exit: scrolling through the pinned screen, the light (the
		// source) goes out first, then the veil darkens and blurs what is left
		// (it sits over the hero, under the manifesto); once it is black the
		// manifesto's stage is pinned and its line comes up out of the dark.
		let _heroExitOff: (() => void) | null = null;
		function initHeroExit() {
			_heroExitOff?.();
			const pin = document.getElementById('hero-pin');
			const hero = document.getElementById('hero');
			const veil = document.getElementById('hero-veil');
			const blur = document.getElementById('hero-blur');
			const rays = document.getElementById('rays-canvas');
			const man = document.getElementById('manifesto');
			const stage = man?.querySelector<HTMLElement>(':scope > .sticky');
			if (!pin || !hero || !veil || !blur || !man || !stage) return;
			const desktop = window.matchMedia('(min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine)').matches;
			if (!desktop || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
			const smooth = (t: number) => t * t * (3 - 2 * t);
			let range = 1;
			let pinStart = 1;
			const measure = () => {
				range = Math.max(1, pin.offsetHeight - hero.offsetHeight);
				pinStart = man.getBoundingClientRect().top + window.scrollY;
			};
			let ticking = false;
			const update = () => {
				ticking = false;
				const y = window.scrollY;
				const p = y / range;
				// The light goes first: it is the source of everything on screen.
				// Brightness, not opacity (the intro owns the canvas's opacity).
				if (rays) rays.style.filter = p > 0 ? `brightness(${(1 - smooth(clamp01(p / 0.6))).toFixed(3)})` : '';
				// Then the type and the rest go soft (the blur layer), and only once
				// they are soft do they sink into the dark (the black layer) — the
				// same going-out as the manifesto's line.
				const bk = smooth(clamp01((p - 0.12) / 0.65));
				const a = smooth(clamp01((p - 0.45) / 0.5));
				const live = y < pinStart + window.innerHeight;
				blur.style.visibility = bk > 0 && live ? 'visible' : 'hidden';
				blur.style.backdropFilter = blur.style.webkitBackdropFilter = bk > 0 ? `blur(${(bk * 22).toFixed(1)}px)` : '';
				veil.style.visibility = a > 0 && live ? 'visible' : 'hidden';
				veil.style.opacity = a.toFixed(3);
				// The manifesto's line comes up slowly once its stage is pinned
				// (about 0.4 of a screen), before the words start to focus.
				const vh = window.innerHeight;
				stage.style.opacity = smooth(clamp01((y - pinStart) / (0.4 * vh))).toFixed(3);
			};
			const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
			const onResize = () => { measure(); onScroll(); };
			measure();
			update();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize, { passive: true });
			const late = window.setTimeout(onResize, 400); // after fonts / layout settle
			_heroExitOff = () => {
				if (rays) rays.style.filter = '';
				window.clearTimeout(late);
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onResize);
				_heroExitOff = null;
			};
		}
		document.addEventListener('astro:page-load', initHeroExit);
		document.addEventListener('astro:before-swap', () => _heroExitOff?.());
	</script>

	<script>
		import Lenis from 'lenis';
		import gsap from 'gsap';
		import ScrollTrigger from 'gsap/ScrollTrigger';
		import { syncTickerToScroll } from '../utils/afterPageTransition';

		let lenisInstance: Lenis | null = null;
		let lenisTickerCb: ((time: number) => void) | null = null;
		let _isTraverseNav = false;

		function initLenis() {
			if (lenisInstance) { lenisInstance.destroy(); lenisInstance = null; }
			if (lenisTickerCb) { gsap.ticker.remove(lenisTickerCb); lenisTickerCb = null; }

			const isTouch = window.matchMedia('(pointer: coarse)').matches;

			gsap.registerPlugin(ScrollTrigger);
			ScrollTrigger.config({ ignoreMobileResize: true });

			if (!_isTraverseNav) window.scrollTo(0, 0);

			if (isTouch) {
				// Na mobile natywny scroll — compositor thread, zero janku przy WebGL hero
				(window as any).__lenis = null;
				// null is falsy, so without this Layout.astro's own fallback
				// Lenis init (`if (__lenis) return`) couldn't tell this apart
				// from "no page Lenis exists yet" — it would create its own
				// Lenis anyway, undoing this native-scroll choice and running
				// an extra rAF loop alongside native scroll on mobile.
				(window as any).__lenisHandled = true;
							} else {
				lenisInstance = new Lenis({
					duration: 2.4,
					easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
					wheelMultiplier: 0.65,
				});
				(window as any).__lenis = lenisInstance;
				lenisTickerCb = (time: number) => lenisInstance?.raf(time * 1000);
				gsap.ticker.add(lenisTickerCb);
				syncTickerToScroll();
				lenisInstance.on('scroll', ScrollTrigger.update);
			}

			requestAnimationFrame(() => ScrollTrigger.refresh());

			_isTraverseNav = false;
		}

		document.addEventListener('astro:before-swap', (event: any) => {
			const navType: string = event.navigationType ?? '';
			_isTraverseNav = navType === 'traverse';
			if (!_isTraverseNav) window.scrollTo(0, 0);
			if (lenisTickerCb) { gsap.ticker.remove(lenisTickerCb); lenisTickerCb = null; }
			if (lenisInstance) { lenisInstance.destroy(); lenisInstance = null; }
						});

		document.addEventListener('astro:page-load', () => {
			initLenis();
		});
	</script>
</Layout>
