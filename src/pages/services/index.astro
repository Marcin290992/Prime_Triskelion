---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';

// One entry per service. `visual` is the card's picture (an import or a
// URL) — empty for now, the card shows its placeholder frame until set.
const SERVICES = [
  {
    id: 'websites',
    name: 'Websites',
    title: 'High-performance websites built to convert and scale.',
    items: ['Landing pages', 'Custom multi-page sites', 'CMS integration', 'SEO & performance optimization', 'Responsive across all devices', 'API & third-party integrations'],
    visual: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1400&q=80&auto=format&fit=crop', // TEMP: Unsplash preview
  },
  {
    id: 'branding',
    name: 'Branding',
    title: 'Brand strategy, identity, and guidelines. The fundamentals of your image.',
    items: ['Naming & positioning', 'Logo & visual identity', 'Brand guidelines', 'Typography system', 'Print & digital collateral', 'Art direction'],
    visual: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1400&q=80&auto=format&fit=crop', // TEMP: Unsplash preview
  },
  {
    id: 'motion',
    name: 'Motion',
    title: 'Animations and motion systems that bring interfaces to life.',
    items: ['Web animations & microinteractions', 'GSAP & Lottie integration', 'Scroll-based storytelling', 'Video editing & compositing', 'Transition systems', 'Interactive 3D elements'],
    visual: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1400&q=80&auto=format&fit=crop', // TEMP: Unsplash preview
  },
  {
    id: 'strategy',
    name: 'Strategy',
    title: 'Creative direction and strategy built around your goals.',
    items: ['Brand strategy workshops', 'Competitor & market analysis', 'Content & UX strategy', 'Creative brief development', 'Go-to-market planning', 'KPI frameworks'],
    visual: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80&auto=format&fit=crop', // TEMP: Unsplash preview
  },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout
  title="Services — Prime Triskelion"
  description="Websites, branding, motion, and digital strategy — Prime Triskelion services for ambitious brands."
>
  <main id="services-page">

    <header class="svc-hero" data-side-rays>
      <h1 class="svc-title">
        <span class="svc-title__line"><span class="svc-title__word">My</span></span>
        <span class="svc-title__line"><span class="svc-title__word"><em>Services.</em></span></span>
      </h1>
      <p class="svc-hero__lead">Websites, branding, motion and strategy — designed and built end to end.</p>
      <div class="svc-hero__scroll" aria-hidden="true">
        <span class="svc-hero__line"></span>
        <span class="svc-hero__scroll-text">scroll</span>
      </div>
    </header>

    <!-- Desktop: the cards on the left are stacked sticky panels — each
         next one slides up over the last — while the copy on the right
         scrolls normally beside them. Phones and tablets: the wrappers
         dissolve (display: contents) and each card sits above its own
         copy, a plain stack. -->
    <div class="svc-split" data-after-hero>
      <div class="svc-deck">
        {SERVICES.map((s, i) => (
          <div class="svc-card" data-svc-card style={`order: ${i * 2}`}>
            <div class="svc-card__inner">
              <div class="svc-card__frame">
                {s.visual
                  ? <Fragment><img class="svc-card__visual" src={s.visual} alt="" loading="lazy" decoding="async" /><span class="svc-card__scrim" aria-hidden="true"></span></Fragment>
                  : <span class="svc-card__ghost" aria-hidden="true">{num(i)}</span>}
                <span class="svc-card__name" aria-hidden="true">{s.name}</span>
              </div>
              <div class="svc-card__shade" aria-hidden="true"></div>
            </div>
          </div>
        ))}
      </div>

      <div class="svc-texts">
        {SERVICES.map((s, i) => (
          <section class="svc-text" id={s.id} data-svc-text style={`order: ${i * 2 + 1}`}>
            <div class="svc-text__body">
              <p class="svc-text__label">{s.name}</p>
              <h2 class="svc-content__title">{s.title}</h2>
              <ul class="svc-list">
                {s.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </section>
        ))}
      </div>
    </div>

  </main>
  <CtaSection />
</Layout>

<style>
  #services-page {
    min-height: 100vh;
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }

  /* â”€â”€ Hero â”€â”€ */
  .svc-hero {
    padding: clamp(8rem, 16vh, 14rem) var(--site-gutter) 0;
    box-sizing: border-box;
  }
  .svc-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 8.5rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 0.9;
    color: rgb(var(--c-cream));
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
  }
  .svc-title__line {
    display: block;
    padding-bottom: 0.08em;
  }
  .svc-title__word {
    display: block;
    opacity: 0;
    filter: blur(18px);
  }
  .svc-title em { font-style: normal; color: rgb(var(--c-red)); }

  .svc-hero__lead {
    font-family: var(--f-body);
    font-weight: 300;
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: rgb(var(--c-cream) / 0.82);
    max-width: 34ch;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    opacity: 0;
    transform: translateY(10px);
  }

  /* Same scroll hint as .proj-header__scroll on Projects */
  .svc-hero__scroll {
    position: absolute;
    bottom: clamp(5.5rem, 11vh, 8rem);
    right: var(--site-gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .svc-hero__scroll.visible { opacity: 1; }
  .svc-hero__line {
    width: 36px;
    height: 1px;
    background: rgb(var(--c-red) / 0.6);
    animation: svcScrollPulse 2s ease-in-out infinite;
  }
  .svc-hero__scroll-text {
    font-family: var(--f-body);
    font-size: 10px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.2);
  }
  @keyframes svcScrollPulse {
    0%, 100% { opacity: 0.5; transform: scaleX(1); }
    50%       { opacity: 1;   transform: scaleX(1.3); }
  }

  /* Desktop: full-screen hero like .proj-header — the title gets the
     first screen to itself, and the first service row (plus its own
     reveal) only arrives on scroll instead of blurring in together with
     the title and running under the bottom HUD. */
  @media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
    .svc-hero {
      position: relative;
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: clamp(8rem, 18vh, 13rem);
    }
    .svc-hero__lead { margin-bottom: 0; }
  }

  /* ── Services: deck + copy ── */
  .svc-split {
    display: flex;
    align-items: flex-start;
    width: 100%;
  }
  .svc-deck,
  .svc-texts { width: 50%; }

  /* A card: a panel the height of the screen, held at the top; the next
     one comes up over it. Each card's flow height is set (JS) to its copy's
     height, so card and copy change together however long the copy runs. */
  .svc-card {
    position: sticky;
    top: 0;
    height: 100vh;
    height: calc(var(--app-stable-vh, 1vh) * 100);
    overflow: hidden;
    background: rgb(var(--c-bg));
    border-top: 1px solid rgb(var(--c-cream) / 0.08);
    border-right: 1px solid rgb(var(--c-cream) / 0.06);
  }
  .svc-card:first-child { border-top-color: transparent; }
  /* Alternate depth so a card arriving over the last one reads as a new
     layer even on black. */
  .svc-card:nth-child(even) { background: rgb(12 12 14); }
  .svc-card__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Clear of the logo / top blur band and the bottom HUD. */
    padding: clamp(6.5rem, 13vh, 9rem) clamp(2rem, 4vw, 4.5rem) clamp(7rem, 14vh, 9.5rem);
    transform-origin: 50% 0%;
    will-change: transform;
  }
  /* Darkens the card as the next one covers it (JS). */
  .svc-card__shade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  /* The picture frame — the placeholder until a visual is set: the same
     dark gradient as the site's cards, the service's number big and
     faint, its name in the corner. */
  .svc-card__frame {
    position: relative;
    /* 4:3, as wide as fits both the column and the screen's height (less
       the padding above) — never stretched on a short laptop screen. */
    width: min(100%, 720px, calc((var(--app-stable-vh, 1vh) * 100 - 17rem) * 4 / 3));
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(180deg, rgb(20 20 24 / 0.96) 0%, rgb(13 13 17 / 0.99) 100%);
  }
  .svc-card__visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Over a picture: darker toward the bottom and the top corner, so the
     name stays readable on any photo. */
  .svc-card__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.15) 42%, transparent 60%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.4) 0%, transparent 22%);
    pointer-events: none;
  }
  .svc-card__ghost {
    position: absolute;
    right: -0.04em;
    bottom: -0.16em;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(9rem, 17vw, 18rem);
    line-height: 1;
    color: rgb(var(--c-cream) / 0.06);
    pointer-events: none;
    user-select: none;
  }
  .svc-card__name {
    position: absolute;
    left: clamp(1.6rem, 2.6vw, 2.4rem);
    bottom: clamp(1.4rem, 2.2vw, 2rem);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }

  /* ── Copy ── */
  .svc-text {
    min-height: 100vh;
    min-height: calc(var(--app-stable-vh, 1vh) * 100);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding: clamp(6.5rem, 13vh, 9rem) var(--site-gutter) clamp(7rem, 14vh, 9.5rem) clamp(3rem, 6vw, 7rem);
    border-bottom: 1px solid rgb(var(--c-cream) / 0.06);
  }
  .svc-text:last-child { border-bottom: 0; }
  .svc-text__body { max-width: 620px; }
  .svc-text__label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.4rem;
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.55);
  }
  .svc-content__title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 2.7vw, 3.2rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.05;
    color: rgb(var(--c-cream));
    max-width: 20ch;
    margin-bottom: 2rem;
  }
  .svc-list {
    list-style: none;
    width: 100%;
    margin: 0;
    border-top: 1px solid rgb(var(--c-cream) / 0.07);
  }
  .svc-list li {
    font-family: var(--f-body);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    font-weight: 300;
    color: rgb(var(--c-cream) / 0.82);
    padding: clamp(0.8rem, 1.2vw, 1.05rem) 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    letter-spacing: 0.025em;
    border-bottom: 1px solid rgb(var(--c-cream) / 0.07);
  }
  /* The site's list dash (same as About's .am-item): solid red, on its own
     layer so every one renders the same crisp 1px whatever row it's on. */
  .svc-list li::before {
    content: '';
    display: block;
    width: 18px;
    height: 1px;
    background: rgb(var(--c-red));
    flex-shrink: 0;
    transform: translateZ(0);
  }

  /* â”€â”€ Mobile â”€â”€ */
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    /* Cinematic first screen like Projects: title + lead alone,
       vertically centred, the services only on scroll. Stable-vh sized so
       the URL bar can't resize it mid-scroll. */
    .svc-hero {
      /* About two thirds of the screen, not all of it: the title keeps its
         moment, and the first card already peeks in below — that invites
         the scroll, so the "scroll" hint goes. */
      position: relative;
      height: 68svh;
      height: calc(var(--app-stable-vh, 1svh) * 68);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 5rem;
      padding-bottom: 1.5rem;
    }
    .svc-hero__scroll { display: none; }
    .svc-hero__lead { margin-bottom: 0; }
    /* Vertical, centred under the text — same as Projects' hint: "scroll"
       label on top, a red hairline pulsing downward below it. In flow so
       it travels with the centred title/lead block and can never end up
       under the bottom menu button (it did on iOS Safari when it was
       bottom-anchored). */
    .svc-hero__scroll {
      position: static;
      align-self: center;
      margin-top: 3rem;
      flex-direction: column-reverse;
      gap: 0.7rem;
    }
    .svc-hero__line {
      width: 1px;
      height: 40px;
      transform-origin: top center;
      animation-name: svcScrollPulseY;
    }
    /* letter-spacing trails after the last letter — pad the front to match
       so the label sits truly centred over the line. */
    .svc-hero__scroll-text { padding-left: 0.45em; }
    @keyframes svcScrollPulseY {
      0%, 100% { opacity: 0.5; transform: scaleY(0.6); }
      50%       { opacity: 1;   transform: scaleY(1); }
    }
    /* Plain stack: the deck and copy wrappers dissolve and each card sits
       above its own copy (order set inline) — same card, same type as
       desktop, nothing sticky. */
    .svc-split {
      flex-direction: column;
      align-items: stretch;
      padding: 0 var(--site-gutter) clamp(4rem, 10vw, 6rem);
      box-sizing: border-box;
    }
    .svc-deck, .svc-texts { display: contents; }
    .svc-card {
      position: relative;
      height: auto;
      border: 0;
      background: none;
      overflow: visible;
      margin-top: clamp(2.5rem, 8vw, 4rem);
    }
    .svc-card:nth-child(even) { background: none; }
    .svc-card__inner { position: relative; padding: 0; will-change: auto; }
    .svc-card__shade { display: none; }
    .svc-card__frame { width: 100%; aspect-ratio: 4 / 5; }
    .svc-card__ghost { font-size: clamp(8rem, 42vw, 14rem); }
    .svc-card__name { font-size: clamp(1.6rem, 7vw, 2.4rem); }
    .svc-text {
      min-height: 0;
      padding: clamp(1.6rem, 5vw, 2.4rem) 0 0;
      border-bottom: 0;
    }
    .svc-text__body { max-width: none; }
    .svc-content__title {
      max-width: none;
      font-size: clamp(1.6rem, 6.2vw, 2.6rem);
      margin-bottom: 1.5rem;
    }
  }

  /* Tablet: the same stack, the card in a wider frame. */
  @media (max-width: 1024px) and (min-width: 700px), (hover: none) and (pointer: coarse) and (min-width: 700px) {
    .svc-card__frame { aspect-ratio: 16 / 10; }
    .svc-card__ghost { font-size: clamp(10rem, 24vw, 16rem); }
    .svc-text__body { max-width: 680px; }
    .svc-content__title { font-size: clamp(1.9rem, 4vw, 2.8rem); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { afterPageTransition, revealAfterHero, titleIn, supportIn, subpageMode } from '../../utils/afterPageTransition';
  import { trackLeaving } from '../../utils/leavingPage';

  let _cleanup: (() => void) | null = null;

  function initServicesPage() {
    const titleWords = document.querySelectorAll<HTMLElement>('.svc-title__word');
    const lead = document.querySelector<HTMLElement>('.svc-hero__lead');
    const scrollHint = document.querySelector<HTMLElement>('.svc-hero__scroll');
    // Don't bring the hint in on a page that's already being left (see
    // trackLeaving) — it flashed in just ahead of the next page's hero.
    const isLeaving = trackLeaving();
    afterPageTransition(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      titleIn(tl, titleWords);
      const isMob = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
      // Repeat / back visits (subpageMode) skip the choreography, so no wait.
      const mode = subpageMode();
      if (isMob || mode !== 'full') supportIn(tl, lead, 1.3);
      else if (lead) tl.to(lead, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, 0.5);
      // Mobile: the hint comes in once title and lead have landed; desktop
      // keeps its own cue.
      setTimeout(() => { if (!isLeaving()) scrollHint?.classList.add('visible'); },
        mode === 'none' ? 0 : mode === 'short' ? 700 : isMob ? 2400 : 1100);
      revealAfterHero();
    });

    // Phones and tablets: the plain stack, nothing more to set up.
    if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) return;

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-svc-card]'));
    const texts = Array.from(document.querySelectorAll<HTMLElement>('[data-svc-text]'));
    if (!cards.length || cards.length !== texts.length) return;
    const inners = cards.map((c) => c.querySelector<HTMLElement>('.svc-card__inner'));
    const shades = cards.map((c) => c.querySelector<HTMLElement>('.svc-card__shade'));

    // Each card takes up as much scroll as its copy: the card is a screen
    // tall, so the rest goes in its bottom margin — the next card then
    // arrives exactly as the next copy does, however long a copy runs.
    const sync = () => {
      cards.forEach((card, i) => {
        card.style.marginBottom = `${Math.max(0, texts[i].offsetHeight - card.offsetHeight)}px`;
      });
      depth();
    };

    // Depth: as the next card comes up, the one under it eases back a touch
    // and darkens.
    const depth = () => {
      for (let i = 0; i < cards.length - 1; i++) {
        const h = cards[i].offsetHeight || 1;
        const top = cards[i + 1].getBoundingClientRect().top;
        const p = Math.min(1, Math.max(0, 1 - top / h));
        if (inners[i]) inners[i]!.style.transform = p ? `scale(${(1 - 0.06 * p).toFixed(4)})` : '';
        if (shades[i]) shades[i]!.style.opacity = (0.6 * p).toFixed(3);
      }
    };
    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; depth(); });
    };

    const ro = new ResizeObserver(sync);
    texts.forEach((t) => ro.observe(t));
    window.addEventListener('scroll', onScroll, { passive: true });
    sync();

    // The copy comes in as it reaches the screen, as before.
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const targets = entry.target.querySelectorAll<HTMLElement>('.svc-text__label, .svc-content__title, .svc-list li');
        gsap.to(targets, { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.58, ease: 'power3.out', stagger: 0.07 });
        reveal.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    texts.forEach((t) => {
      gsap.set(t.querySelectorAll('.svc-text__label, .svc-content__title, .svc-list li'), { opacity: 0, filter: 'blur(8px)', y: 14 });
      reveal.observe(t);
    });

    _cleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      ro.disconnect();
      reveal.disconnect();
      window.removeEventListener('scroll', onScroll);
    };
  }

  document.addEventListener('astro:before-swap', () => {
    _cleanup?.();
    _cleanup = null;
  });

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('services-page')) initServicesPage();
  });
</script>

