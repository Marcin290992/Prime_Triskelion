---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';

// One entry per service. `visual` is the card's picture — TEMP: Unsplash placeholders until the real ones are in.
const SERVICES = [
  {
    id: 'websites',
    name: 'Websites',
    title: 'High-performance websites built to convert and scale.',
    items: ['Landing pages', 'Custom multi-page sites', 'CMS integration', 'SEO & performance optimization', 'Responsive across all devices', 'API & third-party integrations'],
    visual: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1600&q=80&auto=format&fit=crop',
  },
  {
    id: 'branding',
    name: 'Branding',
    title: 'Brand strategy, identity, and guidelines. The fundamentals of your image.',
    items: ['Naming & positioning', 'Logo & visual identity', 'Brand guidelines', 'Typography system', 'Print & digital collateral', 'Art direction'],
    visual: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1600&q=80&auto=format&fit=crop',
  },
  {
    id: 'motion',
    name: 'Motion',
    title: 'Animations and motion systems that bring interfaces to life.',
    items: ['Web animations & microinteractions', 'GSAP & Lottie integration', 'Scroll-based storytelling', 'Video editing & compositing', 'Transition systems', 'Interactive 3D elements'],
    visual: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1600&q=80&auto=format&fit=crop',
  },
  {
    id: 'strategy',
    name: 'Strategy',
    title: 'Creative direction and strategy built around your goals.',
    items: ['Brand strategy workshops', 'Competitor & market analysis', 'Content & UX strategy', 'Creative brief development', 'Go-to-market planning', 'KPI frameworks'],
    visual: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1600&q=80&auto=format&fit=crop',
  },
];
---

<Layout
  title="Services — Prime Triskelion"
  description="Websites, branding, motion, and digital strategy — Prime Triskelion services for ambitious brands."
>
  <main id="services-page">

    <!-- A grid of large cards, as on a studio's project index: the picture, a line of tags, the name big under it. On
         desktop each picture forms out of a band of light and then follows the pointer (a fluid, with a little film grain);
         on phones and tablets it is a plain picture. -->
    <header class="sg-head">
      <h1 class="sg-h1">My <em>Services.</em></h1>
      <p class="sg-lead0">Websites, branding, motion and strategy — designed and built end to end.</p>
    </header>

    <section class="sg-grid" aria-label="Services">
      {SERVICES.map((s, i) => (
        <article class="sg-card" id={s.id} data-sg-card>
          <div class="sg-frame" data-sg-frame>
            <img class="sg-img" src={s.visual} alt="" loading="lazy" decoding="async" crossorigin="anonymous" />
            <span class="sg-scrim" aria-hidden="true"></span>
          </div>
          <h2 class="sg-title">{s.name}</h2>
          <p class="sg-lead">{s.title}</p>
          <ul class="sg-list">
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </section>

  </main>
  <CtaSection />
</Layout>

<style>
  #services-page {
    min-height: 100vh;
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
    padding: clamp(7rem, 14vh, 11rem) var(--site-gutter) clamp(4rem, 9vw, 8rem);
    box-sizing: border-box;
  }

  /* ── Header ── */
  .sg-head { max-width: 62rem; margin-bottom: clamp(2.5rem, 6vw, 5.5rem); }
  .sg-h1 {
    margin: 0 0 clamp(0.9rem, 1.6vw, 1.4rem);
    font-family: var(--f-display); font-weight: 600; font-size: clamp(2.6rem, 5.4vw, 5.6rem);
    letter-spacing: -0.01em; text-transform: uppercase; line-height: 0.92; color: rgb(var(--c-cream));
  }
  .sg-h1 em { font-style: normal; color: rgb(var(--c-red)); }
  .sg-lead0 {
    margin: 0; max-width: 40ch; font-family: var(--f-body); font-weight: 300; font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.55; letter-spacing: 0.01em; color: rgb(var(--c-cream) / 0.82);
  }

  /* ── The grid ── */
  .sg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 8vw, 5rem) 0;
  }
  @media (min-width: 1025px) {
    .sg-grid { grid-template-columns: 1fr 1fr; gap: clamp(4rem, 7vw, 7rem) clamp(1.5rem, 2.6vw, 3rem); }
    /* a quiet stagger: the second column sits a little lower */
    .sg-card:nth-child(even) { margin-top: clamp(3rem, 7vw, 7rem); }
  }

  .sg-card { min-width: 0; }
  .sg-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: linear-gradient(180deg, rgb(20 20 24 / 0.96) 0%, rgb(13 13 17 / 0.99) 100%);
    margin-bottom: clamp(1rem, 1.6vw, 1.6rem);
  }
  .sg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  /* over the picture: a slightly darker foot (above the beam's canvas, z-index 1) */
  .sg-scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.22) 0%, transparent 30%);
  }
  .sg-title {
    margin: 0 0 clamp(0.7rem, 1.2vw, 1.1rem);
    font-family: var(--f-display); font-weight: 600; font-size: clamp(2.4rem, 4.6vw, 4.8rem);
    letter-spacing: -0.02em; text-transform: uppercase; line-height: 0.95; color: rgb(var(--c-cream));
  }
  .sg-lead {
    margin: 0; max-width: 36ch; font-family: var(--f-body); font-weight: 300; font-size: clamp(0.95rem, 1.15vw, 1.15rem);
    line-height: 1.55; color: rgb(var(--c-cream) / 0.82);
  }

  /* ── The points of the service: all of them, there from the start ── */
  .sg-list { list-style: none; margin: clamp(1.1rem, 1.8vw, 1.8rem) 0 0; padding: 0; max-width: 36rem; border-top: 1px solid rgb(var(--c-cream) / 0.07); }
  .sg-list li {
    display: flex; align-items: center; gap: 1rem; padding: clamp(0.45rem, 1.2vh, 0.8rem) 0; letter-spacing: 0.025em;
    font-family: var(--f-body); font-size: clamp(0.85rem, 1vw, 1.02rem); font-weight: 300; color: rgb(var(--c-cream) / 0.82);
    border-bottom: 1px solid rgb(var(--c-cream) / 0.07);
  }
  .sg-list li::before { content: ''; display: block; width: 18px; height: 1px; background: rgb(var(--c-red)); flex-shrink: 0; }

</style>

<script>
  import gsap from 'gsap';
  import { initBeamReveal, type BeamReveal } from '../../utils/beamReveal';
  import { ImageFluidEngine } from '../../lib/zen/ImageFluidEngine.js';

  let _cleanup: (() => void) | null = null;
  // the pictures' effects: desktop with a pointer, and no reduced motion
  const FX = '(min-width: 1025px) and (hover: hover) and (prefers-reduced-motion: no-preference)';

  function initServicesPage() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-sg-card]'));
    if (!cards.length) return;
    const offs: Array<() => void> = [];

    // The text of a card comes in out of blur as the card reaches the screen.
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const copy = (c: HTMLElement) => Array.from(c.querySelectorAll<HTMLElement>('.sg-title, .sg-lead, .sg-list li'));
    if (!still) cards.forEach((c) => gsap.set(copy(c), { opacity: 0, filter: 'blur(8px)', y: 14 }));
    const reveal = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      reveal.unobserve(en.target);
      gsap.to(copy(en.target as HTMLElement), { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.06 });
    }), { threshold: 0.2 });
    // (with the light on the pictures the text is not on its own clock: it comes down with the picture, see below)
    const fx = window.matchMedia(FX).matches;
    if (!still && !fx) cards.forEach((c) => reveal.observe(c));
    offs.push(() => reveal.disconnect());

    // Desktop: each picture forms out of a band of light the first time its card is on screen; when the light has passed,
    // the picture goes on a canvas that follows the pointer (a fluid) with a little film grain.
    if (fx) {
      const beams: Array<BeamReveal | null> = [];
      const fluids: Array<ImageFluidEngine | null> = [];
      const seen = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (!en.isIntersecting) return;
        seen.unobserve(en.target);
        const frame = en.target as HTMLElement;
        const i = Number(frame.dataset.fx);
        const img = frame.querySelector<HTMLImageElement>('img')!;
        const beam = beams[i];
        const mountFluid = () => {
          img.style.visibility = '';
          fluids[i] = new ImageFluidEngine(frame, {
            maxPixelRatio: 2,
            fluid: { brushSize: 25, brushStrength: 0.5, distortion: 120, decay: 0.98, trail: 0.8, stopDecay: 0.85, resolution: 0.5 },
            grain: { amount: 0.1, blend: 0.1 },
          });
        };
        const card = frame.closest<HTMLElement>('[data-sg-card]')!;
        const t = copy(card);
        const title = t.filter((e) => e.classList.contains('sg-title'));
        const lead = t.filter((e) => e.classList.contains('sg-lead'));
        const points = t.filter((e) => e.tagName === 'LI');
        const into = { opacity: 1, filter: 'blur(0px)', y: 0, ease: 'power3.out' };
        if (!beam) { mountFluid(); gsap.to(t, { ...into, duration: 0.8, stagger: 0.1 }); return; }
        // A cascade: the light comes down the picture and its words follow it down, step by step: the name as the front
        // passes the middle, the line under it, then the points one after another, the last as the front leaves the picture.
        const proxy = { p: 0 };
        gsap.timeline()
          .to(proxy, {
            p: 1, duration: 4.6, ease: 'power2.inOut',   // slow on purpose: it should feel unhurried
            onUpdate: () => beam.setProgress(proxy.p),
            onComplete: () => { beam.destroy(); beams[i] = null; mountFluid(); },
          }, 0)
          .to(title, { ...into, duration: 1.1 }, 2.2)
          .to(lead, { ...into, duration: 1.0 }, 2.8)
          .to(points, { ...into, duration: 0.8, stagger: 0.28 }, 3.3);
      // watched on the PICTURE, a little before it is on screen (not on the whole card, which is tall: the light then began
      // only once a third of the card was in view, with the picture already half way up the screen)
      }), { threshold: 0, rootMargin: '0px 0px 25% 0px' });
      cards.forEach((card, i) => {
        const frame = card.querySelector<HTMLElement>('[data-sg-frame]');
        const img = frame?.querySelector<HTMLImageElement>('img');
        if (!frame || !img) return;
        // the very front of light the Projects ribbon opens with (torn by noise, a hard core, a halo, the colours pulled apart), but
        // coming DOWN from the top where Projects' climbs from the bottom
        const beam = initBeamReveal(frame, img, { style: 'ink', seed: i * 7.31 });
        beams[i] = beam;
        if (beam) { img.style.visibility = 'hidden'; beam.setProgress(0); }
        frame.dataset.fx = String(i);
        seen.observe(frame);
      });
      offs.push(() => {
        seen.disconnect();
        beams.forEach((b) => b?.destroy());
        fluids.forEach((f) => f?.dispose());
      });
    }

    _cleanup = () => offs.forEach((o) => o());
  }

  document.addEventListener('astro:before-swap', () => {
    _cleanup?.();
    _cleanup = null;
  });
  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('services-page')) initServicesPage();
  });
</script>
