---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
---

<Layout
  title="Services — Prime Triskelion"
  description="Websites, branding, motion, and digital strategy — Prime Triskelion services for ambitious brands."
>
  <main id="services-page">

    <header class="svc-hero">
      <h1 class="svc-title">
        <span class="svc-title__line"><span class="svc-title__word">My</span></span>
        <span class="svc-title__line"><span class="svc-title__word"><em>Services.</em></span></span>
      </h1>
      <p class="svc-hero__lead">Websites, branding, motion and strategy — designed and built end to end.</p>
      <div class="svc-hero__scroll" aria-hidden="true">
        <span class="svc-hero__line"></span>
        <span class="svc-hero__scroll-text">scroll</span>
      </div>
    </header>

    <div class="svc-rows" data-after-hero>

      <div class="svc-row" id="websites">
        <div class="svc-sticky">
          <div class="svc-badge">
            <span class="svc-badge__bgnum" aria-hidden="true">01</span>
            <span class="svc-badge__num">01</span>
            <span class="svc-badge__name">Websites</span>
          </div>
        </div>
        <div class="svc-content">
          <span class="svc-pill">01 / Websites</span>
          <h2 class="svc-content__title">High-performance websites built to convert and scale.</h2>
          <ul class="svc-list">
            <li>Landing pages</li>
            <li>Custom multi-page sites</li>
            <li>CMS integration</li>
            <li>SEO & performance optimization</li>
            <li>Responsive across all devices</li>
            <li>API & third-party integrations</li>
          </ul>
          <div class="h-hero-cta-wrap svc-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="/contact" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Start a project</span>
            </a>
          </div>
        </div>
      </div>

      <div class="svc-row" id="branding">
        <div class="svc-sticky">
          <div class="svc-badge">
            <span class="svc-badge__bgnum" aria-hidden="true">02</span>
            <span class="svc-badge__num">02</span>
            <span class="svc-badge__name">Branding</span>
          </div>
        </div>
        <div class="svc-content">
          <span class="svc-pill">02 / Branding</span>
          <h2 class="svc-content__title">Brand strategy, identity, and guidelines. The fundamentals of your image.</h2>
          <ul class="svc-list">
            <li>Naming & positioning</li>
            <li>Logo & visual identity</li>
            <li>Brand guidelines</li>
            <li>Typography system</li>
            <li>Print & digital collateral</li>
            <li>Art direction</li>
          </ul>
          <div class="h-hero-cta-wrap svc-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="/contact" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Start a project</span>
            </a>
          </div>
        </div>
      </div>

      <div class="svc-row" id="motion">
        <div class="svc-sticky">
          <div class="svc-badge">
            <span class="svc-badge__bgnum" aria-hidden="true">03</span>
            <span class="svc-badge__num">03</span>
            <span class="svc-badge__name">Motion</span>
          </div>
        </div>
        <div class="svc-content">
          <span class="svc-pill">03 / Motion</span>
          <h2 class="svc-content__title">Animations and motion systems that bring interfaces to life.</h2>
          <ul class="svc-list">
            <li>Web animations & microinteractions</li>
            <li>GSAP & Lottie integration</li>
            <li>Scroll-based storytelling</li>
            <li>Video editing & compositing</li>
            <li>Transition systems</li>
            <li>Interactive 3D elements</li>
          </ul>
          <div class="h-hero-cta-wrap svc-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="/contact" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Start a project</span>
            </a>
          </div>
        </div>
      </div>

      <div class="svc-row" id="strategy">
        <div class="svc-sticky">
          <div class="svc-badge">
            <span class="svc-badge__bgnum" aria-hidden="true">04</span>
            <span class="svc-badge__num">04</span>
            <span class="svc-badge__name">Strategy</span>
          </div>
        </div>
        <div class="svc-content">
          <span class="svc-pill">04 / Strategy</span>
          <h2 class="svc-content__title">Creative direction and strategy built around your goals.</h2>
          <ul class="svc-list">
            <li>Brand strategy workshops</li>
            <li>Competitor & market analysis</li>
            <li>Content & UX strategy</li>
            <li>Creative brief development</li>
            <li>Go-to-market planning</li>
            <li>KPI frameworks</li>
          </ul>
          <div class="h-hero-cta-wrap svc-cta-wrap">
            <div class="h-hero-cta-grad-top" aria-hidden="true"></div>
            <div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
            <a href="/contact" class="h-hero-cta h-hero-cta--fixed">
              <span class="hud-spin-border"></span>
              <span class="h-hero-cta__text">Start a project</span>
            </a>
          </div>
        </div>
      </div>

    </div>

  </main>
  <CtaSection />
</Layout>

<style>
  #services-page {
    min-height: 100vh;
    background: rgb(var(--c-bg));
    color: rgb(var(--c-cream));
  }

  /* â”€â”€ Hero â”€â”€ */
  .svc-hero {
    padding: clamp(8rem, 16vh, 14rem) var(--site-gutter) 0;
    box-sizing: border-box;
  }
  .svc-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 8.5rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 0.9;
    color: rgb(var(--c-cream));
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
  }
  .svc-title__line {
    display: block;
    padding-bottom: 0.08em;
  }
  .svc-title__word {
    display: block;
    opacity: 0;
    filter: blur(18px);
  }
  .svc-title em { font-style: normal; color: rgb(var(--c-red)); }

  .svc-hero__lead {
    font-family: var(--f-body);
    font-weight: 300;
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: rgb(var(--c-cream) / 0.55);
    max-width: 34ch;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    opacity: 0;
    transform: translateY(10px);
  }

  /* Same scroll hint as .proj-header__scroll on Projects */
  .svc-hero__scroll {
    position: absolute;
    bottom: clamp(5.5rem, 11vh, 8rem);
    right: var(--site-gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .svc-hero__scroll.visible { opacity: 1; }
  .svc-hero__line {
    width: 36px;
    height: 1px;
    background: rgb(var(--c-red) / 0.6);
    animation: svcScrollPulse 2s ease-in-out infinite;
  }
  .svc-hero__scroll-text {
    font-family: var(--f-body);
    font-size: 8px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.2);
  }
  @keyframes svcScrollPulse {
    0%, 100% { opacity: 0.5; transform: scaleX(1); }
    50%       { opacity: 1;   transform: scaleX(1.3); }
  }

  /* Desktop: full-screen hero like .proj-header — the title gets the
     first screen to itself, and the first service row (plus its own
     reveal) only arrives on scroll instead of blurring in together with
     the title and running under the bottom HUD. */
  @media (min-width: 1025px) {
    .svc-hero {
      position: relative;
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: clamp(8rem, 18vh, 13rem);
    }
    .svc-hero__lead { margin-bottom: 0; }
  }

  /* â”€â”€ Sticky rows â”€â”€ */
  .svc-rows {
    padding: 0 var(--site-gutter) clamp(6rem, 12vh, 10rem);
    box-sizing: border-box;
  }
  .svc-row {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(8rem, 16vw, 20rem);
    min-height: 100vh;
    padding: clamp(4rem, 7vw, 6rem) 0;
    align-items: start;
  }

  /* â”€â”€ Sticky badge â”€â”€ */
  .svc-sticky {
    position: sticky;
    top: clamp(5rem, 10vh, 7rem);
    height: fit-content;
  }
  .svc-badge {
    position: relative;
    background: linear-gradient(180deg, rgb(20 20 24 / 0.96) 0%, rgb(13 13 17 / 0.99) 100%);
    border: 1px solid rgba(255,255,255,0.1);
    overflow: hidden;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 320px;
    justify-content: flex-end;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .svc-badge__bgnum {
    position: absolute;
    right: -0.05em;
    bottom: -0.1em;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(10rem, 16vw, 16rem);
    color: rgba(255,255,255,0.07);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .svc-badge__num {
    font-family: var(--f-body);
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.4em;
    color: rgb(var(--c-red) / 0.65);
    position: relative;
    z-index: 1;
  }
  .svc-badge__name {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: rgb(var(--c-cream));
    line-height: 1;
    position: relative;
    z-index: 1;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-top: 0.2rem;
  }

  /* â”€â”€ Content â”€â”€ */
  .svc-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: clamp(0.5rem, 1vw, 1rem);
  }
  .svc-pill {
    display: inline-block;
    font-family: var(--f-body);
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.35);
    border: 1px solid rgb(var(--c-cream) / 0.12);
    padding: 0.3rem 0.75rem;
    margin-bottom: 1.8rem;
  }
  .svc-content__title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.8vw, 4.5rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.05;
    color: rgb(var(--c-cream));
    max-width: 22ch;
    margin-bottom: 2rem;
  }
  .svc-list {
    list-style: none;
    width: 100%;
    margin-bottom: 2.5rem;
    border-top: 1px solid rgb(var(--c-cream) / 0.07);
  }
  .svc-list li {
    font-family: var(--f-body);
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 300;
    color: rgb(var(--c-cream) / 0.62);
    padding: clamp(0.85rem, 1.3vw, 1.1rem) 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    letter-spacing: 0.025em;
    border-bottom: 1px solid rgb(var(--c-cream) / 0.07);
    transition: color 0.28s ease;
    position: relative;
  }
  .svc-list li::before {
    content: '';
    display: block;
    width: 18px;
    height: 1px;
    background: rgb(var(--c-red) / 0.45);
    flex-shrink: 0;
    transition: width 0.28s ease, background 0.28s ease;
  }
  .svc-list li::after {
    content: '→';
    position: absolute;
    right: 0;
    font-size: 0.8rem;
    color: rgb(var(--c-red) / 0);
    transform: translateX(-6px);
    transition: color 0.28s ease, transform 0.28s cubic-bezier(0.16,1,0.3,1);
    pointer-events: none;
  }
  @media (hover: hover) {
    .svc-list li:hover { color: rgb(var(--c-cream) / 0.9); }
    .svc-list li:hover::before { width: 26px; background: rgb(var(--c-red)); }
    .svc-list li:hover::after { color: rgb(var(--c-red) / 0.7); transform: translateX(0); }
  }
  .svc-cta-wrap { max-width: 260px; }

  /* â”€â”€ Mobile â”€â”€ */
  @media (max-width: 1024px) {
    /* Cinematic first screen like Projects: title + lead alone,
       vertically centred, the services only on scroll. Stable-vh sized so
       the URL bar can't resize it mid-scroll. */
    .svc-hero {
      position: relative;
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .svc-hero__lead { margin-bottom: 0; }
    /* Fixed rem offset (not vh) — clears the bottom menu HUD. */
    .svc-hero__scroll { bottom: 6.5rem; }
    .svc-row {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2.4rem;
      padding: clamp(2.5rem, 6vw, 4rem) 0;
    }
    .svc-sticky { position: relative; top: auto; }
    .svc-badge {
      min-height: 200px;
      padding: clamp(1.2rem, 4vw, 1.6rem);
    }
    .svc-badge__bgnum {
      font-size: clamp(7rem, 30vw, 10rem);
    }
    .svc-badge__name {
      font-size: clamp(1.6rem, 6vw, 2.4rem);
    }
    .svc-content__title {
      max-width: none;
      font-size: clamp(1.8rem, 6.5vw, 3rem);
    }
    .svc-cta-wrap { max-width: 100%; width: 100%; }
  }

  @media (max-width: 480px) {
    .svc-badge { min-height: 170px; }
    .svc-badge__bgnum { font-size: clamp(6rem, 28vw, 8rem); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { afterPageTransition, revealAfterHero } from '../../utils/afterPageTransition';

  let _rowObserver: IntersectionObserver | null = null;

  function initServicesPage() {
    const titleWords = document.querySelectorAll<HTMLElement>('.svc-title__word');
    const lead = document.querySelector<HTMLElement>('.svc-hero__lead');
    const scrollHint = document.querySelector<HTMLElement>('.svc-hero__scroll');
    afterPageTransition(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      if (titleWords.length) tl.to(titleWords,
        { opacity: 1, filter: 'blur(0px)', duration: 1.15, stagger: 0.14 },
        0.08
      );
      if (lead) tl.to(lead, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, 0.5);
      setTimeout(() => scrollHint?.classList.add('visible'), 1100);
      revealAfterHero();
    });

    if (window.matchMedia('(max-width: 1024px)').matches) return;

    _rowObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const targets = entry.target.querySelectorAll<HTMLElement>(
          '.svc-pill, .svc-content__title, .svc-list li, .svc-cta-wrap'
        );
        gsap.to(targets, { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.58, ease: 'power3.out', stagger: 0.07 });
        _rowObserver?.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    document.querySelectorAll<HTMLElement>('.svc-row').forEach(row => {
      const targets = row.querySelectorAll<HTMLElement>(
        '.svc-pill, .svc-content__title, .svc-list li, .svc-cta-wrap'
      );
      gsap.set(targets, { opacity: 0, filter: 'blur(8px)', y: 14 });
      _rowObserver!.observe(row);
    });
  }

  document.addEventListener('astro:before-swap', () => {
    _rowObserver?.disconnect();
    _rowObserver = null;
  });

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('services-page')) initServicesPage();
  });
</script>

