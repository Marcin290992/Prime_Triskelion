---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import portrait from '../img/portrait-top.webp';
---

<Layout title="About — Prime Triskelion">
  <Fragment slot="head">
    <link rel="preload" href={portrait.src} as="image" />
  </Fragment>
  <!-- The About scene, on every device (the desktop fluid-sim version is
       kept in _about-fluid.astro). -->
  <div id="about-mobile">
    <!-- Scroll-linked intro: "Who's Behind?" centred on black; scrolling
         fades the words, lifts the black and the black & white portrait
         appears. CSS sticky pin, scrubbed by ScrollTrigger. -->
    <div class="am-reveal">
      <div class="am-reveal__pin">
        <div class="am-veil" aria-hidden="true" data-side-rays="0.5,0.55" data-side-rays-intensity="0.65"></div>
        <div class="am-hero">
          <p class="am-who">
            <span class="am-who-l"><span class="am-who-w">Who's</span></span>
            <span class="am-who-r"><span class="am-who-w">Behind?</span></span>
          </p>
        </div>
        <!-- One beam of light sweeps this whole layer: name, portrait, logo. -->
        <div class="am-scene">
          <div class="am-portrait-stack">
            <Image
              class="am-portrait am-portrait-img"
              src={portrait}
              alt="Martin — Prime Triskelion"
              widths={[480, 768, 1080]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="am-namebox">
            <p class="am-greeting">Hi, my name is</p>
            <p class="am-name">Martin.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- The portrait comes up out of the dark once the logo has gone. -->
  <section id="about-content" data-after-hero>
    <div class="ac-photo">
      <Image
        class="ac-photo__img"
        src={portrait}
        alt="Martin — Prime Triskelion"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1025px) 55vw, 100vw"
        loading="lazy"
      />
    </div>
    <div class="ac-body-col">
      <div class="ac-scroll">
        <p class="ac-body">Martin is a creative director and web developer in London. He builds brands and websites for people who would rather be remembered than approved.</p>
        <p class="ac-body">His work starts in the dark. Before the colour, before the code, there is a feeling, and he builds backwards from it until every frame, every scroll, every pause belongs to it. The night is darkest just before the dawn; it is usually when the real idea shows up.</p>
        <p class="ac-body">It is not about the stack. It is about the pull: the nights spent on a single transition, the refusal to ship anything that feels merely fine. Not the studio you deserve. The one the work needs.</p>
        <p class="ac-body">So bring the idea you are afraid is too much. That is usually the one he wants.</p>
        <div class="am-bio">
          <span class="am-item">Creative Director &amp; Developer</span>
          <span class="am-item">Blender · 3D · Motion</span>
          <span class="am-item">Brand Identity · Web Dev</span>
          <span class="am-item">London, UK · Est. 2024</span>
        </div>
      </div>
    </div>
  </section>

  <!-- After the pinned scene the page just scrolls on, normally. -->
  <section class="ac-after"><CtaSection /></section>

</Layout>

<style>
  /* -- Content section: portrait left, details right -- */
  #about-content {
    position: relative;
    z-index: 1;
    background: rgb(var(--c-bg));
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    padding-right: var(--site-gutter, 2rem);
  }
  .ac-photo {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    height: 100svh;
    overflow: hidden;
    /* Every edge melts into the black through a gradient — no hard cut. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 50%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 28%, #000 56%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 50%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 28%, #000 56%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .ac-photo__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
    filter: grayscale(1) contrast(1.1) brightness(0.9);
  }
  /* The window the copy scrolls through while the portrait stays put;
     its top and bottom fade into the black. */
  .ac-body-col {
    grid-column: 2;
    grid-row: 1;
    height: 100svh;
    width: 100%;
    max-width: 38rem;
    padding-left: clamp(2rem, 7vw, 9rem);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
  }
  .ac-scroll { will-change: transform; }
  /* Pre-blurred twin of the portrait (added by script on phones/tablets). */
  .ac-photo__blur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
    filter: grayscale(1) contrast(1.1) brightness(0.9) blur(26px);
    pointer-events: none;
    will-change: opacity, transform;
  }
  /* The fire and the closing line: in the page's flow, under the scene. */
  .ac-after {
    position: relative;
    z-index: 1;
    background: rgb(var(--c-bg));
  }
  .ac-body {
    font-family: var(--f-body);
    font-size: clamp(0.9rem, 1.05vw, 1.05rem);
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--c-cream) / 0.82);
    margin: 0 0 1.1rem;
  }
  /* A compact list, so the whole copy fits beside the portrait at rest. */
  .ac-scroll .am-bio { padding: 0.6rem 0 0; }
  .ac-scroll .am-item { font-size: clamp(0.8rem, 0.95vw, 1rem); padding: 0.4rem 0; }

  /* -- Phones and tablets: one column -- */
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    #about-content {
      grid-template-columns: 1fr;
      align-items: start;
      padding: 0 0 clamp(3rem, 8vw, 5rem);
    }
    .ac-photo {
      height: 70svh;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 16%, #000 62%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 16%, #000 62%, transparent 100%);
    }
    /* The copy is static, under the portrait, in the page's own flow: as
       tall as it needs to be, nothing scrolls inside it or over the photo. */
    #about-content { min-height: 0; }
    .ac-body-col {
      grid-column: 1;
      grid-row: 2;
      height: auto;
      overflow: visible;
      display: block;
      padding: 1.5rem var(--site-gutter, 1.5rem) 0;
      max-width: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* -- The scene, every device (desktop sizes further down) -- */
  @media all {
    #about-mobile { display: block; background: rgb(var(--c-bg)); }
    /* -- Scroll-linked intro (see initAboutMobileReveal) --
       340 stable-vh of scroll room with a sticky full-screen pin inside,
       same pattern as #manifesto on Home: --app-stable-vh is measured
       once (Layout.astro), so the toolbar can't resize it mid-scroll.
       Veil lift, then a short hold on the photo. */
    .am-reveal {
      position: relative;
      /* Above the About section that slides up under its last screen. */
      z-index: 2;
      height: 345svh;
      height: calc(var(--app-stable-vh, 1svh) * 345);
      /* Once the title scene is over, the About section takes the screen
         at once instead of after one more empty screen of scroll: it
         starts a viewport early, over the (black) pin on its way out. */
      margin-bottom: -100svh;
      margin-bottom: calc(var(--app-stable-vh, 1svh) * -100);
    }
    /* Positioned so it paints above the sticky pin's black veil it now
       overlaps by that 25%. */
    .am-after {
      position: relative;
      z-index: 6;
    }
    .am-reveal__pin {
      position: sticky;
      top: 0;
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      /* Sideways only: the words slide out past the edges. Vertically the
         veil bleeds out of the pin (see .am-veil). */
      overflow: visible;
      overflow-x: clip;
    }
    /* Everything but (iOS) Safari — see initAboutMobileReveal. Chrome on
       Android has its URL bar at the TOP: as it slides away the viewport's
       top edge moves up by the bar's height, and a top:0 sticky pin jumps
       up with it. The bottom edge stays put, so pin to that instead: the
       pin sits at the end of .am-reveal and sticky bottom:0 holds it on
       screen for the same scroll distance. The strip the bar frees up at
       the top is the page's own black. */
    .am-reveal--bottom {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .am-reveal--bottom .am-reveal__pin {
      top: auto;
      bottom: 0;
      flex-shrink: 0;
    }
    /* Black layer between photo and title; faded out by scroll.
       The pin is as tall as the page's first, toolbar-shown viewport. When
       the browser's toolbar slides away the viewport grows past it — at the
       top in Chrome (URL bar), at the bottom in Safari — and that strip was
       the page's bare black, without the light. The veil (which carries the
       light) bleeds out of the pin on both sides, so whichever edge opens
       up is already covered. */
    .am-veil {
      position: absolute;
      inset: -140px 0;
      z-index: 4;
      background: rgb(var(--c-bg));
      pointer-events: none;
    }
    .am-hero {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--site-gutter, 1.5rem);
      pointer-events: none;
    }
    /* "Who's Behind?" obok siebie, na środku */
    .am-who {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      /* 0.22em of the words' own size — a bare 0.22em here resolved
         against this element's 16px, leaving the words ~3px apart. */
      gap: calc(clamp(2.2rem, 9vw, 5rem) * 0.22);
      margin: 0;
      position: relative;
      z-index: 2;
    }
    .am-who-l, .am-who-r {
      display: inline-block;
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(2.2rem, 9vw, 5rem);
      letter-spacing: -0.02em;
      text-transform: uppercase;
      line-height: 1;
      white-space: nowrap;
    }
    /* Inner span = load entrance (blur-in, initAboutMobileTitle); outer
       span = scroll split (x/opacity, initAboutMobileReveal) — separate
       elements so the two GSAP tweens never fight over opacity. */
    .am-who-w { display: inline-block; opacity: 0; filter: blur(18px); }
    .am-who-l { color: rgb(var(--c-cream)); }
    .am-who-r { color: rgb(var(--c-red)); }

    /* Half the screen, vertically centred — the original mobile layout
       used an 80svh box, and full-screen cropped the (landscape) photo far
       too tight. Its own background is black, so the edges blend into the
       pin's black. */
    .am-portrait-stack {
      position: absolute;
      left: 0;
      right: 0;
      top: 25%;
      height: 50%;
      overflow: hidden;
    }
    /* One soft pass of light, left to right: --pc is the beam's centre
       (% of the width). The name, the face and the logo are lit only where
       the light is: dark ahead of the beam, and dark again behind it once
       it has passed. */
    .am-scene {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
      will-change: mask-image;
      --pc: -100;
      -webkit-mask-image: linear-gradient(90deg,
        rgb(0 0 0 / 0) calc(var(--pc) * 1% - 85.0%),
        rgb(0 0 0 / 0.017) calc(var(--pc) * 1% - 78.4%),
        rgb(0 0 0 / 0.067) calc(var(--pc) * 1% - 71.8%),
        rgb(0 0 0 / 0.146) calc(var(--pc) * 1% - 65.2%),
        rgb(0 0 0 / 0.25) calc(var(--pc) * 1% - 58.7%),
        rgb(0 0 0 / 0.371) calc(var(--pc) * 1% - 52.1%),
        rgb(0 0 0 / 0.5) calc(var(--pc) * 1% - 45.5%),
        rgb(0 0 0 / 0.629) calc(var(--pc) * 1% - 38.9%),
        rgb(0 0 0 / 0.75) calc(var(--pc) * 1% - 32.3%),
        rgb(0 0 0 / 0.854) calc(var(--pc) * 1% - 25.8%),
        rgb(0 0 0 / 0.933) calc(var(--pc) * 1% - 19.2%),
        rgb(0 0 0 / 0.983) calc(var(--pc) * 1% - 12.6%),
        rgb(0 0 0 / 1) calc(var(--pc) * 1% - 6.0%),
        rgb(0 0 0 / 0.99) calc(var(--pc) * 1% + 11.6%),
        rgb(0 0 0 / 0.962) calc(var(--pc) * 1% + 17.2%),
        rgb(0 0 0 / 0.916) calc(var(--pc) * 1% + 22.9%),
        rgb(0 0 0 / 0.854) calc(var(--pc) * 1% + 28.5%),
        rgb(0 0 0 / 0.778) calc(var(--pc) * 1% + 34.1%),
        rgb(0 0 0 / 0.691) calc(var(--pc) * 1% + 39.8%),
        rgb(0 0 0 / 0.598) calc(var(--pc) * 1% + 45.4%),
        rgb(0 0 0 / 0.5) calc(var(--pc) * 1% + 51.0%),
        rgb(0 0 0 / 0.402) calc(var(--pc) * 1% + 56.6%),
        rgb(0 0 0 / 0.309) calc(var(--pc) * 1% + 62.2%),
        rgb(0 0 0 / 0.222) calc(var(--pc) * 1% + 67.9%),
        rgb(0 0 0 / 0.146) calc(var(--pc) * 1% + 73.5%),
        rgb(0 0 0 / 0.084) calc(var(--pc) * 1% + 79.1%),
        rgb(0 0 0 / 0.038) calc(var(--pc) * 1% + 84.8%),
        rgb(0 0 0 / 0.01) calc(var(--pc) * 1% + 90.4%),
        rgb(0 0 0 / 0) calc(var(--pc) * 1% + 96.0%));
      mask-image: linear-gradient(90deg,
        rgb(0 0 0 / 0) calc(var(--pc) * 1% - 85.0%),
        rgb(0 0 0 / 0.017) calc(var(--pc) * 1% - 78.4%),
        rgb(0 0 0 / 0.067) calc(var(--pc) * 1% - 71.8%),
        rgb(0 0 0 / 0.146) calc(var(--pc) * 1% - 65.2%),
        rgb(0 0 0 / 0.25) calc(var(--pc) * 1% - 58.7%),
        rgb(0 0 0 / 0.371) calc(var(--pc) * 1% - 52.1%),
        rgb(0 0 0 / 0.5) calc(var(--pc) * 1% - 45.5%),
        rgb(0 0 0 / 0.629) calc(var(--pc) * 1% - 38.9%),
        rgb(0 0 0 / 0.75) calc(var(--pc) * 1% - 32.3%),
        rgb(0 0 0 / 0.854) calc(var(--pc) * 1% - 25.8%),
        rgb(0 0 0 / 0.933) calc(var(--pc) * 1% - 19.2%),
        rgb(0 0 0 / 0.983) calc(var(--pc) * 1% - 12.6%),
        rgb(0 0 0 / 1) calc(var(--pc) * 1% - 6.0%),
        rgb(0 0 0 / 0.99) calc(var(--pc) * 1% + 11.6%),
        rgb(0 0 0 / 0.962) calc(var(--pc) * 1% + 17.2%),
        rgb(0 0 0 / 0.916) calc(var(--pc) * 1% + 22.9%),
        rgb(0 0 0 / 0.854) calc(var(--pc) * 1% + 28.5%),
        rgb(0 0 0 / 0.778) calc(var(--pc) * 1% + 34.1%),
        rgb(0 0 0 / 0.691) calc(var(--pc) * 1% + 39.8%),
        rgb(0 0 0 / 0.598) calc(var(--pc) * 1% + 45.4%),
        rgb(0 0 0 / 0.5) calc(var(--pc) * 1% + 51.0%),
        rgb(0 0 0 / 0.402) calc(var(--pc) * 1% + 56.6%),
        rgb(0 0 0 / 0.309) calc(var(--pc) * 1% + 62.2%),
        rgb(0 0 0 / 0.222) calc(var(--pc) * 1% + 67.9%),
        rgb(0 0 0 / 0.146) calc(var(--pc) * 1% + 73.5%),
        rgb(0 0 0 / 0.084) calc(var(--pc) * 1% + 79.1%),
        rgb(0 0 0 / 0.038) calc(var(--pc) * 1% + 84.8%),
        rgb(0 0 0 / 0.01) calc(var(--pc) * 1% + 90.4%),
        rgb(0 0 0 / 0) calc(var(--pc) * 1% + 96.0%));
    }
    /* A tablet in landscape: full width at half the height made a wide
       strip, and the 16:9 photo, cropped top and bottom to fill it, lost
       the top of the head. Keep the phone's proportions, centred. */
    @media (min-width: 1025px) {
      .am-portrait-stack {
        left: 0;
        right: 0;
        margin-inline: auto;
        top: 10%;
        height: 80%;
        width: min(100%, 96vh);
      }
    }
    .am-portrait-stack::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 24%;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.85) 0%,
        rgba(0, 0, 0, 0.6)  22%,
        rgba(0, 0, 0, 0.38) 42%,
        rgba(0, 0, 0, 0.18) 62%,
        rgba(0, 0, 0, 0.07) 80%,
        rgba(0, 0, 0, 0)    100%
      );
      pointer-events: none;
      z-index: 3;
    }
    .am-portrait {
      display: block;
      width: 100%;
      height: 100%;
    }
    .am-portrait-img {
      position: absolute;
      inset: 0;
      z-index: 0;
      object-fit: cover;
      object-position: center 72%;
      filter: grayscale(1) contrast(1.3) brightness(0.62);
      /* The dark is part of the picture: the face holds its light, and the
         shoulders and edges sink into black through a long, soft falloff. */
      -webkit-mask-image: radial-gradient(ellipse 46% 54% at 50% 50%, #000 18%, rgb(0 0 0 / 0.92) 28%, rgb(0 0 0 / 0.78) 38%, rgb(0 0 0 / 0.6) 47%, rgb(0 0 0 / 0.42) 56%, rgb(0 0 0 / 0.27) 64%, rgb(0 0 0 / 0.15) 72%, rgb(0 0 0 / 0.07) 80%, rgb(0 0 0 / 0.02) 86%, transparent 90%);
      mask-image: radial-gradient(ellipse 46% 54% at 50% 50%, #000 18%, rgb(0 0 0 / 0.92) 28%, rgb(0 0 0 / 0.78) 38%, rgb(0 0 0 / 0.6) 47%, rgb(0 0 0 / 0.42) 56%, rgb(0 0 0 / 0.27) 64%, rgb(0 0 0 / 0.15) 72%, rgb(0 0 0 / 0.07) 80%, rgb(0 0 0 / 0.02) 86%, transparent 90%);
    }
    /* The name, left of the screen, over the black veil (scroll-driven) */
    .am-namebox {
      position: absolute;
      left: max(var(--site-gutter, 1.5rem), calc((100% - var(--site-max-width, 100%)) / 2));
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
      pointer-events: none;
    }
    /* Phones and touch tablets: the scene sits higher, so the dark above
       the portrait isn't a wasted quarter of the screen. */
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .am-scene { translate: 0 calc(var(--app-stable-vh, 1svh) * -10); }
      /* The name sits below the ears, not level with them. */
      .am-namebox { top: calc(50% + var(--app-stable-vh, 1svh) * 10); }
    }
    .am-greeting {
      font-family: var(--f-body);
      font-size: clamp(0.6rem, 2.2vw, 0.75rem);
      font-weight: 300;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgb(var(--c-cream) / 0.6);
      margin: 0 0 clamp(0.35rem, 0.9vw, 0.6rem);
    }
    .am-name {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(1.1rem, 4.5vw, 1.5rem);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: rgb(var(--c-red));
      line-height: 0.85;
      margin: 0;
    }

    /* Bio z red-dash itemami */
    .am-bio {
      padding: 0 var(--site-gutter, 1.5rem) clamp(2.5rem, 7vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .am-item {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(0.95rem, 4.2vw, 1.5rem);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: rgb(var(--c-cream));
      line-height: 1.1;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: clamp(0.9rem, 2.8vw, 1.2rem) 0;
    }
    .am-item::before {
      content: '';
      display: block;
      width: 18px;
      height: 1px;
      background: rgb(var(--c-red));
      flex-shrink: 0;
      transform: translateZ(0);
    }

  }

  /* -- Desktop: the scene at a desktop scale -- */
  @media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
    .am-who-l, .am-who-r { font-size: clamp(3rem, 8.5vw, 9rem); }
    .am-bio {
      width: min(100%, var(--site-max-width));
      margin-inline: auto;
      box-sizing: border-box;
    }
    /* The name stands clear of the portrait's own edges (its box is
       min(100%, 96vh) wide, centred), never closer than the page margin. */
    .am-namebox { left: max(var(--site-gutter, 1.5rem), calc(50% - min(50%, 48vh) - 7rem)); }
    .am-greeting { font-size: 0.6rem; }
    .am-name { font-size: clamp(1.2rem, 1.6vw, 1.8rem); }
    .am-item { font-size: clamp(1.1rem, 1.8vw, 2rem); }
  }


  /* The pins here (and their spacers) change the page's height as they open
     and close; with scroll anchoring on, Chrome nudges scrollTop to "keep
     its place" and the page jumps when scrolling back up. */
  :global(html), :global(body) { overflow-anchor: none; }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { afterPageTransition, revealAfterHero, titleIn } from '../utils/afterPageTransition';
  import { isSafari } from '../utils/isSafari';

  gsap.registerPlugin(ScrollTrigger);
  // The browser's toolbar sliding in/out (it comes back as soon as you scroll
  // up) resizes the window by a few dozen px. Without this ScrollTrigger
  // refreshes on that resize — pins and their spacers are measured again
  // mid-scroll and the page jumps. (Home sets it too, but a visit that starts
  // on About never ran that code.)
  ScrollTrigger.config({ ignoreMobileResize: true });

  // The frozen viewport height (px per 1vh, set once in Layout.astro), so a
  // toolbar-driven resize can't change a pin's length either.
  const stableVh = () => {
    const v = parseFloat(document.documentElement.style.getPropertyValue('--app-stable-vh'));
    return v > 0 ? v * 100 : window.innerHeight;
  };

  // The intro, every device: the title fades out and the black veil lifts
  // off the (black & white) portrait — scrubbed by scroll over .am-reveal
  // (its sticky pin holds for exactly that distance, then scrolls away into
  // the name/bio below).
  let _amRevealST: ScrollTrigger | null = null;
  function initAboutMobileReveal() {
    const reveal = document.querySelector<HTMLElement>('.am-reveal');
    const pin    = document.querySelector<HTMLElement>('.am-reveal__pin');
    const veil   = document.querySelector<HTMLElement>('.am-veil');
    const img    = document.querySelector<HTMLElement>('.am-portrait-img');
    const wordL  = document.querySelector<HTMLElement>('.am-who-l');
    const wordR  = document.querySelector<HTMLElement>('.am-who-r');
    if (!reveal || !pin || !veil || !img || !wordL || !wordR) return;

    // Safari (iOS 26's floating bottom toolbar) is fine pinned to the top
    // and stays that way; everything else pins to the bottom edge (see
    // .am-reveal--bottom). Same scroll range either way.
    reveal.classList.toggle('am-reveal--bottom', !isSafari());

    const scene = document.querySelector<HTMLElement>('.am-scene');
    if (!scene) return;

    // black → one slow beam of light sweeps left to right and brings the
    // name, the portrait and the logo out of the dark in turn, then leaves
    // them dark again.
    const tl = gsap.timeline({ defaults: { ease: 'sine.inOut' } });
    // Original order: the light goes out first, then the title dissolves
    // (blur + fade), then the rest; `o` shifts the rest behind them.
    const hold = 0.12; // the name stands alone on black before the face is lit
    const o = 0.48; // light out (0–0.2), title dissolves (0.2–0.44), a short beat of dark, then the name at 0.53
    const rays = veil.querySelector<HTMLElement>('canvas');
    if (rays) tl.fromTo(rays, { opacity: 1 }, { opacity: 0, duration: 0.2, immediateRender: false }, 0);
    tl.fromTo([wordL, wordR], { opacity: 1, filter: 'blur(0px)' }, { opacity: 0, filter: 'blur(16px)', duration: 0.24, ease: 'sine.in' }, 0.2)
      .fromTo(veil, { opacity: 1 }, { opacity: 0, duration: 0.04 }, 0.06 + o + hold)
      .fromTo(scene, { '--pc': -100 }, { '--pc': 190, duration: 0.9, ease: 'none' }, 0.1 + o + hold)
      // …and then a stretch of pure black before the page carries on.
      .to({}, { duration: 0.04 }, 1.04 + o + hold);

    _amRevealST = ScrollTrigger.create({
      animation: tl,
      trigger: reveal,
      start: 'top top',
      // The distance the pin stays stuck (container minus pin, both sized
      // from the stable --app-stable-vh, which the toolbar doesn't change)
      // — not innerHeight.
      end: () => `+=${reveal.offsetHeight - pin.offsetHeight}`,
      // A little smoothing so the wheel's steps don't show in the light.
      scrub: 0.8,
      // .rays-off stops sideRays.js rendering once the light has faded; on
      // the way back it stays out until the title has rejoined.
      onUpdate: (self) => veil.classList.toggle('rays-off', self.progress >= 0.2 / 1.68),
    });

    document.addEventListener('astro:before-swap', () => {
      _amRevealST?.kill();
      _amRevealST = null;
    }, { once: true });
  }

  // "Who's Behind?" — same entrance as the Projects/Services headers so
  // every subpage title blurs in instead of just appearing with the page.
  function initAboutTitle() {
    const words = document.querySelectorAll<HTMLElement>('.am-who-w');
    afterPageTransition(() => {
      revealAfterHero();
      if (!words.length) return;
      titleIn(gsap.timeline(), words);
    });
  }

  // The portrait comes up out of the dark as the section scrolls in, from a
  // blur, then the details after it.
  let _acST: ScrollTrigger | null = null;
  function initAboutContent() {
    const section = document.querySelector<HTMLElement>('#about-content');
    const photo   = document.querySelector<HTMLElement>('.ac-photo');
    const body    = document.querySelector<HTMLElement>('.ac-body-col');
    if (!section || !photo || !body) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const inner = body.querySelector<HTMLElement>('.ac-scroll');
    const img = photo.querySelector<HTMLElement>('.ac-photo__img');
    if (!inner) return;

    // Phones and tablets: only the portrait is scrubbed — held at the top
    // while it comes out of the dark, then released. The copy stays put
    // under it, and the page scrolls on normally.
    if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) {
      const mtl = gsap.timeline({ defaults: { ease: 'sine.inOut' } });
      // Animating a CSS blur on the masked portrait janks on phones. Instead a
      // second copy is blurred once, statically (one cached raster), and only
      // its opacity/scale are scrubbed — a cross-fade from soft to sharp.
      mtl.fromTo(photo, { opacity: 0 }, { opacity: 1, duration: 0.5, ease: 'sine.out' }, 0);
      if (img) {
        photo.querySelector('.ac-photo__blur')?.remove();
        const soft = img.cloneNode(false) as HTMLImageElement;
        soft.classList.add('ac-photo__blur');
        soft.removeAttribute('id');
        soft.setAttribute('aria-hidden', 'true');
        soft.alt = '';
        soft.loading = 'eager';
        photo.appendChild(soft);
        mtl.fromTo(img, { scale: 1.18, filter: 'grayscale(1) contrast(1.1) brightness(0)' }, { scale: 1, filter: 'grayscale(1) contrast(1.1) brightness(0.9)', duration: 1, ease: 'sine.out' }, 0);
        mtl.fromTo(soft, { opacity: 1, scale: 1.3 }, { opacity: 0, scale: 1.1, duration: 1, ease: 'sine.inOut' }, 0);
      }
      _acST = ScrollTrigger.create({
        animation: mtl,
        trigger: photo,
        start: 'top top',
        end: () => `+=${stableVh() * 0.7}`,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true,
      });
      document.addEventListener('astro:before-swap', () => {
        _acST?.kill();
        _acST = null;
      }, { once: true });
      return;
    }

    // Scroll distance: the portrait develops first, then the copy rises
    // from below the screen to its place beside it.
    const travel = () => window.innerHeight + inner.offsetHeight;
    const develop = 0.14;
    // The scene's own length (the pin holds for 62% of it, see `end`).
    const baseDist = () => window.innerHeight * 1.5 + travel() * 0.5;
    const holdDist = () => 0;

    const tl = gsap.timeline({ defaults: { ease: 'sine.inOut' } });
    // Out of pure black: heavy blur and no light at first, the picture
    // slowly settles (scale) and finds focus as the light comes up.
    tl.fromTo(photo, { opacity: 0, filter: 'blur(48px)' }, { opacity: 1, filter: 'blur(0px)', duration: develop, ease: 'power2.out' }, 0);
    if (img) {
      tl.fromTo(img, { scale: 1.18, filter: 'grayscale(1) contrast(1.1) brightness(0)' }, { scale: 1, filter: 'grayscale(1) contrast(1.1) brightness(0.9)', duration: develop, ease: 'sine.out' }, 0);
    }
    // The copy rises from below and comes to rest in the middle, beside the
    // portrait.
    tl.fromTo(inner, { y: () => travel() / 2 }, { y: 0, duration: 0.36, ease: 'sine.out' }, develop);
    // …and it stays there, at rest: the pin lets go and the page scrolls
    // on normally to the closing line.
    tl.to({}, { duration: 0.12 }, develop + 0.36);

    _acST = ScrollTrigger.create({
      animation: tl,
      trigger: section,
      // Pinned: the portrait stays; the scroll plays the picture, then the copy.
      start: 'top top',
      end: () => `+=${(baseDist() + holdDist()) * 0.62}`,
      pin: true,
      scrub: 1,
      invalidateOnRefresh: true,
    });
    document.addEventListener('astro:before-swap', () => {
      _acST?.kill();
      _acST = null;
    }, { once: true });
  }

  function initAbout() {
    initAboutTitle();
    initAboutMobileReveal();
    initAboutContent();
  }

  document.addEventListener('astro:page-load', initAbout);
</script>
