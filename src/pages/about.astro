---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import portraitTop from '../img/portrait-top.webp';

// Dither texture — the full 3840px original is far more than the portrait
// frame ever needs.
const ditherTexture = await getImage({ src: portraitTop, width: 1600, format: 'webp' });
---

<Layout title="About — Prime Triskelion">
  <Fragment slot="head">
    <link rel="preload" href={portraitTop.src} as="image" />
  </Fragment>
  <!-- The About scene, on every device (the desktop fluid-sim version is
       kept in _about-fluid.astro). -->
  <div id="about-mobile">
    <!-- Scroll-linked intro: "Who's Behind?" centred on black; scrolling
         splits the words apart, lifts the black and the portrait develops
         out of dither. CSS sticky pin, scrubbed by ScrollTrigger. With a
         mouse, a lens under the cursor resolves the dots into the photo. -->
    <div class="am-reveal">
      <div class="am-reveal__pin">
        <div class="am-portrait-stack">
          <Image
            class="am-portrait am-portrait-img"
            src={portraitTop}
            alt="Martin — Prime Triskelion"
            widths={[480, 768, 1080]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <canvas class="am-dither" data-src={ditherTexture.src} aria-hidden="true"></canvas>
        </div>
        <div class="am-veil" aria-hidden="true"></div>
        <div class="am-hero">
          <p class="am-who">
            <span class="am-who-l"><span class="am-who-w">Who's</span></span>
            <span class="am-who-r"><span class="am-who-w">Behind?</span></span>
          </p>
        </div>
      </div>
    </div>
    <div class="am-after" data-after-hero>
    <div class="am-intro">
      <p class="am-greeting">Hi, my name is</p>
      <p class="am-name">Martin.</p>
    </div>
    <div class="am-bio">
      <span class="am-item">Creative Director &amp; Developer</span>
      <span class="am-item">Blender · 3D · Motion</span>
      <span class="am-item">Brand Identity · Web Dev</span>
      <span class="am-item">London, UK · Est. 2024</span>
    </div>
    </div>
  </div>

  <!-- Content: canvas has scrolled away, normal page resumes -->
  <section id="about-content" data-after-hero>
    <div class="ac-grid">
      <h2 class="ac-label">About</h2>
      <div class="ac-body-col">
        <p class="ac-body">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        <p class="ac-body">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
      </div>
    </div>
  </section>

  <CtaSection />
</Layout>

<style>
  /* -- Content section -- */
  #about-content {
    position: relative;
    z-index: 1;
    background: rgb(var(--c-bg));
    padding: clamp(6rem, 14vw, 14rem) var(--site-gutter, 2rem);
  }
  .ac-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .ac-label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 8vw, 9rem);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
    line-height: 0.9;
    margin: 0;
    position: sticky;
    top: 2rem;
  }
  .ac-body-col {
    padding-top: 0.5rem;
  }
  .ac-body {
    font-family: var(--f-body);
    font-size: clamp(1.1rem, 1.7vw, 1.55rem);
    font-weight: 300;
    line-height: 1.75;
    color: rgb(var(--c-cream) / 0.82);
    margin: 0 0 2rem;
  }
  .ac-body:last-child { margin: 0; }


  /* -- The scene, every device (desktop sizes further down) -- */
  @media all {
    #about-mobile { display: block; background: rgb(var(--c-bg)); }
    /* -- Scroll-linked intro (see initAboutMobileReveal) --
       340 stable-vh of scroll room with a sticky full-screen pin inside,
       same pattern as #manifesto on Home: --app-stable-vh is measured
       once (Layout.astro), so the toolbar can't resize it mid-scroll.
       Veil lift, dither develop, then a short hold on the photo. */
    .am-reveal {
      position: relative;
      height: 340svh;
      height: calc(var(--app-stable-vh, 1svh) * 340);
      /* The photo ends at 75% of the pin (see .am-portrait-stack) — pull
         the name/bio up by the remaining 25% so they follow right under
         the photo instead of after a band of empty black. */
      margin-bottom: -25svh;
      margin-bottom: calc(var(--app-stable-vh, 1svh) * -25);
    }
    /* Positioned so it paints above the sticky pin's black veil it now
       overlaps by that 25%. */
    .am-after {
      position: relative;
      z-index: 6;
    }
    .am-reveal__pin {
      position: sticky;
      top: 0;
      height: 100svh;
      height: calc(var(--app-stable-vh, 1svh) * 100);
      overflow: hidden;
    }
    /* Everything but (iOS) Safari — see initAboutMobileReveal. Chrome on
       Android has its URL bar at the TOP: as it slides away the viewport's
       top edge moves up by the bar's height, and a top:0 sticky pin jumps
       up with it. The bottom edge stays put, so pin to that instead: the
       pin sits at the end of .am-reveal and sticky bottom:0 holds it on
       screen for the same scroll distance. The strip the bar frees up at
       the top is the page's own black. */
    .am-reveal--bottom {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .am-reveal--bottom .am-reveal__pin {
      top: auto;
      bottom: 0;
      flex-shrink: 0;
    }
    /* Black layer between photo and title; faded out by scroll. */
    .am-veil {
      position: absolute;
      inset: 0;
      z-index: 4;
      background: rgb(var(--c-bg));
      pointer-events: none;
    }
    .am-hero {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--site-gutter, 1.5rem);
      pointer-events: none;
    }
    /* "Who's Behind?" obok siebie, na środku */
    .am-who {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      /* 0.22em of the words' own size — a bare 0.22em here resolved
         against this element's 16px, leaving the words ~3px apart. */
      gap: calc(clamp(2.2rem, 9vw, 5rem) * 0.22);
      margin: 0;
      position: relative;
      z-index: 2;
    }
    .am-who-l, .am-who-r {
      display: inline-block;
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(2.2rem, 9vw, 5rem);
      letter-spacing: -0.02em;
      text-transform: uppercase;
      line-height: 1;
      white-space: nowrap;
    }
    /* Inner span = load entrance (blur-in, initAboutMobileTitle); outer
       span = scroll split (x/opacity, initAboutMobileReveal) — separate
       elements so the two GSAP tweens never fight over opacity. */
    .am-who-w { display: inline-block; opacity: 0; filter: blur(18px); }
    .am-who-l { color: rgb(var(--c-cream)); }
    .am-who-r { color: rgb(var(--c-red)); }

    /* Half the screen, vertically centred — the original mobile layout
       used an 80svh box, and full-screen cropped the (landscape) photo far
       too tight. Its own background is black, so the edges blend into the
       pin's black. */
    .am-portrait-stack {
      position: absolute;
      left: 0;
      right: 0;
      top: 25%;
      height: 50%;
      overflow: hidden;
    }
    /* A tablet in landscape: full width at half the height made a wide
       strip, and the 16:9 photo, cropped top and bottom to fill it, lost
       the top of the head. Keep the phone's proportions, centred. */
    @media (min-width: 1025px) {
      .am-portrait-stack {
        left: 50%;
        right: auto;
        top: 10%;
        height: 80%;
        width: min(100%, 96vh);
        transform: translateX(-50%);
      }
      /* The photo now ends at 90% of the pin, so the name/bio below
         pull up by the remaining 10% (see .am-reveal). */
      .am-reveal { margin-bottom: calc(var(--app-stable-vh, 1svh) * -10); }
    }
    .am-portrait-stack::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 40%;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 1)    0%,
        rgba(0, 0, 0, 0.94) 18%,
        rgba(0, 0, 0, 0.8)  34%,
        rgba(0, 0, 0, 0.6)  48%,
        rgba(0, 0, 0, 0.38) 62%,
        rgba(0, 0, 0, 0.2)  76%,
        rgba(0, 0, 0, 0.08) 88%,
        rgba(0, 0, 0, 0)    100%
      );
      pointer-events: none;
      z-index: 3;
    }
    .am-portrait {
      display: block;
      width: 100%;
      height: 100%;
    }
    .am-portrait-img {
      position: absolute;
      inset: 0;
      z-index: 0;
      object-fit: cover;
      object-position: center 72%;
      transform-origin: 50% 72%;
      /* Settles to scale(1) as the veil lifts (scroll-scrubbed). No blur
         here — a scrubbed full-screen filter is what mobile Safari
         handles worst. */
      transform: scale(1.12);
    }
    /* Dither → photo canvas (see initDitherPortrait) over the <img>, which
       stays underneath as the fallback (no WebGL2, reduced motion, still
       loading). Below the ::after bottom fade. */
    .am-dither {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .am-dither.is-ready { opacity: 1; }
    /* Intro */
    .am-intro {
      padding: clamp(2.5rem, 7vw, 4rem) var(--site-gutter, 1.5rem);
    }
    .am-greeting {
      font-family: var(--f-body);
      font-size: clamp(0.85rem, 3vw, 1rem);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: rgb(var(--c-cream) / 0.82);
      margin: 0 0 0.5rem;
    }
    .am-name {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(2rem, 7.5vw, 3.2rem);
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: rgb(var(--c-red));
      line-height: 0.9;
      margin: 0;
    }

    /* Bio z red-dash itemami */
    .am-bio {
      padding: 0 var(--site-gutter, 1.5rem) clamp(2.5rem, 7vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .am-item {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(0.95rem, 4.2vw, 1.5rem);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: rgb(var(--c-cream));
      line-height: 1.1;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: clamp(0.9rem, 2.8vw, 1.2rem) 0;
    }
    .am-item::before {
      content: '';
      display: block;
      width: 18px;
      height: 1px;
      background: rgb(var(--c-red) / 0.45);
      flex-shrink: 0;
    }

  }

  /* -- Phones and tablets: the About copy in one column -- */
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    #about-content { padding: clamp(3rem, 8vw, 5rem) var(--site-gutter, 1.5rem); }
    .ac-grid      { grid-template-columns: 1fr; gap: 2rem; }
    .ac-label     { font-size: clamp(2.5rem, 10vw, 5rem); position: static; }
  }

  /* -- Desktop: the scene at a desktop scale -- */
  @media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
    .am-who-l, .am-who-r { font-size: clamp(3rem, 8.5vw, 9rem); }
    .am-intro, .am-bio {
      width: min(100%, var(--site-max-width));
      margin-inline: auto;
      box-sizing: border-box;
    }
    .am-greeting { font-size: 1.1rem; }
    .am-name { font-size: clamp(3.5rem, 7vw, 7rem); }
    .am-item { font-size: clamp(1.1rem, 1.8vw, 2rem); }
    /* The lens follows a mouse over the portrait. */
    .am-portrait-stack { cursor: none; pointer-events: auto; }
  }

</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { afterPageTransition, revealAfterHero, titleIn } from '../utils/afterPageTransition';
  import { isSafari } from '../utils/isSafari';
  import { initDitherPortrait, type DitherPortraitHandle } from '../utils/ditherPortrait';

  gsap.registerPlugin(ScrollTrigger);


  // The intro, every device: the words split apart and the black veil
  // lifts off the portrait, which develops out of dither — scrubbed by
  // scroll over .am-reveal (its sticky pin holds for exactly that
  // distance, then scrolls away into the name/bio below).
  let _amRevealST: ScrollTrigger | null = null;
  let _amDither: DitherPortraitHandle | null = null;
  let _amSinkST: ScrollTrigger | null = null;
  function initAboutMobileReveal() {
    const reveal = document.querySelector<HTMLElement>('.am-reveal');
    const pin    = document.querySelector<HTMLElement>('.am-reveal__pin');
    const veil   = document.querySelector<HTMLElement>('.am-veil');
    const img    = document.querySelector<HTMLElement>('.am-portrait-img');
    const wordL  = document.querySelector<HTMLElement>('.am-who-l');
    const wordR  = document.querySelector<HTMLElement>('.am-who-r');
    if (!reveal || !pin || !veil || !img || !wordL || !wordR) return;

    // Safari (iOS 26's floating bottom toolbar) is fine pinned to the top
    // and stays that way; everything else pins to the bottom edge (see
    // .am-reveal--bottom). Same scroll range either way.
    reveal.classList.toggle('am-reveal--bottom', !isSafari());

    // Dither → photo develop on top of the plain portrait. Reduced motion
    // (or no WebGL2) just keeps the <img>.
    const ditherCanvas = document.querySelector<HTMLCanvasElement>('.am-dither');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (ditherCanvas?.dataset.src && !reduceMotion) {
      _amDither = initDitherPortrait(ditherCanvas, {
        src: ditherCanvas.dataset.src,
        ink: [0, 0, 0],
        paper: [242 / 255, 237 / 255, 232 / 255],
        focusX: 0.5,
        focusY: 0.72,
        onReady: () => ditherCanvas.classList.add('is-ready'),
      });
      if (_amDither) initAboutLens(ditherCanvas, _amDither);
    }
    const develop = { p: 0 };

    // Timeline spans the whole 240 stable-vh the pin holds: title split +
    // veil lift first (same pace as before the track grew), then the
    // dither develop, then a hold on the finished portrait (last 0.2) so
    // the name/bio don't slide up the instant the face resolves.
    const tl = gsap.timeline({ defaults: { ease: 'none' } })
      .fromTo(wordL, { x: 0, opacity: 1 }, { x: '-60vw', opacity: 0, duration: 0.25 }, 0)
      .fromTo(wordR, { x: 0, opacity: 1 }, { x: '60vw', opacity: 0, duration: 0.25 }, 0)
      .fromTo(veil,  { opacity: 1 }, { opacity: 0, duration: 0.33 }, 0)
      .fromTo(img,   { scale: 1.12 }, { scale: 1, duration: 0.42 }, 0)
      .fromTo(develop, { p: 0 }, {
        p: 1,
        duration: 0.51,
        onUpdate: () => _amDither?.setProgress(develop.p),
      }, 0.29)
      .to({}, { duration: 0.2 }, 0.8);

    _amRevealST = ScrollTrigger.create({
      animation: tl,
      trigger: reveal,
      start: 'top top',
      // The distance the pin stays stuck (container minus pin, both sized
      // from the stable --app-stable-vh, which the toolbar doesn't change)
      // — not innerHeight.
      end: () => `+=${reveal.offsetHeight - pin.offsetHeight}`,
      scrub: true,
    });

    // As the name/bio slide in, the portrait sinks back toward the dark:
    // dims, the vignette closes on the face and the edges re-dither. Tied
    // to the text itself (not the pin timeline) so it starts exactly when
    // the name appears and carries on after the pin lets go.
    const after = document.querySelector<HTMLElement>('.am-after');
    if (_amDither && after) {
      _amSinkST = ScrollTrigger.create({
        trigger: after,
        start: 'top bottom',
        end: 'top 45%',
        scrub: true,
        onUpdate: (self) => _amDither?.setSink(self.progress),
      });
    }

    document.addEventListener('astro:before-swap', () => {
      _amRevealST?.kill();
      _amRevealST = null;
      _amSinkST?.kill();
      _amSinkST = null;
      _amDither?.destroy();
      _amDither = null;
    }, { once: true });
  }

  // With a mouse: a lens under the cursor resolves the dots into the photo
  // (DitherPortraitHandle.setLens). It eases after the pointer and fades
  // in and out at the portrait's edge; a frame loop only while moving.
  let _lensOff: (() => void) | null = null;
  function initAboutLens(canvas: HTMLCanvasElement, dither: DitherPortraitHandle) {
    _lensOff?.();
    _lensOff = null;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const box = canvas.closest<HTMLElement>('.am-portrait-stack') ?? canvas;
    const goal = { x: 0, y: 0, on: 0 };
    const cur = { x: 0, y: 0, on: 0 };
    let raf = 0;
    const tick = () => {
      raf = 0;
      cur.x += (goal.x - cur.x) * 0.2;
      cur.y += (goal.y - cur.y) * 0.2;
      cur.on += (goal.on - cur.on) * 0.12;
      dither.setLens(cur.x, cur.y, cur.on);
      const moving = Math.abs(goal.x - cur.x) + Math.abs(goal.y - cur.y) > 0.3 || Math.abs(goal.on - cur.on) > 0.004;
      if (moving) raf = requestAnimationFrame(tick);
    };
    const wake = () => { if (!raf) raf = requestAnimationFrame(tick); };
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      goal.x = e.clientX - r.left;
      goal.y = e.clientY - r.top;
      if (goal.on === 0) { cur.x = goal.x; cur.y = goal.y; }
      goal.on = 1;
      wake();
    };
    const onLeave = () => { goal.on = 0; wake(); };
    box.addEventListener('pointermove', onMove);
    box.addEventListener('pointerleave', onLeave);
    _lensOff = () => {
      cancelAnimationFrame(raf);
      box.removeEventListener('pointermove', onMove);
      box.removeEventListener('pointerleave', onLeave);
    };
    document.addEventListener('astro:before-swap', () => { _lensOff?.(); _lensOff = null; }, { once: true });
  }

  // "Who's Behind?" — same entrance as the Projects/Services headers so
  // every subpage title blurs in instead of just appearing with the page.
  function initAboutTitle() {
    const words = document.querySelectorAll<HTMLElement>('.am-who-w');
    afterPageTransition(() => {
      revealAfterHero();
      if (!words.length) return;
      titleIn(gsap.timeline(), words);
    });
  }

  function initAbout() {
    initAboutTitle();
    initAboutMobileReveal();
  }

  document.addEventListener('astro:page-load', initAbout);
</script>

