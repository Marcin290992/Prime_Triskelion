---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import TopBarCta from '../components/TopBarCta.astro';
import OxygenMenu from '../components/OxygenMenu.astro';
import GridLines from '../components/GridLines.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

interface Props {
	title: string;
	description?: string;
	topBar?: boolean;
}

const { title, description = "Prime Triskelion — one-person design studio crafting digital experiences for ambitious brands.", topBar = true } = Astro.props;
---

<!doctype html>
<html lang="en" style="background:#000">
	<head>
		<meta charset="UTF-8" />
		<!-- No viewport-fit=cover (removed — see git history for why it was
		     added). It opts into extending the page's own layout under the
		     notch/Dynamic Island and home-indicator/gesture-bar strips
		     instead of Safari reserving and filling them itself — which
		     puts the burden on this page's own CSS to size every fixed
		     element (the fullscreen nav overlay especially) exactly right
		     against the true visual viewport, every time, including mid-
		     toolbar-animation. That turned out to be a much bigger, harder-
		     to-fully-pin-down problem (page content visible through gaps at
		     the top/bottom of the open menu) than the narrower one
		     viewport-fit=cover was added to fix in the first place (a
		     lighter strip right around the toolbar/gesture-bar area).
		     Confirmed via a real reference site with the same kind of
		     fullscreen nav overlay and no gap issue: it doesn't set
		     viewport-fit=cover either. -->
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark" />
		<!-- Matches --c-bg (0 0 0) — the toolbar/status-bar chrome's own tint,
		     distinct from the safe-area coverage above. -->
		<meta name="theme-color" content="#000000" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var lockWidth = window.innerWidth || 0;
				var isTraverseNav = false;

				function measureHeight() {
					var ih = window.innerHeight || 0;
					var vv = window.visualViewport ? window.visualViewport.height : 0;
					// Was Math.max(ih, vv) — deliberately taking whichever
					// number was BIGGER. visualViewport.height exists
					// specifically to report the true currently-visible
					// area (that's its whole purpose vs. innerHeight, which
					// can reflect a different, sometimes larger, layout
					// reference on Safari); picking the larger of the two
					// on purpose meant --app-stable-vh (and every section
					// sized off calc(var(--app-stable-vh) * 100), i.e. #hero
					// and .proj-section on mobile) could end up taller than
					// what's actually visible on screen — content runs out
					// before the bottom the page thinks it has, leaving a
					// gap once you scroll far enough to reach it. Trusting
					// visualViewport.height when it's available, instead of
					// whichever is bigger, is the fix.
					return vv || ih;
				}

				function setLockedHeight() {
					var h = measureHeight();
					if (!h) return;
					root.style.setProperty('--app-stable-vh', (h * 0.01) + 'px');
				}

				setLockedHeight();

				window.addEventListener('orientationchange', function () {
					setTimeout(setLockedHeight, 160);
				}, { passive: true });

				window.addEventListener('resize', function () {
					var w = window.innerWidth || 0;
					if (Math.abs(w - lockWidth) > 80) {
						lockWidth = w;
						setLockedHeight();
					}
					// Height-only resizes (the mobile toolbar collapsing/expanding
					// as the page scrolls) are deliberately ignored — the value
					// stays locked from load/navigation/orientation/width change.
					// Re-measuring after the toolbar settled (history: debounced
					// 200ms, later first-screen-only) resized #hero and everything
					// below it mid-scroll: a page jump on Chrome and, on iOS
					// Safari 26 — whose toolbar collapses right around the end of
					// the hero — a one-off hitch just after leaving it. The cost of
					// not re-measuring: with the toolbar hidden, the first screen is
					// a toolbar-height short and the (black) next section peeks in.
				}, { passive: true });

				// Astro's swap() unconditionally wipes every attribute on <html>
				// (including this script's own `style.setProperty` additions) and
				// replaces them with the new document's server-rendered ones —
				// see swapRootAttributes() in astro/dist/transitions/swap-functions.js.
				// The server-rendered <html> never has --app-stable-vh (it's only
				// ever added client-side), so after EVERY client-side navigation —
				// traverse (back/forward) included — this custom property is gone
				// until JS restores it. Previously this listener skipped the
				// restore on traverse specifically (theory: avoid baking in a
				// chrome-collapsed measurement from a restored scroll position) —
				// that was wrong: skipping it doesn't preserve the old value, it
				// just leaves the property missing, so #hero's
				// calc(var(--app-stable-vh) * 100) fell back to global.css's
				// `--app-stable-vh: 1vh` — a live, chrome-reactive unit, i.e.
				// exactly the unstable behavior this whole mechanism exists to
				// avoid. Always restore it, on every swap, no exceptions.
				document.addEventListener('astro:before-swap', function (event) {
					isTraverseNav = (event && event.navigationType) === 'traverse';
				});
				// astro:after-swap fires right after the attribute wipe above,
				// before astro:page-load — restoring here (rather than waiting
				// for page-load) minimizes the window where CSS reads the raw
				// `1vh` fallback.
				document.addEventListener('astro:after-swap', setLockedHeight);
				// Traverse restores a previous scroll position instead of 0 (see
				// index.astro's matching isTraverseNav skip of scrollTo(0,0)) — if
				// that position is scrolled down, mobile chrome may still be
				// mid-collapse at the instant of the measurement above. One more
				// measurement shortly after lets chrome settle into its resting
				// state for that scroll position before trusting the value —
				// same reasoning as the existing orientationchange delay below.
				document.addEventListener('astro:page-load', function () {
					if (isTraverseNav) setTimeout(setLockedHeight, 160);
				});
			})();
		</script>
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon-triskelion.svg" />
		<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/clash-display-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/logo-white.svg" as="image" type="image/svg+xml" />
		<ClientRouter />
		<slot name="head" />
		<script is:inline>
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'auto';
			}
		</script>
		<style>
		html, body { margin: 0; padding: 0; background: #000; }
	</style>
	<style is:global>
			/* In dev, Vite injects component CSS via JS modules (not a blocking
			   <link>), so the browser briefly paints raw HTML with the UA default
			   button style (light/white box) before that JS runs — most visible on
			   #hud-menu-btn (lives in a child component, so this must be :global to
			   reach it). Reset synchronously here so nothing flashes. */
			button { background: transparent; border: 0; margin: 0; padding: 0; font: inherit; color: inherit; -webkit-appearance: none; appearance: none; }

			/* ── View Transition: fade out to black, then blur-in from black ── */
			@keyframes vt-fade-out {
				from { opacity: 1; }
				to   { opacity: 0; }
			}
			@keyframes vt-blur-in {
				from { opacity: 0; filter: blur(20px); }
				to   { opacity: 1; filter: blur(0px); }
			}
			/* Touch devices: plain fade, no blur. Blurring the whole new-page
			   snapshot smears white text/logo across the black background, so
			   for its duration the screen reads as a hazy grey instead of black
			   ("black too light for a moment" on every phone) — and full-screen
			   filter animation is exactly what touch Safari handles worst. */
			@keyframes vt-fade-in-mobile {
				from { opacity: 0; }
				to   { opacity: 1; }
			}

			/* The old/new snapshots (below) only ever animate `opacity` and
			   `filter` — neither one paints a background. `::view-transition-old`
			   fades OUT to fully transparent over the first 0.2s while
			   `::view-transition-new` is still sitting at opacity:0 (its
			   animation-delay hasn't ended yet), so for that whole 0.2s window
			   nothing in the old/new pair is opaque. What shows through is
			   whatever's behind them — and Chromium's UA stylesheet gives
			   ::view-transition-group(root) no background-color of its own, so
			   that gap defaults to white instead of our page background. Result:
			   every single navigation fades to a flash of white instead of to
			   black before the new page blurs in. Setting it explicitly here is
			   the fix — this is the same root ancestor both old and new paint
			   on top of, so it covers the gap regardless of which one is
			   transparent at any given moment. */
			::view-transition-group(root) {
				background-color: rgb(var(--c-bg));
			}

			/* Root page transition — same fade-out/blur-in as before, just
			   tightened (~60% of the original durations/delay) so navigating
			   feels snappier without changing the style of the transition. */
			::view-transition-old(root) {
				animation: vt-fade-out 0.2s ease-in both;
			}
			::view-transition-new(root) {
				animation: vt-blur-in 0.32s ease-out 0.2s both;
			}

			/* Touch devices: no blur at all, just a fade (see vt-fade-in-mobile) —
			   full-viewport blur on a page snapshot is expensive on weaker GPUs,
			   caused scroll stutter right after navigation, and greys out the black.
			   Keyed off pointer type, not viewport width — a landscape tablet is
			   easily >1024px wide but still has a phone-class GPU, so a width-only
			   query here was quietly giving tablets the heavy desktop blur and
			   flickering right through it. */
			@media (pointer: coarse) {
				::view-transition-new(root) {
					animation: vt-fade-in-mobile 0.25s ease-out 0.15s both;
				}
			}

			/* Fallback for browsers with no native Cross-Document View
			   Transitions support (e.g. Safari on iOS 17) — Astro's router
			   still runs its own "animate" fallback in that case (the
			   default; see ClientRouter's fallback prop), but that mode
			   works completely differently from the native path above: it
			   never creates any ::view-transition-*(root) pseudo-elements at
			   all. Instead it sets data-astro-transition-fallback="old" on
			   <html> right before the swap and ="new" right after, then
			   waits for whatever CSS animation that triggers to finish
			   before continuing — see animate()/animateFallbackOld() in
			   astro/dist/transitions/router.js. We never gave it one, so
			   that wait resolved instantly and every navigation on those
			   browsers was a hard, unanimated cut — the missing blur-in and
			   the flaky page-transition behavior reported there. Targeting
			   body (not html itself, like the native rule targets root)
			   because <html> already carries its own permanent black
			   background (see the inline style on the <html> tag above) —
			   fading html's own opacity would fade that background away
			   too and flash the browser's default white canvas through, the
			   same problem ::view-transition-group(root) above exists to
			   avoid on the native path. Fading body instead leaves html's
			   black behind it untouched. */
			html[data-astro-transition-fallback="old"] body {
				animation: vt-fade-out 0.2s ease-in both;
			}
			html[data-astro-transition-fallback="new"] body {
				animation: vt-blur-in 0.32s ease-out 0.2s both;
			}
			@media (pointer: coarse) {
				html[data-astro-transition-fallback="new"] body {
					animation: vt-fade-in-mobile 0.25s ease-out 0.15s both;
				}
			}

			/* iOS Safari 26+ tints the status-bar strip and the area behind
			   its floating URL bar from whatever fixed element touches that
			   screen edge; with none, it shows page content scrolling through
			   them instead. These two always-present black edge strips make
			   Safari paint both areas solid black (like phantom.land), so the
			   page reads as a framed screen between two black bars at all
			   times — not only while the menu is open. iOS-only
			   (-webkit-touch-callout exists nowhere else).
			   Height matters: WebKit samples 4-6px in from the viewport edge
			   and ignores any box 10px tall or less
			   (LocalFrameView::fixedContainerEdges — sampleRectMargin = 4,
			   thinBorderWidth = 10), so the strips must be taller than that.
			   Once Safari picks them up, the black bars it paints run straight
			   into them, so they read as part of the bars. */
			/* Scroll-under blur behind the logo/top CTA (same recipe as
			   phantom.land's header): content scrolling up under it blurs
			   and fades out toward the top edge. z-index 998 — above page
			   content, below the menu overlay (999) and the logo/CTA (1002).
			   Deliberately a single short strip: backdrop-filter over
			   scrolling content is expensive on iOS Safari, and cost scales
			   with the filtered area. */
			.top-blur {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				height: 104px;
				z-index: 998;
				pointer-events: none;
				-webkit-backdrop-filter: blur(26px);
				backdrop-filter: blur(26px);
				-webkit-mask: linear-gradient(#000, rgba(0, 0, 0, 0.6) 75%, transparent);
				mask: linear-gradient(#000, rgba(0, 0, 0, 0.6) 75%, transparent);
			}

			@supports (-webkit-touch-callout: none) {
				.edge-tint {
					position: fixed;
					left: 0;
					right: 0;
					height: 12px;
					background: rgb(var(--c-bg));
					z-index: 10000;
				}
				.edge-tint--top { top: 0; }
				.edge-tint--bottom { bottom: 0; }
			}

		</style>
	</head>
	<body class="text-white">
		<div class="edge-tint edge-tint--top" aria-hidden="true"></div>
		<div class="edge-tint edge-tint--bottom" aria-hidden="true"></div>
		<div class="top-blur" aria-hidden="true"></div>
		<GridLines />
		<Logo />
		<TopBarCta />
		<OxygenMenu />
		<ContactModal />
		<slot />
		<Footer />
	</body>
</html>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { isSafari } from '../utils/isSafari';
  import '../utils/afterPageTransition';

  let _layoutLenis: Lenis | null = null;
  let _layoutRaf: ((t: number) => void) | null = null;

  function initLayoutLenis() {
    // Poczekaj jeden frame — strony które mają własny Lenis (index, winds-of-sinai)
    // zdążą ustawić window.__lenis przed tym sprawdzeniem
    requestAnimationFrame(() => {
      // Those pages deliberately set __lenis to null on touch — "native
      // scroll on mobile, zero jank next to the WebGL hero" — but null is
      // falsy, so a plain `if (__lenis) return` here couldn't tell "no page
      // Lenis exists yet" apart from "a page explicitly chose no Lenis" and
      // created one anyway, undoing that choice: mobile Home/Winds Of Sinai
      // ended up running this fallback Lenis's own rAF loop competing with
      // native scroll after all, which is a well-matched cause for Safari-
      // only jank (WebKit tends to handle a competing scroll-linked rAF
      // loop worse than Chromium does) that no amount of tuning the scrolled
      // content itself was ever going to fix. __lenisHandled is the
      // explicit "a page already decided" signal those pages also set;
      // check it first.
      if ((window as any).__lenisHandled || (window as any).__lenis) return;

      const isTouch = window.matchMedia('(pointer: coarse)').matches;
      // Mobile Safari specifically: skip Lenis entirely rather than the
      // reduced-motion config below. Safari's own compositor handles a
      // competing scroll-linked rAF loop worse than Chromium's does, and
      // this fallback path exists for pages that never opted into any
      // particular scroll behavior — native scroll is the safe default
      // there, same as index.astro/winds-of-sinai.astro already choose for
      // themselves on all touch devices, not just Safari.
      if (isTouch && isSafari()) {
        (window as any).__lenis = null;
        return;
      }

      _layoutLenis = new Lenis(isTouch ? {
        duration: 0.7,
        easing: (t: number) => 1 - Math.pow(1 - t, 2.4),
        smoothWheel: false,
        touchMultiplier: 1.8,
      } : {
        duration: 2.4,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        wheelMultiplier: 0.65,
      });

      (window as any).__lenis = _layoutLenis;
      _layoutRaf = (t: number) => _layoutLenis?.raf(t * 1000);
      gsap.ticker.add(_layoutRaf);
      gsap.ticker.lagSmoothing(0);
    });
  }

  function destroyLayoutLenis() {
    // Runs on every navigation regardless of which page's own script set
    // __lenisHandled (this listener is the one thing guaranteed to exist on
    // every page) — clearing it here means the NEXT page, if it doesn't set
    // its own Lenis choice, still correctly falls through to this file's
    // fallback instead of inheriting a stale "already decided" flag from
    // whatever page you navigated away from.
    (window as any).__lenisHandled = false;
    if (!_layoutLenis) return;
    if ((window as any).__lenis === _layoutLenis) (window as any).__lenis = null;
    if (_layoutRaf) { gsap.ticker.remove(_layoutRaf); _layoutRaf = null; }
    _layoutLenis.destroy();
    _layoutLenis = null;
  }

  document.addEventListener('astro:page-load', initLayoutLenis);
  document.addEventListener('astro:before-swap', destroyLayoutLenis);

  // Persistent site chrome (logo, top-bar CTA, menu button, desktop
  // contact icons — see the view-transition-name rules in global.css):
  // their entrance animations play once, on the first page of the visit.
  // Flipped after that first page-load's handlers have all run, so they
  // still see `false` and animate.
  document.addEventListener('astro:page-load', () => {
    setTimeout(() => { (window as any).__ptShellShown = true; }, 0);
  }, { once: true });

  // Persistent site chrome: logo, top-bar CTA, menu button, and on desktop
  // the contact icons, location label and clock are pulled out of the root page fade/blur during a page
  // transition, so they stay put while only the page content changes.
  // Named only WHILE a transition runs — a permanent view-transition-name
  // makes the element a backdrop root, which would blank the glass
  // (backdrop-filter) of the buttons inside it the rest of the time. Set
  // from JS, not an html:active-view-transition CSS rule: WebKit captures
  // the old page before that pseudo-class starts matching, so on Safari
  // the chrome was still in the old snapshot and faded with the page.
  // after-preparation fires right before startViewTransition(); after-swap
  // names the new page's copies (inline styles on the transition:persist
  // ones carry over by themselves).
  const CHROME_NAMES: Record<string, string> = {
    'h-title': 'pt-logo',
    'site-cta-wrap': 'pt-top-cta',
    'hud-menu-btn': 'pt-menu-btn',
    'hud-right-col': 'pt-contact-col',
    'hud-location': 'pt-location',
    'hud-time': 'pt-clock',
  };
  function nameChrome(on: boolean) {
    for (const [id, name] of Object.entries(CHROME_NAMES)) {
      const el = document.getElementById(id);
      if (el) el.style.viewTransitionName = on ? name : '';
    }
  }
  document.addEventListener('astro:after-preparation', () => nameChrome(true));
  document.addEventListener('astro:before-swap', (e) => {
    // Desktop location label + clock: make the incoming copies visible and
    // already showing the current time BEFORE they're inserted — they'd
    // otherwise run their 0.6s CSS opacity transition from 0, and show
    // "--:--" until oxygenMenu's page-load tick, on the live new snapshot.
    if ((window as any).__ptShellShown) {
      const loc = e.newDocument.getElementById('hud-location');
      if (loc) loc.style.opacity = '1';
      const time = e.newDocument.getElementById('hud-time');
      if (time) {
        time.style.opacity = '1';
        time.textContent = document.getElementById('hud-time')?.textContent ?? time.textContent;
      }
    }
    const done = e.viewTransition?.finished;
    if (done) done.then(() => nameChrome(false), () => nameChrome(false));
    else nameChrome(false);
  });
  document.addEventListener('astro:after-swap', () => nameChrome(true));

  // Border beams (.hud-spin-border::before, `global-spin` 4s) on the
  // chrome buttons: re-inserting an element restarts its CSS animations,
  // and the swap re-inserts even the transition:persist menu button — the
  // beam snapped back to its start on every navigation. Lock the phase to
  // the document timeline (which keeps running across client-side
  // navigations) on first load and after every swap, so it just carries on.
  const SPIN_PERIOD = 4000;
  function syncChromeBeams() {
    const now = document.timeline.currentTime;
    if (typeof now !== 'number') return;
    for (const id of ['hud-menu-btn', 'hud-right-col']) {
      document.getElementById(id)?.getAnimations({ subtree: true }).forEach((a) => {
        if ((a as CSSAnimation).animationName === 'global-spin') a.currentTime = now % SPIN_PERIOD;
      });
    }
  }
  document.addEventListener('astro:page-load', syncChromeBeams, { once: true });
  document.addEventListener('astro:after-swap', syncChromeBeams);

  // On navigations, make the (freshly swapped-in) HUD visible right away,
  // before the browser captures the new page for the transition — the
  // menu button / contact icons then stay put instead of fading in again.
  // after-swap runs inside the transition's update callback, i.e. before
  // that capture; astro:page-load would be too late.
  document.addEventListener('astro:after-swap', () => {
    if (!(window as any).__ptShellShown) return;
    const hud = document.getElementById('ox-hud-mobile');
    if (hud) gsap.set(hud, { opacity: 1, y: 0 });
    const rightCol = document.getElementById('hud-right-col');
    if (rightCol) gsap.set(rightCol, { opacity: 1, x: 0 });
    const time = document.getElementById('hud-time');
    if (time) gsap.set(time, { opacity: 1 });
    const loc = document.getElementById('hud-location');
    if (loc) loc.style.opacity = '1';
  });
</script>
