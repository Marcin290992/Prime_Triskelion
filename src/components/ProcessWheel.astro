---
// The Process, desktop: a pinned stage with a fixed centre; the five steps
// ride in as tiles that seem to sit on a wheel around it. The mechanism is
// the services section of trionn.com, rebuilt without dependencies:
//   · tiles ride in one at a time, alternating sides — the left one rises from
//     the bottom, the right one falls from the top — each swinging in from its
//     side along a half sine, so they turn like a wheel; with room between
//     them, so only two are ever on screen together;
//   · tiles follow the scroll with a soft lag, not a hard scrub;
//   · a tile's rule draws itself once the tile is 30% along its path.
// Phones and tablets keep the stacked cards (.pstack in ShowcaseSection).
//
//   <ProcessWheel steps={steps} center="image" />
//
// `center` is what stands still in the middle: 'image' (the current step's own
// picture — 1, then 2, ...) or 'number' (its big number).
import { Image } from 'astro:assets';

interface Props {
	steps: { title: string; desc: string; img: ImageMetadata }[];
	center?: 'number' | 'image';
}
const { steps, center = 'image' } = Astro.props;
// Steps ride in one at a time, alternating sides: 1 on the left, 2 on the right, ...
---

<div class="pw" id="process-wheel" data-center={center} data-count={steps.length}>
	<div class="pw__stage">
		<h2 class="pw__title">The <em>Process.</em></h2>

		<div class="pw__field">
			<div class="pw__core" aria-hidden="true">
				{center === 'number' && (
					<div class="pw__bignums">
						{steps.map((_, i) => <span class:list={['pw__bignum', i === 0 && 'is-active']} data-i={i}>{String(i + 1).padStart(2, '0')}</span>)}
					</div>
				)}
				{center === 'image' && (
					<div class="pw__pics">
						{steps.map((st, i) => (
							<Image class:list={['pw__pic', i === 0 && 'is-active']} data-i={i} src={st.img} alt="" widths={[800, 1200]} sizes="(min-width: 1900px) 700px, 480px" />
						))}
					</div>
				)}
			</div>

			<div class="pw__cards">
				{steps.map((st, i) => (
					<article class="pw-card" data-i={i} data-side={i % 2 === 0 ? 'left' : 'right'}>
						<div class="pw-card__top">
							<span class="pw-card__num">{String(i + 1).padStart(2, '0')}</span>
						</div>
						<span class="pw-card__rule"></span>
						<h3 class="pw-card__title">{st.title}</h3>
						<p class="pw-card__desc">{st.desc}</p>
					</article>
				))}
			</div>
		</div>

		<!-- Comes up once the last step has settled: the way on, in the same line-and-label style as See more. -->
		<a class="pw__cta" href="/contact">
			<span class="pw__cta-line"></span>
			Start a project
		</a>

		<p class="pw__count" aria-hidden="true"><span class="pw__count-now">01</span> / {String(steps.length).padStart(2, '0')}</p>
	</div>
</div>

<style>
	/* Desktop only (a real mouse, wide screen); everyone else has the stacked cards. */
	.pw { display: none; }
	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		.pw {
			display: block;
			position: relative;
			/* Fallback; the script sets the exact height from the pair timing. */
			height: 480vh;
		}
		.pw__stage {
			position: sticky;
			top: 0;
			height: 100vh;
			overflow: hidden;
			background: rgb(var(--c-bg));
			/* The title's own band at the top, and the band at the bottom where the
			   fixed MENU button lives: the animated field sits between them, so the
			   picture can never run under the title, on any screen height. */
			--pw-top: calc(clamp(5.5rem, 6vw, 7rem) + clamp(1.6rem, 2.6vw, 3rem) + 1.75rem);
			--pw-bottom: clamp(124px, 16vh, 150px);
			/* The picture is 4:3: as wide as the middle gap allows, and never taller than the field. */
			--pw-pic: min(27vw, calc((100vh - var(--pw-top) - var(--pw-bottom)) * 0.86 * 4 / 3));
		}
		/* Under the fixed logo / top blur band. */
		.pw__title {
			position: absolute;
			z-index: 5;
			top: calc(clamp(5.5rem, 6vw, 7rem) + 0.25rem);
			left: 0;
			right: 0;
			margin: 0;
			text-align: center;
			font-family: var(--f-display);
			font-weight: 600;
			font-size: clamp(1.6rem, 2.6vw, 3rem);
			line-height: 1;
			letter-spacing: -0.01em;
			text-transform: uppercase;
			color: rgb(var(--c-cream));
			pointer-events: none;
		}
		.pw__title em { font-style: normal; color: rgb(var(--c-red)); }
		/* The animated area: everything but the band where the fixed MENU button lives. */
		.pw__field {
			position: absolute;
			inset: var(--pw-top) 0 var(--pw-bottom) 0;
		}
		.pw__core {
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			pointer-events: none;
		}

		/* ── centre: the big number ── */
		.pw__bignums { position: relative; width: 40vw; height: calc(var(--pw-pic) * 3 / 4); }
		.pw__bignum {
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			font-family: var(--f-display);
			font-weight: 700;
			font-size: clamp(8rem, min(20vw, 38vh), 22rem);
			line-height: 1;
			color: rgb(var(--c-cream) / 0.1);
			opacity: 0;
			transform: scale(0.96);
			transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.pw__bignum.is-active { opacity: 1; transform: none; }

		/* ── centre: the picture ── */
		.pw__pics { position: relative; width: var(--pw-pic); aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid rgb(var(--c-cream) / 0.1); background: #060608; }
		.pw__pic {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			filter: grayscale(100%) contrast(1.1) brightness(0.78);
			opacity: 0;
			transition: opacity 0.7s ease;
		}
		.pw__pic.is-active { opacity: 1; }

		/* ── the tiles ── */
		.pw__cards { position: absolute; inset: 0; }
		.pw-card {
			position: absolute;
			left: 0;
			top: 0;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: clamp(1rem, 1.6vw, 1.8rem);
			box-sizing: border-box;
			opacity: 0;
			will-change: transform, opacity;
			color: rgb(var(--c-cream));
		}
		/* The tile of the step that is not current (the one leaving) is dimmed. */
		.pw-card > * { transition: opacity 0.5s ease; }
		.pw-card:not(.is-current) > * { opacity: 0.3; }
		.pw-card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
		.pw-card__num {
			font-family: var(--f-display);
			font-weight: 700;
			font-size: clamp(2rem, 3.2vw, 3.6rem);
			line-height: 1;
			color: rgb(var(--c-red));
		}
		/* Draws itself once the tile is 30% along its path. */
		.pw-card__rule {
			display: block;
			height: 1px;
			margin: 0.9rem 0;
			background: rgb(var(--c-cream) / 0.35);
			transform: scaleX(0);
			transform-origin: left;
			transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.pw-card.is-drawn .pw-card__rule { transform: scaleX(1); }
		.pw-card__title {
			margin: 0 0 0.6rem;
			font-family: var(--f-display);
			font-weight: 600;
			font-size: clamp(1.4rem, 2.2vw, 2.5rem);
			line-height: 1.02;
			letter-spacing: -0.01em;
			text-transform: uppercase;
		}
		.pw-card__desc {
			margin: 0;
			max-width: 36ch;
			font-family: var(--f-body);
			font-size: clamp(0.8rem, 0.95vw, 1.05rem);
			font-weight: 300;
			line-height: 1.6;
			color: rgb(var(--c-cream) / 0.72);
		}

		.pw__cta {
			position: absolute;
			z-index: 6;
			left: 50%;
			bottom: calc(var(--pw-bottom) + 0.4rem);
			display: inline-flex;
			align-items: center;
			gap: 1rem;
			font-family: var(--f-body);
			font-size: clamp(0.75rem, 1.1vw, 0.9rem);
			font-weight: 300;
			letter-spacing: 0.38em;
			text-transform: uppercase;
			white-space: nowrap;
			color: rgb(var(--c-cream) / 0.7);
			text-decoration: none;
			opacity: 0;
			transform: translate(-50%, 10px);
			pointer-events: none;
			transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
		}
		.pw__cta.is-shown { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
		.pw__cta:hover { color: rgb(var(--c-cream) / 0.95); }
		.pw__cta-line { display: block; width: 36px; height: 1px; background: rgb(var(--c-red) / 0.9); transition: width 0.35s ease; flex-shrink: 0; }
		.pw__cta:hover .pw__cta-line { width: 56px; }

		.pw__count {
			position: absolute;
			left: var(--site-gutter);
			bottom: clamp(2.6rem, 5vh, 3.4rem);
			margin: 0;
			font-family: var(--f-body);
			font-size: 11px;
			letter-spacing: 0.28em;
			color: rgb(var(--c-cream) / 0.45);
		}
		.pw__count-now { color: rgb(var(--c-cream)); }
	}
</style>

<script>
	import { onReady } from '../utils/onReady';

	// Scroll lengths, in screen heights (vh), while the section stays pinned.
	const LEAD_VH = 0; // step 01 is already beside the picture when the section arrives
	const TAIL_VH = 25; // a calm moment after the last tile leaves
	const CARDS_VH = 320;
	// One tile at a time, alternating sides: each travels for 0.5 of the run,
	// and the next starts 0.30 later — so mostly one is on screen, and only briefly two.
	const STEP_GAP = 0.30;
	const STEP_RUN = 0.5;
	// The run starts with step 1 already at rest beside the picture (half-way along its path).
	const T_START = 0.5 * STEP_RUN;
	// A tile's rule draws itself once the tile is 30% along its path.
	const DRAW_AT = 0.3;

	const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
	const fadeAt = (a: number) => (a < 0.15 ? a / 0.15 : a > 0.85 ? 1 - (a - 0.85) / 0.15 : 1);

	let _cleanup: (() => void) | null = null;

	function init() {
		_cleanup?.();
		_cleanup = null;
		const track = document.getElementById('process-wheel');
		if (!track || getComputedStyle(track).display === 'none') return;
		const cards = Array.from(track.querySelectorAll<HTMLElement>('.pw-card'));
		const field = track.querySelector<HTMLElement>('.pw__field')!;
		const cta = track.querySelector<HTMLElement>('.pw__cta');
		const nowEl = track.querySelector<HTMLElement>('.pw__count-now');
		const bigNums = Array.from(track.querySelectorAll<HTMLElement>('.pw__bignum'));
		const pics = Array.from(track.querySelectorAll<HTMLElement>('.pw__pic'));
		const dimensions = { W: 0, H: 0, cw: 0, ch: 0, lead: 0, cardsPx: 0, leftRest: 0, rightRest: 0 };
		const centre = track.querySelector<HTMLElement>('.pw__pics, .pw__bignums');

		const layout = () => {
			const stageH = window.innerHeight;
			dimensions.W = field.clientWidth;
			dimensions.H = field.clientHeight;
			dimensions.cw = Math.round(0.28 * dimensions.W);
			dimensions.ch = Math.round(0.34 * dimensions.H);
			cards.forEach((el) => { el.style.width = `${dimensions.cw}px`; el.style.height = `${dimensions.ch}px`; });
			// Where the tiles come to rest: the same gap from the picture on both
			// sides. A tile's text starts one padding inside its edge, so the tile
			// itself sits that much closer to the picture.
			const pad = cards[0] ? parseFloat(getComputedStyle(cards[0]).paddingLeft) || 0 : 0;
			const gap = clamp(0.035 * dimensions.W, 32, 64);
			const picW = centre ? centre.offsetWidth : 0.27 * dimensions.W;
			const picLeft = (dimensions.W - picW) / 2;
			dimensions.leftRest = picLeft - gap - dimensions.cw + pad;
			dimensions.rightRest = picLeft + picW + gap - pad;
			dimensions.lead = (LEAD_VH / 100) * stageH;
			dimensions.cardsPx = (CARDS_VH / 100) * stageH;
			track.style.height = `${stageH + dimensions.lead + dimensions.cardsPx + (TAIL_VH / 100) * stageH}px`;
		};

		let active = -1; // the first call (below) marks step 1 as current
		const setActive = (i: number) => {
			if (i === active) return;
			active = i;
			bigNums.forEach((el, k) => el.classList.toggle('is-active', k === i));
			pics.forEach((el, k) => el.classList.toggle('is-active', k === i));
			if (nowEl) nowEl.textContent = String(i + 1).padStart(2, '0');
			cards.forEach((el, k) => el.classList.toggle('is-current', k === i));
		};

		const place = (el: HTMLElement, x: number, y: number, opacity: number) => {
			if (opacity <= 0) {
				el.style.opacity = '0';
				el.style.transform = 'translate3d(0,0,0)';
				return;
			}
			el.style.opacity = opacity.toFixed(4);
			el.style.transform = `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0)`;
		};

		const render = (p: number) => {
			const { W, H, cw, ch } = dimensions;
			const t = T_START + p * (STEP_GAP * (cards.length - 1) + STEP_RUN - T_START);
			// Where each side settles at the middle of its path (see layout()).
			const { leftRest, rightRest } = dimensions;
			const leftFrom = -0.7 * cw;
			const rightFrom = W - 0.3 * cw;
			let best = -1;
			let bestOp = 0.2; // a step becomes "current" once it's at least this visible
			cards.forEach((el, i) => {
				const left = i % 2 === 0;
				const start = STEP_GAP * i;
				const a = (t - start) / STEP_RUN;
				if (t >= start + DRAW_AT * STEP_RUN) el.classList.add('is-drawn');
				else if (t < start) el.classList.remove('is-drawn');
				if (a <= 0 || a >= 1) { place(el, 0, 0, 0); return; }
				// Swing in from the side along a half sine during the first half, then hold the line.
				const swing = a <= 0.5 ? Math.sin(a * Math.PI) : 1;
				const op = fadeAt(a);
				// The left tile rises from below, the right one falls from above: together they turn like a wheel.
				if (left) place(el, leftFrom + swing * (leftRest - leftFrom), H + a * (-ch - H), op);
				else place(el, rightFrom + swing * (rightRest - rightFrom), -ch + a * (H + ch), op);
				if (op > bestOp) { bestOp = op; best = i; }
			});
			if (best >= 0) setActive(best);
			// The way on appears once the last step is past the middle of its path.
			const lastStart = STEP_GAP * (cards.length - 1);
			cta?.classList.toggle('is-shown', t >= lastStart + 0.6 * STEP_RUN);
		};

		// Scroll progress through the cards' stretch (0–1).
		const target = () => clamp((-track.getBoundingClientRect().top - dimensions.lead) / dimensions.cardsPx, 0, 1);

		// Tiles follow the scroll with a soft lag (8% of the gap per 60 Hz frame),
		// and the loop stops when they have caught up or the section is off screen.
		let cur = 0;
		let raf = 0;
		let last = 0;
		let near = false;
		const tick = (now: number) => {
			raf = 0;
			const dt = last ? Math.min(64, now - last) : 16.667;
			last = now;
			const tg = target();
			cur += (tg - cur) * (1 - Math.pow(1 - 0.08, dt / 16.667));
			if (Math.abs(tg - cur) < 0.00005) cur = tg;
			render(cur);
			if (near && cur !== tg) raf = requestAnimationFrame(tick);
			else last = 0;
		};
		const wake = () => { if (near && !raf) raf = requestAnimationFrame(tick); };

		layout();
		setActive(0);
		cur = target();
		render(cur);
		const io = new IntersectionObserver(([en]) => { near = en.isIntersecting; wake(); }, { rootMargin: '25% 0px' });
		io.observe(track);
		const onResize = () => { layout(); render(cur); wake(); };
		window.addEventListener('scroll', wake, { passive: true });
		window.addEventListener('resize', onResize);
		_cleanup = () => {
			io.disconnect();
			window.removeEventListener('scroll', wake);
			window.removeEventListener('resize', onResize);
			if (raf) cancelAnimationFrame(raf);
		};
	}

	onReady(init);
	document.addEventListener('astro:before-swap', () => { _cleanup?.(); _cleanup = null; });
</script>
