---
---

<div id="contact-modal-overlay" class="cm-overlay" aria-hidden="true">
  <div class="cm-panel" role="dialog" aria-modal="true" aria-labelledby="cm-title">
    <button type="button" class="cm-close" id="cm-close-btn" aria-label="Close">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <h2 id="cm-title" class="cm-title">Get in touch</h2>

    <form id="cm-form" class="cm-form" novalidate>
      <div class="cm-field">
        <label for="cm-name" class="cm-label">Full Name <span class="cm-req" aria-hidden="true">*</span></label>
        <input type="text" id="cm-name" name="name" class="cm-input" placeholder="First &amp; Last Name" autocomplete="name" required />
      </div>
      <div class="cm-field">
        <label for="cm-email-input" class="cm-label">Email <span class="cm-req" aria-hidden="true">*</span></label>
        <input type="email" id="cm-email-input" name="email" class="cm-input" placeholder="hello@yourcompany.com" autocomplete="email" required />
      </div>
      <div class="cm-field">
        <label for="cm-message" class="cm-label">Tell me more <span class="cm-req" aria-hidden="true">*</span></label>
        <textarea id="cm-message" name="message" class="cm-textarea" rows="3" placeholder="Describe your project, goals, timeline…" required></textarea>
      </div>
      <button type="submit" class="cm-submit" id="cm-submit-btn">
        <span class="hud-spin-border"></span>
        <span class="cm-submit__label">Send message</span>
      </button>
      <p class="cm-status" id="cm-status" aria-live="polite"></p>
    </form>

    <div class="cm-divider" role="separator" aria-label="or reach me directly"><span>or reach me directly</span></div>

    <div class="cm-channels">
      <a href="tel:+44YOURPHONE" class="cm-channel">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>+44 YOUR PHONE</span>
      </a>
      <a href="https://wa.me/YOURPHONE" class="cm-channel" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<style>
  .cm-overlay {
    position: fixed;
    inset: 0;
    z-index: 9500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .cm-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .cm-panel {
    position: relative;
    isolation: isolate;
    width: min(100%, 380px);
    max-height: calc(100vh - 3rem);
    /* dvh (not vh) accounts for the on-screen keyboard shrinking the
       visible viewport on mobile — without it the panel keeps sizing
       itself to the full, keyboard-ignorant page height and can end up
       taller than what's actually visible above the keyboard. Declared
       after the vh version so browsers without dvh support just keep
       that one (an unknown unit makes the whole declaration invalid,
       not zero). */
    max-height: calc(100dvh - 3rem);
    overflow-y: auto;
    /* Lets the panel's own internal scroll move freely (momentum scrolling
       included) without that reaching the boundary and "chaining" into the
       page behind it — the JS lock above already blocks touchmove outside
       the panel, but without this, scrolling to the very top/bottom of the
       panel's own content and continuing the drag could still rubber-band
       or scroll whatever's behind the overlay. */
    overscroll-behavior: contain;
    padding: 1.75rem;
    background: rgb(var(--c-bg) / 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    transform: translateY(12px) scale(0.98);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cm-overlay.active .cm-panel {
    transform: translateY(0) scale(1);
  }

  .cm-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: rgba(255, 255, 255, 0.6);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .cm-close:hover {
    color: #fff;
    border-color: rgb(var(--c-red) / 0.45);
  }

  .cm-title {
    margin: 0 0 1.25rem;
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }

  .cm-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .cm-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cm-label {
    font-family: var(--f-body);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.45);
  }
  .cm-req { color: rgb(var(--c-red) / 0.9); }

  .cm-input,
  .cm-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.85rem;
    font-family: var(--f-body);
    font-size: 0.85rem;
    color: rgb(var(--c-cream) / 0.92);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .cm-input::placeholder,
  .cm-textarea::placeholder {
    color: rgb(var(--c-cream) / 0.4);
  }
  .cm-input:focus,
  .cm-textarea:focus {
    outline: none;
    border-color: rgb(var(--c-red) / 0.5);
    background: rgba(255, 255, 255, 0.05);
  }
  .cm-textarea {
    resize: vertical;
    min-height: 4.5rem;
  }

  .cm-submit {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 0.15rem;
    padding: 0.75rem 1rem;
    font-family: var(--f-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .cm-submit:hover {
    color: #fff;
    border-color: rgb(var(--c-red) / 0.45);
    background: rgb(var(--c-red) / 0.08);
  }
  .cm-submit:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .cm-status {
    margin: 0;
    min-height: 1.1em;
    font-family: var(--f-body);
    font-size: 0.75rem;
  }
  .cm-status--ok  { color: rgba(74, 222, 128, 0.85); }
  .cm-status--err { color: rgb(var(--c-red) / 0.85); }

  .cm-divider {
    position: relative;
    margin: 1.4rem 0 1rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cm-divider span {
    position: relative;
    top: -0.55em;
    padding: 0 0.6em;
    background: rgb(var(--c-bg));
    font-family: var(--f-body);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.4);
  }

  .cm-channels {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cm-channel {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.75rem;
    font-family: var(--f-body);
    font-size: 0.82rem;
    color: rgb(var(--c-cream) / 0.75);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .cm-channel:hover {
    color: #fff;
    border-color: rgb(var(--c-red) / 0.4);
    background: rgb(var(--c-red) / 0.06);
  }
</style>

<script>
  import { sendContactEmail } from '../utils/sendContactEmail';

  // Simple but real check: something@something.tld — not just "non-empty".
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function initContactModal() {
    const overlay = document.getElementById('contact-modal-overlay');
    const closeBtn = document.getElementById('cm-close-btn');
    // Shared trigger class, not a single id — the desktop dock's email
    // button and the mobile contact flyout's email button both open this
    // same modal, and can't both carry id="hud-email-btn".
    const openBtns = document.querySelectorAll<HTMLElement>('.hud-contact-modal-trigger');
    const form = document.getElementById('cm-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('cm-submit-btn') as HTMLButtonElement | null;
    const status = document.getElementById('cm-status');
    if (!overlay || !form || !status) return;

    const panel = overlay.querySelector<HTMLElement>('.cm-panel');
    let lastFocused: HTMLElement | null = null;
    let isOpen = false;
    let releaseScrollLock: (() => void) | null = null;

    function getLenis() {
      return (window as any).__lenis;
    }

    // Body overflow alone doesn't stop scrolling here (Lenis drives the
    // actual scroll independently of native overflow), so — same approach
    // as OxygenMenu's menu overlay — block wheel/touch/key scroll directly,
    // except when it targets something inside the modal panel itself.
    function createScrollLockRelease() {
      const scrollKeys = new Set([' ', 'PageUp', 'PageDown', 'Home', 'End', 'ArrowUp', 'ArrowDown']);
      // PageUp/PageDown do nothing inside a plain input/textarea, so letting them
      // through whenever a form field happens to be focused (which it always is
      // right after opening, since the first field auto-focuses) just falls
      // through to the browser's native page-scroll. Only Home/End/arrows/space
      // get the "focused in a field" exemption — those have real text-editing meaning.
      const alwaysBlockedKeys = new Set(['PageUp', 'PageDown']);
      const insidePanel = (target: EventTarget | null) => target instanceof Node && !!panel?.contains(target);

      const onWheel = (e: WheelEvent) => { if (isOpen && !insidePanel(e.target)) e.preventDefault(); };
      const onTouchMove = (e: TouchEvent) => { if (isOpen && !insidePanel(e.target)) e.preventDefault(); };
      const onKeyScroll = (e: KeyboardEvent) => {
        if (!isOpen || !scrollKeys.has(e.key)) return;
        if (alwaysBlockedKeys.has(e.key) || !insidePanel(e.target)) e.preventDefault();
      };

      window.addEventListener('wheel', onWheel, { passive: false, capture: true });
      window.addEventListener('touchmove', onTouchMove, { passive: false, capture: true });
      document.addEventListener('keydown', onKeyScroll, { capture: true });

      return () => {
        window.removeEventListener('wheel', onWheel, true);
        window.removeEventListener('touchmove', onTouchMove, true);
        document.removeEventListener('keydown', onKeyScroll, true);
      };
    }

    function openModal() {
      isOpen = true;
      lastFocused = document.activeElement as HTMLElement | null;
      overlay!.classList.add('active');
      overlay!.setAttribute('aria-hidden', 'false');
      getLenis()?.stop();
      releaseScrollLock = createScrollLockRelease();
      const firstField = form!.querySelector<HTMLElement>('input, textarea');
      setTimeout(() => firstField?.focus(), 350);
    }

    function closeModal() {
      isOpen = false;
      overlay!.classList.remove('active');
      overlay!.setAttribute('aria-hidden', 'true');
      getLenis()?.start();
      releaseScrollLock?.();
      releaseScrollLock = null;
      lastFocused?.focus();
    }

    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay!.classList.contains('active')) closeModal();
    });

    // Mobile: the on-screen keyboard eats a big chunk of the (already
    // dvh-capped, see .cm-panel above) viewport, and the browser doesn't
    // reliably scroll a focused field inside a position:fixed panel into
    // the space that's left — so the field being typed into can end up
    // hidden behind the keyboard. Nudge it into view ourselves, once the
    // keyboard has actually finished animating in rather than mid-resize.
    form.addEventListener('focusin', (e) => {
      const field = e.target as HTMLElement;
      if (!field.matches('input, textarea')) return;
      setTimeout(() => field.scrollIntoView({ block: 'center', behavior: 'smooth' }), 300);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'cm-status';

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        message: String(data.get('message') || '').trim(),
      };
      if (!payload.name || !payload.email || !payload.message) {
        status.textContent = 'Please fill in all fields.';
        status.classList.add('cm-status--err');
        return;
      }
      if (!EMAIL_PATTERN.test(payload.email)) {
        status.textContent = 'Please enter a valid email address.';
        status.classList.add('cm-status--err');
        form.querySelector<HTMLInputElement>('[name="email"]')?.focus();
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      status.textContent = 'Sending…';

      const ok = await sendContactEmail(payload);

      if (ok) {
        status.textContent = "Message sent — I'll get back to you soon.";
        status.classList.add('cm-status--ok');
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('cm-status--err');
      }
      if (submitBtn) submitBtn.disabled = false;
    });

    document.addEventListener('astro:before-swap', () => {
      if (overlay!.classList.contains('active')) closeModal();
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactModal);
  } else {
    initContactModal();
  }
  document.addEventListener('astro:page-load', initContactModal);
</script>
