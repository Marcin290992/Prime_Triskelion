---
/**
 * Preloader — "system boot" style gate: real-time percentage counter,
 * status readout, and a manual ENTER click to actually dismiss it (not an
 * auto-hide) — a deliberate ritual/beat before HeroSection's own reveal
 * timeline, not just a loading spinner.
 *
 * Shown once per browser tab session (sessionStorage-gated) — internal
 * navigation never re-triggers it. The percentage/status reflect real
 * readiness (fonts + window load + a minimum display time), never a fixed
 * fake timer — the one exception is MAX_MS, a safety ceiling that force-
 * enables ENTER if a font/asset load stalls, so a broken load can't trap
 * a visitor behind a screen with no way through.
 *
 * The #preloader div carries transition:persist — without it, Astro's
 * client-side router builds a BRAND NEW element from scratch on every
 * internal navigation (clicking the logo, a nav link, etc.), fully visible
 * by default, with no script left to ever hide it again (this one only
 * ever runs once, on the original element, at first load). Persisting
 * means the same element (already hidden after the visitor clicked ENTER)
 * just carries that state forward through every later page.
 */
---

<div id="preloader" transition:persist aria-hidden="true">
  <div class="pl-percent" id="pl-percent">0%</div>

  <div class="pl-status" id="pl-status">
    <span class="pl-status-line" id="pl-status-line">INITIALIZING_</span>
  </div>

  <div class="pl-controls">
    <button type="button" class="pl-btn pl-btn--enter" id="pl-enter" disabled aria-label="Enter site">Enter</button>
  </div>
</div>

<style is:global>
  /* is:global, not scoped — this component is the very first thing
     rendered in <body>, and Astro's dev-mode scoped-style injection (a JS
     module appending a <style> tag, rather than a blocking <link> —
     see the button reset comment in Layout.astro for the same class of
     issue) was apparently never catching up for it, leaving it
     permanently unstyled in dev with no console error. All selectors
     below are already uniquely prefixed (#preloader, .pl-*), so nothing
     is lost by dropping Astro's automatic scoping here. */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: rgb(var(--c-bg));
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.5s ease, filter 0.5s ease;
  }
  #preloader.is-hidden {
    opacity: 0;
    filter: blur(20px);
    pointer-events: none;
  }
  @media (pointer: coarse) {
    #preloader.is-hidden { filter: blur(8px); transition-duration: 0.35s; }
  }

  .pl-percent {
    position: absolute;
    top: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgb(var(--c-cream));
    font-variant-numeric: tabular-nums;
  }

  .pl-status {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    text-align: right;
  }
  .pl-status-line {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.4);
    white-space: nowrap;
  }
  .pl-status-line.is-ready { color: rgb(var(--c-red) / 0.85); }

  .pl-controls {
    position: absolute;
    left: 50%;
    bottom: clamp(3rem, 10vh, 6rem);
    transform: translateX(-50%);
    display: flex;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px;
  }
  .pl-btn {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--c-cream) / 0.5);
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: background 0.3s ease, color 0.3s ease, opacity 0.3s ease;
  }
  .pl-btn--enter {
    color: rgb(var(--c-cream) / 0.3);
    cursor: not-allowed;
  }
  .pl-btn--enter:not(:disabled) {
    color: rgb(var(--c-bg));
    background: rgb(var(--c-cream));
    cursor: pointer;
  }
  @media (hover: hover) {
    .pl-btn--enter:not(:disabled):hover { background: rgb(var(--c-red)); color: rgb(var(--c-cream)); }
  }

  @media (max-width: 640px) {
    .pl-percent { font-size: clamp(2.4rem, 12vw, 3.5rem); }
    .pl-controls { bottom: clamp(2.5rem, 12vh, 4rem); }
    .pl-btn { padding: 0.6rem 1rem; font-size: 10px; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'ptk-preloader-shown';
    var el = document.getElementById('preloader');
    if (!el) return;

    if (sessionStorage.getItem(KEY)) {
      el.hidden = true;
      return;
    }

    var percentEl = document.getElementById('pl-percent');
    var statusEl = document.getElementById('pl-status-line');
    var enterBtn = document.getElementById('pl-enter');

    // 1300ms floor — still a FLOOR, not a fake fixed duration (a real load
    // that takes longer still takes exactly as long as it takes, see the
    // Promise.all below). On a fast connection there's nothing to wait
    // for, but disappearing in under half a second read as an accidental
    // flicker rather than the deliberate beat this is meant to be.
    var MIN_MS = 1300;
    var MAX_MS = 8000; // ceiling — force ENTER available even if a font/asset load stalls
    var start = 0;
    var raf = 0;
    var ready = false;

    function setPercent(p) {
      var n = Math.round(p);
      if (percentEl) percentEl.textContent = n + '%';
    }

    // This is a PERCEIVED progress cue, not a byte-accurate measurement —
    // computing true combined progress across fonts/images/scripts isn't
    // practical. What's real is the actual ready condition below (fonts +
    // window load + MIN_MS), which is what this snaps to at 100%.
    function tick(now) {
      if (!start) start = now; // first rAF timestamp, not script-parse time —
      // using performance.now() at parse time instead measured from BEFORE
      // the browser's first paint, so the visible counter could already
      // read ~50% on its very first frame. Anchoring to the first rAF
      // callback's own timestamp keeps 0% actually visible at 0%.
      var elapsed = now - start;
      if (!ready) {
        setPercent(Math.min(96, (elapsed / MIN_MS) * 96));
      }
      if (elapsed < MAX_MS && !ready) raf = requestAnimationFrame(tick);
    }
    raf = requestAnimationFrame(tick);

    var fontsReady = (document.fonts && document.fonts.ready) || Promise.resolve();
    var windowLoaded = document.readyState === 'complete'
      ? Promise.resolve()
      : new Promise(function (resolve) { window.addEventListener('load', resolve, { once: true }); });
    var minTime = new Promise(function (resolve) { setTimeout(resolve, MIN_MS); });
    var safety = new Promise(function (resolve) { setTimeout(resolve, MAX_MS); });

    Promise.race([
      Promise.all([fontsReady, windowLoaded, minTime]),
      safety,
    ]).then(function () {
      ready = true;
      cancelAnimationFrame(raf);
      setPercent(100);
      if (statusEl) {
        statusEl.textContent = 'SYSTEM_READY';
        statusEl.classList.add('is-ready');
      }
      enterBtn.disabled = false;
      enterBtn.focus();
    });

    enterBtn.addEventListener('click', function () {
      if (enterBtn.disabled) return;
      el.classList.add('is-hidden');
      sessionStorage.setItem(KEY, '1');
      el.addEventListener('transitionend', function () { el.hidden = true; }, { once: true });
    });
  })();
</script>
