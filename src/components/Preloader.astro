---
/**
 * Preloader — bridges the gap between raw asset loading (fonts, hero
 * canvas/scripts) and HeroSection's own reveal timeline, so first-time
 * visitors never see a flash of unstyled text or an empty canvas before
 * that choreography can start.
 *
 * Shown once per browser tab session (sessionStorage-gated) — internal
 * navigation never re-triggers it. Hides only once fonts + window load +
 * a small minimum display time have all actually happened (see the script
 * below), never on a fixed fake timer — a safety timeout is the one
 * exception, purely so a stalled font/asset load can't trap a visitor
 * behind a black screen forever.
 *
 * The #preloader div carries transition:persist — without it, Astro's
 * client-side router builds a BRAND NEW element from scratch on every
 * internal navigation (clicking the logo, a nav link, etc.), fully visible
 * by default, with no script left to ever hide it again (this one only
 * ever runs once, on the original element, at first load). That read as
 * the preloader "freezing" back on for every subsequent navigation.
 * Persisting means the same element (already hidden after its one real
 * run) just carries that state forward through every later page.
 */
---

<div id="preloader" transition:persist aria-hidden="true">
  <svg class="preloader-mark" viewBox="128 152 744 644" fill="rgb(var(--c-cream))">
    <defs><polygon id="preloader-arm-shape" points="476.676,605.596 394.876,463.914 500.000,281.834 559.525,384.935 487.122,384.935 453.185,443.715 661.335,443.715 500.000,164.274 327.003,463.914 442.740,664.375"/></defs>
    <use href="#preloader-arm-shape" transform="rotate(0 500 577.259)"/>
    <use href="#preloader-arm-shape" transform="rotate(120 500 577.259)"/>
    <use href="#preloader-arm-shape" transform="rotate(240 500 577.259)"/>
  </svg>
  <div class="preloader-bar-track">
    <div class="preloader-bar-fill" id="preloader-bar-fill"></div>
  </div>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: rgb(var(--c-bg));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 3.5vw, 3.25rem);
    opacity: 1;
    transition: opacity 0.5s ease, filter 0.5s ease;
  }
  #preloader.is-hidden {
    opacity: 0;
    filter: blur(20px);
    pointer-events: none;
  }
  /* @media (max-width: 1024px): lighter/shorter, same reasoning as the
     root view-transition blur in Layout.astro — full-viewport blur is
     expensive on weaker GPUs. Keyed off pointer type, not width, for the
     same tablet-vs-phone reason documented there. */
  @media (pointer: coarse) {
    #preloader.is-hidden { filter: blur(8px); transition-duration: 0.35s; }
  }

  .preloader-mark {
    width: clamp(140px, 16vw, 220px);
    height: auto;
  }

  .preloader-bar-track {
    width: clamp(220px, 20vw, 320px);
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .preloader-bar-fill {
    height: 100%;
    width: 0%;
    background: rgb(var(--c-red));
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'ptk-preloader-shown';
    var el = document.getElementById('preloader');
    if (!el) return;

    // Repeat view in this tab session — skip instantly, no flash, no
    // waiting on anything. This is the ONLY fast path; every other exit
    // still waits for real readiness below.
    if (sessionStorage.getItem(KEY)) {
      el.hidden = true;
      return;
    }

    var fill = document.getElementById('preloader-bar-fill');
    // 1300ms floor, not 450 — this is still a FLOOR, not a fake fixed
    // duration (real loads that take longer still take exactly as long as
    // they take, see the Promise.all below). But on a fast connection
    // there's nothing to wait for, and 450ms read as an accidental flicker
    // rather than a deliberate beat before the site's own hero entrance —
    // the whole point of a premium preloader is that brief pause/breath,
    // not disappearing before anyone registers it.
    var MIN_MS = 1300;
    var MAX_MS = 8000;  // ceiling so a stalled font/asset load can't trap the visitor
    var start = performance.now();
    var raf = 0;

    // This is a PERCEIVED progress cue, not a byte-accurate measurement —
    // computing true combined progress across fonts/images/scripts isn't
    // practical. What's real is the actual hide condition below (fonts +
    // window load + MIN_MS), which is what this bar eventually snaps to.
    function tick() {
      var elapsed = performance.now() - start;
      var pct = Math.min(90, (elapsed / MIN_MS) * 90);
      if (fill) fill.style.width = pct + '%';
      if (elapsed < MAX_MS) raf = requestAnimationFrame(tick);
    }
    raf = requestAnimationFrame(tick);

    var fontsReady = (document.fonts && document.fonts.ready) || Promise.resolve();
    var windowLoaded = document.readyState === 'complete'
      ? Promise.resolve()
      : new Promise(function (resolve) { window.addEventListener('load', resolve, { once: true }); });
    var minTime = new Promise(function (resolve) { setTimeout(resolve, MIN_MS); });
    var safety = new Promise(function (resolve) { setTimeout(resolve, MAX_MS); });

    Promise.race([
      Promise.all([fontsReady, windowLoaded, minTime]),
      safety,
    ]).then(function () {
      cancelAnimationFrame(raf);
      if (fill) fill.style.width = '100%';
      setTimeout(function () {
        el.classList.add('is-hidden');
        sessionStorage.setItem(KEY, '1');
        el.addEventListener('transitionend', function () { el.hidden = true; }, { once: true });
      }, 300); // hold at 100% — reads as deliberate, not an instant cut
    });
  })();
</script>
