---
import { Image } from 'astro:assets';
import marcinPhoto from '../../img/contact section/Marcin_contact_section.webp';
---

<!-- ═══════ FAQ ═══════ -->
<section id="faq">

	<div class="faq__inner">

		<aside class="faq__sidebar">
			<div class="faq__photo">
				<Image src={marcinPhoto} alt="Martin" width={180} height={207} loading="lazy" />
			</div>
			<p class="faq__contact-text">Got more questions?<br>Let's talk.</p>
			<div class="h-hero-cta-wrap faq__cta-wrap">
				<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
				<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
				<a href="/contact" class="h-hero-cta faq__cta h-hero-cta--fixed">
					<span class="hud-spin-border"></span>
					<span class="h-hero-cta__text">Contact</span>
				</a>
			</div>
		</aside>

		<div class="disc-header">
			<h2 class="disc-header__title">What you should<br><em>to know</em></h2>
		</div>

		<div class="faq__content">

			<div class="disc-list">

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">01</span>
						<h3 class="disc-item__title">Discovery &amp; Strategy</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">I begin by understanding your brand, goals, and audience. Strategy workshops, competitor analysis, and a creative brief happen before a single line of code.</p>
					</div></div>
				</div>

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">02</span>
						<h3 class="disc-item__title">Design &amp; Motion</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">I design with pixel-level care: typography, color, rhythm, and microinteractions. Wireframe to high-fidelity in Figma, with collaborative iteration throughout.</p>
					</div></div>
				</div>

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">03</span>
						<h3 class="disc-item__title">Development</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">Astro, React, and GSAP — I choose the stack around the project, not the other way around. Motion, performance, SEO, and accessibility from the first commit.</p>
					</div></div>
				</div>

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">04</span>
						<h3 class="disc-item__title">QA &amp; Launch</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">Cross-browser, cross-device, and built to hit 90+ PageSpeed. I deploy to your server or Vercel/Netlify and hand over clear documentation for your team.</p>
					</div></div>
				</div>

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">05</span>
						<h3 class="disc-item__title">Support &amp; Growth</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">After launch, I stay available for retainer support, iterations, and new features. I treat each project as a long-term partnership, not a one-off delivery.</p>
					</div></div>
				</div>

			</div>
		</div>

	</div>

</section>

<style>
	#faq {
		position: relative;
		z-index: 43;
		color: rgb(var(--c-cream));
	}
	.faq__inner {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) var(--section-space-bottom);
		box-sizing: border-box;
		display: grid;
		grid-template-columns: 220px 1fr;
		grid-template-areas:
			"sidebar header"
			"sidebar list";
		column-gap: clamp(4.8rem, 9vw, 10.5rem);
		row-gap: 0;
		align-items: start;
	}
	.faq__content { grid-area: list; padding-left: clamp(1rem, 2.2vw, 2rem); }
	.faq__sidebar {
		grid-area: sidebar;
		position: sticky;
		top: 5rem;
		padding-top: clamp(6rem, 12vw, 14rem);
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.faq__sidebar.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.faq__photo {
		width: 180px;
		aspect-ratio: 1 / 1.2;
		overflow: hidden;
		border-radius: 0;
		margin-bottom: 1.8rem;
		background: #1a1a1a;
	}
	.faq__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.faq__contact-text {
		font-family: var(--f-body);
		font-size: clamp(0.85rem, 1.1vw, 0.95rem);
		font-weight: 300;
		line-height: 1.65;
		color: rgb(var(--c-cream) / 0.55);
		margin-bottom: 1.4rem;
	}
	.faq__cta-wrap { width: 100%; max-width: 320px; }
	.faq__cta { width: 100%; font-size: 1rem; padding: 1.15rem 1.5rem; }
	.disc-header {
		grid-area: header;
		width: 100%;
		margin-inline: 0;
		padding: 0 0 var(--section-space-bottom);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.faq__content .disc-list {
		width: 100%;
		margin-inline: 0;
		padding: 0 0 var(--section-space-bottom);
		box-sizing: border-box;
	}
	.disc-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.disc-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 11rem);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.disc-header__title em { font-style: normal; color: rgb(var(--c-red)); }
	.disc-list { width: 100%; padding: 0 var(--site-gutter) var(--section-space-bottom); box-sizing: border-box; }
	.disc-item { }
	.disc-item__row {
		display: grid;
		grid-template-columns: 4rem 1fr;
		align-items: center;
		gap: clamp(0.75rem, 1.5vw, 1.5rem);
		padding: clamp(2.2rem, 4vw, 4rem) 0;
		cursor: default;
	}
	.disc-item__num {
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(1.6rem, 2.6vw, 2.6rem);
		line-height: 1;
		letter-spacing: -0.01em;
		color: rgb(var(--c-red));
	}
	.disc-item__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.6rem, 3vw, 3.5rem);
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		line-height: 1;
		transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
	}
	.disc-item__body {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.5s cubic-bezier(0.16,1,0.3,1);
	}
	.disc-item__body > div { overflow: hidden; }
	.disc-item__desc {
		font-family: var(--f-body);
		font-size: clamp(0.8rem, 1.05vw, 0.88rem);
		font-weight: 300;
		line-height: 1.8;
		color: rgb(var(--c-cream) / 0.46);
		padding-bottom: clamp(1.4rem, 2.2vw, 2.2rem);
		max-width: 74ch;
		padding-left: calc(4rem + clamp(0.75rem, 1.5vw, 1.5rem));
	}
	@media (hover: hover) {
		.disc-item:hover .disc-item__title { transform: translateX(0.4rem); }
		.disc-item:hover .disc-item__body { grid-template-rows: 1fr; }
	}
	/* Laptop-height viewports: the sticky sidebar's tall decorative
	   padding-top pushed the Contact button down onto the fixed
	   bottom-left location badge (OxygenMenu's #ox-hud-mobile). Pull the
	   whole sidebar up and tighten it so it clears that badge. Taller
	   screens keep the roomy original spacing. */
	@media (min-width: 1025px) and (max-height: 900px) {
		.faq__sidebar {
			top: 3.5rem;
			padding-top: clamp(4rem, 9vh, 9rem);
		}
		.faq__photo { width: 150px; margin-bottom: 1.4rem; }
		.faq__contact-text { margin-bottom: 1.1rem; }
	}

	@media (max-width: 1024px) {
		/* Heading, then the list, then the photo/CTA last — the photo+CTA sat
		   as a left column next to the heading+list on desktop; here they're
		   all one column, ordered by grid-template-areas rows instead of
		   source order so it reads as a closing "got more questions?" note
		   after the last FAQ item, not something above/before the list. */
		.faq__inner {
			grid-template-columns: 1fr;
			grid-template-areas:
				"header"
				"list"
				"sidebar";
			row-gap: 0;
		}
		.faq__content { padding-left: 0; }
		/* Was display:none — the photo + "Got more questions?" CTA were
		   skipped on mobile entirely. Shown now as a plain stacked block
		   instead of the desktop sticky sidebar (that position/padding-top
		   was only there to line the sidebar up against the much taller
		   sticky-adjacent content column). Visibility itself is already
		   handled by the global mobile instant-visibility override
		   (global.css) that includes .faq__sidebar. */
		.faq__sidebar {
			position: static;
			top: auto;
			padding-top: clamp(2rem, 5vw, 3rem);
			padding-bottom: clamp(2.5rem, 7vw, 3.5rem);
		}
		.faq__photo { width: clamp(120px, 32vw, 160px); margin-bottom: 1.4rem; }
		.faq__cta-wrap { max-width: 320px; }
		.disc-header { padding: 0 0 clamp(2rem, 5vw, 3rem); }
		.faq__content .disc-list { padding-bottom: 0; }
	}
	@media (max-width: 768px) {
		.disc-item__row { grid-template-columns: 2.5rem 1fr; }
		.disc-item__body { grid-template-rows: 1fr; }
		.disc-item__desc { padding-left: calc(2.5rem + 0.75rem); }
	}
	@media (max-width: 480px) {
		.disc-item__row { grid-template-columns: 2rem 1fr; }
		.disc-item__desc { padding-left: calc(2rem + 0.75rem); }
	}
	@media (orientation: landscape) and (max-height: 500px) {
		.disc-item__body { grid-template-rows: 1fr; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { onReady } from '../../utils/onReady';
	gsap.registerPlugin(ScrollTrigger);

	function initFaq() {
		const section = document.getElementById('faq');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px)').matches) return;

		ScrollTrigger.create({
			trigger: section,
			start: 'top 78%',
			onEnter: () => {
				section.querySelector('.disc-header')?.classList.add('visible');
				section.querySelector('.faq__sidebar')?.classList.add('visible');
			},
		});

		section.querySelectorAll<HTMLElement>('.disc-item').forEach((item, i) => {
			gsap.set(item, { opacity: 0, filter: 'blur(8px)', y: 14 });
			ScrollTrigger.create({
				trigger: item,
				start: 'top 90%',
				onEnter: () => {
					gsap.to(item, {
						opacity: 1,
						filter: 'blur(0px)',
						y: 0,
						duration: 0.58,
						delay: i * 0.09,
						ease: 'power3.out',
					});
				},
				once: true,
			});
		});
	}

	onReady(initFaq);
</script>
