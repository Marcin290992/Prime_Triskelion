---
import { Image } from 'astro:assets';
import marcinPhoto from '../../img/contact section/Marcin_contact_section.webp';
---

<!-- ═══════ FAQ ═══════ -->
<section id="faq">

	<div class="faq__inner">

		<aside class="faq__sidebar">
			<div class="faq__photo">
				<Image src={marcinPhoto} alt="Marcin, founder of Prime Triskelion Ltd" width={240} height={288} densities={[1, 2]} loading="lazy" />
				<!-- Desktop: the photo as a chroma card (initFaqPhoto). -->
				<canvas class="faq__chroma" aria-hidden="true"></canvas>
			</div>
			<p class="faq__contact-text">Got more questions?<br>Let's talk.</p>
			<div class="h-hero-cta-wrap faq__cta-wrap">
				<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
				<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
				<a href="/contact" class="h-hero-cta faq__cta h-hero-cta--fixed" data-frame-fx>
					<span class="hud-spin-border"></span>
					<span class="h-hero-cta__text">Contact</span>
				</a>
			</div>
		</aside>

		<div class="disc-header">
			<h2 class="disc-header__title">Good<br><em>to know.</em></h2>
		</div>

		<div class="faq__content">

			<div class="disc-list">

				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">01</span>
						<h3 class="disc-item__title">Who will I work with?</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">Directly with the person who designs and builds your website. No account managers, no handoffs, no layers between your idea and the result.</p>
					</div></div>
				</div>
				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">02</span>
						<h3 class="disc-item__title">How does a project start?</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">With a conversation about your brand, your audience and what the website has to win. A clear brief and a fixed scope come before a single line of code.</p>
					</div></div>
				</div>
				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">03</span>
						<h3 class="disc-item__title">How long does it take?</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">Every project has its own rhythm. A clear timeline is agreed before the work begins, and you always know where the project stands.</p>
					</div></div>
				</div>
				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">04</span>
						<h3 class="disc-item__title">What does it cost?</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">Every project is quoted individually, since no two briefs are the same. Get in touch and a clear proposal follows, before anything is committed.</p>
					</div></div>
				</div>
				<div class="disc-item">
					<div class="disc-item__row">
						<span class="disc-item__num">05</span>
						<h3 class="disc-item__title">What do I get at the end?</h3>
					</div>
					<div class="disc-item__body"><div>
						<p class="disc-item__desc">A finished, fast website, the source and clear documentation, so it is yours to run. After launch, support and new features are available whenever you need them.</p>
					</div></div>
				</div>

			</div>
		</div>

	</div>

</section>

<style>
	#faq {
		position: relative;
		z-index: 43;
		color: rgb(var(--c-cream));
	}
	.faq__inner {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) var(--section-space-bottom);
		box-sizing: border-box;
		display: grid;
		grid-template-columns: 240px 1fr;
		grid-template-areas:
			"sidebar header"
			"sidebar list";
		column-gap: clamp(4.8rem, 9vw, 10.5rem);
		row-gap: 0;
		align-items: start;
	}
	.faq__content { grid-area: list; padding-left: clamp(1rem, 2.2vw, 2rem); }
	.faq__sidebar {
		grid-area: sidebar;
		position: sticky;
		top: 5rem;
		padding-top: clamp(6rem, 12vw, 14rem);
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.faq__sidebar.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	/* Touch: a light, quick blur-in (3px, 0.4s) instead of the desktop 8px / 0.72s. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.faq__sidebar, .faq__photo, .disc-header { filter: blur(3px); transition: opacity 0.4s ease, transform 0.4s ease, filter 0.4s ease; }
		.faq__sidebar.visible, .faq__photo.visible, .disc-header.visible { filter: blur(0); }
	}
	.faq__photo {
		width: 240px;
		aspect-ratio: 1 / 1.2;
		position: relative;
		overflow: hidden;
		border-radius: 0;
		margin-bottom: 1.8rem;
		background: #1a1a1a;
	}
	.faq__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	/* Chroma card: 1.5× the photo box (PAD in chromaCard.ts), centred, so
	   the card can lean and drift without being cut off. Shown once its
	   first frame is drawn; the plain photo stays until then. */
	.faq__chroma {
		position: absolute;
		left: -25%;
		top: -25%;
		width: 150%;
		height: 150%;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.faq__photo.is-chroma { overflow: visible; background: none; }
	.faq__photo.is-chroma img { visibility: hidden; }
	.faq__photo.is-chroma .faq__chroma { opacity: 1; }
	.faq__contact-text {
		font-family: var(--f-body);
		font-size: clamp(0.85rem, 1.1vw, 0.95rem);
		font-weight: 300;
		line-height: 1.65;
		color: rgb(var(--c-cream) / 0.82);
		margin-bottom: 1.4rem;
	}
	.faq__cta-wrap { width: 100%; max-width: 320px; }
	.faq__cta { width: 100%; font-size: 1rem; padding: 1.15rem 1.5rem; }
	.disc-header {
		grid-area: header;
		width: 100%;
		margin-inline: 0;
		padding: 0 0 var(--section-space-bottom);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.faq__content .disc-list {
		width: 100%;
		margin-inline: 0;
		padding: 0 0 var(--section-space-bottom);
		box-sizing: border-box;
	}
	.disc-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.disc-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.disc-header__title em { font-style: normal; color: rgb(var(--c-red)); }
	.disc-list { width: 100%; padding: 0 var(--site-gutter) var(--section-space-bottom); box-sizing: border-box; }
	/* a hairline between the questions, so they stand apart */
	.disc-item { border-bottom: 1px solid rgb(var(--c-cream) / 0.1); }
	.disc-item:first-child { border-top: 1px solid rgb(var(--c-cream) / 0.1); }
	.disc-item__row {
		display: grid;
		grid-template-columns: 4rem 1fr;
		align-items: center;
		gap: clamp(0.75rem, 1.5vw, 1.5rem);
		padding: clamp(2.2rem, 4vw, 4rem) 0;
		cursor: default;
	}
	.disc-item__num {
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(1.6rem, 2.6vw, 2.6rem);
		line-height: 1;
		letter-spacing: -0.01em;
		color: rgb(var(--c-red));
	}
	.disc-item__title {
		font-family: var(--f-display);
		font-weight: 600;
		/* The titles are questions now, whole sentences: in capitals, in this wide, tight face, the words ran together
		   ("WILL I WORK" read as one). Sentence case, a smaller size, real space between the words. */
		font-size: clamp(1.45rem, 2.4vw, 2.7rem);
		letter-spacing: -0.005em;
		word-spacing: 0.12em;
		text-transform: none;
		color: rgb(var(--c-cream));
		line-height: 1.12;
		transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
	}
	.disc-item__body {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.5s cubic-bezier(0.16,1,0.3,1);
	}
	.disc-item__body > div { overflow: hidden; }
	.disc-item__desc {
		font-family: var(--f-body);
		font-size: clamp(0.9rem, 1.1vw, 1rem);
		font-weight: 300;
		line-height: 1.75;
		color: rgb(var(--c-cream) / 0.88);
		padding-bottom: clamp(1.4rem, 2.2vw, 2.2rem);
		max-width: 74ch;
		padding-left: calc(4rem + clamp(0.75rem, 1.5vw, 1.5rem));
	}
	@media (hover: hover) {
		.disc-item:hover .disc-item__title { transform: translateX(0.4rem); }
		.disc-item:hover .disc-item__body { grid-template-rows: 1fr; }
	}
	/* Laptop-height viewports: the sticky sidebar's tall decorative
	   padding-top pushed the Contact button down onto the fixed
	   bottom-left location badge (OxygenMenu's #ox-hud-mobile). Pull the
	   whole sidebar up and tighten it so it clears that badge. Taller
	   screens keep the roomy original spacing. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 900px), (min-width: 1025px) and (pointer: fine) and (max-height: 900px) {
		.faq__sidebar {
			top: 3.5rem;
			padding-top: clamp(4rem, 9vh, 9rem);
		}
		.faq__photo { width: 190px; margin-bottom: 1.4rem; }
		.faq__contact-text { margin-bottom: 1.1rem; }
	}

	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		/* Heading, then the list, then the photo/CTA last — the photo+CTA sat
		   as a left column next to the heading+list on desktop; here they're
		   all one column, ordered by grid-template-areas rows instead of
		   source order so it reads as a closing "got more questions?" note
		   after the last FAQ item, not something above/before the list. */
		.faq__inner {
			grid-template-columns: 1fr;
			grid-template-areas:
				"header"
				"list"
				"sidebar";
			row-gap: 0;
		}
		.faq__content { padding-left: 0; }
		/* Was display:none — the photo + "Got more questions?" CTA were
		   skipped on mobile entirely. Shown now as a plain stacked block
		   instead of the desktop sticky sidebar (that position/padding-top
		   was only there to line the sidebar up against the much taller
		   sticky-adjacent content column). Visibility itself is already
		   handled by the global mobile instant-visibility override
		   (global.css) that includes .faq__sidebar. */
		.faq__sidebar {
			position: static;
			top: auto;
			padding-top: clamp(2rem, 5vw, 3rem);
			padding-bottom: clamp(2.5rem, 7vw, 3.5rem);
		}
		/* A small portrait beside the note, like an avatar — not a feature image. */
		.faq__photo { width: clamp(56px, 14vw, 120px); margin-bottom: 1.1rem; }
		.faq__cta-wrap { max-width: 320px; }
		.disc-header { padding: 0 0 clamp(2rem, 5vw, 3rem); }
		.faq__content .disc-list { padding-bottom: 0; }
	}
	/* Phone list: every answer open, since there's no hover to open it.
	   Tablets (touch, any width) get the same, not the hover-only list. */
	@media (max-width: 768px), (hover: none) and (pointer: coarse) {
		.disc-item__row { grid-template-columns: 2.5rem 1fr; }
		.disc-item__body { grid-template-rows: 1fr; }
		.disc-item__desc { padding-left: calc(2.5rem + 0.75rem); }
	}
	@media (max-width: 480px) {
		.disc-item__row { grid-template-columns: 2rem 1fr; }
		.disc-item__desc { padding-left: calc(2rem + 0.75rem); }
	}
	@media (orientation: landscape) and (max-height: 500px) {
		.disc-item__body { grid-template-rows: 1fr; }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { onReady } from '../../utils/onReady';
	import { createChromaCard, type ChromaCardHandle } from '../../utils/chromaCard';
	gsap.registerPlugin(ScrollTrigger);

	function initFaq() {
		const section = document.getElementById('faq');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) return;

		ScrollTrigger.create({
			trigger: section,
			start: 'top 78%',
			onEnter: () => {
				section.querySelector('.disc-header')?.classList.add('visible');
				section.querySelector('.faq__sidebar')?.classList.add('visible');
			},
		});

		section.querySelectorAll<HTMLElement>('.disc-item').forEach((item, i) => {
			const touchy = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
			gsap.set(item, { opacity: 0, filter: `blur(${touchy ? 3 : 8}px)`, y: 14 });
			ScrollTrigger.create({
				trigger: item,
				start: 'top 90%',
				onEnter: () => {
					gsap.to(item, {
						opacity: 1,
						filter: 'blur(0px)',
						y: 0,
						duration: touchy ? 0.4 : 0.58,
						delay: touchy ? 0 : i * 0.09,
						ease: 'power3.out',
					});
				},
				once: true,
			});
		});
	}

	// Desktop: the photo becomes a chroma card (mouse-driven lean, RGB-split
	// zoom on hover). Touch keeps the plain photo — nothing to hover there.
	let _chroma: ChromaCardHandle | null = null;
	function initFaqPhoto() {
		_chroma?.destroy();
		_chroma = null;
		if (!window.matchMedia('(min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine)').matches) return;
		const box = document.querySelector<HTMLElement>('#faq .faq__photo');
		const img = box?.querySelector<HTMLImageElement>('img');
		const canvas = box?.querySelector<HTMLCanvasElement>('.faq__chroma');
		if (!box || !img || !canvas) return;
		// The photo is lazy: start loading it now, build the card once it's in.
		img.loading = 'eager';
		img.decode().then(() => {
			if (!canvas.isConnected || _chroma) return;
			_chroma = createChromaCard(box, canvas, img, {
				zoomLevel: 0.15,
				scaleIntensity: 0.12,
				positionIntensity: 0.7,
				// It also leans toward the cursor moving over the questions.
				zone: document.getElementById('faq') ?? undefined,
				// Hovering the Contact button lights the photo up too.
				hoverTrigger: document.querySelector<HTMLElement>('#faq .faq__cta') ?? undefined,
			});
			if (_chroma) requestAnimationFrame(() => box.classList.add('is-chroma'));
		}).catch(() => {});
	}
	document.addEventListener('astro:before-swap', () => {
		_chroma?.destroy();
		_chroma = null;
	});

	onReady(() => {
		initFaq();
		initFaqPhoto();
	});
</script>
