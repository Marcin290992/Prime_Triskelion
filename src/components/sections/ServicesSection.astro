---
// The services list of the 12 Studio reference (12-studio/app/src/components/sections.jsx): one big
// numbered list ruled between its rows. Its heading is the manifesto right above it (the label
// "Expertise" and the statement, see ManifestoSection): the two are one section to the eye. Only what the earlier section did better is kept: on a desktop with a mouse a
// picture unfolds in WebGL under the pointer and trails it (utils/hoverGallery.ts); phones and tablets
// get the plain list (the pinned scene is gone). The earlier version is in
// components/backup/ServicesSection.before-12-studio.astro.
import { getImage } from 'astro:assets';
// The desktop hover picture is WebGL (437px on screen): one local photo per service
// (the site's CSP blocks remote images).
import glWebsites from '../../img/services/websites.jpg';
import glBranding from '../../img/services/branding.jpg';
import glMotion from '../../img/services/motion.jpg';
import glStrategy from '../../img/services/strategy.jpg';

const services = [
	{ name: 'Websites', gl: glWebsites },
	{ name: 'Branding', gl: glBranding },
	{ name: 'Motion', gl: glMotion },
	{ name: 'Strategy', gl: glStrategy },
];
const glSrcs = await Promise.all(services.map(async (sv) => (await getImage({ src: sv.gl, width: 960 })).src));
---
<!-- ═══════ SERVICES (Expertise): the services as a centred list of options ═══════ -->
<section id="services">

	<!-- All four names readable at once. Desktop: one picture follows the name under the mouse. -->
	<div class="svc__body">
		<ul class="svc__list">
			{services.map((sv, i) => (
				<li class="svc__row svc-rv" style={`--d:${(i * 0.08).toFixed(2)}s`} data-key={`s${i}`} data-src={glSrcs[i]}>
					<a href="/services" class="svc__link">
						<span class="svc__roll">
							<span class="svc__roll__base">{sv.name}</span>
							<span class="svc__roll__red" aria-hidden="true">{sv.name}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
		<a href="/services" class="svc__btn" aria-label="View all services">
			<span class="svc__btn__line"></span>
			See more
		</a>
	</div>

</section>

<style>
	#services {
		position: relative;
		z-index: 46;
		color: rgb(var(--c-cream));
		/* The spacing of every other section of the page. The manifesto above ends first (its pinned stage
		   is over before this starts), so none of the names is seen while the statement is still appearing. */
		padding-top: clamp(1.5rem, 5vh, 3.5rem);
		padding-bottom: var(--section-space-bottom);
	}

	/* ── The list: big names, centred like a menu of options (no numbers, no rules) ─────── */
	.svc__body {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 var(--site-gutter);
	}
	.svc__list { width: 100%; }
	.svc__list { list-style: none; margin: 0; padding: 0; }
	.svc__row { position: relative; padding: 0; }
	.svc__link {
		position: relative;
		display: block;
		width: 100%;
		text-align: center;
		padding: clamp(0.9rem, 3.6vw, 1.6rem) 0;
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(3rem, 13.5vw, 8rem);
		line-height: 1.04;
		letter-spacing: 0.005em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}
	.svc__link:focus-visible { outline: 1px solid rgb(var(--c-cream) / 0.6); outline-offset: 6px; }

	/* Rolling text, as in the menu: the dimmed name slides up, the white one comes in
	   from below. (Mouse only, below.) */
	.svc__roll { position: relative; display: block; overflow: hidden; }
	.svc__roll__base, .svc__roll__red {
		display: block;
		transition: transform 0.34s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.svc__roll__red {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		color: rgb(var(--c-cream));
	}

	.svc__btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		margin-top: clamp(2rem, 6vw, 3.5rem);
		font-family: var(--f-body);
		font-size: clamp(0.75rem, 1.1vw, 0.9rem);
		font-weight: 300;
		letter-spacing: 0.38em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.7);
		text-decoration: none;
		cursor: pointer;
		transition: color 0.3s ease;
	}
	.svc__btn:hover { color: rgb(var(--c-cream) / 0.9); }
	.svc__btn__line {
		display: block;
		width: 36px;
		height: 1px;
		background: rgb(var(--c-red) / 0.9);
		transform-origin: left;
		transition: width 0.35s ease;
		flex-shrink: 0;
	}
	.svc__btn:hover .svc__btn__line { width: 56px; }
	/* Touch: the link's text line is 18px tall: tap 44px. */
	@media (pointer: coarse) {
		.svc__btn::before { content: ''; position: absolute; inset: -13px 0; }
	}

	@media (min-width: 700px) and (max-width: 1024px) {
		.svc__link { font-size: clamp(5rem, 15vw, 11rem); }
	}

	/* ── Desktop (mouse): the names big, in the middle; the picture follows the one under the mouse ── */
	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		.svc__list { width: 100%; }
		.svc__link {
			/* BIG, sized by the width AND the height: the four names fill about one screen */
			padding: clamp(0.5rem, 1.6vh, 1.4rem) 0;
			font-size: clamp(3.4rem, min(11vw, 17vh), 15rem);
			color: rgb(var(--c-cream) / 0.38);
			transition: color 0.4s ease;
		}
		/* The names stay above the WebGL picture (a canvas in this section, z 2). */
		.svc__body { position: relative; }
		.svc__row .svc__roll { position: relative; z-index: 3; }

		/* Mouse only. At rest, and whenever the mouse is off the names (on the picture too),
		   every name is dimmed. The one under the mouse rolls to white. */
		@media (hover: hover) and (pointer: fine) {
			.svc__link:hover .svc__roll__base,
			.svc__link:hover .svc__roll__red,
			.svc__row.is-hot .svc__roll__base,
			.svc__row.is-hot .svc__roll__red { transform: translateY(-100%); }
		}

		/* The site's blur-in, desktop only (on phones it is instant, see global.css). */
		.svc-rv {
			opacity: 0;
			filter: blur(8px);
			transform: translateY(14px);
			transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16, 1, 0.3, 1), filter 0.72s cubic-bezier(0.16, 1, 0.3, 1);
			transition-delay: var(--d, 0s);
		}
		.svc-rv.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	}
	/* The hand-over to Selected work: as the options leave, they blur out (one transition, not tied to the
	   scroll) and the next section's title comes out of blur in the same place (script below, and
	   SelectedWorkSection). The class is on the section; scrolling back brings them back. */
	#services.is-out .svc__row,
	#services.is-out .svc__btn {
		opacity: 0;
		filter: blur(6px);
		transform: translateY(-6px);
		transition: opacity 0.9s ease, filter 1s ease, transform 1s ease !important;
		transition-delay: 0s !important;
		pointer-events: none;
	}
	/* Phones and tablets have no blur-in on the way in, but the way back needs a soft return too. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		#services .svc__row, #services .svc__btn { transition: opacity 0.7s ease, filter 0.8s ease, transform 0.8s ease; }
	}
	@media (prefers-reduced-motion: reduce) {
		#services.is-out .svc__row, #services.is-out .svc__btn { filter: none; transform: none; transition: opacity 0.2s linear !important; }
		.svc__roll__base, .svc__roll__red { transition: none; }
		.svc-rv { transition: none !important; opacity: 1 !important; filter: none !important; transform: none !important; }
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';
	import { createHoverGallery } from '../../utils/hoverGallery';

	let _isBackNav = false;

	// Where the mouse last was, kept for the whole visit: a page's own scripts
	// start knowing nothing, but the pointer is still where the click that
	// brought the visitor here left it. Bound once; -1 = not known / outside.
	const pointer = { x: -1, y: -1 };
	const track = (e: MouseEvent) => { pointer.x = e.clientX; pointer.y = e.clientY; };
	['mousemove', 'mousedown', 'click'].forEach((type) => window.addEventListener(type, track as EventListener, { passive: true, capture: true }));
	document.documentElement.addEventListener('mouseleave', () => { pointer.x = -1; pointer.y = -1; });

	document.addEventListener('astro:before-swap', (e: any) => {
		_isBackNav = (e.navigationType ?? '') === 'traverse';
	});

	// Desktop: the reveal observer, the WebGL hover gallery and their listeners, undone on leaving the page.
	let _svcDesk: (() => void) | null = null;
	let _svcHand: (() => void) | null = null;
	document.addEventListener('astro:before-swap', () => { _svcDesk?.(); _svcDesk = null; _svcHand?.(); _svcHand = null; });

	function initServices() {
		_svcDesk?.();
		_svcDesk = null;
		_svcHand?.();
		_svcHand = null;
		const section = document.getElementById('services');
		if (!section) return;

		// The hand-over to Selected work, on every device: once the options have scrolled up to the upper part
		// of the screen (the last of them, See more, above 56% of its height) they blur out, and the next
		// section's title comes in where they were. Scrolling back brings them back (with a margin, so it
		// never flickers at the threshold).
		const handBtn = section.querySelector<HTMLElement>('.svc__btn');
		if (handBtn) {
			let out = false;
			const check = () => {
				const b = handBtn.getBoundingClientRect().bottom;
				const vh = window.innerHeight;
				if (!out && b < vh * 0.56) { out = true; section.classList.add('is-out'); }
				else if (out && b > vh * 0.66) { out = false; section.classList.remove('is-out'); }
			};
			let ticking = false;
			const onHandScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; check(); }); };
			window.addEventListener('scroll', onHandScroll, { passive: true });
			check();
			_svcHand = () => { window.removeEventListener('scroll', onHandScroll); section.classList.remove('is-out'); };
		}

		// Phones and tablets: the plain list, nothing hidden, nothing to start.
		if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) { _isBackNav = false; return; }

		const isBack = _isBackNav;
		_isBackNav = false;

		// The blur-in of the label, the heading, the text and every row, as the section comes up.
		const reveals = Array.from(section.querySelectorAll<HTMLElement>('.svc-rv'));
		let rio: IntersectionObserver | null = null;
		if (isBack) {
			reveals.forEach((el) => {
				el.style.transition = 'none';
				el.classList.add('visible');
			});
			requestAnimationFrame(() => reveals.forEach((el) => { el.style.transition = ''; }));
		} else {
			rio = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						rio?.unobserve(entry.target);
					}
				});
			}, { threshold: 0.15 });
			reveals.forEach((el) => rio!.observe(el));
		}

		const rows = Array.from(section.querySelectorAll<HTMLElement>('.svc__row'));
		const list = section.querySelector<HTMLElement>('.svc__list');

		// A real mouse (and no request for less motion): the picture is a WebGL
		// plane that unfolds under the pointer and trails it (see
		// utils/hoverGallery.ts). Everyone else gets the plain list.
		if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			_svcDesk = () => rio?.disconnect();
			return;
		}
		const gallery = createHoverGallery(
			section,
			rows.map((r) => ({ key: r.dataset.key!, src: r.dataset.src! })),
			// Brighter than the original's half opacity, and over the list's rules (unfold slowed from 1.75 s to 2.6 s).
			{ opacity: 0.92, above: true, openSeconds: 2.6, side: 'right', scale: 0.78 },
		);
		if (!gallery) {
			_svcDesk = () => rio?.disconnect();
			return;
		}

		// The row under the pointer is lit by the script (see .is-hot in the CSS)
		// and has the picture. The browser does not update :hover (nor send mouse
		// events) while the list scrolls under a resting pointer, so the row is found
		// from the pointer's last known position (kept across pages, see `pointer`);
		// :hover only backs it up when no position is known yet.
		const sync = () => {
			const under = pointer.x >= 0 ? document.elementFromPoint(pointer.x, pointer.y) : null;
			const row = (under && list?.contains(under) ? under.closest<HTMLElement>('.svc__row') : null)
				?? (pointer.x < 0 ? list?.querySelector('.svc__link:hover')?.closest<HTMLElement>('.svc__row') ?? null : null);
			rows.forEach((r) => r.classList.toggle('is-hot', r === row));
			gallery.setHovered(row ? row.dataset.key! : null);
		};
		let syncing = false;
		let settle = 0;
		const onScroll = () => {
			// The browser refreshes :hover a moment after a scroll stops, so check
			// again then as well as while it runs.
			clearTimeout(settle);
			settle = window.setTimeout(sync, 160);
			if (syncing) return;
			syncing = true;
			requestAnimationFrame(() => { syncing = false; sync(); });
		};
		const onLeave = () => gallery.setHovered(null);
		window.addEventListener('mousemove', sync, { passive: true });
		window.addEventListener('scroll', onScroll, { passive: true });
		document.documentElement.addEventListener('mouseleave', onLeave);
		list?.addEventListener('mouseleave', onLeave);
		rows.forEach((row) => {
			row.querySelector('a')?.addEventListener('mouseenter', sync);
			// Keyboard focus opens the picture too.
			row.querySelector('a')?.addEventListener('focus', () => gallery.setHovered(row.dataset.key!));
			row.querySelector('a')?.addEventListener('blur', onLeave);
		});
		_svcDesk = () => {
			rio?.disconnect();
			clearTimeout(settle);
			window.removeEventListener('mousemove', sync);
			window.removeEventListener('scroll', onScroll);
			document.documentElement.removeEventListener('mouseleave', onLeave);
			gallery.destroy();
		};
	}

	onReady(initServices);
</script>
