---
// Four services as a 3D cylinder of words. The section is a tall stage with a
// pinned (position: sticky) screen inside. Scrolling (wheel or finger) through
// the stage chooses which word is at the front, but the roll itself runs at its
// own steady speed — a hard flick and a slow nudge look the same. Plain CSS +
// a scroll listener + one rAF loop, no libraries. Without JS, or with reduced
// motion, it is just a stacked list of links.
const services = ['Websites', 'Branding', 'Motion', 'Strategy'];
---
<!-- ═══════ SERVICES ═══════ -->
<section id="services">
	<div class="svc__stage">
		<div class="svc__sticky">
			<div class="svc__header">
				<h2 class="svc__title-main">My<br><em>Services.</em></h2>
			</div>

			<div class="svc__scene">
				<div class="svc__cyl">
					{services.map((name) => (
						<a href="/services" class="svc__word">{name}</a>
					))}
				</div>
			</div>

			<div class="svc__footer">
				<a href="/services" class="svc__btn" aria-label="View all services">
					<span class="svc__btn__line"></span>
					See more
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	#services {
		position: relative;
		z-index: 46;
		color: rgb(var(--c-cream));
		/* One viewport unit for the whole section: the stable one on touch (the
		   browser toolbar must not resize a pinned screen mid-scroll). */
		--svc-vh: 1vh;
	}
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		#services { --svc-vh: var(--app-stable-vh, 1svh); }
	}

	/* ── Static fallback (no JS / reduced motion): a plain stacked list ── */
	.svc__header {
		width: 100%;
		padding: clamp(5rem, 11vh, 8rem) var(--site-gutter) clamp(1.2rem, 3vh, 2.5rem);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.svc__header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.svc__title-main {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, min(8vw, 12vh), 8.5rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.svc__title-main em { font-style: normal; color: rgb(var(--c-red) / 1); }
	.svc__cyl { display: flex; flex-direction: column; padding: 0 var(--site-gutter); }
	.svc__word {
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(2.6rem, 9vw, 7rem);
		line-height: 1.05;
		letter-spacing: 0.005em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		text-decoration: none;
		padding: 0.15em 0;
	}
	.svc__footer {
		width: 100%;
		padding: 1.5rem var(--site-gutter) clamp(3rem, 8vh, 6rem);
		box-sizing: border-box;
		display: flex;
		justify-content: center;
	}
	.svc__btn {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--f-body);
		font-size: clamp(0.75rem, 1.1vw, 0.9rem);
		font-weight: 300;
		letter-spacing: 0.38em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.7);
		text-decoration: none;
		cursor: pointer;
		transition: color 0.3s ease;
		position: relative;
	}
	.svc__btn:hover { color: rgb(var(--c-cream) / 0.9); }
	.svc__btn::before { content: ''; position: absolute; inset: -13px 0; }
	.svc__btn__line {
		display: block;
		width: 36px;
		height: 1px;
		background: rgb(var(--c-red) / 0.9);
		transform-origin: left;
		transition: width 0.35s ease;
		flex-shrink: 0;
	}
	.svc__btn:hover .svc__btn__line { width: 56px; }

	/* ── 3D mode (set by JS when motion is allowed) ───────────────────── */
	#services.svc--3d .svc__stage { height: calc(var(--svc-vh) * 300); }
	#services.svc--3d .svc__sticky {
		position: sticky;
		top: 0;
		height: calc(var(--svc-vh) * 100);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	#services.svc--3d .svc__header { flex: none; }
	#services.svc--3d .svc__scene {
		position: relative;
		flex: 1 1 0;
		min-height: 0;
		perspective: 1000px;
		/* Words fade in and out at the top and bottom of the scene. */
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 20%, #000 80%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 20%, #000 80%, transparent 100%);
	}
	#services.svc--3d .svc__cyl {
		position: absolute;
		inset: 0;
		display: block;
		padding: 0;
		transform-style: preserve-3d;
		transform-origin: 50% 50%;
	}
	#services.svc--3d .svc__word {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100%;
		padding: 0;
		text-align: center;
		white-space: nowrap;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		/* A word is a picture here; "See more" is the link. */
		pointer-events: none;
		font-size: clamp(3rem, min(11vw, 17vh), 9rem);
	}
	/* Bottom clearance for the fixed MENU button. */
	#services.svc--3d .svc__footer { flex: none; padding: 0.5rem var(--site-gutter) clamp(5.5rem, 12vh, 7rem); }

</style>

<script>
	import { onReady } from '../../utils/onReady';

	let _isBackNav = false;
	let _svcOff: (() => void) | null = null;

	document.addEventListener('astro:before-swap', (e: any) => {
		_isBackNav = (e.navigationType ?? '') === 'traverse';
		_svcOff?.();
		_svcOff = null;
	});

	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
	const GAP = 90;            // degrees between words: four words = one full turn
	const RADIUS = 0.42;       // cylinder radius as a share of the scene's height
	const MAX_SPEED = 540;     // the roll never goes faster than this, degrees per second
	const EASE_TIME = 0.13;    // seconds: how soft the landing on a word is

	function initServices() {
		const section = document.getElementById('services');
		if (!section) return;
		_svcOff?.();
		_svcOff = null;

		const isBack = _isBackNav;
		_isBackNav = false;

		const header = section.querySelector<HTMLElement>('.svc__header');
		let io: IntersectionObserver | null = null;
		if (header) {
			if (isBack) {
				header.style.transition = 'none';
				header.classList.add('visible');
				requestAnimationFrame(() => { header.style.transition = ''; });
			} else {
				io = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) { header.classList.add('visible'); io?.disconnect(); }
					});
				}, { threshold: 0.15 });
				io.observe(header);
			}
		}

		const stage = section.querySelector<HTMLElement>('.svc__stage');
		const sticky = section.querySelector<HTMLElement>('.svc__sticky');
		const scene = section.querySelector<HTMLElement>('.svc__scene');
		const cyl = section.querySelector<HTMLElement>('.svc__cyl');
		const words = Array.from(section.querySelectorAll<HTMLElement>('.svc__word'));
		const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (!stage || !sticky || !scene || !cyl || !words.length || calm.matches) {
			_svcOff = () => io?.disconnect();
			return;
		}

		section.classList.add('svc--3d');

		// Each word sits on the cylinder at its own angle; the cylinder's
		// radius follows the scene's height.
		const place = () => {
			const radius = scene.clientHeight * RADIUS;
			words.forEach((w, i) => {
				const a = (i * GAP * Math.PI) / 180;
				const y = Math.sin(a) * radius;
				const z = Math.cos(a) * radius;
				w.style.transform = `translate3d(-50%, -50%, 0) translate3d(0, ${y.toFixed(1)}px, ${z.toFixed(1)}px) rotateX(${(-i * GAP).toFixed(1)}deg)`;
			});
		};

		// Scroll position -> which word is at the front: each word owns an equal
		// slice of the stage. The cylinder then rolls to it at its own pace — a
		// capped speed with a soft landing — however fast the scroll was.
		let target = 0;           // degrees
		let angle = 0;
		let raf = 0;
		let last = 0;
		const paint = () => { cyl.style.transform = `rotateX(${angle.toFixed(2)}deg)`; };
		const frame = (now: number) => {
			raf = 0;
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			const diff = target - angle;
			if (Math.abs(diff) < 0.05) { angle = target; paint(); return; }
			// Ease toward the target, but never faster than MAX_SPEED.
			const ease = diff * (1 - Math.exp(-dt / EASE_TIME));
			const cap = MAX_SPEED * dt;
			angle += clamp(ease, -cap, cap);
			paint();
			raf = requestAnimationFrame(frame);
		};
		const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };

		const update = () => {
			const range = Math.max(1, stage.offsetHeight - sticky.offsetHeight);
			const p = clamp(-stage.getBoundingClientRect().top / range, 0, 1);
			const idx = Math.min(words.length - 1, Math.floor(p * words.length));
			const next = idx * GAP;
			if (next !== target) { target = next; kick(); }
		};
		let ticking = false;
		const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } };
		const onResize = () => { place(); update(); };

		place();
		// Start on the word the scroll position already points at (a reload
		// halfway down the stage), without a roll.
		update();
		angle = target;
		paint();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize, { passive: true });
		const ro = new ResizeObserver(onResize);
		ro.observe(scene);
		document.fonts?.ready.then(onResize);

		_svcOff = () => {
			if (raf) cancelAnimationFrame(raf);
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', onResize);
			ro.disconnect();
			io?.disconnect();
			section.classList.remove('svc--3d');
		};
	}

	onReady(initServices);
</script>
