---
// The services as a centred list of big names, part of the Expertise screen: this component is
// rendered INSIDE the manifesto's pinned stage (see ManifestoSection), under the statement. It is
// not a section of its own that scrolls up: it is already in place, and the manifesto's scroll
// timeline brings the names in (focus out of blur, one after another).
//
// The list of the 12 Studio reference (12-studio/app/src/components/sections.jsx) gave the idea
// (big names, a list of options). On a desktop with a mouse a picture unfolds in WebGL under the
// pointer and trails it (utils/hoverGallery.ts); phones and tablets get the plain list. The earlier
// versions are in components/backup/ServicesSection.before-12-studio.astro (and in git).
import { getImage } from 'astro:assets';
// The desktop hover picture is WebGL (437px on screen): one local photo per service
// (the site's CSP blocks remote images).
import glWebsites from '../../img/services/websites.jpg';
import glBranding from '../../img/services/branding.jpg';
import glMotion from '../../img/services/motion.jpg';
import glStrategy from '../../img/services/strategy.jpg';

const services = [
	{ name: 'Websites', gl: glWebsites },
	{ name: 'Branding', gl: glBranding },
	{ name: 'Motion', gl: glMotion },
	{ name: 'Strategy', gl: glStrategy },
];
const glSrcs = await Promise.all(services.map(async (sv) => (await getImage({ src: sv.gl, width: 960 })).src));
---
<!-- Fills the manifesto's stage (the WebGL picture is drawn on a canvas that fills it); the names sit in its lower part. -->
<div id="services" class="svc">
	<ul class="svc__list">
		{services.map((sv, i) => (
			<li class="svc__row" data-key={`s${i}`} data-src={glSrcs[i]}>
				<a href="/services" class="svc__link">
					<span class="svc__roll">
						<span class="svc__roll__base">{sv.name}</span>
						<span class="svc__roll__red" aria-hidden="true">{sv.name}</span>
					</span>
				</a>
			</li>
		))}
	</ul>
</div>

<style>
	/* The whole stage, over the statement (which is not interactive); only the names answer the pointer. */
	.svc {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		color: rgb(var(--c-cream));
	}
	.svc__list {
		position: absolute;
		left: var(--site-gutter);
		right: var(--site-gutter);
		/* clear of the MENU button at the bottom of the screen */
		bottom: clamp(4.5rem, 9.5vh, 6.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.svc__row { position: relative; padding: 0; pointer-events: auto; }
	.svc__link {
		position: relative;
		display: block;
		width: 100%;
		text-align: center;
		/* sized by the width AND the height: the four names and the statement above them
		   always fit one screen */
		padding: clamp(0.15rem, 0.6vh, 0.45rem) 0;
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(2.6rem, min(13vw, 11.2vh), 11rem);
		line-height: 1.04;
		letter-spacing: 0.005em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}
	.svc__link:focus-visible { outline: 1px solid rgb(var(--c-cream) / 0.6); outline-offset: 6px; }

	/* Rolling text, as in the menu: the dimmed name slides up, the white one comes in
	   from below. (Mouse only, below.) */
	.svc__roll { position: relative; display: block; overflow: hidden; }
	.svc__roll__base, .svc__roll__red {
		display: block;
		transition: transform 0.34s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.svc__roll__red {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		color: rgb(var(--c-cream));
	}

	/* Tablets: a little more room for the names. */
	@media (min-width: 700px) and (max-width: 1024px) {
		.svc__link { font-size: clamp(3.8rem, min(12vw, 11.2vh), 11rem); }
	}

	/* ── Desktop (mouse): the names dimmed, the one under the pointer rolls to white and has the picture ── */
	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		.svc__link {
			color: rgb(var(--c-cream) / 0.38);
			transition: color 0.4s ease;
		}
		/* The names stay above the WebGL picture (a canvas in this stage, z 2). */
		.svc__row .svc__roll { position: relative; z-index: 3; }

		/* Mouse only. At rest, and whenever the mouse is off the names (on the picture too),
		   every name is dimmed. The one under the mouse rolls to white. .is-hot: set by the script
		   for the name under the pointer (the browser does not update :hover while the page
		   scrolls under a pointer that is not moving). */
		@media (hover: hover) and (pointer: fine) {
			.svc__link:hover .svc__roll__base,
			.svc__link:hover .svc__roll__red,
			.svc__row.is-hot .svc__roll__base,
			.svc__row.is-hot .svc__roll__red { transform: translateY(-100%); }
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.svc__roll__base, .svc__roll__red { transition: none; }
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';
	import { createHoverGallery } from '../../utils/hoverGallery';

	// Where the mouse last was, kept for the whole visit: a page's own scripts
	// start knowing nothing, but the pointer is still where the click that
	// brought the visitor here left it. Bound once; -1 = not known / outside.
	const pointer = { x: -1, y: -1 };
	const track = (e: MouseEvent) => { pointer.x = e.clientX; pointer.y = e.clientY; };
	['mousemove', 'mousedown', 'click'].forEach((type) => window.addEventListener(type, track as EventListener, { passive: true, capture: true }));
	document.documentElement.addEventListener('mouseleave', () => { pointer.x = -1; pointer.y = -1; });

	// Desktop: the WebGL hover gallery and its listeners, undone on leaving the page.
	let _svcDesk: (() => void) | null = null;
	document.addEventListener('astro:before-swap', () => { _svcDesk?.(); _svcDesk = null; });

	function initServices() {
		_svcDesk?.();
		_svcDesk = null;
		const section = document.getElementById('services');
		if (!section) return;

		const rows = Array.from(section.querySelectorAll<HTMLElement>('.svc__row'));
		const list = section.querySelector<HTMLElement>('.svc__list');

		// A real mouse (and no request for less motion), on a wide screen: the picture is a WebGL
		// plane that unfolds under the pointer and trails it (see utils/hoverGallery.ts). Everyone
		// else gets the plain list.
		if (window.matchMedia('(max-width: 1024px)').matches) return;
		if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const gallery = createHoverGallery(
			section,
			rows.map((r) => ({ key: r.dataset.key!, src: r.dataset.src! })),
			// Brighter than the original's half opacity, and over the list's rules (unfold slowed from 1.75 s to 2.6 s).
			{ opacity: 0.92, above: true, openSeconds: 2.6 },
		);
		if (!gallery) return;

		// The row under the pointer is lit by the script (see .is-hot in the CSS)
		// and has the picture. The browser does not update :hover (nor send mouse
		// events) while the list scrolls under a resting pointer, so the row is found
		// from the pointer's last known position (kept across pages, see `pointer`);
		// :hover only backs it up when no position is known yet.
		const sync = () => {
			const under = pointer.x >= 0 ? document.elementFromPoint(pointer.x, pointer.y) : null;
			const row = (under && list?.contains(under) ? under.closest<HTMLElement>('.svc__row') : null)
				?? (pointer.x < 0 ? list?.querySelector('.svc__link:hover')?.closest<HTMLElement>('.svc__row') ?? null : null);
			rows.forEach((r) => r.classList.toggle('is-hot', r === row));
			gallery.setHovered(row ? row.dataset.key! : null);
		};
		let syncing = false;
		let settle = 0;
		const onScroll = () => {
			// The browser refreshes :hover a moment after a scroll stops, so check
			// again then as well as while it runs.
			clearTimeout(settle);
			settle = window.setTimeout(sync, 160);
			if (syncing) return;
			syncing = true;
			requestAnimationFrame(() => { syncing = false; sync(); });
		};
		const onLeave = () => gallery.setHovered(null);
		window.addEventListener('mousemove', sync, { passive: true });
		window.addEventListener('scroll', onScroll, { passive: true });
		document.documentElement.addEventListener('mouseleave', onLeave);
		list?.addEventListener('mouseleave', onLeave);
		rows.forEach((row) => {
			row.querySelector('a')?.addEventListener('mouseenter', sync);
			// Keyboard focus opens the picture too.
			row.querySelector('a')?.addEventListener('focus', () => gallery.setHovered(row.dataset.key!));
			row.querySelector('a')?.addEventListener('blur', onLeave);
		});
		_svcDesk = () => {
			clearTimeout(settle);
			window.removeEventListener('mousemove', sync);
			window.removeEventListener('scroll', onScroll);
			document.documentElement.removeEventListener('mouseleave', onLeave);
			gallery.destroy();
		};
	}

	onReady(initServices);
</script>
