---
// The services as a centred list of big names, a plain section right after the manifesto (which blurs out into
// the dark, see ManifestoSection). A "ghost train": as the page scrolls, each name comes up from the bottom of the
// screen out of blur, is sharp in the middle, and goes out of the top into blur again, one after another, all by
// its own position on the screen (nothing timed: the same on the way back, in the reverse order). The section is
// pulled up into the manifesto's dark last screen, so the first name is already rising as the statement is gone.
//
// The list of the 12 Studio reference (12-studio/app/src/components/sections.jsx) gave the idea (big names, a list
// of options). No hover effect: the names are plain links (an earlier version had hover pictures, then a white
// roll; both were dropped, see git history).
const services = ['Websites', 'Identity', 'Motion', 'Direction'];
---
<!-- ═══════ SERVICES: the options, a ghost train up the screen ═══════ -->
<section id="services">
	<div class="svc__body">
		<ul class="svc__list">
			{services.map((name, i) => (
				<li class="svc__row">
					<div class="svc__link">
						{name}
					</div>
				</li>
			))}
		</ul>
		<a href="/services" class="svc__btn" aria-label="View all services">
			<span class="svc__btn__line"></span>
			All services
		</a>
	</div>

</section>

<style>
	#services {
		position: relative;
		z-index: 46;
		color: rgb(var(--c-cream));
		/* Pulled up into the manifesto's last screen (dark by then, the statement blurred out): the first name is
		   just starting to rise at the bottom of the screen as it ends, so there is no long empty scroll. A name
		   is invisible while low on the screen (its blur-in by position, script), so none shows while the statement
		   is still appearing. */
		margin-top: calc(var(--app-stable-vh, 1svh) * -25);
		padding-top: clamp(1.5rem, 5vh, 3.5rem);
		padding-bottom: var(--section-space-bottom);
	}

	/* ── The list: big names, centred like a menu of options (no numbers, no rules) ─────── */
	.svc__body {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 var(--site-gutter);
	}
	.svc__list { width: 100%; list-style: none; margin: 0; padding: 0; }
	/* The names are plain text, not links: the row is a click-through band and
	   only "See more" leads to /services. */
	.svc__row { position: relative; padding: 0; display: flex; justify-content: center; pointer-events: none; }
	.svc__link {
		position: relative;
		display: block;
		width: auto;
		max-width: 100%;
		pointer-events: none;
		text-align: center;
		padding: clamp(0.9rem, 3.6vw, 1.6rem) 0;
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(3rem, 13.5vw, 8rem);
		line-height: 1.04;
		letter-spacing: 0.005em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		text-decoration: none;
	}

	.svc__btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		margin-top: clamp(2rem, 6vw, 3.5rem);
		font-family: var(--f-body);
		font-size: clamp(0.75rem, 1.1vw, 0.9rem);
		font-weight: 300;
		letter-spacing: 0.38em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.7);
		text-decoration: none;
		cursor: pointer;
	}
	.svc__btn:hover { color: rgb(var(--c-cream) / 0.9); }
	.svc__btn__line {
		display: block;
		width: 36px;
		height: 1px;
		background: rgb(var(--c-red) / 0.9);
		transform-origin: left;
		transition: width 0.35s ease;
		flex-shrink: 0;
	}
	.svc__btn:hover .svc__btn__line { width: 56px; }
	/* Touch: the link's text line is 18px tall: tap 44px. */
	@media (pointer: coarse) {
		.svc__btn::before { content: ''; position: absolute; inset: -13px 0; }
	}

	@media (min-width: 700px) and (max-width: 1024px) {
		.svc__link { font-size: clamp(5rem, 15vw, 11rem); }
	}

	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		.svc__body { position: relative; }
		.svc__link {
			/* BIG, sized by the width AND the height: the four names fill about one screen */
			padding: clamp(0.5rem, 1.6vh, 1.4rem) 0;
			font-size: clamp(3.4rem, min(11vw, 17vh), 15rem);
		}
	}
	/* The ghost train: every name's opacity, blur and lift are set by the script from where it is on the screen. No
	   transitions while it is, or they would lag behind the scroll. */
	#services [data-scrub] { transition: none !important; will-change: opacity, filter, transform; }
</style>

<script>
	import { onReady } from '../../utils/onReady';
	import { clockScrollItems } from '../../utils/clockReveal';
	import { blurPx } from '../../utils/device';

	// Everything this section starts, undone on leaving the page.
	let _svcOff: (() => void) | null = null;
	document.addEventListener('astro:before-swap', () => { _svcOff?.(); _svcOff = null; });

	function initServices() {
		_svcOff?.();
		_svcOff = null;
		const section = document.getElementById('services');
		if (!section) return;
		const offs: Array<() => void> = [];
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// ── The ghost train ─────────────────────────────────────────────────────────────────────────
		// Each name (and See more) is sharp while its centre is between ~18% and ~82% of the screen height, in blur
		// outside that. Scroll only fires the change; it plays on the clock, in and out (see utils/clockReveal.ts).
		const scrubEls = Array.from(section.querySelectorAll<HTMLElement>('.svc__row, .svc__btn'));
		if (!reduce) offs.push(clockScrollItems(scrubEls, { inAt: 0.82, outAt: 0.18, blur: blurPx(9), rise: 14, dur: 0.8 }));

		const rows = Array.from(section.querySelectorAll<HTMLElement>('.svc__row'));
		const list = section.querySelector<HTMLElement>('.svc__list');

		_svcOff = () => offs.forEach((off) => off());
	}

	onReady(initServices);
</script>
