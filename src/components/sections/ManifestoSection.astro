---
const paragraphs = [
	'Every visitor who leaves in silence is a client you never met. A weak website never complains. It simply sends your leads to someone who looks the part.',
	'Here, one person designs, codes and animates every detail, so your brand is chosen, not scrolled past.',
];
const lines = paragraphs.map((p) => p.split(' '));
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['silence', 'chosen,']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:200vh;height:200lvh;height:calc(var(--app-stable-vh) * 200);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(1.55rem,2.5vw,2.5rem);max-width:68rem;font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label={paragraphs.join(" ")}
		>
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br gap"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br.gap { height: 1em; }
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		// Touch: less blur and shorter dark stretches before/after the line, so the page never looks empty or broken.
		const touchy = true; // same short pacing on every device
		gsap.set(words, { filter: 'blur(5.5px)', opacity: touchy ? 0.35 : 0.15, y: 0 });

		// Lead-in: the faint line comes up out of the dark (the stage fades in,
		// see index.astro) before the words start to focus.
		const tl = gsap.timeline();
		tl.to({}, { duration: 0.05 });
		tl.to(words, { filter: 'blur(0px)', opacity: 1, duration: 0.4, stagger: 0.02, ease: 'none' });

		// Once the line is whole it is held, and two things happen in the hold:
		// the camera pushes in on it very slowly, and the words that carry the
		// sentence take the red, one after another.
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		const HOLD = 0.8;
		if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}
		if (picked.length && red) tl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, `-=${HOLD}`);

		// Then the whole line goes out where it stands, into blur and the dark; the services come up out of that
		// dark on their own pinned screen (it takes over exactly where this pin ends, see ServicesSection).
		if (heading) tl.to(heading, { filter: 'blur(5.5px)', opacity: 0, duration: touchy ? 0.7 : 1.6, ease: 'sine.inOut' }, tl.duration());
		tl.to({}, { duration: touchy ? 0.05 : 0.15 }); // a breath of black

		// The fill follows the scroll as before, but on touch the home page hands over its own paced position
		// (window.__heroY, see index.astro): after a hard fling the words wait until the hero's exit has played and the
		// line is up, instead of starting to fill at once.
		const apply = () => {
			const st = _manifestoST;
			if (!st) return;
			const y = (window as any).__heroY ?? window.scrollY;
			tl.progress(Math.max(0, Math.min(1, (y - st.start) / Math.max(1, st.end - st.start))));
		};
		(window as any).__heroYCb = apply;
		_manifestoST = ScrollTrigger.create({
			trigger: section,
			start: () => 'top top+=' + Math.round(window.innerHeight * 0.2),   // the words start to focus while the line is still coming up out of the dark
			end: 'bottom bottom',
			onUpdate: apply,
			onRefresh: apply,
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
		(window as any).__heroYCb = null;
	});
</script>
