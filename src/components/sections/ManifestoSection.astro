---
const lines = [
	['I', 'craft', 'digital', 'experiences', 'that', 'push', 'boundaries,'],
	['challenge', 'conventions,', 'and', 'leave', 'a', 'lasting', 'mark', 'on', 'the', 'world.'],
];
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:180vh;height:180lvh;height:calc(var(--app-stable-vh) * 180);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(2rem,3.5vw,3.2rem);font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label="I craft digital experiences that push boundaries, challenge conventions, and leave a lasting mark on the world."
		>
			{words[0].map(({ w, style }) => <span class="mw" style={style}>{w}</span>)}
			<span class="mw br"></span>
			{words[1].map(({ w, style }) => <span class="mw" style={style}>{w}</span>)}
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	/* Phones and tablets: the same pinned focus-in as desktop, but scrubbed
	   by a scroll-driven animation the browser runs alongside its own
	   scroll — no GSAP per frame (desktop's ScrollTrigger scrub lagged and
	   stuttered on phones). Each word focuses over its own slice of the
	   pinned stretch (--s/--e, same stagger as desktop). Without support
	   (Safari before 26) the words are simply there. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		@supports (animation-timeline: view()) {
			#manifesto { view-timeline-name: --manifesto; }
			#manifesto .mw:not(.br) {
				animation: mw-focus linear both;
				animation-duration: 1ms;
				animation-timeline: --manifesto;
				animation-range: contain var(--s) contain var(--e);
			}
		}
	}
	@keyframes mw-focus {
		from { filter: blur(8px); opacity: 0.15; }
		to { filter: blur(0px); opacity: 1; }
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		gsap.registerPlugin(ScrollTrigger);

		const isMobile = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches
			|| navigator.maxTouchPoints > 0
			|| window.matchMedia('(pointer: coarse)').matches;
		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');

		_manifestoST?.kill();

		// Phones/tablets: the focus-in is CSS (scroll-driven), see <style>.
		if (isMobile) return;
		gsap.set(words, { filter: 'blur(8px)', opacity: 0.15, y: 0 });

		_manifestoST = ScrollTrigger.create({
			animation: gsap.to(words, { filter: 'blur(0px)', opacity: 1, stagger: 0.1, ease: 'none' }),
			trigger: section,
			start: 'top top',
			end: 'bottom bottom',
			scrub: true,
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
	});
</script>
