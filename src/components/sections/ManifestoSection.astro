---
const paragraphs = [
	'Every visitor who leaves in silence is a client you never met. A weak website never complains. It simply sends your leads to someone who looks the part.',
	'Here, one person designs, codes and animates every detail, so your brand is chosen, not scrolled past.',
];
const lines = paragraphs.map((p) => p.split(' '));
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['silence', 'chosen,']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:180vh;height:180lvh;height:calc(var(--app-stable-vh) * 180);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<div class="mf-hold">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(1.55rem,2.5vw,2.5rem);max-width:68rem;font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label={paragraphs.join(" ")}
		>
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br gap"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
		</h2>
		</div>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	.mf-hold { width: 100%; }
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br.gap { height: 1em; }
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		gsap.set(words, { filter: 'blur(8px)', opacity: 0.15, y: 0 });

		// The words answer the SCROLL (the visitor decides the pace): they focus one after another, then the line is held (the
		// camera pushes in very slowly, the words that carry the sentence take the red one after another) and goes out where it
		// stands, into blur and the dark; the services come up out of that dark on their own pinned screen (see ServicesSection).
		const tl = gsap.timeline({ paused: true });
		// each word takes longer and overlaps its neighbours more (a wave, not a row of switches), eased both ends
		tl.to(words, { filter: 'blur(0px)', opacity: 1, stagger: 0.07, duration: 1.3, ease: 'sine.inOut' });
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		const HOLD = 1.5;
		if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}
		if (picked.length && red) tl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, `-=${HOLD}`);
		if (heading) tl.to(heading, { filter: 'blur(7px)', opacity: 0, duration: 1.0, ease: 'sine.inOut' }, '>');
		tl.to({}, { duration: 0.15 }); // a breath of black

		// The scroll is the target; the words follow it (softly) only while the gate is open. index.astro shuts it while the
		// line is out of sight (words back to fully blurred) and opens it once the line has come up: so they always start
		// blurred, and never move before the line is visible, however far the page already is.
		let target = 0;
		let open = false;
		const follow = () => { if (open) gsap.to(tl, { progress: target, duration: 1.2, ease: 'power3.out', overwrite: true }); };
		const mf = {
			reset() { open = false; gsap.killTweensOf(tl); tl.progress(0); },
			play() { open = true; follow(); },
			freeze() { open = false; gsap.killTweensOf(tl); },
			show(on: boolean) { gsap.killTweensOf(tl); open = on; tl.progress(on ? target : 0); },
		};
		(window as any).__mf = mf;

		_manifestoST = ScrollTrigger.create({
			trigger: section,
			// from the moment the line comes up (10% into the hero's exit stretch, see index.astro), not from its pinned stage,
			// so the words begin to focus at once, with no dead scroll in between
			start: () => 0.1 * (section.getBoundingClientRect().top + window.scrollY),
			end: 'bottom bottom',
			invalidateOnRefresh: true,
			onUpdate: (self) => { target = self.progress; follow(); },
			onRefresh: (self) => { target = self.progress; if (open) tl.progress(target); },
		});
		mf.show((window as any).__mfShown === true);
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
		(window as any).__mf = null;
	});
</script>
