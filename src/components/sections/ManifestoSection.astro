---
const paragraphs = [
	'Every visitor who leaves in silence is a client you never met. A weak website never complains. It simply sends your leads to someone who looks the part.',
	'Here, one person designs, codes and animates every detail, so your brand is chosen, not scrolled past.',
];
const lines = paragraphs.map((p) => p.split(' '));
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['silence', 'chosen,']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:290vh;height:290lvh;height:calc(var(--app-stable-vh) * 290);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(1.55rem,2.5vw,2.5rem);max-width:68rem;font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label={paragraphs.join(" ")}
		>
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br gap"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br.gap { height: 1em; }
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { blurPx, isTouchLayout } from '../../utils/device';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		// Touch: smaller blur (never none), the same clocked in and out as on desktop.
		const touchy = isTouchLayout();
		const B = blurPx(8);
		gsap.set(words, { filter: `blur(${B}px)`, opacity: touchy ? 0.35 : 0.15, y: 0 });
		if (heading) gsap.set(heading, { filter: 'blur(0px)', opacity: 1, scale: 1, transformOrigin: '0% 50%' });

		// The scroll only FIRES three states (dark -> shown -> gone); each change plays on the clock, in and out,
		// so the page never rests half-way in a mush of blur. The line is held while it is shown: the camera pushes
		// in very slowly and the words that carry the sentence take the red, one after another.
		const inTl = gsap.timeline({ paused: true });
		inTl.to(words, { filter: 'blur(0px)', opacity: 1, stagger: touchy ? 0.05 : 0.07, duration: 0.9, ease: 'power2.out' });
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		if (heading) inTl.to(heading, { scale: 1.04, duration: 4, ease: 'none' }, 0.4);
		if (picked.length && red) inTl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, 0.9);

		// Out: the whole line goes into blur and the dark where it stands; the services come up out of that dark on
		// their own pinned screen (it takes over exactly where this pin ends, see ServicesSection).
		const outTw = heading
			? gsap.to(heading, { filter: `blur(${blurPx(7)}px)`, opacity: 0, duration: touchy ? 0.9 : 1.2, ease: 'sine.inOut', paused: true })
			: gsap.timeline({ paused: true });

		// Where on the pin each change fires (shares of the pin; same layout as before: lead-in, line, exit).
		const P_IN = touchy ? 0.1 : 0.2, P_OUT = touchy ? 0.8 : 0.78;
		type St = 'dark' | 'shown' | 'gone';
		let st: St | null = null;
		const go = (next: St, instant: boolean) => {
			if (next === st) return;
			const jump = (st === 'dark' && next === 'gone') || (st === 'gone' && next === 'dark');
			const prev = st;
			st = next;
			const fast = jump ? 2.4 : 1;
			if (next === 'dark') {
				outTw.pause(0);
				inTl.timeScale(fast * 1.4);
				instant ? inTl.pause(0) : inTl.reverse();
			} else if (next === 'shown') {
				outTw.timeScale(1.4);
				instant ? outTw.pause(0) : outTw.reverse();
				inTl.timeScale(1);
				instant ? inTl.progress(1) : inTl.play();
			} else {
				if (prev === 'dark' || prev === null) inTl.progress(1);
				outTw.timeScale(fast);
				instant ? outTw.progress(1) : outTw.play();
			}
		};
		const stateAt = (p: number): St => (p < P_IN ? 'dark' : p < P_OUT ? 'shown' : 'gone');

		_manifestoST = ScrollTrigger.create({
			trigger: section,
			start: 'top top',
			end: 'bottom bottom',
			onUpdate: (self) => go(stateAt(self.progress), false),
			onRefresh: (self) => { if (st === null) go(stateAt(self.progress), true); },
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
	});
</script>
