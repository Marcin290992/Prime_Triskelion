---
const paragraphs = [
	'Every visitor who leaves in silence is a client you never met. A weak website never complains. It simply sends your leads to someone who looks the part.',
	'Here, one person designs, codes and animates every detail, so your brand is chosen, not scrolled past.',
];
const lines = paragraphs.map((p) => p.split(' '));
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:200vh;height:200lvh;height:calc(var(--app-stable-vh) * 200);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(1.55rem,2.5vw,2.5rem);max-width:68rem;font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label={paragraphs.join(" ")}
		>
			{words[0].map(({ w, style }) => <span class="mw" style={style} aria-hidden="true">{w}</span>)}
			<span class="mw br gap" aria-hidden="true"></span>
			{words[1].map(({ w, style }) => <span class="mw" style={style} aria-hidden="true">{w}</span>)}
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	/* Phones and tablets: a little more scroll for the whole line, so the slower going-out has room (the fill keeps its pace) */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		#manifesto { height: calc(var(--app-stable-vh) * 225) !important; }
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	/* Phones and tablets: the words are driven by utils/introStage.ts (the fill on the clock) */
	@media (hover: none) and (pointer: coarse) { .mw { will-change: filter, opacity, transform; } }
	.mw.br.gap { height: 1em; }
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	// Desktop: one scrubbed timeline. The line comes up out of the dark (its stage fades in, see index.astro), the words
	// come into focus, the camera pushes in slowly while it is held, then the line goes out into blur and the dark.
	// Phones and tablets with a touch screen do not run this: the stage (utils/introStage.ts) drives the line there.
	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		if (window.matchMedia('(hover: none) and (pointer: coarse)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');
		if (!section.querySelector(':scope > div')) return;

		manifestoST?.kill();
		manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		gsap.set(words, { filter: 'blur(5.5px)', opacity: 0.35, y: 0 });

		const tl = gsap.timeline();
		tl.to({}, { duration: 0.05 });
		tl.to(words, { filter: 'blur(0px)', opacity: 1, duration: 0.4, stagger: 0.02, ease: 'none' });

		// held whole, the camera pushes in very slowly
		const HOLD = 0.8;
		if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}

		// then the whole line goes out where it stands, into blur and the dark; the services come up out of that dark on
		// their own pinned screen. On narrow screens the going-out is slower: it also drifts up a little and pushes on.
		if (heading) {
			const narrow = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
			if (narrow) tl.to(heading, { filter: 'blur(5.5px)', opacity: 0, scale: 1.09, y: -26, duration: 1.15, ease: 'power2.inOut' }, tl.duration());
			else tl.to(heading, { filter: 'blur(5.5px)', opacity: 0, duration: 0.7, ease: 'sine.inOut' }, tl.duration());
		}
		tl.to({}, { duration: 0.05 }); // a breath of black

		manifestoST = ScrollTrigger.create({
			animation: tl,
			trigger: section,
			start: () => 'top top+=' + Math.round(window.innerHeight * 0.2),   // the words start to focus while the line is still coming up out of the dark
			end: 'bottom bottom',
			scrub: true,
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		manifestoST?.kill();
		manifestoST = null;
	});
</script>
