---
const paragraphs = [
	'Every visitor who leaves in silence is a client you never met. A weak website never complains. It simply sends your leads to someone who looks the part.',
	'Here, one person designs, codes and animates every detail, so your brand is chosen, not scrolled past.',
];
const lines = paragraphs.map((p) => p.split(' '));
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['silence', 'chosen,']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:200vh;height:200lvh;height:calc(var(--app-stable-vh) * 200);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(1.55rem,2.5vw,2.5rem);max-width:68rem;font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label={paragraphs.join(" ")}
		>
			<span class="mfs">
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br gap"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			</span>
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	/* Phones and tablets: a little more scroll for the whole line, so the slower going-out has room (the fill keeps its pace) */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		#manifesto { height: calc(var(--app-stable-vh) * 225) !important; }
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br.gap { height: 1em; }
	.mfs { display: block; transform-origin: 0% 50%; }
	/* Phones and tablets: the line fills by itself (JS, on a clock): the words come out of a soft blur from dim grey to cream,
	   the two carrying words are then wiped red. */
	#manifesto.mfx .mw { will-change: filter, opacity, transform; }
	#manifesto.mfx .mw--accent {
		background: linear-gradient(90deg, rgb(var(--c-red)) 0, rgb(var(--c-red)) 49%, var(--hc, #4a4a53) 51%, var(--hc, #4a4a53) 100%);
		background-size: 200% 100%;
		background-position: 100% 0;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	let _fillOff: (() => void) | null = null;

	// Phones and tablets: once the line is up out of the dark it fills ITSELF, on the clock, whatever the finger does: a soft
	// edge sweeps through the words in reading order (each comes out of a blur, from dim grey to cream, a hair lower to its
	// place), the whole line grows a little as it fills, and only when it is all cream the two carrying words are wiped red.
	// Leaving upward (the line is dark again) it empties quickly, ready for next time.
	function initClockFill(section: HTMLElement, words: NodeListOf<HTMLElement>): () => void {
		const CFG = { fillTime: 2.6, soft: 0.7, wordBlur: 11, grow: 0.06, redDelay: 0.15, redTime: 0.9 };
		const smooth = (x: number) => { x = Math.min(1, Math.max(0, x)); return x * x * (3 - 2 * x); };
		const rgbOf = (v: string, d: number[]) => { const a = v.split(' ').filter(Boolean).map(Number); return a.length >= 3 && a.every((n) => !isNaN(n)) ? a : d; };
		const cs = getComputedStyle(document.documentElement);
		const INK = rgbOf(cs.getPropertyValue('--c-cream'), [244, 241, 234]);
		const DIM = [74, 74, 83];
		const list = Array.from(words).map((el, i, all) => ({ el, rank: all.length > 1 ? i / (all.length - 1) : 0, hl: el.classList.contains('mw--accent') }));
		const grow = section.querySelector<HTMLElement>('.mfs');
		const S = { fill: 0, red: 0 };
		const render = () => {
			for (const w of list) {
				const e = smooth((S.fill * (1 + CFG.soft) - w.rank) / CFG.soft), st = w.el.style;
				const rgb = `rgb(${DIM.map((c, j) => Math.round(c + (INK[j] - c) * e))})`;
				if (w.hl) { st.setProperty('--hc', rgb); st.backgroundPosition = `${((1 - smooth(S.red)) * 100).toFixed(1)}% 0`; }
				else st.color = rgb;
				if (e >= 0.999) { st.filter = 'none'; st.opacity = '1'; st.transform = ''; }
				else {
					st.filter = `blur(${((1 - e) * CFG.wordBlur).toFixed(1)}px)`;
					st.opacity = (0.3 + 0.7 * e).toFixed(3);
					st.transform = `translate3d(0,${((1 - e) * 7).toFixed(1)}px,0)`;
				}
			}
			if (grow) grow.style.transform = `scale(${(1 + CFG.grow * smooth(S.fill)).toFixed(4)})`;
		};
		render();
		let on = false;
		const go = (want: boolean) => {
			if (want === on) return;
			on = want;
			gsap.killTweensOf(S);
			if (want) {
				gsap.to(S, { fill: 1, duration: CFG.fillTime, ease: 'sine.inOut', onUpdate: render,
					onComplete: () => { gsap.to(S, { red: 1, duration: CFG.redTime, delay: CFG.redDelay, ease: 'sine.inOut', onUpdate: render }); } });
			} else {
				gsap.to(S, { red: 0, fill: 0, duration: 0.7, ease: 'sine.inOut', onUpdate: render });
			}
		};
		let pinStart = 0;
		const measure = () => { pinStart = section.getBoundingClientRect().top + window.scrollY; };
		measure();
		const check = () => go(window.scrollY >= pinStart - window.innerHeight * 0.2);
		const onResize = () => { measure(); check(); };
		window.addEventListener('scroll', check, { passive: true });
		window.addEventListener('resize', onResize, { passive: true });
		check();
		return () => {
			window.removeEventListener('scroll', check);
			window.removeEventListener('resize', onResize);
			gsap.killTweensOf(S);
		};
	}

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		// Touch: less blur and shorter dark stretches before/after the line, so the page never looks empty or broken.
		const touchy = true; // same short pacing on every device
		const coarseM = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
		section.classList.toggle('mfx', coarseM);
		if (!coarseM) gsap.set(words, { filter: 'blur(5.5px)', opacity: touchy ? 0.35 : 0.15, y: 0 });

		// Lead-in: the faint line comes up out of the dark (the stage fades in,
		// see index.astro) before the words start to focus.
		const tl = gsap.timeline();
		tl.to({}, { duration: 0.05 });
		// (coarse: the same stretch of scroll, but the words are filled by the clock, below, not by the scroll)
		if (coarseM) tl.to({}, { duration: 0.4 + 0.02 * (words.length - 1) });
		else tl.to(words, { filter: 'blur(0px)', opacity: 1, duration: 0.4, stagger: 0.02, ease: 'none' });

		// Once the line is whole it is held, and two things happen in the hold:
		// the camera pushes in on it very slowly, and the words that carry the
		// sentence take the red, one after another.
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		const HOLD = 0.8;
		if (coarseM) tl.to({}, { duration: HOLD });
		else if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}
		if (!coarseM && picked.length && red) tl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, `-=${HOLD}`);

		// Then the whole line goes out where it stands, into blur and the dark; the services come up out of that
		// dark on their own pinned screen (it takes over exactly where this pin ends, see ServicesSection).
		// Phones and tablets: a slower, more cinematic going-out: the line eases into the 5.5px blur and fades while it drifts a little
		// upward and pushes on (the camera keeps moving in), instead of being switched off where it stands.
		const holdEnd = tl.duration();   // the line whole, held, the two words red: where the home scene lets the manifesto rest
		if (heading) {
			if (coarseM) tl.to(heading, { filter: 'blur(5.5px)', opacity: 0, scale: 1.09, y: -26, duration: 1.15, ease: 'power2.inOut' }, tl.duration());
			else tl.to(heading, { filter: 'blur(5.5px)', opacity: 0, duration: touchy ? 0.7 : 1.6, ease: 'sine.inOut' }, tl.duration());
		}
		tl.to({}, { duration: touchy ? 0.05 : 0.15 }); // a breath of black

		_manifestoST = ScrollTrigger.create({
			animation: tl,
			trigger: section,
			start: () => 'top top+=' + Math.round(window.innerHeight * 0.2),   // the words start to focus while the line is still coming up out of the dark
			end: 'bottom bottom',
			scrub: true,
		});
		_fillOff?.();
		_fillOff = coarseM ? initClockFill(section, words) : null;
		// the home scene (utils/homeScene.ts) rests the page here, with the manifesto whole and red
		(window as any).__manifestoST = _manifestoST;
		(window as any).__manifestoHold = holdEnd / tl.duration();
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
		_fillOff?.();
		_fillOff = null;
		(window as any).__manifestoST = null;
		(window as any).__manifestoHold = null;
	});
</script>
