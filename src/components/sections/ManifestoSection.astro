---
const lines = [
	['I', 'craft', 'digital', 'experiences', 'that', 'push', 'boundaries,'],
	['challenge', 'conventions,', 'and', 'leave', 'a', 'lasting', 'mark', 'on', 'the', 'world.'],
];
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['experiences', 'lasting', 'mark']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:330vh;height:330lvh;height:calc(var(--app-stable-vh) * 330);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-center px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100)">
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(2rem,3.5vw,3.2rem);font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label="I craft digital experiences that push boundaries, challenge conventions, and leave a lasting mark on the world."
		>
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
		</h2>
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	/* Phones and tablets use the same normal section flow and spacing as the rest of the page. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		#manifesto { height: auto !important; }
		#manifesto > .sticky {
			position: static !important;
			top: auto !important;
			height: auto !important;
			min-height: 0 !important;
			padding: var(--section-space-top) var(--site-gutter) var(--section-space-bottom) !important;
		}
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const isMobile = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches
			|| navigator.maxTouchPoints > 0
			|| window.matchMedia('(pointer: coarse)').matches;
		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		if (isMobile) {
			// Same word-by-word focus as desktop, but no pin and no extra scroll
			// height: the section stays in normal flow and the reveal is scrubbed
			// while it travels up through the viewport.
			gsap.registerPlugin(ScrollTrigger);
			gsap.set(words, { filter: 'blur(8px)', opacity: 0.15, y: 0 });
			const mtl = gsap.timeline();
			mtl.to(words, { filter: 'blur(0px)', opacity: 1, stagger: 0.1, ease: 'none' });
			const mPicked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
			const mRed = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
			if (mPicked.length && mRed) mtl.to(mPicked, { color: `rgb(${mRed})`, duration: 0.5, stagger: 0.3, ease: 'none' }, '-=1.4');
			_manifestoST = ScrollTrigger.create({
				animation: mtl,
				trigger: section,
				start: 'top 83%',
				end: 'bottom 71%',
				scrub: true,
			});
			gsap.set(content, { clearProps: 'opacity' });
			return;
		}

		gsap.registerPlugin(ScrollTrigger);
		gsap.set(words, { filter: 'blur(8px)', opacity: 0.15, y: 0 });

		// Lead-in: the faint line comes up out of the dark (the stage fades in,
		// see index.astro) before the words start to focus.
		const tl = gsap.timeline();
		tl.to({}, { duration: 1.0 });
		tl.to(words, { filter: 'blur(0px)', opacity: 1, stagger: 0.1, ease: 'none' });

		// Once the line is whole it is held, and two things happen in the hold:
		// the camera pushes in on it very slowly, and the words that carry the
		// sentence take the red, one after another.
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		const HOLD = 1.5;
		if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}
		if (picked.length && red) tl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, `-=${HOLD}`);

		// Then the whole line goes out where it stands, into blur and the dark;
		// the work section comes up out of that dark on the next scroll (it
		// pins itself exactly where this pin ends, see SelectedWorkSection).
		if (heading) tl.to(heading, { filter: 'blur(7px)', opacity: 0, duration: 1.6, ease: 'sine.inOut' }, tl.duration());
		tl.to({}, { duration: 0.15 }); // a breath of black

		_manifestoST = ScrollTrigger.create({
			animation: tl,
			trigger: section,
			start: 'top top',
			end: 'bottom bottom',
			scrub: true,
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
	});
</script>
