---
import ServicesSection from './ServicesSection.astro';
const lines = [
	['I', 'craft', 'digital', 'experiences', 'that', 'push', 'boundaries,'],
	['challenge', 'conventions,', 'and', 'leave', 'a', 'lasting', 'mark', 'on', 'the', 'world.'],
];
const count = lines.flat().length;
const total = 1 + (count - 1) * 0.1;
const slice = (i: number) => {
	const start = ((i * 0.1) / total) * 100;
	const end = ((i * 0.1 + 1) / total) * 100;
	return `--s:${start.toFixed(2)}%;--e:${end.toFixed(2)}%`;
};
const accent = new Set(['experiences', 'lasting', 'mark']);
let n = 0;
const words = lines.map((line) => line.map((w) => ({ w, style: slice(n++), accent: accent.has(w) })));
---
<!-- ═══════ MANIFESTO ═══════ -->
<section id="manifesto" class="relative" style="height:280vh;height:280lvh;height:calc(var(--app-stable-vh) * 280);z-index:10">
	<div class="sticky top-0 h-lvh flex flex-col items-start justify-start px-8 sm:px-16 md:px-24 desk:px-32" style="height:calc(var(--app-stable-vh) * 100);padding-top:clamp(5.5rem,16vh,10rem)">
		<!-- The label of the Expertise screen: the manifesto below is its heading, and the services names sit
		     under it in the same pinned stage (ServicesSection, below): nothing scrolls in, the timeline brings
		     the names in where they stand. -->
		<h6 class="mf-label">Expertise</h6>
		<h2
			class="font-bold leading-[1.15] tracking-[-0.03em] m-0"
			style="font-size:clamp(2rem,3.5vw,3.2rem);font-family:var(--f-body);color:rgb(var(--c-cream))"
			aria-label="I craft digital experiences that push boundaries, challenge conventions, and leave a lasting mark on the world."
		>
			{words[0].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
			<span class="mw br"></span>
			{words[1].map(({ w, style, accent }) => <span class:list={['mw', accent && 'mw--accent']} style={style}>{w}</span>)}
		</h2>
		<ServicesSection />
	</div>
</section>

<style>
	#manifesto > .sticky {
		width: 100%;
		padding-left: var(--site-gutter) !important;
		padding-right: var(--site-gutter) !important;
		box-sizing: border-box;
	}
	.mf-label {
		margin: 0 0 1.4rem;
		font-family: var(--f-body);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.32;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.6);
		user-select: none;
	}
	.mw {
		display: inline-block;
		margin-right: 0.3em;
	}
	.mw.br {
		display: block;
		height: 0;
		margin: 0;
		pointer-events: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';

	let _manifestoST: ReturnType<typeof ScrollTrigger.create> | null = null;

	function initManifesto() {
		const section = document.getElementById('manifesto');
		if (!section) return;
		const content = section.querySelector<HTMLElement>(':scope > div');
		if (!content) return;

		const words = section.querySelectorAll<HTMLElement>('.mw:not(.br)');
		const heading = section.querySelector<HTMLElement>('h2');

		_manifestoST?.kill();
		_manifestoST = null;
		gsap.registerPlugin(ScrollTrigger);
		gsap.set(words, { filter: 'blur(8px)', opacity: 0.15, y: 0 });

		// Lead-in: the faint line comes up out of the dark (the stage fades in,
		// see index.astro) before the words start to focus.
		const tl = gsap.timeline();
		tl.to({}, { duration: 1.0 });
		tl.to(words, { filter: 'blur(0px)', opacity: 1, stagger: 0.1, ease: 'none' });

		// Once the line is whole it is held, and two things happen in the hold:
		// the camera pushes in on it very slowly, and the words that carry the
		// sentence take the red, one after another.
		const picked = Array.from(section.querySelectorAll<HTMLElement>('.mw--accent'));
		const red = getComputedStyle(document.documentElement).getPropertyValue('--c-red').trim().split(/\s+/).join(',');
		const HOLD = 1.5;
		if (heading) {
			gsap.set(heading, { transformOrigin: '0% 50%' });
			tl.to(heading, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		}
		if (picked.length && red) tl.to(picked, { color: `rgb(${red})`, duration: 0.5, stagger: 0.3, ease: 'none' }, `-=${HOLD}`);

		// Then the same screen turns to the services: the statement and its label lift away (still
		// the same pinned stage, nothing scrolls in) and the services names, BIG, come out of blur
		// where they stand, one after another. They are hidden until then, so they cannot be
		// clicked early; scrolling back up undoes it.
		const names = section.querySelectorAll<HTMLElement>('.svc__row');
		const label = section.querySelector<HTMLElement>('.mf-label');
		gsap.set(names, { autoAlpha: 0, y: 24, filter: 'blur(10px)' });
		const turn = tl.duration();
		const leaving = [label, heading].filter(Boolean) as HTMLElement[];
		tl.to(leaving, { y: () => -window.innerHeight * 0.14, opacity: 0, filter: 'blur(8px)', duration: 1.0, ease: 'power1.in' }, turn);
		tl.to(names, { autoAlpha: 1, y: 0, filter: 'blur(0px)', stagger: 0.22, duration: 0.8, ease: 'none' }, turn + 0.3);
		tl.to({}, { duration: 0.8 }); // the names stay a while, pinned

		_manifestoST = ScrollTrigger.create({
			animation: tl,
			trigger: section,
			start: 'top top',
			end: 'bottom bottom',
			scrub: true,
		});
	}

	document.addEventListener('astro:page-load', () => {
		setTimeout(() => { initManifesto(); ScrollTrigger.refresh(); }, 200);
	});

	document.addEventListener('astro:before-swap', () => {
		_manifestoST?.kill();
		_manifestoST = null;
	});
</script>
