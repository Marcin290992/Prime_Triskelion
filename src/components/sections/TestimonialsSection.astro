<!-- ═══════ TESTIMONIALS ═══════ -->
<!-- One quote at a time, set large, changing by itself every few seconds
     (initTestimonials) — the outgoing words drift up and out, the next
     quote's words come into focus one after another. The red hairline at
     the foot fills toward the next change; the arrows step back and forth
     by hand. -->
<section id="testimonials">
	<div class="tst__inner">
		<div class="tst__label">(Client Stories)</div>

		<blockquote class="tst__quote">
			<span class="tst__mark" aria-hidden="true">“</span>
			<p class="tst__text" id="tstText"></p>
		</blockquote>

		<div class="tst__author" id="tstAuthor">
			<span class="tst__line" aria-hidden="true"></span>
			<div>
				<p class="tst__name" id="tstName"></p>
				<p class="tst__role" id="tstRole"></p>
			</div>
		</div>

		<div class="tst__foot">
			<div class="tst__nav">
				<button type="button" class="tst__btn" id="tstPrev" aria-label="Previous story"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
				<button type="button" class="tst__btn" id="tstNext" aria-label="Next story"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
			</div>
			<div class="tst__progress" aria-hidden="true"><span id="tstProgress"></span></div>
			<span class="tst__count" id="tstCounter" aria-hidden="true">01 / 03</span>
		</div>
	</div>
</section>

<style>
	#testimonials {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
		background: rgb(var(--c-bg));
	}
	.tst__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(1.75rem, 4vh, 3rem);
		width: min(100%, 1100px);
		margin: 0 auto;
		padding: var(--section-space-top) var(--site-gutter) var(--section-space-bottom);
		box-sizing: border-box;
	}
	.tst__label {
		font-family: var(--f-body);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.55);
	}
	.tst__quote {
		position: relative;
		margin: 0;
	}
	.tst__mark {
		display: block;
		font-family: var(--f-display);
		font-weight: 700;
		font-size: clamp(4rem, 9vw, 8rem);
		line-height: 0.6;
		color: rgb(var(--c-red));
		margin-bottom: 0.15em;
	}
	.tst__text {
		margin: 0;
		font-family: var(--f-body);
		font-weight: 300;
		font-size: clamp(1.55rem, 4.2vw, 3.2rem);
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: rgb(var(--c-cream));
		max-width: 26ch;
		/* Room for the longest quote so the author line doesn't jump. */
		min-height: 3.75em;
	}
	/* Each word animates on its own (see initTestimonials). */
	.tst__text :global(.tw) { display: inline-block; white-space: pre; will-change: transform, opacity; }
	.tst__author {
		display: flex;
		align-items: center;
		gap: 1rem;
		transition: opacity 0.4s ease;
	}
	.tst__line {
		width: 36px;
		height: 1px;
		background: rgb(var(--c-red));
		flex: none;
	}
	.tst__name {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: rgb(var(--c-cream));
	}
	.tst__role {
		margin: 0.25rem 0 0;
		font-family: var(--f-body);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.55);
	}
	.tst__foot {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: clamp(0.5rem, 2vh, 1.5rem);
	}
	/* Prev/next — square hairline buttons like the footer's icons. */
	.tst__nav { display: flex; gap: 0.5rem; flex: none; }
	.tst__btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid rgb(var(--c-cream) / 0.16) !important;
		color: rgb(var(--c-cream) / 0.7);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
	}
	.tst__btn svg { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
	@media (hover: hover) {
		.tst__btn:hover {
			color: rgb(var(--c-cream));
			border-color: rgb(var(--c-red) / 0.5) !important;
			background-color: rgb(var(--c-red) / 0.06);
		}
		#tstPrev:hover svg { transform: translateX(-3px); }
		#tstNext:hover svg { transform: translateX(3px); }
	}
	.tst__btn:focus:not(:focus-visible) { outline: none; }
	.tst__progress {
		flex: 1 1 auto;
		max-width: 22rem;
		height: 1px;
		background: rgb(var(--c-cream) / 0.14);
		overflow: hidden;
	}
	.tst__progress span {
		display: block;
		height: 100%;
		background: rgb(var(--c-red));
		transform-origin: left center;
		transform: scaleX(0);
	}
	.tst__count {
		font-family: var(--f-body);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.28em;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--c-cream) / 0.6);
	}
</style>

<script>
	import gsap from 'gsap';
	import { onReady } from '../../utils/onReady';

	// Placeholder content — swap for real client quotes/names/roles.
	const testimonialsData = [
		{ text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Placeholder testimonial text — swap for a real client quote.', name: 'Client Name', role: 'Role, Company' },
		{ text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Placeholder testimonial text — swap for a real client quote.', name: 'Client Name', role: 'Role, Company' },
		{ text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Placeholder testimonial text — swap for a real client quote.', name: 'Client Name', role: 'Role, Company' },
	];

	// Seconds each quote stays before the next one comes in.
	const AUTOPLAY_DURATION = 6;

	let _tstOff: (() => void) | null = null;

	function initTestimonials() {
		_tstOff?.();
		_tstOff = null;
		const section = document.getElementById('testimonials');
		const textEl = section?.querySelector<HTMLElement>('#tstText');
		const nameEl = section?.querySelector<HTMLElement>('#tstName');
		const roleEl = section?.querySelector<HTMLElement>('#tstRole');
		const author = section?.querySelector<HTMLElement>('#tstAuthor');
		const bar = section?.querySelector<HTMLElement>('#tstProgress');
		const counter = section?.querySelector<HTMLElement>('#tstCounter');
		const prevBtn = section?.querySelector<HTMLButtonElement>('#tstPrev');
		const nextBtn = section?.querySelector<HTMLButtonElement>('#tstNext');
		if (!section || !textEl || !nameEl || !roleEl || !author || !bar || !counter) return;

		const count = testimonialsData.length;
		const total = String(count).padStart(2, '0');

		// Same focus-in on every device; only reduced motion skips the blur.
		const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const hidden = calm ? { opacity: 0, y: 14 } : { opacity: 0, y: 14, filter: 'blur(10px)' };
		const shown = calm ? { opacity: 1, y: 0 } : { opacity: 1, y: 0, filter: 'blur(0px)' };

		const words = (text: string) => {
			textEl.textContent = '';
			return text.split(' ').map((w, i, all) => {
				const s = document.createElement('span');
				s.className = 'tw';
				s.textContent = i < all.length - 1 ? `${w} ` : w;
				textEl.appendChild(s);
				return s;
			});
		};

		let current = 0;
		let swap: gsap.core.Timeline | null = null;
		// While a quote is changing (out and back in), the arrows wait.
		let busy = false;
		// The hairline fills over each quote's time; when it's full, the
		// next quote comes in. Paused while the section is off screen.
		const timer = gsap.fromTo(bar, { scaleX: 0 }, {
			scaleX: 1,
			duration: AUTOPLAY_DURATION,
			ease: 'none',
			paused: true,
			onComplete: () => show((current + 1) % count),
		});

		const reveal = (i: number) => {
			const data = testimonialsData[i];
			const incoming = words(data.text);
			nameEl.textContent = data.name;
			roleEl.textContent = data.role;
			counter.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
			gsap.set(incoming, hidden);
			gsap.to(incoming, { ...shown, duration: calm ? 0.3 : 0.8, ease: 'power2.out', stagger: calm ? 0 : 0.035, onComplete: () => { busy = false; } });
			gsap.to(author, { opacity: 1, duration: 0.5, delay: 0.3 });
			timer.restart();
			if (!visible) timer.pause();
		};

		const show = (i: number) => {
			busy = true;
			current = i;
			const outgoing = Array.from(textEl.querySelectorAll<HTMLElement>('.tw'));
			swap?.kill();
			swap = gsap.timeline();
			swap.to(outgoing, { opacity: 0, y: -12, duration: 0.3, ease: 'power2.in', stagger: 0.012 })
				.to(author, { opacity: 0, duration: 0.25 }, 0)
				.add(() => reveal(i));
		};

		// Laid out but hidden until the section comes into view, so the
		// first quote's entrance is seen.
		gsap.set(words(testimonialsData[0].text), hidden);
		nameEl.textContent = testimonialsData[0].name;
		roleEl.textContent = testimonialsData[0].role;
		gsap.set(author, { opacity: 0 });

		let visible = false;
		let started = false;
		const io = new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			if (visible && !started) {
				started = true;
				reveal(0);
			} else if (started) {
				visible ? timer.resume() : timer.pause();
			}
		}, { threshold: 0.35 });
		io.observe(section);

		// By hand: step back or forward; the timer starts over on the new one.
		const step = (dir: number) => {
			if (busy) return;
			if (!started) { started = true; }
			show((current + dir + count) % count);
		};
		const onPrev = () => step(-1);
		const onNext = () => step(1);
		prevBtn?.addEventListener('click', onPrev);
		nextBtn?.addEventListener('click', onNext);

		_tstOff = () => {
			prevBtn?.removeEventListener('click', onPrev);
			nextBtn?.removeEventListener('click', onNext);
			io.disconnect();
			swap?.kill();
			timer.kill();
		};
	}

	document.addEventListener('astro:before-swap', () => {
		_tstOff?.();
		_tstOff = null;
	});

	onReady(initTestimonials);
</script>
