---
import { Image } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
// deeer2.webp is a huge test-only source file (7360px wide). Piping the
// raw import straight into a plain <img src={deeer2.src}> — what this file
// used everywhere below at first — shipped and decoded that full-size
// original in every one of these small boxes, which is heavy enough to
// visibly jank scrolling specifically on iOS Safari's compositor when
// combined with this section's opacity/transform reveal + the grayscale
// filter on .wr-img-inner img. <Image> generates a properly-downscaled
// asset instead — width/height below match .wr-img-inner's own 4:3
// aspect-ratio.
---
<section id="selected-work">

	<div class="sw-header">
		<h2 class="sw-header__title">What we've<br><em>built.</em></h2>
	</div>

	<div class="scroll-section" id="sw-scroll-section">
		<div class="sticky-view">
			<div class="track" id="sw-track">

				<div class="slide slide-intro">
					<h2>What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn">View All Projects +</a>
				</div>

				<div class="slide slide-card card-fade">
					<a href="/winds-of-sinai" class="img-box">
						<img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Winds Of Sinai">
					</a>
					<div class="card-info">
						<div>
							<a href="/winds-of-sinai" class="card-title-link"><h3>Winds Of Sinai</h3></a>
							<p>Luxury travel brand identity &amp; digital presence</p>
						</div>
						<a href="/winds-of-sinai" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/unfallfix24" class="img-box">
						<img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="UnfallFix24">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/unfallfix24" class="card-title-link"><h3>UnfallFix24</h3></a>
							<p>Accident reporting &amp; claims management platform</p>
						</div>
						<a href="/work/unfallfix24" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/mousa-export" class="img-box">
						<img src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Mousa Export">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/mousa-export" class="card-title-link"><h3>Mousa Export</h3></a>
							<p>International export logistics platform</p>
						</div>
						<a href="/work/mousa-export" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Steak Club">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Steak Club</h3></a>
							<p>Premium steakhouse brand with booking system</p>
						</div>
						<a href="#" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1511379938547-c1f69419868d?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Josh Jabs">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Josh Jabs</h3></a>
							<p>Personal brand &amp; portfolio for a musician</p>
						</div>
						<a href="#" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1600607686527-6fb886090705?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Umzugsservice">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Umzugsservice</h3></a>
							<p>Moving service with SEO &amp; lead generation</p>
						</div>
						<a href="#" class="link-btn no-border">Explore &#8594;</a>
					</div>
				</div>

				<div class="slide slide-curtain" id="sw-curtain">
					<div class="parallax-text" id="sw-curtain-text">
						<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
					</div>
				</div>

				<div class="slide slide-final" id="sw-final-slide">
					<h2 class="final-title">A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
				</div>

			</div>
		</div>
	</div>

	<div class="work-list">

		<a href="/winds-of-sinai" class="work-row">
			<span class="wr-num">01</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">Winds Of Sinai</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">Luxury travel brand identity &amp; digital presence</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Branding</span><span>#Web</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</a>

		<a href="/work/unfallfix24" class="work-row">
			<span class="wr-num">02</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">UnfallFix24</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">Accident reporting &amp; claims management platform</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Webseite</span><span>#Software</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</a>

		<a href="/work/mousa-export" class="work-row">
			<span class="wr-num">03</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">Mousa Export</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">International export logistics platform</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Webseite</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</a>

		<div class="work-row" role="button" tabindex="0">
			<span class="wr-num">04</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">Steak Club</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">Premium steakhouse brand with booking system</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Webseite</span><span>#Branding</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</div>

		<div class="work-row" role="button" tabindex="0">
			<span class="wr-num">05</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">Josh Jabs</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">Personal brand &amp; portfolio for a musician</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Webseite</span><span>#Branding</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</div>

		<div class="work-row" role="button" tabindex="0">
			<span class="wr-num">06</span>
			<div class="wr-img-col">
				<div class="wr-expand"><div class="wr-expand-inner">
					<div class="wr-img-inner"><Image src={deeer2} alt="" width={640} height={480} loading="lazy" /></div>
				</div></div>
			</div>
			<div class="wr-content">
				<h3 class="wr-title">Umzugsservice</h3>
				<div class="wr-expand"><div class="wr-expand-inner">
					<p class="wr-desc">Moving service with SEO &amp; lead generation</p>
				</div></div>
			</div>
			<div class="wr-tags"><span>#Webseite</span><span>#SEO</span></div>
			<div class="wr-toggle" aria-hidden="true">
				<svg class="wr-arrow" viewBox="0 0 20 20" fill="none"><line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="11,5 16,10 11,15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
		</div>

	</div>

</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
	}

	/* Header — mobile only */
	.sw-header {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) clamp(1.8rem, 3.8vh, 3.5rem);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.sw-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.sw-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 11rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.sw-header__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Horizontal scroll */
	.scroll-section {
		height: 700vh;
		position: relative;
		display: none;
	}
	.sticky-view {
		position: sticky;
		top: 0;
		height: 100vh;
		width: 100%;
		overflow: hidden;
		background-color: rgb(var(--c-bg));
	}
	.track {
		display: flex;
		height: 100%;
		align-items: center;
		padding-left: 10vw;
		gap: 10vw;
		will-change: transform;
	}
	.slide { flex-shrink: 0; will-change: transform, opacity; }

	/* Intro */
	.slide-intro { width: 42vw; padding-right: 5vw; }
	.slide-intro h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 11rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		/* No white-space:nowrap — .slide-intro has flex-shrink:0 (needed for
		   the horizontal-scroll track's width math), so at laptop widths the
		   vw-scaled font-size can render wider than the fixed-width column;
		   nowrap then let it spill straight onto the neighboring image
		   instead of wrapping to a 3rd line like a normal heading would. */
		margin-bottom: 2.5rem;
	}
	.slide-intro h2 em { font-style: normal; color: rgb(var(--c-red)); }

	/* Cards */
	.slide-card {
		width: 45vw;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 2.5rem;
		padding: 1rem 1rem 1.4rem;
		border: 1px solid rgba(255,255,255,0.06);
		background: rgba(255,255,255,0.018);
	}
	.img-box {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background-color: #0d0d0f;
		border: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 8px 40px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.3);
	}
	.img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.2);
	}
	.card-info { display: flex; justify-content: space-between; align-items: flex-start; }
	.card-title-link { text-decoration: none; display: block; }
	.card-info h3 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		margin-bottom: 0.5rem;
	}
	.card-info p {
		font-family: var(--f-body);
		font-size: 0.9rem;
		font-weight: 300;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.42);
		max-width: 320px;
	}

	.link-btn {
		font-family: var(--f-body);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		position: relative;
		padding-bottom: 4px;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream) / 0.25);
		transform: scaleX(1);
		transform-origin: left;
		transition: background 0.3s ease;
	}
	@media (hover: hover) {
		.link-btn:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn:hover::after {
			background: rgb(var(--c-cream));
		}
	}

	.link-btn.no-border {
		border: none;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn.no-border::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-red));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.link-btn.no-border:hover {
			color: rgb(var(--c-red));
			transform: translateX(5px);
		}
		.link-btn.no-border:hover::after {
			transform: scaleX(1);
		}
	}

	/* Curtain */
	.slide-curtain {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0 15vw 0 10vw;
		position: relative;
		z-index: 5;
		overflow: hidden;
	}
	.parallax-text { will-change: transform; }
	.slide-curtain h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2rem, 3.8vw, 4rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 1.05;
		color: rgb(var(--c-cream));
		margin-bottom: 2rem;
	}

	/* Final slide */
	.slide-final {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		margin-left: -10vw;
		will-change: transform;
	}
	.final-title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: 11vw;
		line-height: 0.85;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-align: center;
		color: rgb(var(--c-cream));
	}
	.final-footer {
		position: absolute;
		bottom: 10%;
		width: 90%;
		font-family: var(--f-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: rgb(var(--c-cream) / 0.4);
	}

	/* Mobile list rows */
	.work-list {
		width: 100%;
		padding: 0 var(--site-gutter) var(--section-space-bottom);
		box-sizing: border-box;
	}
	.work-row {
		display: grid;
		grid-template-columns: clamp(2.5rem, 4vw, 4rem) clamp(160px, 22vw, 280px) 1fr clamp(140px, 18vw, 240px) 48px;
		gap: clamp(1rem, 3vw, 3rem);
		padding: clamp(2rem, 3.2vw, 3.8rem) clamp(0.5rem, 1vw, 1rem);
		align-items: start;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
		background: transparent;
		opacity: 0;
		transform: translateY(14px);
		filter: blur(8px);
		transition: background 0.4s ease, opacity 0.6s ease,
		            transform 0.6s cubic-bezier(0.16,1,0.3,1), filter 0.8s cubic-bezier(0.16,1,0.3,1);
	}
	.work-row.visible { opacity: 1; transform: translateY(0); filter: blur(0); }
	@media (hover: hover) {
		.work-row:hover { background: rgba(255,255,255,0.026); }
	}

	.wr-expand {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.38s cubic-bezier(0.25,1,0.5,1);
	}
	.wr-expand-inner { overflow: hidden; }
	@media (hover: hover) {
		.work-row:hover .wr-expand {
			grid-template-rows: 1fr;
			transition: grid-template-rows 0.52s cubic-bezier(0.25,1,0.5,1) 0.25s;
		}
	}

	.wr-num {
		font-family: var(--f-body);
		font-size: 11px;
		font-weight: 300;
		letter-spacing: 0.3em;
		color: rgb(var(--c-cream) / 0.28);
		padding-top: 0.4rem;
		transition: color 0.3s ease;
	}
	@media (hover: hover) {
		.work-row:hover .wr-num { color: rgb(var(--c-red) / 0.75); transition: color 0.4s ease 0.25s; }
	}

	.wr-img-inner {
		width: 100%;
		aspect-ratio: 4 / 3;
		background: #0d0d0f;
		border: 1px solid rgba(255,255,255,0.05);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		opacity: 0;
		transform: scale(0.97);
		transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.work-row:hover .wr-img-inner {
			opacity: 1;
			transform: scale(1);
			transition: opacity 0.42s ease 0.3s, transform 0.52s cubic-bezier(0.25,1,0.5,1) 0.28s;
		}
	}
	.wr-img-inner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: grayscale(100%) contrast(1.05) brightness(0.8);
		/* iOS Safari doesn't reliably promote a filtered element to its own
		   compositor layer on its own — scrolling six of these past the
		   viewport in a row can fall back to repainting each one on every
		   scroll frame instead of just translating a cached layer, which is
		   what reads as this section specifically janking/stuttering there
		   (Chrome's compositor doesn't have the same gap, hence fine there).
		   translateZ(0) is the standard, well-worn nudge that forces the
		   promotion explicitly. */
		transform: translateZ(0);
		-webkit-transform: translateZ(0);
	}
	.wr-content { display: flex; flex-direction: column; }
	.wr-title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.3rem, 1.8vw, 2rem);
		letter-spacing: -0.01em;
		text-transform: uppercase;
		line-height: 1.05;
		color: rgb(var(--c-cream) / 0.35);
		margin: 0;
		transition: font-size 0.35s cubic-bezier(0.25,1,0.5,1),
		            color 0.3s ease,
		            margin-bottom 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.work-row:hover .wr-title {
			font-size: clamp(2rem, 3.2vw, 3.8rem);
			color: rgb(var(--c-cream));
			margin-bottom: 0.9rem;
			transition: font-size 0.52s cubic-bezier(0.25,1,0.5,1) 0.25s,
			            color 0.4s ease 0.25s,
			            margin-bottom 0.52s cubic-bezier(0.25,1,0.5,1) 0.25s;
		}
	}
	.wr-desc {
		font-family: var(--f-body);
		font-size: clamp(0.78rem, 1vw, 0.9rem);
		font-weight: 300;
		color: rgb(var(--c-cream) / 0.42);
		line-height: 1.7;
		margin: 0;
		padding-bottom: 0.5rem;
	}

	.wr-tags { display: flex; flex-wrap: wrap; gap: 0.2rem 0.6rem; padding-top: 0.4rem; align-content: flex-start; }
	.wr-tags span {
		font-family: var(--f-body);
		font-size: clamp(0.68rem, 0.9vw, 0.82rem);
		font-weight: 300;
		letter-spacing: 0.04em;
		color: rgb(var(--c-cream) / 0.3);
		transition: color 0.3s ease;
	}
	@media (hover: hover) {
		.work-row:hover .wr-tags span { color: rgb(var(--c-cream) / 0.62); transition: color 0.4s ease 0.25s; }
	}

	.wr-toggle {
		width: 36px; height: 36px;
		border-radius: 50%;
		border: 1px solid rgba(255,255,255,0.14);
		display: flex; align-items: center; justify-content: center;
		flex-shrink: 0; margin-top: 0.2rem;
		transition: border-color 0.3s ease;
	}
	.wr-arrow {
		width: 16px; height: 16px;
		color: rgb(var(--c-cream) / 0.45);
		transition: transform 0.3s cubic-bezier(0.25,1,0.5,1), color 0.3s ease;
		flex-shrink: 0;
	}
	@media (hover: hover) {
		.work-row:hover .wr-toggle { border-color: rgb(var(--c-red) / 0.55); transition: border-color 0.4s ease 0.25s; }
		.work-row:hover .wr-arrow { transform: rotate(-45deg); color: rgb(var(--c-red)); transition: transform 0.4s cubic-bezier(0.25,1,0.5,1) 0.25s, color 0.4s ease 0.25s; }
	}

	@media (min-width: 1025px) {
		.scroll-section { display: block; }
		.sw-header { display: none; }
		.work-list { display: none; }
	}

	@media (min-width: 1025px) and (max-width: 1600px) {
		.track { padding-left: 5vw; gap: 5vw; }
		.slide-intro { width: 44vw; padding-right: 2vw; }
		.slide-card { width: 42vw; }
		.slide-intro h2 { font-size: clamp(3rem, 6vw, 8rem); }
	}

	/* Laptop-height viewports: the card (16/10 image + info block + the
	   decorative margin-top) is tall enough that, vertically centred in the
	   sticky 100vh view, its footer runs into the fixed MENU button. Keep
	   the card WIDTH untouched (it drives the horizontal-scroll track math
	   and the final-slide reveal) — only drop the decorative offset and
	   flatten the image to a cinematic crop to reclaim the height. */
	@media (min-width: 1025px) and (max-height: 1000px) {
		.slide-card { margin-top: 0; }
		.img-box { aspect-ratio: 2 / 1; }
	}

	@media (min-width: 1025px) and (max-height: 820px) {
		.img-box { aspect-ratio: 21 / 9; }
	}

	/* Final slide headline had only a vw size — on short laptops the four
	   lines overflowed the viewport top/bottom (and the wide words bled off
	   the sides), so the closing reveal looked broken. Cap it against height
	   too. */
	@media (min-width: 1025px) and (max-height: 1000px) {
		.final-title { font-size: min(11vw, 13.5vh); }
	}

	@media (max-width: 1024px) {
		.wr-expand    { grid-template-rows: 1fr !important; }
		/* :has(img) — not a blanket .wr-img-inner rule — because projects
		   04/05/06 have no <img> at all, just a bare number watermark
		   (.wr-img-num) sitting on this box's own #0d0d0f fill. Forcing
		   opacity:1 unconditionally reveals that fill for those rows too: a
		   visibly lighter-than-black rectangle with nothing in it but a
		   number, on every mobile page that renders this section (this is
		   Home's SelectedWorkSection, not a per-page thing) — reported and
		   confirmed by measuring actual rendered pixels (#0d0d0f ≈ the
		   measured RGB, well above the surrounding page's near-#000). Rows
		   with a real <img> still need this: without it they're invisible
		   on mobile (no :hover to reveal them there), which is what this
		   rule originally existed to fix. Placeholder-only rows are better
		   left at their default opacity:0 — the empty grid cell blends with
		   the page's own black instead of showing a boxed-in placeholder. */
		.wr-img-inner:has(img) { opacity: 1 !important; transform: scale(1) !important; }
		.wr-title     { font-size: clamp(1.3rem, 5vw, 2rem) !important; color: rgb(var(--c-cream)) !important; margin-bottom: 0.4rem !important; }
		.wr-tags span { color: rgb(var(--c-cream) / 0.5) !important; }
	}

	/* Was max-width: 768px (phone only) — the tablet range (769-1024px)
	   fell through to the row-grid layout above instead, which relies on
	   :hover to reveal .wr-img-inner (opacity:0 by default). Tablets have
	   no hover, so the thumbnail never appeared — just the empty dark box
	   with its number watermark. Reusing the already-solid stacked mobile
	   layout for the whole ≤1024px range (instead of designing a third,
	   separate tablet treatment) sidesteps that entirely. */
	@media (max-width: 1024px) {
		.work-list { padding-bottom: clamp(3rem, 8vw, 5rem); }
		.work-row {
			grid-template-columns: 2.5rem 1fr;
			grid-template-rows: auto auto auto;
			grid-template-areas: 'num content' 'img img' 'tags tags';
			gap: 0.5rem 0.8rem;
			padding: clamp(1.4rem, 4vw, 2rem) 0;
			transition: none !important;
		}
		.wr-num     { grid-area: num; padding-top: 0.25rem; }
		.wr-content { grid-area: content; }
		.wr-img-col { grid-area: img; }
		.wr-tags    { grid-area: tags; padding-top: 0; }
		.wr-toggle  { display: none; }
		.wr-img-inner { aspect-ratio: 16 / 9; margin-top: 0.4rem; }
		/* Dropped entirely on mobile rather than just GPU-layer-promoted —
		   it wasn't earning its cost there (desktop's hover-reveal is the
		   whole reason it existed) and mobile should stay as light as
		   possible. */
		.wr-img-inner img { filter: none; }
		.wr-desc      { font-size: 0.82rem; line-height: 1.65; }
		.wr-tags      { gap: 0.2rem 0.5rem; }
		.wr-tags span { font-size: 0.7rem; }
		.sw-header__title { font-size: clamp(2.4rem, 10vw, 5rem); }
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';

	function initSelectedWork() {
		const section = document.getElementById('selected-work');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px)').matches) {
			section.querySelector<HTMLElement>('.sw-header')?.classList.add('visible');
			section.querySelectorAll<HTMLElement>('.work-row').forEach(r => r.classList.add('visible'));
			return;
		}

		const ss = document.getElementById('sw-scroll-section')!;
		const tr = document.getElementById('sw-track')!;
		const ce = document.getElementById('sw-curtain')!;
		const ct = document.getElementById('sw-curtain-text')!;
		const fs = document.getElementById('sw-final-slide')!;
		const cards      = Array.from(section.querySelectorAll<HTMLElement>('.card-anim'));
		const fadeCards  = Array.from(section.querySelectorAll<HTMLElement>('.card-fade'));
		const images = Array.from(section.querySelectorAll<HTMLElement>('.img-parallax'));

		/* All layout reads happen in measure() (init + resize only); tick() works
		   off cached offsets + window.scrollY so the frame never forces a reflow.
		   Easing is time-based: identical feel to the old 0.055/frame constant at
		   60 fps, but consistent on 120/144 Hz displays too. */
		const EASE_PER_SECOND = -Math.log(1 - 0.055) * 60;

		let currentX = 0;
		let maxScroll = 0;
		let sectionTop = 0;
		let scrollableH = 1;
		let rafId = 0;
		let lastTime = 0;

		const cardX = new Array<number>(cards.length);
		const fadeX = new Array<number>(fadeCards.length);
		const imgBoxes: { el: HTMLElement; left: number; width: number }[] = [];
		let curtainX = 0;

		function measure() {
			maxScroll = tr.scrollWidth - window.innerWidth;
			sectionTop = ss.getBoundingClientRect().top + window.scrollY;
			scrollableH = Math.max(1, ss.offsetHeight - window.innerHeight);
			curtainX = ce.offsetLeft;
			cards.forEach((card, i) => { cardX[i] = card.offsetLeft; });
			fadeCards.forEach((card, i) => { fadeX[i] = card.offsetLeft; });
			imgBoxes.length = 0;
			images.forEach(img => {
				const box = img.parentElement!;
				imgBoxes.push({ el: img, left: box.offsetLeft, width: box.offsetWidth });
			});
		}

		function tick(now: number) {
			const dt = Math.min((now - lastTime) / 1000, 0.1);
			lastTime = now;

			const progress = Math.max(0, Math.min(1, (window.scrollY - sectionTop) / scrollableH));
			const targetX = progress * maxScroll;

			currentX += (targetX - currentX) * (1 - Math.exp(-EASE_PER_SECOND * dt));
			tr.style.transform = `translate3d(-${currentX}px,0,0)`;

			const vw = window.innerWidth;

			const distToEnd = maxScroll - currentX;
			fs.style.transform = distToEnd < vw * 1.5
				? `translate3d(-${distToEnd * 0.5}px,0,0)`
				: 'translate3d(0,0,0)';

			const maxY = window.innerHeight * 0.55;
			cards.forEach((card, i) => {
				const sp = (cardX[i] - currentX) / vw;
				const lp = Math.max(0, (sp - 0.5) * 2);
				card.style.transform = `translate3d(0,${Math.min(lp * maxY, maxY)}px,0)`;
			});

			fadeCards.forEach((card, i) => {
				const sp = (fadeX[i] - currentX) / vw;
				card.style.opacity = String(Math.max(0, Math.min(1, (1 - sp) * 2)));
			});

			const cp = (curtainX - currentX) / vw;
			if (cp < 1.2 && cp > -1) ct.style.transform = `translate3d(${cp * 200}px,0,0)`;

			imgBoxes.forEach(d => {
				const left = d.left - currentX;
				if (left < vw && left + d.width > 0) {
					const ip = (left - vw / 2) / vw;
					d.el.style.transform = `scale(1.2) translate3d(${ip * 8}%,0,0)`;
				}
			});

			rafId = requestAnimationFrame(tick);
		}

		function start() {
			if (rafId) return;
			/* snap to the correct spot on re-entry so the track never visibly
			   catches up from a stale position */
			const progress = Math.max(0, Math.min(1, (window.scrollY - sectionTop) / scrollableH));
			currentX = progress * maxScroll;
			lastTime = performance.now();
			rafId = requestAnimationFrame(tick);
		}

		function stop() {
			if (!rafId) return;
			cancelAnimationFrame(rafId);
			rafId = 0;
		}

		const ro = new ResizeObserver(() => {
			const prevMax = maxScroll;
			measure();
			if (prevMax > 0 && maxScroll > 0) currentX = (currentX / prevMax) * maxScroll;
		});
		ro.observe(tr);

		/* run the loop only while the section (± one viewport) is near view */
		const io = new IntersectionObserver(entries => {
			entries.forEach(e => (e.isIntersecting ? start() : stop()));
		}, { rootMargin: '100% 0px 100% 0px' });
		io.observe(ss);

		/* On Astro navigation the whole #__astro tree is swapped out, so the
		   element-scoped observers above may never fire a final "out of view".
		   Tear down the loop + observers explicitly the moment the page swap
		   begins, and remove the listener again on exit (once:true). */
		const onBeforeSwap = () => {
			stop();
			io.disconnect();
			ro.disconnect();
			document.removeEventListener('astro:before-swap', onBeforeSwap);
		};
		document.addEventListener('astro:before-swap', onBeforeSwap);
	}

	onReady(initSelectedWork);
</script>
