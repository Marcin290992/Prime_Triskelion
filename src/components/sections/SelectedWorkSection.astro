---
import { Image, getImage } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
// deeer2.webp is a huge source file (7360px wide) — <Image> generates
// properly-downscaled assets instead of shipping the original (heavy
// enough to jank scroll on iOS Safari).
// Full-screen version for the case-study entrance (data-case-src, see
// afterPageTransition.ts) — a card-sized image blows up soft.
const deeer2Full = await getImage({ src: deeer2, width: 2400 });
// Phones/tablets carousel. Placeholder pictures (stored locally — the
// site's CSP blocks remote images) for all but Winds of Sinai; swap the
// img for each project's own shot.
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';
import imgSteak from '../../img/process/launch.jpg';
import imgJosh from '../../img/process/support.jpg';
import imgUmzug from '../../img/process/discovery.jpg';
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', tags: ['Branding', 'Web'], img: deeer2, href: '/winds-of-sinai', caseSrc: deeer2Full.src },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', tags: ['Web', 'Software'], img: imgUnfall, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', tags: ['Web'], img: imgMousa, href: '/work/mousa-export' },
	{ title: 'Steak Club', desc: 'Premium steakhouse brand with booking system', tags: ['Web', 'Branding'], img: imgSteak },
	{ title: 'Josh Jabs', desc: 'Personal brand & portfolio for a musician', tags: ['Web', 'Branding'], img: imgJosh },
	{ title: 'Umzugsservice', desc: 'Moving service with SEO & lead generation', tags: ['Web', 'SEO'], img: imgUmzug },
];
// Desktop: each project is a full-width, widescreen shot (the scenes below).
// Same pictures as the cards before; wider versions for the wide frame.
const u = (id: string, w: number) => `https://images.unsplash.com/${id}?q=80&w=${w}&auto=format&fit=crop`;
const shots = [
	{ title: 'Winds Of Sinai', desc: 'Luxury travel brand identity & digital presence', tags: 'Branding · Web', href: '/winds-of-sinai', img: u('photo-1506905925346-21bda4d32df4', 2200), caseSrc: u('photo-1506905925346-21bda4d32df4', 2400) },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', tags: 'Web · Software', href: '/work/unfallfix24', img: u('photo-1618005182384-a83a8bd57fbe', 2200) },
	{ title: 'Mousa Export', desc: 'International export logistics platform', tags: 'Web', href: '/work/mousa-export', img: u('photo-1494412574643-ff11b0a5c1c3', 2200) },
	{ title: 'Steak Club', desc: 'Premium steakhouse brand with booking system', tags: 'Web · Branding', href: '#', img: u('photo-1555396273-367ea4eb4db5', 2200) },
	{ title: 'Josh Jabs', desc: 'Personal brand & portfolio for a musician', tags: 'Web · Branding', href: '#', img: u('photo-1511379938547-c1f69419868d', 2200) },
	{ title: 'Umzugsservice', desc: 'Moving service with SEO & lead generation', tags: 'Web · SEO', href: '#', img: u('photo-1600607686527-6fb886090705', 2200) },
];
---
<section id="selected-work">

	<div class="sw-header">
		<h2 class="sw-header__title">What we've<br><em>built.</em></h2>
	</div>

	<div class="scroll-section" id="sw-scroll-section">
		<div class="sticky-view">
			<!-- Desktop: scenes, one at a time. Each project is a wide shot
			     (letterboxed, black above and below) with its title as a
			     subtitle along the foot; scrolling cuts from one to the next
			     through the dark, the next coming into focus (initSelectedWork). -->
			<div class="wk" id="wk">

				<div class="wk-scene wk-scene--title">
					<h2 class="wk-title">What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn no-border">View All Projects</a>
				</div>

				{shots.map((p, i) => (
					<div class="wk-scene wk-scene--shot">
						<a href={p.href} class="wk-frame" data-case={p.caseSrc ? '' : undefined} data-case-src={p.caseSrc} data-case-media={p.caseSrc ? '' : undefined}>
							<div class="wk-frame__media"><img src={p.img} alt={p.title} loading="eager" decoding="async" /></div>
							<div class="wk-frame__shade"></div>
							<div class="wk-frame__meta">
								<span class="wk-count">{String(i + 1).padStart(2, '0')} / {String(shots.length).padStart(2, '0')}</span>
								<span class="wk-tags">{p.tags}</span>
							</div>
							<div class="wk-frame__title">
								<div>
									<h3>{p.title}</h3>
									<p>{p.desc}</p>
								</div>
								<span class="wk-go">Explore</span>
							</div>
						</a>
					</div>
				))}

				<div class="wk-scene wk-scene--text">
					<h2 class="wk-lead">Discover my complete collection of digital experiences, brands, and platforms.</h2>
				</div>

				<div class="wk-scene wk-scene--final">
					<h2 class="wk-final">A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
				</div>

			</div>
		</div>
	</div>

	<!-- Phones and tablets: the work as a carousel you swipe — native
	     horizontal scroll that snaps card to card (no script per frame),
	     the next card peeking in. Desktop keeps the horizontal scene above. -->
	<div class="sw-m">
		<div class="sw-m__track" aria-label="Selected work">
			{projects.map((p) => {
				const Tag = p.href ? 'a' : 'div';
				return (
					<Tag class="sw-m__card" href={p.href} data-case={p.caseSrc ? '' : undefined} data-case-src={p.caseSrc}>
						<div class="sw-m__media" data-case-media={p.caseSrc ? '' : undefined}>
							{/* Eager, not lazy: Safari only starts a lazy image once it's
							    nearly in view, so swiping showed the next card empty and its
							    picture popping in. Six card-sized images, loaded with the page. */}
							<Image src={p.img} alt="" widths={[480, 800, 1200]} sizes="(min-width: 700px) 78vw, 82vw" loading="eager" decoding="async" />
						</div>
						<div class="sw-m__bar">
							<div class="sw-m__text">
								<h3 class="sw-m__title">{p.title}</h3>
								<p class="sw-m__desc">{p.desc}</p>
								<span class="sw-m__tags">{p.tags.join(' · ')}</span>
							</div>
						</div>
					</Tag>
				);
			})}
		</div>
		<div class="sw-m__foot">
			<div class="sw-m__progress" aria-hidden="true"><span></span></div>
			<span class="sw-m__count" aria-hidden="true">01 / {String(projects.length).padStart(2, '0')}</span>
		</div>
		<div class="h-hero-cta-wrap sw-m__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">View all projects</span>
			</a>
		</div>
	</div>
</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
	}

	/* Header — mobile only */
	.sw-header {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) clamp(1.8rem, 3.8vh, 3.5rem);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.sw-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.sw-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.sw-header__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Horizontal scroll */
	.scroll-section {
		/* 100vh for the blur-in (ENTER_SCREENS in the script) + 600vh of
		   horizontal travel + a 40vh hold on the final slide (FINAL_HOLD) +
		   the 100vh of the pinned view. */
		height: 840vh;
		position: relative;
		display: none;
	}
	.sticky-view {
		position: sticky;
		top: 0;
		height: 100vh;
		width: 100%;
		overflow: hidden;
		background-color: rgb(var(--c-bg));
	}
	.track {
		display: flex;
		height: 100%;
		align-items: center;
		padding-left: 10vw;
		gap: 10vw;
		will-change: transform;
	}
	.slide { flex-shrink: 0; will-change: transform, opacity; }

	/* Intro */
	.slide-intro { width: 42vw; padding-right: 5vw; }
	.slide-intro h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		/* No white-space:nowrap — .slide-intro has flex-shrink:0 (needed for
		   the horizontal-scroll track's width math), so at laptop widths the
		   vw-scaled font-size can render wider than the fixed-width column;
		   nowrap then let it spill straight onto the neighboring image
		   instead of wrapping to a 3rd line like a normal heading would. */
		margin-bottom: 2.5rem;
	}
	.slide-intro h2 em { font-style: normal; color: rgb(var(--c-red)); }

	/* Cards */
	.slide-card {
		width: 45vw;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 2.5rem;
		padding: 1rem 1rem 1.4rem;
		border: 1px solid rgba(255,255,255,0.06);
		background: rgba(255,255,255,0.018);
	}
	.img-box {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background-color: #0d0d0f;
		border: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 8px 40px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.3);
	}
	.img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.2);
	}
	.card-info { display: flex; justify-content: space-between; align-items: flex-start; }
	.card-title-link { text-decoration: none; display: block; }
	.card-info h3 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		margin-bottom: 0.5rem;
	}
	.card-info p {
		font-family: var(--f-body);
		font-size: 0.9rem;
		font-weight: 300;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.82);
		max-width: 320px;
	}

	.link-btn {
		font-family: var(--f-body);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		position: relative;
		padding-bottom: 4px;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream) / 0.25);
		transform: scaleX(1);
		transform-origin: left;
		transition: background 0.3s ease;
	}
	@media (hover: hover) {
		.link-btn:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn:hover::after {
			background: rgb(var(--c-cream));
		}
	}

	.link-btn.no-border {
		border: none;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn.no-border::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.link-btn.no-border:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn.no-border:hover::after {
			transform: scaleX(1);
		}
	}

	/* Desktop: the whole card answers to the cursor, not only its small link —
	   the same as the cards on the Projects page. The frame leans in a touch
	   and its edge lights, the description comes to full strength and the
	   Explore link does what it does under the cursor (shifts, underline draws
	   in). The frame (not the <img>, which the parallax moves) is what scales. */
	@media (hover: hover) and (pointer: fine) {
		.img-box {
			transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.8s ease;
		}
		.card-info p { transition: color 0.5s ease; }
		.slide-card:hover .img-box {
			transform: scale(1.02);
			border-color: rgba(255,255,255,0.2);
		}
		.slide-card:hover .card-info p { color: rgb(var(--c-cream) / 0.95); }
		.slide-card:hover .link-btn.no-border {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.slide-card:hover .link-btn.no-border::after { transform: scaleX(1); }
	}

	/* Curtain */
	.slide-curtain {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0 15vw 0 10vw;
		position: relative;
		z-index: 5;
		overflow: hidden;
	}
	.parallax-text { will-change: transform; }
	.slide-curtain h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2rem, 3.8vw, 4rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 1.05;
		color: rgb(var(--c-cream));
		margin-bottom: 2rem;
	}

	/* Final slide */
	.slide-final {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		margin-left: -10vw;
		will-change: transform;
	}
	.final-title {
		font-family: var(--f-display);
		font-weight: 600;
		/* Capped by height too, so it never outgrows the hero on a tall screen. */
		font-size: min(11vw, 13.5vh);
		line-height: 0.85;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-align: center;
		color: rgb(var(--c-cream));
	}
	.final-footer {
		position: absolute;
		bottom: 10%;
		width: 90%;
		font-family: var(--f-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: rgb(var(--c-cream) / 0.72);
	}

	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: it blurs in on the spot (nothing slides in from
		   below), then the horizontal travel starts. */
		.scroll-section { display: block; margin-top: -100vh; }
		.sw-header { display: none; }
	}

	@media (min-width: 1025px) and (hover: hover) and (max-width: 1600px), (min-width: 1025px) and (pointer: fine) and (max-width: 1600px) {
		.track { padding-left: 5vw; gap: 5vw; }
		.slide-intro { width: 44vw; padding-right: 2vw; }
		.slide-card { width: 42vw; }
		.slide-intro h2 { font-size: clamp(3rem, 6vw, 8rem); }
	}

	/* Laptop-height viewports: the card (16/10 image + info block + the
	   decorative margin-top) is tall enough that, vertically centred in the
	   sticky 100vh view, its footer runs into the fixed MENU button. Keep
	   the card WIDTH untouched (it drives the horizontal-scroll track math
	   and the final-slide reveal) — only drop the decorative offset and
	   flatten the image to a cinematic crop to reclaim the height. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 1000px), (min-width: 1025px) and (pointer: fine) and (max-height: 1000px) {
		.slide-card { margin-top: 0; }
		.img-box { aspect-ratio: 2 / 1; }
	}

	@media (min-width: 1025px) and (hover: hover) and (max-height: 820px), (min-width: 1025px) and (pointer: fine) and (max-height: 820px) {
		.img-box { aspect-ratio: 21 / 9; }
	}

	/* Final slide headline had only a vw size — on short laptops the four
	   lines overflowed the viewport top/bottom (and the wide words bled off
	   the sides), so the closing reveal looked broken. Cap it against height
	   too. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 1000px), (min-width: 1025px) and (pointer: fine) and (max-height: 1000px) {
		.final-title { font-size: min(11vw, 13.5vh); }
	}

	/* ── Desktop: the work as scenes (initSelectedWork) ── */
	/* A strip of scenes, one screen wide each, panned sideways by the scroll
	   (initSelectedWork) — the shots slide past like a camera moving along. */
	.wk {
		position: absolute;
		inset: 0;
		display: flex;
		gap: 4vw;
		opacity: 0;
		will-change: transform;
	}
	.wk-scene {
		position: relative;
		flex: 0 0 100vw;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.wk-title,
	.wk-lead,
	.wk-final {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	/* Centred, at the page's one heading size: the same as "My Services." and
	   the other sections' headings (capped by the screen's height too, so it
	   does not outgrow a laptop). */
	.wk-title {
		font-size: clamp(3.5rem, min(8vw, 11vh), 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-align: center;
		margin-bottom: 2.5rem;
	}
	.wk-title em { font-style: normal; color: rgb(var(--c-red)); }
	/* The curtain: the "Discover…" scene is opaque and lies over the last
	   scene, which waits beneath it at the same place (its position is set in
	   measure()) and is uncovered as the curtain slides away — the earlier
	   section's curtain reveal. */
	.wk-scene--text {
		z-index: 2;
		background: rgb(var(--c-bg));
	}
	.wk-scene--final {
		position: absolute;
		top: 0;
		left: 0;
		width: 100vw;
		flex: none;
		z-index: 1;
	}
	.wk-lead {
		width: min(100% - var(--site-gutter) * 2, 1100px);
		font-size: clamp(2rem, 4.2vw, 4.6rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.wk-final {
		font-size: min(11vw, 13.5vh);
		line-height: 0.85;
		letter-spacing: -0.04em;
		text-align: center;
	}

	/* The shot: full width, widescreen — what is left of the screen above and
	   below is black, like the bars of a cinema frame. */
	.wk-frame {
		position: relative;
		display: block;
		width: 100vw;
		height: min(78vh, calc(100vw / 2.1));
		overflow: hidden;
		color: rgb(var(--c-cream));
		text-decoration: none;
		background: #050506;
	}
	.wk-frame__media { position: absolute; inset: 0; will-change: transform; }
	.wk-frame__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
	/* Dark at the foot (the subtitle) and a little at the head (the counter). */
	.wk-frame__shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 30%, transparent 58%),
			linear-gradient(to bottom, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.2) 14%, transparent 26%);
	}
	.wk-frame__meta {
		position: absolute;
		top: clamp(1.1rem, 2.6vh, 2rem);
		left: var(--site-gutter);
		right: var(--site-gutter);
		display: flex;
		gap: 1.2rem;
		font-family: var(--f-body);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--c-cream) / 0.8);
	}
	.wk-tags { color: rgb(var(--c-cream) / 0.6); }
	.wk-frame__title {
		position: absolute;
		left: var(--site-gutter);
		right: var(--site-gutter);
		bottom: clamp(1.4rem, 3.4vh, 2.6rem);
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}
	.wk-frame__title h3 {
		margin: 0 0 0.6rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2.2rem, 4.4vw, 5rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}
	.wk-frame__title p {
		margin: 0;
		max-width: 38ch;
		font-family: var(--f-body);
		font-size: clamp(0.85rem, 1.05vw, 1rem);
		font-weight: 300;
		line-height: 1.5;
		color: rgb(var(--c-cream) / 0.85);
	}
	.wk-go {
		position: relative;
		flex: none;
		padding-bottom: 4px;
		font-family: var(--f-body);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.8);
	}
	.wk-go::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0.25);
		transform-origin: left;
		transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
	}
	@media (hover: hover) and (pointer: fine) {
		.wk-frame:hover .wk-go::after { transform: scaleX(1); }
	}
	@media (max-width: 1600px) and (min-width: 1025px) {
		.wk-frame { height: min(78vh, calc(100vw / 2.1)); }
	}

	/* ── Phones/tablets carousel (desktop has the horizontal scene) ── */
	.sw-m { display: none; }
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.sw-header__title { font-size: clamp(2.4rem, 10vw, 5rem); }
		.sw-m {
			display: block;
			padding-bottom: clamp(3.5rem, 10vw, 5.5rem);
		}
		.sw-m__track {
			display: flex;
			gap: 0.75rem;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--site-gutter);
			padding: 0 var(--site-gutter);
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
		}
		.sw-m__track::-webkit-scrollbar { display: none; }
		.sw-m__card {
			position: relative;
			flex: 0 0 82%;
			scroll-snap-align: start;
			aspect-ratio: 4 / 5;
			max-height: 66vh;
			overflow: hidden;
			display: block;
			color: inherit;
			text-decoration: none;
			background: #0b0b0d;
			border: 1px solid rgb(var(--c-cream) / 0.1);
			-webkit-tap-highlight-color: transparent;
		}
		.sw-m__media { position: absolute; inset: 0; }
		.sw-m__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		/* Legibility for the bar at the foot. */
		.sw-m__media::after {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgb(0 0 0 / 0.75) 0%, rgb(0 0 0 / 0.15) 45%, transparent 70%);
		}
		/* Same glass info bar as the Projects page cards. */
		.sw-m__bar {
			position: absolute;
			left: 0.75rem;
			right: 0.75rem;
			bottom: 0.75rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding: 1rem 1.1rem;
			background: rgb(var(--c-bg) / 0.38);
			-webkit-backdrop-filter: blur(20px) saturate(160%);
			backdrop-filter: blur(20px) saturate(160%);
			border: 1px solid rgb(255 255 255 / 0.1);
		}
		.sw-m__text { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
		.sw-m__title {
			margin: 0;
			font-family: var(--f-display);
			font-weight: 600;
			font-size: clamp(1.35rem, 6vw, 1.9rem);
			line-height: 1;
			letter-spacing: -0.01em;
			text-transform: uppercase;
			color: rgb(var(--c-cream));
		}
		.sw-m__desc {
			margin: 0;
			font-family: var(--f-body);
			font-size: 0.82rem;
			font-weight: 300;
			line-height: 1.45;
			color: rgb(var(--c-cream) / 0.75);
		}
		.sw-m__tags {
			font-family: var(--f-body);
			font-size: 10px;
			font-weight: 500;
			letter-spacing: 0.32em;
			text-transform: uppercase;
			color: rgb(var(--c-cream) / 0.7);
		}
		/* Where in the row you are. */
		.sw-m__foot {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1.25rem var(--site-gutter) 0;
		}
		.sw-m__progress {
			flex: 1 1 auto;
			height: 1px;
			background: rgb(var(--c-cream) / 0.14);
			overflow: hidden;
		}
		.sw-m__progress span {
			display: block;
			height: 100%;
			background: rgb(var(--c-red));
			transform-origin: left center;
			transform: scaleX(var(--p, 0.1667));
			transition: transform 0.2s linear;
		}
		.sw-m__count {
			font-family: var(--f-body);
			font-size: 11px;
			font-weight: 500;
			letter-spacing: 0.28em;
			font-variant-numeric: tabular-nums;
			color: rgb(var(--c-cream) / 0.6);
		}
		.sw-m__cta { margin: 1.75rem var(--site-gutter) 0; width: auto !important; }
		/* Tablet width: still one main card with the next peeking in (as on
		   a phone), in a landscape frame — 4:5 at this width ran taller
		   than the screen. */
		@media (min-width: 700px) {
			.sw-m__card { flex-basis: 78%; aspect-ratio: 3 / 2; max-height: 70vh; }
			.sw-m__cta { margin-inline: var(--site-gutter) auto; }
		}
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';

	// Phones/tablets: the carousel scrolls natively; this only keeps the
	// counter and the progress hairline in step (on scroll, a frame at most).
	let _workCarouselOff: (() => void) | null = null;
	function initWorkCarousel(section: HTMLElement) {
		_workCarouselOff?.();
		_workCarouselOff = null;
		const track = section.querySelector<HTMLElement>('.sw-m__track');
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.sw-m__card'));
		const bar = section.querySelector<HTMLElement>('.sw-m__progress');
		const count = section.querySelector<HTMLElement>('.sw-m__count');
		if (!track || cards.length < 2) return;
		const total = String(cards.length).padStart(2, '0');
		let ticking = false;
		let shown = -1;
		const update = () => {
			ticking = false;
			// The card nearest the start edge; the last one once the row is
			// scrolled to its end (on a tablet a few are in view at once).
			const pad = parseFloat(getComputedStyle(track).paddingLeft) || 0;
			const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
			let i = cards.length - 1;
			if (!atEnd) {
				let best = Infinity;
				cards.forEach((c, k) => {
					const d = Math.abs(c.offsetLeft - pad - track.scrollLeft);
					if (d < best) { best = d; i = k; }
				});
			}
			bar?.style.setProperty('--p', ((i + 1) / cards.length).toFixed(4));
			if (i !== shown && count) {
				shown = i;
				count.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
			}
		};
		const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
		track.addEventListener('scroll', onScroll, { passive: true });
		update();
		_workCarouselOff = () => track.removeEventListener('scroll', onScroll);
	}
	document.addEventListener('astro:before-swap', () => {
		_workCarouselOff?.();
		_workCarouselOff = null;
	});

	function initSelectedWork() {
		const section = document.getElementById('selected-work');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) {
			section.querySelector<HTMLElement>('.sw-header')?.classList.add('visible');
			initWorkCarousel(section);
			return;
		}

		const ss = document.getElementById('sw-scroll-section')!;
		const sv = ss.querySelector<HTMLElement>('.sticky-view')!;
		const stage = document.getElementById('wk')!;
		const scenes = Array.from(stage.querySelectorAll<HTMLElement>('.wk-scene'));
		const medias = scenes.map((el) => el.querySelector<HTMLElement>('.wk-frame__media'));
		const subtitles = scenes.map((el) => el.querySelector<HTMLElement>('.wk-frame__title'));
		const n = scenes.length;
		const curtain = scenes[n - 2];                              // "Discover my complete…"
		const finale = scenes[n - 1];                               // the closing words, beneath it
		const lead = curtain.querySelector<HTMLElement>('.wk-lead');

		/* The section is a pinned view. It comes up out of the dark once, on the
		   spot (that is the entrance), and from then on scrolling moves a
		   position along the strip of scenes (0 = the title, n - 1 = the last):
		   each shot rests, then the strip slides sideways to the next. Inside a
		   shot the picture slides against the move (depth) and the subtitle
		   lags behind it a little. */
		const ENTER_SCREENS = 1.0;  // the whole view blurs in on the spot first
		const SCENE_SCREENS = 0.75; // scroll for one scene — keep in step with .scroll-section's height
		const EASE_PER_SECOND = 4;
		const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
		const smooth = (t: number) => t * t * (3 - 2 * t);

		let sectionTop = 0;
		let enterFrom = 0; // scrollY where the manifesto's pin really ends
		let cur = 0;
		let rafId = 0;
		let lastTime = 0;
		// How far one scene is from the next along the strip (a screen and the gap).
		const stride = () => (n > 1 ? scenes[1].offsetLeft - scenes[0].offsetLeft : window.innerWidth);
		// A shot rests over the middle of its stretch of scroll; the slide to the
		// next takes the rest of it.
		const HOLD = 0.2;
		const glide = (f: number) => (f <= HOLD ? 0 : f >= 1 - HOLD ? 1 : smooth((f - HOLD) / (1 - 2 * HOLD)));

		function measure() {
			sectionTop = ss.getBoundingClientRect().top + window.scrollY;
			// The closing words wait beneath the curtain, at its place.
			finale.style.left = `${curtain.offsetLeft}px`;
			// Measured, not assumed: the blur-in starts only once the manifesto's
			// pin has ended and this view is pinned itself.
			const man = document.getElementById('manifesto');
			const manPin = man?.firstElementChild as HTMLElement | null;
			enterFrom = man && manPin
				? Math.max(sectionTop, man.getBoundingClientRect().bottom + window.scrollY - manPin.offsetHeight)
				: sectionTop;
		}
		const target = () => {
			const vh = window.innerHeight;
			const raw = Math.max(0, Math.min(n - 1, (window.scrollY - enterFrom - ENTER_SCREENS * vh) / (SCENE_SCREENS * vh)));
			if (raw >= n - 1) return n - 1;
			const i = Math.floor(raw);
			return i + glide(raw - i);
		};

		function tick(now: number) {
			const dt = Math.min((now - lastTime) / 1000, 0.1);
			lastTime = now;
			const vh = window.innerHeight;

			// The whole view comes up on the spot, then the scenes begin.
			const t = clamp01((window.scrollY - enterFrom) / (ENTER_SCREENS * vh));
			const e = 1 - (1 - t) * (1 - t);
			sv.style.opacity = e > 0 ? '1' : '0';
			stage.style.opacity = String(e);
			stage.style.filter = e < 1 ? `blur(${((1 - e) * 10).toFixed(1)}px)` : '';

			const goal = target();
			cur += (goal - cur) * (1 - Math.exp(-EASE_PER_SECOND * dt));
			if (Math.abs(goal - cur) < 0.0005) cur = goal;

			// The strip slides; no scene fades or blurs on the way.
			const w = window.innerWidth;
			const st = stride();
			stage.style.transform = `translate3d(${(-cur * st).toFixed(1)}px, 0, 0)`;
			// Curtain reveal: the closing words do not travel with the strip. They
			// wait beneath the curtain and come out from behind its trailing edge,
			// at half the pace, to the middle of the screen as the curtain goes.
			const u = clamp01(cur - (n - 2));
			finale.style.transform = `translate3d(${((1 - u) * 0.5 * w + u * st).toFixed(1)}px, 0, 0)`;
			if (lead) lead.style.transform = `translate3d(${((n - 2 - cur) * 200).toFixed(1)}px, 0, 0)`;
			scenes.forEach((_, i) => {
				const d = cur - i;
				if (Math.abs(d) > 1.6) return;
				const m = medias[i];
				if (m) m.style.transform = `translate3d(${(-d * 0.06 * w).toFixed(1)}px, 0, 0) scale(${(1.14 + 0.04 * clamp01(d + 0.5)).toFixed(4)})`;
				const sub = subtitles[i];
				if (sub) sub.style.transform = `translate3d(${(d * 0.045 * w).toFixed(1)}px, 0, 0)`;
			});

			rafId = requestAnimationFrame(tick);
		}

		function start() {
			if (rafId) return;
			cur = target();
			lastTime = performance.now();
			rafId = requestAnimationFrame(tick);
		}

		function stop() {
			if (!rafId) return;
			cancelAnimationFrame(rafId);
			rafId = 0;
		}

		measure();
		const ro = new ResizeObserver(() => { measure(); });
		ro.observe(stage);

		/* run the loop only while the section (± one viewport) is near view */
		const io = new IntersectionObserver(entries => {
			entries.forEach(en => (en.isIntersecting ? start() : stop()));
		}, { rootMargin: '100% 0px 100% 0px' });
		io.observe(ss);

		/* On Astro navigation the whole #__astro tree is swapped out, so the
		   element-scoped observers above may never fire a final "out of view".
		   Tear down the loop + observers explicitly the moment the page swap
		   begins, and remove the listener again on exit. */
		const onBeforeSwap = () => {
			stop();
			io.disconnect();
			ro.disconnect();
			document.removeEventListener('astro:before-swap', onBeforeSwap);
		};
		document.addEventListener('astro:before-swap', onBeforeSwap);
	}

	onReady(initSelectedWork);
</script>
