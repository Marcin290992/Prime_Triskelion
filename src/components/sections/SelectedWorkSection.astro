---
import { Image, getImage } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';

// deeer2.webp is a huge source file (7360px wide) — <Image> generates
// properly-downscaled assets instead of shipping the original (heavy enough
// to jank scroll on iOS Safari). The 2400px version is the full-screen image
// the case-study entrance grows into (data-case-src, see pageTransitions.ts)
// — a card-sized image blows up soft.
const deeer2Full = await getImage({ src: deeer2, width: 2400 });

// One list drives both layouts. Pictures are stored locally (the site's CSP
// blocks remote images). `img` is the phone/tablet strip's picture; the
// desktop scene still shows `deeer2` everywhere — swap each for the
// project's own shot.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, href: '/winds-of-sinai', caseSrc: deeer2Full.src },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, href: '/work/mousa-export' },
];

// Desktop scroll length, in screens: a blur-in on the spot, the horizontal
// travel, a hold on the last slide, and the pinned view itself (1 screen).
// The script reads these back from data attributes.
const ENTER = 0.7;
const HOLD = 0.4;
// The travel keeps one pace however many projects there are: 6.6 screens
// for the 540vw the track moved with six cards.
const TRAVEL_PER_VW = 6.6 / 540;
const trackTravel = (cards: number) => 100 + 10 + cards * 55 + 100; // wide layout, vw
const TRAVEL = Math.round(TRAVEL_PER_VW * trackTravel(projects.length) * 10) / 10;
const TOTAL = ENTER + TRAVEL + HOLD;
const deskHeight = Math.round((TOTAL + 1) * 100);

// Where everything sits on the desktop track, in vw, for the two widths the
// CSS switches between (--card-w / --track-gap). The scroll-driven
// animations are timed from these: a position along the track becomes a
// point in the scroll range.
const LAYOUTS = { wide: { card: 45, gap: 10 }, narrow: { card: 42, gap: 5 } };
const OVERLAP = 10; // the final slide is tucked this far under the cover
const pct = (v: number) => `${(v * 100).toFixed(3)}%`;
function plan({ card, gap }: { card: number; gap: number }) {
	const cardX = projects.map((_, i) => 100 + gap + i * (card + gap));
	const coverX = 100 + gap + projects.length * (card + gap);
	const maxScroll = coverX + 100 + gap - OVERLAP; // track width minus one screen
	// Scroll position at which the track has moved `x` vw.
	const at = (x: number) => pct((ENTER + (TRAVEL * x) / maxScroll) / TOTAL);
	return {
		// A card comes in while its left edge travels from the right edge of
		// the screen to its middle.
		cards: cardX.map((x) => ({ from: at(x - 100), to: at(x - 50) })),
		// The final slide slides out from behind the cover over the last 150vw.
		final: at(maxScroll - 150),
		cover: at(coverX - 120),
		drift: `${2 * (coverX - maxScroll)}px`,
	};
}
const wide = plan(LAYOUTS.wide);
const narrow = plan(LAYOUTS.narrow);
const deskVars = [
	`height:${deskHeight}vh`,
	`--e:${pct(ENTER / TOTAL)}`,
	`--t:${pct((ENTER + TRAVEL) / TOTAL)}`,
	`--overlap:${OVERLAP}vw`,
	`--card-w-wide:${LAYOUTS.wide.card}vw`,
	`--card-w-narrow:${LAYOUTS.narrow.card}vw`,
	`--gap-wide:${LAYOUTS.wide.gap}vw`,
	`--gap-narrow:${LAYOUTS.narrow.gap}vw`,
	`--final-wide:${wide.final}`,
	`--final-narrow:${narrow.final}`,
	`--cover-wide:${wide.cover}`,
	`--cover-narrow:${narrow.cover}`,
	`--drift-wide:${wide.drift}`,
	`--drift-narrow:${narrow.drift}`,
].join(';');
---
<section id="selected-work">

	<!-- Desktop: one pinned view; the scroll slides the track sideways. -->
	<div class="sw-desk" id="sw-scroll-section" style={deskVars} data-enter={ENTER} data-travel={TRAVEL} data-hold={HOLD}>
		<div class="sw-desk__view">
			<div class="sw-desk__track">

				<div class="sw-intro">
					<h2 class="sw-title">What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn sw-link">View All Projects</a>
				</div>

				{projects.map((p, i) => (
					<div
						class:list={['sw-card', i === 0 ? 'sw-card--fade' : 'sw-card--rise']}
						style={`--from-wide:${wide.cards[i].from};--to-wide:${wide.cards[i].to};--from-narrow:${narrow.cards[i].from};--to-narrow:${narrow.cards[i].to}`}
						data-case={p.caseSrc ? '' : undefined}
						data-case-src={p.caseSrc}
					>
						<a href={p.href ?? '#'} class="sw-media" data-case-media={p.caseSrc ? '' : undefined}>
							<Image src={deeer2} alt={p.title} widths={[800, 1200, 1800]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" decoding="async" />
						</a>
						<div class="sw-card__info">
							<div>
								<a href={p.href ?? '#'} class="sw-card__title"><h3>{p.title}</h3></a>
								<p>{p.desc}</p>
							</div>
							<a href={p.href ?? '#'} class="link-btn sw-link">Explore</a>
						</div>
					</div>
				))}

				<div class="sw-panel sw-panel--cover">
					<div class="sw-panel__in">
						<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
						<div class="h-hero-cta-wrap sw-panel__cta">
							<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
							<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
							<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
								<span class="hud-spin-border"></span>
								<span class="h-hero-cta__text">Explore more projects</span>
							</a>
						</div>
					</div>
				</div>

				<div class="sw-panel sw-panel--final">
					<h2>A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
				</div>

			</div>
		</div>
	</div>

	<!-- Phones and tablets: a plain vertical stack. The title takes over on the
	     spot where the manifesto ends and comes up out of the dark; then the
	     cards ride in from below, one under another, and the closing lines
	     follow. No horizontal scroll, no script; the spacing between the rest
	     is the same as every other section's (--section-space-*,
	     --site-gutter). -->
	<div class="sw-mob" id="sw-hs">
		<div class="sw-intro-wrap">
			<div class="sw-intro-pin">
				<div class="sw-intro">
					<h2 class="sw-title">What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn sw-link">View All Projects</a>
				</div>
			</div>
		</div>

		<div class="sw-list">
			{projects.map((p) => (
				<div class="sw-card" data-case={p.caseSrc ? '' : undefined} data-case-src={p.caseSrc}>
					<a href={p.href ?? '#'} class="sw-media" data-case-media={p.caseSrc ? '' : undefined}>
						{/* Eager: a lazy image only starts near the viewport, so a card could show empty. */}
						<Image src={p.img} alt={p.title} widths={[480, 800, 1200]} sizes="(min-width: 700px) 520px, 90vw" loading="eager" decoding="async" />
					</a>
					<div class="sw-card__info">
						<div>
							<a href={p.href ?? '#'} class="sw-card__title"><h3>{p.title}</h3></a>
							<p>{p.desc}</p>
						</div>
						<a href={p.href ?? '#'} class="link-btn sw-link">Explore</a>
					</div>
				</div>
			))}
		</div>

		<div class="sw-close">
			<h2 class="sw-close__text">Discover my complete collection of digital experiences, brands, and platforms.</h2>
			<div class="h-hero-cta-wrap sw-panel__cta">
				<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
				<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
				<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
					<span class="hud-spin-border"></span>
					<span class="h-hero-cta__text">Explore more projects</span>
				</a>
			</div>
			<h2 class="sw-close__final">A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
		</div>
	</div>
</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
	}

	/* Exactly one layout is on at a time (the script uses the same query). */
	.sw-desk,
	.sw-mob { display: none; }

	/* ═══ Shared pieces ═══ */

	/* Opener: a whole screen, the title alone in the middle of it. */
	.sw-intro {
		flex: 0 0 100vw;
		width: 100vw;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 var(--intro-pad, 0);
	}
	.sw-title {
		margin: 0 0 var(--intro-gap);
		font-family: var(--f-display);
		font-weight: 600;
		font-size: var(--intro-size);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.sw-title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Card: a frame, the picture, then title / line / Explore. */
	.sw-card {
		flex: 0 0 var(--card-w);
		width: var(--card-w);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: var(--card-gap);
		margin-top: var(--card-offset);
		padding: var(--card-pad);
		border: 1px solid rgba(255,255,255,0.06);
		background: rgba(255,255,255,0.018);
	}
	.sw-media {
		display: block;
		width: 100%;
		aspect-ratio: var(--media-ratio);
		overflow: hidden;
		background-color: #0d0d0f;
		border: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 8px 40px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.3);
		-webkit-tap-highlight-color: transparent;
	}
	.sw-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.2); /* the parallax moves it inside the frame */
	}
	.sw-card__info { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
	.sw-card__title { display: block; text-decoration: none; }
	.sw-card h3 {
		margin: 0 0 0.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: var(--title-size);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.sw-card p {
		margin: 0;
		max-width: 320px;
		font-family: var(--f-body);
		font-size: var(--text-size);
		font-weight: 300;
		line-height: var(--text-lh);
		color: rgb(var(--c-cream) / 0.82);
	}

	/* Text link whose underline draws in on hover. (Size and tracking come
	   from the global .link-btn rule.) */
	.sw-link {
		position: relative;
		padding-bottom: 3px;
		font-family: var(--f-body);
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.sw-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.sw-link:hover { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-link:hover::after { transform: scaleX(1); }
	}

	/* The last two slides: a whole screen each, in the page's own background
	   (no frame). The cover's text drifts as it comes in; the final one slides
	   out from behind it. */
	.sw-panel {
		flex: 0 0 100vw;
		width: 100vw;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		overflow: hidden;
		padding: 0 var(--panel-pad);
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}
	.sw-panel h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
	}
	.sw-panel--cover { position: relative; z-index: 2; }
	.sw-panel__in {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--cover-gap);
		will-change: transform;
	}
	.sw-panel--cover h2 { font-size: var(--cover-size); line-height: 1.05; letter-spacing: -0.02em; }
	.sw-panel__cta { width: auto !important; margin: 0; }
	.sw-panel--final { position: relative; z-index: 1; }
	.sw-panel--final h2 { font-size: var(--final-size); line-height: 0.85; letter-spacing: -0.04em; }

	/* ═══ Desktop ═══ */
	.sw-desk {
		--intro-size: clamp(3.5rem, 8vw, 8.5rem);
		--intro-gap: 2.5rem;
		--card-w: var(--card-w-wide);
		--track-gap: var(--gap-wide);
		--final-at: var(--final-wide);
		--cover-at: var(--cover-wide);
		--drift-to: var(--drift-wide);
		--card-gap: 1.25rem;
		--card-offset: 2.5rem;
		--card-pad: 1rem 1rem 1.4rem;
		--media-ratio: 16 / 10;
		--title-size: clamp(1.4rem, 2.2vw, 2.2rem);
		--text-size: 0.9rem;
		--text-lh: 1.6;
		--panel-pad: 12vw;
		--cover-gap: 2.5rem;
		--cover-size: clamp(2rem, 3.8vw, 4rem);
		/* Capped by height too, so it never outgrows the screen. */
		--final-size: min(11vw, 13.5vh);
		position: relative;
	}
	.sw-desk__view {
		position: sticky;
		top: 0;
		width: 100%;
		height: 100vh;
		overflow: hidden;
		background-color: rgb(var(--c-bg));
	}
	/* No lead-in space: the intro is a whole screen wide, so the title stands
	   alone in the middle at the start and the first project is a screen away
	   until the scroll brings it in. */
	.sw-desk__track {
		display: flex;
		align-items: center;
		gap: var(--track-gap);
		/* As wide as its content, so translateX(100vw - 100%) is exactly the
		   distance to the end of the track. */
		width: max-content;
		height: 100%;
		will-change: transform;
	}
	/* Each moving card gets its own compositor layer, so moving it never
	   repaints the frame, shadow and picture. */
	.sw-desk .sw-card--rise { will-change: transform; }
	.sw-desk .sw-card--fade { will-change: opacity; }
	.sw-desk .sw-panel { height: 100vh; }
	/* The final slide is pulled under the cover and slides out from behind it
	   (the script). */
	.sw-desk .sw-panel--final { margin-left: calc(var(--overlap) * -1); will-change: transform; }

	/* Pulled up by one screen, so the pinned view takes over exactly where the
	   manifesto's pin ends: it blurs in on the spot (nothing slides in from
	   below), then the horizontal travel starts. */
	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		.sw-desk { display: block; margin-top: -100vh; }
	}

	.sw-card--rise,
	.sw-card--fade { --from: var(--from-wide); --to: var(--to-wide); }

	/* Desktop: the whole card answers to the cursor, not only its small link —
	   the same as the cards on the Projects page. The frame (not the <img>,
	   which the parallax moves) leans in a touch and its edge lights. */
	@media (hover: hover) and (pointer: fine) {
		.sw-desk .sw-media { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.8s ease; }
		.sw-desk .sw-card p { transition: color 0.5s ease; }
		.sw-desk .sw-card:hover .sw-media { transform: scale(1.02); border-color: rgba(255,255,255,0.2); }
		.sw-desk .sw-card:hover p { color: rgb(var(--c-cream) / 0.95); }
		.sw-desk .sw-card:hover .sw-link { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-desk .sw-card:hover .sw-link::after { transform: scaleX(1); }
	}

	@media (max-width: 1600px) {
		.sw-desk {
			--card-w: var(--card-w-narrow);
			--track-gap: var(--gap-narrow);
			--final-at: var(--final-narrow);
			--cover-at: var(--cover-narrow);
			--drift-to: var(--drift-narrow);
			--intro-size: clamp(3rem, 6vw, 8rem);
		}
		.sw-card--rise,
		.sw-card--fade { --from: var(--from-narrow); --to: var(--to-narrow); }
	}
	/* Laptop-height screens: the card is tall enough that its footer would run
	   into the fixed MENU button. The card WIDTH stays (it drives the scroll
	   math and the final-slide reveal) — only the decorative offset goes and
	   the picture flattens to a cinematic crop. */
	@media (max-height: 1000px) {
		.sw-desk { --card-offset: 0; --media-ratio: 2 / 1; }
	}
	@media (max-height: 820px) {
		.sw-desk { --media-ratio: 21 / 9; }
	}

	/* ═══ Desktop motion: scroll-driven CSS animations ═══
	   The whole scene is driven by the page's scroll position and runs on the
	   compositor, off the main thread, so it cannot stutter the way a
	   per-frame script does. One timeline (--sw) spans the pinned scroll;
	   every move below is a slice of it. (`contain` on a subject taller than
	   the screen is exactly the span it stays pinned for.) Browsers without
	   this get the same scene from the script instead. */
	@supports (animation-timeline: view()) {
		.sw-desk { view-timeline: --sw block; }

		.sw-desk__view,
		.sw-desk__track,
		.sw-card--rise,
		.sw-card--fade,
		.sw-desk .sw-panel--cover .sw-panel__in,
		.sw-desk .sw-panel--final {
			animation-duration: 1ms;
			animation-fill-mode: both;
			animation-timeline: --sw;
		}

		/* The pinned view is invisible until the scroll reaches it (it would
		   cover the manifesto's last screen). */
		.sw-desk__view {
			animation-name: sw-show;
			animation-timing-function: linear;
			animation-range: contain 0% contain 0.01%;
		}
		/* Blur-in on the spot (a fade), then the horizontal travel. */
		.sw-desk__track {
			animation-name: sw-slide, sw-fade-in;
			animation-timing-function: linear, cubic-bezier(0.5, 1, 0.89, 1);
			animation-range: contain var(--e) contain var(--t), contain 0% contain var(--e);
		}
		.sw-card--rise {
			animation-name: sw-rise;
			animation-timing-function: linear;
			animation-range: contain var(--from) contain var(--to);
		}
		.sw-card--fade {
			animation-name: sw-appear;
			animation-timing-function: linear;
			animation-range: contain var(--from) contain var(--to);
		}
		.sw-desk .sw-panel--cover .sw-panel__in {
			animation-name: sw-drift;
			animation-timing-function: linear;
			animation-range: contain var(--cover-at) contain var(--t);
		}
		.sw-desk .sw-panel--final {
			animation-name: sw-slide-out;
			animation-timing-function: linear;
			animation-range: contain var(--final-at) contain var(--t);
		}
	}
	@keyframes sw-show {
		from { visibility: hidden; }
		to { visibility: visible; }
	}
	@keyframes sw-slide {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(calc(100vw - 100%), 0, 0); }
	}
	@keyframes sw-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes sw-rise {
		from { transform: translate3d(0, 55vh, 0); }
		to { transform: translate3d(0, 0, 0); }
	}
	@keyframes sw-appear {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes sw-drift {
		from { transform: translate3d(240px, 0, 0); }
		to { transform: translate3d(var(--drift-to), 0, 0); }
	}
	/* Tucked half a step behind the cover, then slid out to its own place. */
	@keyframes sw-slide-out {
		from { transform: translate3d(-75vw, 0, 0); }
		to { transform: translate3d(0, 0, 0); }
	}

	/* ═══ Phones and tablets: a plain vertical stack ═══
	   The opener is pulled up one screen so it takes over exactly where the
	   manifesto ends: a whole screen, pinned for a moment while it comes up
	   out of the dark. Then the cards rise from below, one under another, and
	   the closing lines follow. The cards pad like every other section
	   (--section-space-bottom, --site-gutter). */
	.sw-mob {
		--intro-size: clamp(3rem, 15vw, 6rem);
		--intro-gap: 2rem;
		--intro-pad: 6vw;
		--card-w: 100%;
		--card-gap: 1.1rem;
		--card-offset: 0;
		--card-pad: 0.75rem 0.75rem 1.1rem;
		--media-ratio: 4 / 3;
		--title-size: clamp(1.25rem, 5.4vw, 1.9rem);
		--text-size: 0.88rem;
		--text-lh: 1.55;
	}
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.sw-mob {
			display: block;
			margin-top: calc(var(--app-stable-vh, 1svh) * -100);
			padding-bottom: var(--section-space-bottom);
		}
	}
	/* One screen pinned for 70% of a screen of scroll, while it fades in. */
	.sw-intro-wrap { height: calc(var(--app-stable-vh, 1svh) * 170); }
	.sw-intro-pin {
		position: sticky;
		top: 0;
		height: calc(var(--app-stable-vh, 1svh) * 100);
	}
	.sw-mob .sw-intro { width: 100%; height: 100%; }
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.sw-intro-wrap { view-timeline: --swi block; }
			.sw-mob .sw-intro {
				animation: sw-blur-in 1ms cubic-bezier(0.5, 1, 0.89, 1) both;
				animation-timeline: --swi;
				animation-range: contain 0% contain calc(var(--app-stable-vh, 1svh) * 70);
			}
		}
	}
	/* Comes into focus out of a blur as it fades in. */
	@keyframes sw-blur-in {
		from { opacity: 0; filter: blur(14px); }
		to { opacity: 1; filter: blur(0); }
	}
	.sw-list { display: grid; gap: 1.5rem; padding-inline: var(--site-gutter); }
	.sw-close {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
		margin-top: 3rem;
		padding-inline: var(--site-gutter);
		text-align: center;
	}
	.sw-close h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.sw-close__text { font-size: clamp(1.5rem, 6.8vw, 3rem); line-height: 1.05; letter-spacing: -0.02em; }
	.sw-close__final { margin-top: 1.5rem !important; font-size: clamp(2.4rem, 12vw, 4.5rem); line-height: 0.85; letter-spacing: -0.04em; }
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { onReady } from '../../utils/onReady';

	gsap.registerPlugin(ScrollTrigger);

	const MOBILE = '(max-width: 1024px), (hover: none) and (pointer: coarse)';

	// ── Desktop ────────────────────────────────────────────────────────────
	function initScene(section: HTMLElement) {
		const scene = section.querySelector<HTMLElement>('.sw-desk')!;
		const view = scene.querySelector<HTMLElement>('.sw-desk__view')!;
		const track = scene.querySelector<HTMLElement>('.sw-desk__track')!;
		const cover = scene.querySelector<HTMLElement>('.sw-panel--cover')!;
		const coverIn = cover.querySelector<HTMLElement>('.sw-panel__in')!;
		const last = scene.querySelector<HTMLElement>('.sw-panel--final')!;
		const rising = Array.from(scene.querySelectorAll<HTMLElement>('.sw-card--rise'));
		const fading = Array.from(scene.querySelectorAll<HTMLElement>('.sw-card--fade'));
		const pictures = Array.from(scene.querySelectorAll<HTMLElement>('.sw-media img'))
			.map((el) => ({ el, box: el.parentElement!, left: 0, width: 0 }));

		// The scroll's length, in screens (set in the frontmatter, which also
		// sizes the scene): blur-in on the spot, the horizontal travel, then a
		// hold on the last slide.
		const ENTER = Number(scene.dataset.enter);
		const TRAVEL = Number(scene.dataset.travel);
		const HOLD = Number(scene.dataset.hold);

		let maxScroll = 0;
		let risingX: number[] = [];
		const risenY: number[] = [];
		let fadingX: number[] = [];
		let coverX = 0;
		const dpr = () => window.devicePixelRatio || 1;

		// Layout reads happen here only (init + refresh), never per frame.
		const measure = () => {
			maxScroll = Math.max(0, track.scrollWidth - window.innerWidth);
			risingX = rising.map((c) => c.offsetLeft);
			fadingX = fading.map((c) => c.offsetLeft);
			coverX = cover.offsetLeft;
			pictures.forEach((p) => { p.left = p.box.offsetLeft; p.width = p.box.offsetWidth; });
		};
		measure();
		ScrollTrigger.addEventListener('refreshInit', measure);

		// Everything that rides on the track's position.
		const apply = () => {
			const x = -(gsap.getProperty(track, 'x') as number);
			const vw = window.innerWidth;
			const vh = window.innerHeight;

			// The last slide slides out from behind the cover.
			const toEnd = maxScroll - x;
			last.style.transform = toEnd < vw * 1.5 ? `translate3d(-${(toEnd * 0.5).toFixed(1)}px,0,0)` : 'translate3d(0,0,0)';

			// Cards rise into place as they come in; the first one just fades.
			// Only a value that changed is written: cards still waiting below
			// the screen (clamped at maxY) or already in place cost nothing.
			const maxY = vh * 0.55;
			rising.forEach((card, i) => {
				const lp = Math.max(0, ((risingX[i] - x) / vw - 0.5) * 2);
				// Not rounded: whole-pixel steps made the card's speed uneven
				// frame to frame (a visible crunch). It still lands on exactly 0.
				const y = Math.round(Math.min(lp * maxY, maxY) * 100) / 100;
				if (y !== risenY[i]) {
					risenY[i] = y;
					card.style.transform = `translate3d(0,${y}px,0)`;
				}
			});
			fading.forEach((card, i) => {
				card.style.opacity = Math.max(0, Math.min(1, (1 - (fadingX[i] - x) / vw) * 2)).toFixed(3);
			});

			const cp = (coverX - x) / vw;
			if (cp < 1.2 && cp > -1) coverIn.style.transform = `translate3d(${(cp * 200).toFixed(1)}px,0,0)`;

			pictures.forEach((p) => {
				const left = p.left - x;
				if (left < vw && left + p.width > 0) {
					p.el.style.transform = `scale(1.2) translate3d(${(((left - vw / 2) / vw) * 8).toFixed(2)}%,0,0)`;
				}
			});
		};

		// One scrubbed timeline spans the whole pinned scroll.
		const tl = gsap.timeline({ defaults: { ease: 'none' }, onUpdate: apply });
		tl.fromTo(view, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.001, immediateRender: true }, 0);
		tl.fromTo(track, { opacity: 0 }, { opacity: 1, duration: ENTER, ease: 'power1.out' }, 0);
		tl.fromTo(track,
			{ x: 0 },
			{
				x: () => -maxScroll,
				duration: TRAVEL,
				force3D: true,
				// Whole device pixels: fractional offsets resample the big layers.
				modifiers: { x: (v: string) => `${Math.round(parseFloat(v) * dpr()) / dpr()}px` },
			},
			ENTER);
		tl.to({}, { duration: HOLD }, ENTER + TRAVEL);

		const st = ScrollTrigger.create({
			animation: tl,
			trigger: scene,
			start: 'top top',
			end: 'bottom bottom',
			scrub: 0.3,
			invalidateOnRefresh: true,
		});
		apply();

		document.addEventListener('astro:before-swap', () => {
			st.kill();
			tl.kill();
			ScrollTrigger.removeEventListener('refreshInit', measure);
		}, { once: true });
		window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
	}

	onReady(() => {
		const section = document.getElementById('selected-work');
		if (!section) return;
		// Phones and tablets are a plain vertical stack (CSS only).
		if (window.matchMedia(MOBILE).matches) return;
		// The desktop scene is driven by CSS where scroll-driven animations
		// exist (see the styles); this is the same scene for the rest.
		if (!CSS.supports('animation-timeline: view()')) initScene(section);
	});
</script>
