---
import { Image } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';

// Selected work as full-screen frames: one pinned screen on every device, the
// scroll melts one project into the next along a band of light (WebGL, see
// utils/beamSlides.ts). The old horizontal carousel / phone strip is kept in
// components/backup/SelectedWorkSection.before-beam.astro.
//
// Pictures are stored locally (the site's CSP blocks remote images). Swap each
// for the project's own shot (wide, ~2400px). `fx` is where its subject sits
// across the picture (0 left .. 1 right): on a portrait screen the picture is
// cropped to a narrow window, and this keeps the subject (the deer) in it.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, fx: 0.15, href: '/projects/winds-of-sinai/' },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, fx: 0.5, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, fx: 0.5, href: '/work/mousa-export' },
];

// Scroll length: see LEAD / PER in the script (longer on touch screens). The
// value here is only the no-JS default.
const HOLD = 0.4;
const SCREENS = projects.length + HOLD;
---
<section id="selected-work">

	<!-- #sw-scroll-section keeps its id: HeroSection's menu button waits for it. -->
	<div class="swb" id="sw-scroll-section" data-n={projects.length} data-hold={HOLD} style={`--screens:${SCREENS + 1}`}>
		<div class="swb__stage">

			<!-- The picture fills the screen; the edge blur bands stay on over it
			     (lighter while this view is pinned, see global.css). -->
			<div class="swb__frame">
				<canvas class="swb__canvas" aria-hidden="true"></canvas>

				<!-- The same pictures, as ordinary images: they are the textures of the
				     canvas, and the cross-fade for browsers without WebGL. -->
				{projects.map((p) => (
					<Image class="swb__img" src={p.img} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="async" data-fx={p.fx} />
				))}

				<div class="swb__shade" aria-hidden="true"></div>
			</div>

			<div class="swb__intro">
				<h2 class="swb__title">What we've<br><em>created.</em></h2>
				<a href="/projects" class="link-btn sw-link">View All Projects</a>
			</div>

			{projects.map((p) => (
				<div class="swb__slide">
					<div>
						<a href={p.href} class="swb__name"><h3>{p.title}</h3></a>
						<p>{p.desc}</p>
					</div>
					<a href={p.href} class="link-btn sw-link">Explore</a>
				</div>
			))}
		</div>
	</div>

	<div class="swb-panel swb-cover">
		<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
		<div class="h-hero-cta-wrap swb-cover__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">Explore more projects</span>
			</a>
		</div>
	</div>

</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
		/* (no background of its own: pulled up a screen, it would paint over the
		   manifesto's last screen; the stage and the closing panel have theirs) */
	}

	/* The pinned view is sticky (not a script pin): the height is the scroll
	   length, in the locked screen height so a phone's moving address bar
	   cannot stretch it. */
	.swb {
		position: relative;
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: the title comes up out of the dark on the spot
		   (nothing slides in from below), as in the original section. */
		margin-top: calc(var(--app-stable-vh, 1svh) * -100);
		height: calc(var(--app-stable-vh, 1svh) * 100 * var(--screens));
	}
	.swb__stage {
		position: sticky;
		top: 0;
		height: calc(var(--app-stable-vh, 1svh) * 100);
		overflow: hidden;
		background: #000;
	}
	/* --band is the edge blur bands' height (utils/gradualBlur.js): the copy
	   stands clear of it, so the bands never blur the text. */
	.swb__stage { --band: clamp(5.5rem, 6vw, 7rem); }
	.swb__frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #000;
	}
	.swb__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* Without WebGL the images themselves cross-fade (the script sets opacity). */
	.swb__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 70%;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
	.swb--fallback .swb__img { visibility: visible; }
	.swb--fallback .swb__canvas { display: none; }

	/* A light darkening under the copy only (no blur anywhere on the pictures). */
	.swb__shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 75% 60% at 12% 100%, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.3) 45%, transparent 75%),
			linear-gradient(to top, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.18) 22%, transparent 40%);
	}

	/* Type and spacing are the original section's (title, card title, line,
	   text link, closing panels) — only the layout around them is new. */

	/* The opener: the title and its link alone in the dark, before the first picture. */
	.swb__intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		pointer-events: none;
		will-change: opacity, filter;
	}
	/* In from blur once the view is pinned (time-based, like the other sections'
	   headings); scrolling back up it goes out quicker. The script sets .in. */
	.swb__intro .swb__title,
	.swb__intro .sw-link {
		transition: opacity 0.8s ease, filter 1s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
	}
	.swb__intro:not(.in) .swb__title,
	.swb__intro:not(.in) .sw-link {
		opacity: 0;
		filter: blur(14px);
		transform: translateY(14px);
		transition: opacity 0.45s ease, filter 0.5s ease, transform 0.5s ease;
	}
	.swb__intro.in .sw-link { transition-delay: 0.15s; }
	.swb__title {
		margin: 0 0 2.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* The card's info row: title and line left, Explore right. */
	.swb__slide {
		position: absolute;
		left: calc(var(--site-gutter, 2rem) + 1.5rem);
		bottom: calc(var(--band) + 0.75rem + 1.5rem);
		width: min(44rem, calc(100% - 2 * (var(--site-gutter, 2rem) + 1.5rem)));
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		opacity: 0;
		visibility: hidden;
		will-change: opacity, filter, transform;
		/* a soft dark halo, so the copy reads over bright grass and water alike */
		text-shadow: 0 1px 2px rgb(0 0 0 / 0.5), 0 2px 22px rgb(0 0 0 / 0.65);
	}
	.swb__name { display: block; text-decoration: none; }
	.swb__slide h3 {
		margin: 0 0 0.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__slide p {
		margin: 0;
		max-width: 320px;
		font-family: var(--f-body);
		font-size: 0.9rem;
		font-weight: 300;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.95);
	}

	/* Text link whose underline draws in on hover. (Size and tracking come
	   from the global .link-btn rule.) */
	.sw-link {
		position: relative;
		padding-bottom: 3px;
		font-family: var(--f-body);
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.sw-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.sw-link:hover { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-link:hover::after { transform: scaleX(1); }
	}

	/* On the pictures the link is full cream with its underline already drawn
	   (it is dimmer elsewhere, on the plain black of the opener). */
	.swb__slide .sw-link { color: rgb(var(--c-cream)); }
	.swb__slide .sw-link::after { transform: scaleX(1); opacity: 0.45; transition: transform 0.4s cubic-bezier(0.25,1,0.5,1), opacity 0.3s ease; }
	@media (hover: hover) {
		.swb__slide .sw-link:hover::after { opacity: 1; }
	}

	/* After the pinned view: the two closing screens, in the page's own
	   background, centred, as before. */
	.swb-panel {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding-left: 12vw;
		padding-right: 12vw;
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}
	.swb-panel h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
	}
	/* (The old carousel's last slide, the A.I. / DESIGN / DEVELOPMENT / BRANDING
	   line, is gone: the Services section already says it.) */
	.swb-cover { gap: 2.5rem; padding-top: clamp(6rem, 16vh, 11rem); padding-bottom: clamp(5rem, 14vh, 10rem); }
	.swb-cover h2 { font-size: clamp(2rem, 3.8vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
	.swb-cover__cta { width: auto !important; margin: 0; }

	@media (min-width: 1025px) and (max-width: 1600px) {
		.swb__title { font-size: clamp(3rem, 6vw, 8rem); }
	}
	/* Phones and tablets: the original's smaller steps. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb__intro { padding: 0 6vw; }
		.swb__title { margin-bottom: 2rem; font-size: clamp(3rem, 15vw, 6rem); }
		.swb__slide { left: calc(var(--site-gutter, 2rem) + 1rem); bottom: calc(var(--band) + 0.75rem + 1rem); width: calc(100% - 2 * (var(--site-gutter, 2rem) + 1rem)); }
		.swb__slide h3 { font-size: clamp(1.25rem, 5.4vw, 1.9rem); }
		.swb__slide p { font-size: 0.88rem; line-height: 1.55; }
		.swb-panel { padding-left: 8vw; padding-right: 8vw; }
		.swb-cover { gap: 1.75rem; }
		.swb-cover h2 { font-size: clamp(1.5rem, 6.8vw, 3rem); }
	}
	/* Tablets: a card title one step under the page titles (as in the original). */
	@media (min-width: 700px) and (max-width: 1024px), (min-width: 700px) and (hover: none) and (pointer: coarse) {
		.swb__slide h3 { font-size: calc(var(--hero-size) * 0.55); }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';

	gsap.registerPlugin(ScrollTrigger);

	const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
	const smooth = (v: number) => { v = clamp(v); return v * v * (3 - 2 * v); };
	const TOUCH = '(max-width: 1024px), (hover: none) and (pointer: coarse)';
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let cleanup: (() => void) | null = null;

	function initWork() {
		cleanup?.();
		cleanup = null;

		const wrap = document.getElementById('sw-scroll-section');
		const stage = wrap?.querySelector<HTMLElement>('.swb__stage');
		const canvas = wrap?.querySelector<HTMLCanvasElement>('.swb__canvas');
		const frame = wrap?.querySelector<HTMLElement>('.swb__frame');
		if (!wrap || !stage || !canvas || !frame) return;

		const n = Number(wrap.dataset.n) || 1;
		const hold = Number(wrap.dataset.hold) || 0;
		const images = Array.from(wrap.querySelectorAll<HTMLImageElement>('.swb__img'));
		const slides = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__slide'));
		const intro = wrap.querySelector<HTMLElement>('.swb__intro')!;
		const root = document.documentElement;

		const fallback = () => stage.classList.add('swb--fallback');
		let beam: BeamSlides | null = null;
		if (reduced()) fallback();
		else {
			beam = createBeamSlides(canvas, images, fallback);
			if (!beam) fallback();
		}

		let pos = 0;      // 0 .. n: the dark, then each project in turn

		const show = (el: HTMLElement, o: number) => {
			el.style.opacity = o.toFixed(3);
			el.style.visibility = o < 0.02 ? 'hidden' : 'visible';
			el.style.filter = o >= 0.999 ? '' : `blur(${((1 - o) * 14).toFixed(1)}px)`;
		};

		const render = () => {
			beam?.setPos(pos);
			// the opener goes out (blur) as the first picture comes
			const t = 1 - smooth((pos - 0.05) / 0.25);
			intro.style.opacity = t.toFixed(3);
			intro.style.filter = t >= 0.999 ? '' : `blur(${((1 - t) * 16).toFixed(1)}px)`;
			intro.style.pointerEvents = t > 0.5 && intro.classList.contains('in') ? 'auto' : 'none';
			slides.forEach((el, i) => {
				const o = 1 - smooth((Math.abs(pos - (i + 1)) - 0.12) / 0.18);
				show(el, o);
				el.style.transform = o >= 0.999 ? '' : `translateY(${((1 - o) * 14).toFixed(1)}px)`;
				el.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
			});
			if (stage.classList.contains('swb--fallback')) {
				images.forEach((im, k) => { im.style.opacity = (1 - smooth((Math.abs(pos - (k + 1)) - 0.3) / 0.4)).toFixed(3); });
			}
		};

		// How much scroll each step takes. The title first stands alone for LEAD
		// screens (it was easy to scroll past), then each picture gets PER screens
		// (the beam sweeps in the middle 40% of it): longer on touch, where a flick
		// would otherwise carry through a whole transition.
		const touch = window.matchMedia(TOUCH).matches;
		const LEAD = touch ? 1.1 : 0.9;
		const PER = touch ? 2.2 : 1.6;
		const length = LEAD + PER * (n + hold);   // in screens
		wrap.style.setProperty('--screens', String(length + 1));
		const setFrom = (progress: number) => { pos = clamp((progress * length - LEAD) / PER, 0, n); render(); };

		// The edge blur bands stay on over the pictures; while the view is pinned
		// they run light and, on phones, off (the original behaviour of this
		// section, global.css html.sw-hscroll).
		const sync = (st: ScrollTrigger) => {
			const pinned = st.scroll() >= st.start;
			intro.classList.toggle('in', pinned);
			// Hidden until its pin starts: pulled up a screen, its black stage would
			// otherwise slide up over the manifesto's last screen like a curtain
			// (and scrolling back up it goes away the same way).
			stage.style.visibility = pinned ? '' : 'hidden';
			root.classList.toggle('sw-hscroll', st.isActive);
		};
		const stPin = ScrollTrigger.create({
			trigger: wrap, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
			onUpdate: (s) => { setFrom(s.progress); sync(s); },
			onRefresh: (s) => { setFrom(s.progress); sync(s); },
			onToggle: sync,
		});
		render();

		const ro = new ResizeObserver(() => beam?.resize());
		ro.observe(frame);

		cleanup = () => {
			stPin.kill();
			ro.disconnect();
			beam?.destroy();
			root.classList.remove('sw-hscroll');
		};
	}

	document.addEventListener('astro:page-load', initWork);
	// (a phone turned on its side, a window resized across the tablet width)
	let wasTouch = window.matchMedia(TOUCH).matches;
	window.addEventListener('resize', () => {
		const now = window.matchMedia(TOUCH).matches;
		if (now === wasTouch) return;
		wasTouch = now;
		if (document.getElementById('sw-scroll-section')) { initWork(); ScrollTrigger.refresh(); }
	});
	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
