---
import { Image } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';

// Selected work as full-screen frames: one pinned screen on every device, the
// scroll melts one project into the next along a band of light (WebGL, see
// utils/beamSlides.ts). The old horizontal carousel / phone strip is kept in
// components/backup/SelectedWorkSection.before-beam.astro.
//
// Pictures are stored locally (the site's CSP blocks remote images). Swap each
// for the project's own shot (wide, ~2400px). `fx` is where its subject sits
// across the picture (0 left .. 1 right): on a portrait screen the picture is
// cropped to a narrow window, and this keeps the subject (the deer) in it.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, fx: 0.15, href: '/projects/winds-of-sinai/' },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, fx: 0.5, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, fx: 0.5, href: '/work/mousa-export' },
];

// Scroll length: see LEAD / PER in the script (one screen per step, the snap lands each picture exactly). The
// value here is only the no-JS default.
const HOLD = 0.4;

// The project text and the Explore button under each picture. They were the cause of the stutter on
// Chrome (Android): see BUGS.md. Now a light version (one layer, opacity and a short rise only, no
// filter, no backdrop blur). Set to false to leave them out.
const SHOW_TEXT = true;
const SCREENS = projects.length + HOLD;
---
<section id="selected-work">

	<!-- #sw-scroll-section keeps its id: HeroSection's menu button waits for it. -->
	<div class="swb" id="sw-scroll-section" data-n={projects.length} data-hold={HOLD} style={`--screens:${SCREENS + 1}`}>
		<div class="swb__stage">

			<!-- The picture fills the screen; the edge blur bands stay on over it
			     (lighter while this view is pinned, see global.css). -->
			<div class="swb__frame">
				<canvas class="swb__canvas" aria-hidden="true"></canvas>

				<!-- The same pictures, as ordinary images: they are the textures of the
				     canvas, and the cross-fade for browsers without WebGL. -->
				{projects.map((p) => (
					<Image class="swb__img" src={p.img} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="async" data-fx={p.fx} />
				))}

			</div>

			<div class="swb__intro">
				<h2 class="swb__title">Selected<br><em>work.</em></h2>
				<a href="/projects" class="link-btn sw-link">View All Projects</a>
			</div>

			<!-- The picture itself opens the project too, with a mouse only (CSS below):
			     on a touch screen it is the scrolling surface, and a tap to stop it
			     must not open anything. Real links, so they prefetch and middle-click. -->
			{projects.map((p) => (
				<a class="swb__hit" href={p.href} tabindex="-1" aria-hidden="true"></a>
			))}

			<!-- Top line: the section's name on the left, which project on the right (the
			     layout of the test file). Arrives with the first picture. -->
			<div class="swb__top">
				<span>Selected work</span>
				<span class="swb__count" aria-hidden="true">01 / {String(projects.length).padStart(2, '0')}</span>
			</div>

			{SHOW_TEXT && (
			<div class="swb__bottom">
				<div class="swb__info">
					{projects.map((p) => (
						<div class="swb__slide">
							<a href={p.href} class="swb__name"><h3>{p.title}</h3></a>
							<p>{p.desc}</p>
							<div class="h-hero-cta-wrap swb__cta">
								<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
								<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
								<a href={p.href} class="h-hero-cta h-hero-cta--fixed">
									<span class="hud-spin-border"></span>
									<span class="h-hero-cta__text">Explore</span>
								</a>
							</div>
						</div>
					))}
				</div>
			</div>
			)}
		</div>
	</div>

	<div class="swb-panel swb-cover">
		<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
		<div class="h-hero-cta-wrap swb-cover__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed" data-frame-fx>
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">Explore more projects</span>
			</a>
		</div>
	</div>

</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
		/* (no background of its own: pulled up a screen, it would paint over the
		   manifesto's last screen; the stage and the closing panel have theirs) */
	}

	/* The pinned view is sticky (not a script pin): the height is the scroll
	   length, in the locked screen height so a phone's moving address bar
	   cannot stretch it. */
	.swb {
		position: relative;
		/* Pulled up 20 of a screen under the end of Services (it was 55: the title then came in while See more was still
		   at half strength, with too little scroll between the two). By the time this view pins, the last option has
		   blurred out and there is a short stretch of dark before the title. Pulled up under the end of Services, so the pinned view takes over just as the options blur out:
		   the title comes out of blur where they were, with no long black stretch between (Services is above
		   it, so it stays readable until it blurs out). */
		margin-top: calc(var(--app-stable-vh, 1svh) * -20);
		height: calc(var(--app-stable-vh, 1svh) * 100 * var(--screens));
	}
	.swb__stage {
		position: sticky;
		top: 0;
		height: calc(var(--app-stable-vh, 1svh) * 100);
		overflow: hidden;
		background: #000;
	}
	/* --band is the edge blur bands' height (utils/gradualBlur.js): the copy
	   stands clear of it, so the bands never blur the text. */
	.swb__stage { --band: clamp(5.5rem, 6vw, 7rem); }
	.swb__frame {
		position: absolute;
		inset: 0;
		/* its own stacking context: the vignette inside it can never paint over the text */
		isolation: isolate;
		overflow: hidden;
		background: #000;
	}
	.swb__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* Vignette: the pictures sit in the dark, their edges and corners fall away to
	   black, so each one comes up out of the dark and centres on the middle (and the
	   text at the bottom has a darker ground). Over the canvas and the fallback images,
	   under the title and the text. */
	/* ?lite=… switches (see the script): one cost off at a time on a slow phone */
	:global(html.sw-lite-bands .gradual-blur) { display: none !important; }
	.swb--lite-vig .swb__frame::after { display: none; }
	.swb__frame::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background:
			radial-gradient(ellipse 75% 70% at 50% 46%, transparent 38%, rgb(0 0 0 / 0.55) 72%, rgb(0 0 0 / 0.9) 100%),
			linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, transparent 24%, transparent 58%, rgb(0 0 0 / 0.78) 100%);
	}
	/* The picture ends in the page's black, not in an edge: the last stretch of the frame fades to the
	   background colour, so there is no visible border of the picture above the closing panel. */
	.swb__frame::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: clamp(9rem, 32vh, 22rem);
		pointer-events: none;
		z-index: 1;
		background: linear-gradient(180deg, rgb(var(--c-bg) / 0) 0%, rgb(var(--c-bg) / 0.55) 45%, rgb(var(--c-bg)) 100%);
	}
	/* Without WebGL the images themselves cross-fade (the script sets opacity). */
	.swb__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 70%;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
	.swb--fallback .swb__img { visibility: visible; }
	.swb--fallback .swb__canvas { display: none; }

	/* Type and spacing are the original section's (title, card title, line,
	   text link, closing panels) — only the layout around them is new. */

	/* The opener: the title and its link alone in the dark, before the first picture. */
	.swb__intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		pointer-events: none;
		will-change: opacity, filter;
	}
	/* The title comes in and goes out as ONE motion, driven by the scroll (opacity, blur and a small rise on the whole
	   opener, see render()). It used to blur in twice: the opener's own blur, and a second one from a class toggle on
	   the title and the link inside. */
	.swb__title {
		margin: 0 0 2.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Every letter carries its own shadow (no box, no cloud): a tight dark edge
	   plus wider layers, so each line reads on bright and busy pictures alike. */
	.swb__slide {
		position: absolute;
		left: 0;
		bottom: 0;
		width: min(30rem, 100%);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		/* Two layers (it was seven, up to 90px wide): painted over a canvas that changes every
		   frame, wide shadows are what Chrome on Android could not keep up with. The picture's
		   own dark vignette at the bottom does the rest. */
		--ink-shadow:
			0 1px 2px rgb(0 0 0 / 0.9),
			0 0 16px rgb(0 0 0 / 0.75);
		/* The site's blur-in (as the title and the other headings: opacity .8s, blur 1s, rise .8s on the
		   same soft ease), as CSS transitions: Chrome runs opacity, transform and filter on the
		   compositor, so the entrance does not repaint text over the live canvas on every frame (what
		   stuttered on Android with the scripted blur, BUGS.md). It goes out quicker, like the title. */
		opacity: 0;
		visibility: hidden;
		transform: translateY(14px);
		filter: blur(14px);
		transition: opacity 0.45s ease, filter 0.5s ease, transform 0.5s ease, visibility 0s linear 0.5s;
	}
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb__slide { filter: none; transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s; }
		.swb__slide.in { transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s; }
	}
	.swb__slide.in {
		opacity: 1;
		visibility: visible;
		transform: none;
		filter: none;
		transition: opacity 0.8s ease, filter 1s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
	}
	/* The picture as a link: one per project, only the one on screen answers,
	   and only to a mouse. */
	.swb__hit {
		position: absolute;
		inset: 0;
		display: block;
		pointer-events: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.swb__hit.is-active { pointer-events: auto; cursor: pointer; }
	}
	.swb__name { display: block; text-decoration: none; }
	.swb__slide h3 {
		text-shadow: var(--ink-shadow);
		margin: 0 0 0.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__slide p {
		text-shadow: var(--ink-shadow);
		margin: 0 0 1.4rem;
		max-width: 340px;
		font-family: var(--f-body);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.9);
	}
	/* Explore is the site's own button (.h-hero-cta, as START A PROJECT), small,
	   under the text on the left. Only its size and backdrop are set here: dark
	   glass with a blur, the way the top-bar button does it (.nav-cta in
	   global.css), so it reads over any picture. A small element: the blur is
	   cheap. */
	.swb__cta { width: auto !important; max-width: none !important; margin: 0; }
	.swb__cta .h-hero-cta {
		/* dark, nearly solid ground instead of a backdrop blur: a blur over the live canvas
		   is what stuttered on Chrome (Android) */
		--cta-bg: rgb(0 0 0 / 0.72);
		min-height: 46px;
		min-width: 11rem;
		padding: 0.7rem 1.8rem;
	}

	/* Previous / next, bottom right, level with the text block. Dark glass like the
	   Explore button, so they read over any picture. Hidden over the title screen
	   (the script sets the opacity). */
	.swb__top {
		font-family: var(--f-body);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.6);
		text-shadow: 0 0 12px rgb(0 0 0 / 0.8);
	}
	.swb__count { font-variant-numeric: tabular-nums; }

	/* The layout of the test file: a line across the bottom, the text on the left,
	   the controls on the right, and the section's name with the count on top. Both
	   arrive with the first picture (the script sets their opacity); the blur band at
	   each edge is cleared by --band. */
	.swb__top {
		position: absolute;
		top: calc(var(--band) + 0.75rem);
		left: calc(var(--site-gutter, 2rem) + 1rem);
		display: flex;
		gap: 1.5rem;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}
	.swb__bottom {
		position: absolute;
		left: calc(var(--site-gutter, 2rem) + 1rem);
		right: calc(var(--site-gutter, 2rem) + 1rem);
		bottom: calc(var(--band) + 2rem);
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 2rem;
		padding-top: 1.5rem;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}
	/* The slides stack and cross-fade here, so the box keeps the tallest one's room. */
	.swb__info { position: relative; min-height: 11.5rem; }

	/* Text link whose underline draws in on hover. (Size and tracking come
	   from the global .link-btn rule.) */
	.sw-link {
		position: relative;
		padding-bottom: 3px;
		font-family: var(--f-body);
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.sw-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.sw-link:hover { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-link:hover::after { transform: scaleX(1); }
	}

	/* After the pinned view: the two closing screens, in the page's own
	   background, centred, as before. */
	.swb-panel {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding-left: 12vw;
		padding-right: 12vw;
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}
	.swb-panel h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
	}
	/* (The old carousel's last slide, the A.I. / DESIGN / DEVELOPMENT / BRANDING
	   line, is gone: the Services section already says it.) */
	.swb-cover { gap: 2.5rem; padding-top: clamp(6rem, 16vh, 11rem); padding-bottom: clamp(5rem, 14vh, 10rem); }
	.swb-cover h2 { font-size: clamp(2rem, 3.8vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
	.swb-cover__cta { width: auto !important; margin: 0; }
	/* Phones and tablets: far less black around the closing panel. After the last picture the page had a stretch of empty black
	   (the panel's top padding on top of the black the picture fades into) before the first word came up, and the same
	   again below the button: it looked as if the page had stopped loading. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb-cover { padding-top: clamp(1.25rem, 3.5vh, 2.5rem); padding-bottom: clamp(2rem, 5vh, 3.5rem); }
	}

	@media (min-width: 1025px) and (max-width: 1600px) {
		.swb__title { font-size: clamp(3rem, 6vw, 8rem); }
	}
	/* Phones and tablets: the original's smaller steps. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb__intro { padding: 0 6vw; }
		.swb__title { margin-bottom: 2rem; font-size: clamp(3rem, 15vw, 6rem); }
		/* the text on top, the controls in a row under it (buttons right, bar left) */
		.swb__top { left: var(--site-gutter, 2rem); }
		.swb__bottom { left: var(--site-gutter, 2rem); right: var(--site-gutter, 2rem); bottom: calc(var(--band) + 1.25rem); grid-template-columns: 1fr; gap: 1.1rem; padding-top: 1.1rem; }
		.swb__info { min-height: 12.5rem; }
		.swb__slide { width: 100%; }
		/* (the shadow is on the letters themselves, see --ink-shadow) */
		.swb__slide h3 { font-size: clamp(1.25rem, 5.4vw, 1.9rem); }
		.swb__slide p { font-size: 0.95rem; line-height: 1.55; max-width: none; margin-bottom: 1.2rem; }
		.swb-panel { padding-left: 8vw; padding-right: 8vw; }
		.swb-cover { gap: 1.75rem; }
		.swb-cover h2 { font-size: clamp(1.5rem, 6.8vw, 3rem); }
	}
	/* Tablets: a card title one step under the page titles (as in the original). */
	@media (min-width: 700px) and (max-width: 1024px), (min-width: 700px) and (hover: none) and (pointer: coarse) {
		.swb__slide h3 { font-size: calc(var(--hero-size) * 0.55); }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';

	gsap.registerPlugin(ScrollTrigger);

	const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
	const smooth = (v: number) => { v = clamp(v); return v * v * (3 - 2 * v); };
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let cleanup: (() => void) | null = null;

	function initWork() {
		cleanup?.();
		cleanup = null;

		const wrap = document.getElementById('sw-scroll-section');
		const stage = wrap?.querySelector<HTMLElement>('.swb__stage');
		const canvas = wrap?.querySelector<HTMLCanvasElement>('.swb__canvas');
		const frame = wrap?.querySelector<HTMLElement>('.swb__frame');
		if (!wrap || !stage || !canvas || !frame) return;

		const n = Number(wrap.dataset.n) || 1;
		const hold = Number(wrap.dataset.hold) || 0;
		const images = Array.from(wrap.querySelectorAll<HTMLImageElement>('.swb__img'));
		const slides = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__slide'));
		const hits = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__hit'));
		const intro = wrap.querySelector<HTMLElement>('.swb__intro')!;
		// the top line and the bottom block (rule, text, controls) arrive with the first picture
		const chrome = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__top, .swb__bottom'));
		const count = wrap.querySelector<HTMLElement>('.swb__count')!;
		let lastShown = 0;
		const root = document.documentElement;

		// Diagnostics for a slow phone: open the page with ?lite=bands,vig,dpr (or ?lite=all)
		// and each named cost is switched off, so the one that makes it stutter can be found.
		//   bands = the edge blur bands, vig = the vignette, dpr = the canvas at 1x.
		const lite = new URLSearchParams(window.location.search).get('lite') ?? '';
		const liteOn = (k: string) => lite === 'all' || lite.split(',').includes(k);
		if (liteOn('bands')) root.classList.add('sw-lite-bands');
		if (liteOn('vig')) stage.classList.add('swb--lite-vig');

		// The beam crosses the whole step (as in the test file); the snap makes every
		// picture come to rest exactly on its own stop, on a mouse and on a finger alike.
		const RANGE: [number, number] = [0, 1];
		const TEXT_REST = 0.05;   // within this of a whole number a picture stands still
		let lastPos = 0;
		let forward = true;       // the way the page is moving
		const fallback = () => stage.classList.add('swb--fallback');
		let beam: BeamSlides | null = null;
		if (reduced()) fallback();
		else {
			beam = createBeamSlides(canvas, images, fallback, RANGE);
			if (!beam) fallback();
		}

		let pos = 0;      // 0 .. n: each project in turn (the light's position)
		let uPos = 0;     // the scroll since the title's rest, in steps: first the title goes out and there is a moment of dark (0 .. DARK), then the light
		// The title is out by 0.6 of DARK, then a moment of dark, and only then the light. The dark is its OWN stretch of
		// scroll in front of the first picture (not a share of the first picture's step), so the light has to be pushed
		// through exactly as far for the first picture as for the next two: the same resistance on all three.
		// Touch: almost no dark, and the title takes longer to go out (TITLE_SPAN) than the dark lasts, so the first picture's
		// light is already coming in while the title is still blurring away: an overlap, not a gap.
		const touchDark = true;   // every device: desktop, tablet and phone
		const DARK = touchDark ? 0.06 : 0.42;
		const TITLE_SPAN = touchDark ? 0.4 : DARK * 0.6;   // the title is gone after this much scroll (in steps)

		// The text does not follow the scroll: it comes in by itself (time-based) while the beam
		// is still crossing, out of blur, so by the time the light has landed it is already there.
		// It leaves quickly the moment the next beam begins. All of it is the .in class and the CSS
		// transitions above (nothing is animated from the script).
		const revealText = (el: HTMLElement) => {
			el.classList.add('in');
			el.style.pointerEvents = 'auto';
		};
		const hideText = (el: HTMLElement) => {
			el.classList.remove('in');
			el.style.pointerEvents = 'none';
		};
		let activeText = -1;

		const noIntroBlur = true;   // every device
		// The opener: in from blur as the scroll reaches it, out before the first picture begins, both scrubbed, so
		// it is one soft motion either way and never in two stages.
		// Touch: it starts BEFORE the view pins (while the options are still blurring out above it), held on the spot
		// against the stage that is still rising, so it only comes out of the dark and no black stretch is left between.
		const updateIntro = () => {
			const vh = window.innerHeight;
			const y = window.scrollY;
			const pinStart = wrap.getBoundingClientRect().top + y;
			const from = noIntroBlur ? -0.4 : 0.15;
			const span = noIntroBlur ? 0.5 : 0.45;
			let tin = smooth((y - pinStart - from * vh) / (span * vh));
			// Touch: no two texts on screen at once. The title starts only when "All services" (the last thing of the
			// options) has gone out at the top (its centre above 20% of the screen, it is already faint there), so one takes over from the other.
			if (noIntroBlur) {
				const btn = document.querySelector<HTMLElement>('#services .svc__btn');
				if (btn) {
					const r = btn.getBoundingClientRect();
					tin = smooth((0.20 - (r.top + r.height / 2) / vh) / 0.25);
				}
			}
			const tout = 1 - smooth(uPos / TITLE_SPAN);
			const t = Math.min(tin, tout);
			intro.style.opacity = t.toFixed(3);
			intro.style.filter = t >= 0.999 ? '' : `blur(${((1 - t) * (noIntroBlur ? 9 : 14)).toFixed(1)}px)`;
			const hold = noIntroBlur && y < pinStart ? y - pinStart : 0;
			const rise = tin >= 0.999 ? 0 : (1 - tin) * 14;
			intro.style.transform = hold || rise ? `translateY(${(hold + rise).toFixed(1)}px)` : '';
			intro.style.pointerEvents = t > 0.7 ? 'auto' : 'none';
		};
		const render = () => {
			// The light and everything that follows it (picture, name, controls) share one position.
			const bpos = pos;
			beam?.setPos(bpos);
			updateIntro();
			let nowText = -1;
			// The name of the picture the light is going TO comes in the moment the beam starts (and
			// the one it leaves goes out): at rest it is the picture on screen, on the move the next one
			// in the direction of the scroll.
			if (bpos !== lastPos) { forward = bpos > lastPos; lastPos = bpos; }
			const nearestPic = Math.round(bpos);
			const dest = Math.abs(bpos - nearestPic) < TEXT_REST ? nearestPic : forward ? Math.ceil(bpos) : Math.floor(bpos);
			if (dest >= 1 && dest <= n) nowText = dest - 1;
			if (nowText !== activeText) {
				activeText = nowText;
				slides.forEach((el, i) => (i === nowText ? revealText(el) : hideText(el)));
			}
			hits.forEach((h, i) => h.classList.toggle('is-active', i === nowText));
			// previous / next arrive with the first picture; the ends are disabled
			const on = smooth((bpos - 0.35) / 0.3);
			chrome.forEach((el) => {
				el.style.opacity = on.toFixed(3);
				el.style.visibility = on < 0.02 ? 'hidden' : 'visible';
			});
			const shown = clamp(Math.round(bpos), 1, n);
			if (shown !== lastShown) {
				lastShown = shown;
				count.textContent = `${String(shown).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
			}
			if (stage.classList.contains('swb--fallback')) {
				images.forEach((im, k) => { im.style.opacity = (1 - smooth((Math.abs(pos - (k + 1)) - 0.1) / 0.5)).toFixed(3); });
			}
		};

		// How much scroll each step takes: one screen, as the home hero's exit. The title
		// first stands alone for LEAD screens, then each picture gets PER screens.
		// Premium, so smooth and unhurried, never aggressive: long steps (the title stands a good while, a picture gets
		// a full screen or more of scroll), a third of a step to commit to the next picture (a light touch just settles
		// back), and a long, soft glide. A finger covers ground far faster than a wheel, so on touch everything is
		// longer still.
		const coarse = window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches;
		// (On a wide screen the wheel moves the page 0.36/0.5 = 0.72x as far as it used to, see Layout.astro: steps 0.72.
		// On touch the scroll is the original one, utils/touchLenis.ts, and the steps are the longer ones.)
		// The scroll no longer drags the pictures (see "The clock" below): a step only needs a short push to fire, so the
		// scroll length of a step is short, and the same on every device.
		const LEAD = 0.35;
		const PER = 0.17;
		const length = LEAD + PER * (n + hold + DARK);   // in screens
		wrap.style.setProperty('--screens', String(length + 1));

		// The edge blur bands stay on over the pictures; while the view is pinned
		// they run light and, on phones, off (the original behaviour of this
		// section, global.css html.sw-hscroll).
		// (The title's own in / out: titleTick below, from the scroll position and its direction.)
		const sync = (st: ScrollTrigger) => {
			root.classList.toggle('sw-hscroll', st.isActive);
		};
		const stPin = ScrollTrigger.create({
			trigger: wrap, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
			onUpdate: sync,
			onRefresh: sync,
			onToggle: sync,
		});
		// The title's in / out, decided from the scroll position and its direction on EVERY scroll event:
		//  - above the line (the pin start + A of a screen: 11% on a mouse screen, 18% on a phone / tablet, a breath of
		//    dark after Services has blurred out): out;
		//  - below the second line (60% of a screen after the pin start): in;
		//  - between the two: in while the page goes DOWN, out as soon as it goes UP, so on the way back it blurs out
		//    early, while the view is still pinned for a good stretch, instead of sliding down the screen while it fades.
		// Above the pin start the stage is moving, so the title is hidden at once (no fade, nothing to slide).
		const touchy = true;   // every device
		const TITLE_A = touchy ? 0.18 : 0.11;
		const TITLE_B = 0.6;
		let titleOn = false;
		let titleY = window.scrollY;
		const titleTick = () => {
			const y = window.scrollY;
			const vh = window.innerHeight;
			const s = stPin.start;
			const moved = y !== titleY;
			const down = y > titleY;
			titleY = y;
			let want = titleOn;
			if (y < s + TITLE_A * vh) want = false;
			else if (y >= s + TITLE_B * vh) want = true;
			else if (moved) want = down;
			intro.style.visibility = y < s - (touchy ? 0.45 * vh : 0) ? 'hidden' : '';
			if (touchy && y < s + vh) updateIntro();   // before the pin, ScrollTrigger's onUpdate is not running
		};
		let titleRaf = 0;
		const onTitleScroll = () => { if (titleRaf) return; titleRaf = requestAnimationFrame(() => { titleRaf = 0; titleTick(); }); };
		window.addEventListener('scroll', onTitleScroll, { passive: true });
		ScrollTrigger.addEventListener('refresh', titleTick);
		titleTick();
		render();

		// ── The clock (the home hero's way) ─────────────────────────────────────────────────────────────
		// The scroll does not drag the pictures along. It only CHOOSES the stop the view should be at: the title, picture 1..n,
		// (after the last one the page just scrolls on). One animation on the clock, `m`, goes there by itself, whatever the scroll does:
		//   m = 0                the title
		//   m = DARK + k         picture k (the light has landed on it)
		// A first push past a short threshold fires the move to the next stop (and back below a lower one winds it back);
		// a fast scroll only plays it faster (x2.5), and since `m` always runs through the stops one after another, a fling
		// over several of them shows every picture in turn: nothing is skipped. A scroll the other way turns it round.
		const unit = () => (stPin.end - stPin.start) / length;   // one screen of scroll
		const stop = (k: number) => stPin.start + (k === 0 ? LEAD : LEAD + PER * (k + DARK)) * unit();   // where the arrows take the page
		const EXIT_AT = n + DARK;        // m of the last picture
		const M_MAX = EXIT_AT;           // the last stop: after it the page scrolls on as ever
		const STEP_DUR = 1.1;            // seconds for one step of m
		const FAST = 2.5;                // a fling plays it this much faster
		const FIRE = 0.12 / PER;         // steps of scroll past a stop's rest: the next one goes (12% of a screen)
		const BACK = 0.06 / PER;         // back below this it winds back
		const stepM = (k: number) => (k <= 0 ? 0 : k > n ? M_MAX : DARK + k);

		const mObj = { v: 0 };
		let mTarget: number | null = null;
		let mTween: gsap.core.Tween | null = null;
		const applyM = () => {
			const m = mObj.v;
			uPos = Math.max(0, m);
			pos = clamp(m - DARK, 0, n);
			render();
			// A fast scroll runs past the end of the pin before the clock is done: the stage stays on the spot (fixed, not a
			// transform worked out per frame, which would trail the scroll) until the light has landed on the last picture, then it may go.
			const y = window.scrollY;
			const held = m < M_MAX - 0.001 && y > stPin.end && y < stPin.end + window.innerHeight;
			stage.style.position = held ? 'fixed' : '';
			stage.style.top = held ? '0' : '';
			stage.style.left = held ? '0' : '';
			stage.style.width = held ? '100%' : '';
		};
		// the stop the scroll position asks for (0 = title .. n = last picture), with a hysteresis
		const stopFor = (y: number) => {
			const u = ((y - stPin.start) / unit() - LEAD) / PER;   // the scroll in steps, 0 at the title's rest
			let k = 0;
			for (let j = 1; j <= n; j++) {
				const from = j === 1 ? 0 : DARK + (j - 1);   // the rest of the stop before
				const wound = mTarget !== null && mTarget >= stepM(j) - 1e-6;   // already on (or past) j: it winds back later
				if (u >= from + (wound ? BACK : FIRE)) k = j; else break;
			}
			return k;
		};
		// One gesture moves ONE step at most. A flick has momentum: the page keeps travelling for a few hundred pixels after the
		// finger (or the wheel) has stopped, far more than a step's stretch of scroll, and read straight from the position
		// that would be several pictures for one touch. So a gesture (a run of scroll with no quiet gap of GAP ms, nor a finger
		// down) can only choose between the stop it began on and the one on either side of it; when it ends, if the page has
		// run further than that, it is brought back to the stop that was chosen.
		const GAP = 200;
		const MOVING = 2;   // px a frame: below this the page is only settling
		let kTarget = 0;
		let gBase = -1;
		let gTimer = 0;
		let resyncing = false;
		let fingerDown = false;
		const restY = (k: number) => stPin.start + (LEAD + PER * stepM(k)) * unit();
		const endGesture = () => {
			gTimer = 0;
			if (fingerDown) { gTimer = window.setTimeout(endGesture, 120); return; }
			gBase = -1;
			if (stopFor(window.scrollY) === kTarget) return;
			resyncing = true;
			const done = () => { resyncing = false; };
			const lenis = (window as any).__lenis;
			if (lenis?.scrollTo && !reduced()) { lenis.scrollTo(restY(kTarget), { duration: 0.5, force: true, onComplete: done }); window.setTimeout(done, 900); }
			else { window.scrollTo(0, restY(kTarget)); done(); }
		};
		const onTouchDown = () => { fingerDown = true; };
		const onTouchUp = () => { fingerDown = false; };
		window.addEventListener('touchstart', onTouchDown, { passive: true });
		window.addEventListener('touchend', onTouchUp, { passive: true });
		window.addEventListener('touchcancel', onTouchUp, { passive: true });
		let lastY = window.scrollY;
		let lastT = performance.now();
		const tick = () => {
			const y = window.scrollY;
			const now = performance.now();
			const dy = Math.abs(y - lastY);
			const speed = dy / Math.max(1, now - lastT);   // px per ms
			lastY = y;
			lastT = now;
			if (resyncing) { applyM(); return; }   // the page is being brought back to its stop: it chooses nothing meanwhile
			let k = stopFor(y);
			if (mTarget !== null) {
				if (gBase < 0) gBase = kTarget;
				// only real movement keeps the gesture going: the smoothed scroll creeps on by a pixel or less a frame for a
				// second or more after the push, and that tail must not hold the gesture open
				if (dy >= MOVING || !gTimer) { window.clearTimeout(gTimer); gTimer = window.setTimeout(endGesture, GAP); }
				k = clamp(k, Math.max(0, gBase - 1), Math.min(n, gBase + 1));
			}
			kTarget = k;
			const to = stepM(k);
			if (mTarget === null) { mTarget = to; mObj.v = to; applyM(); return; }   // first look: the state, no animation
			if (Math.abs(to - mTarget) > 1e-6) {
				mTarget = to;
				mTween?.kill();
				const left = Math.abs(to - mObj.v);
				if (left < 1e-3) { mObj.v = to; mTween = null; }
				else {
					mTween = gsap.to(mObj, { v: to, duration: STEP_DUR * left, ease: 'sine.inOut', onUpdate: applyM, onComplete: () => { mTween = null; } });
					if (speed > 2) mTween.timeScale(FAST);
				}
			} else if (speed > 2 && mTween && mTween.isActive()) mTween.timeScale(FAST);
			applyM();
		};
		let tickRaf = 0;
		const onClockScroll = () => { if (!tickRaf) tickRaf = requestAnimationFrame(() => { tickRaf = 0; tick(); }); };
		window.addEventListener('scroll', onClockScroll, { passive: true });
		window.addEventListener('resize', onClockScroll, { passive: true });
		ScrollTrigger.addEventListener('refresh', tick);
		tick();

		// previous / next buttons and the arrow keys (only while the view is pinned): they scroll the page to the stop, and
		// the scroll then asks the clock for it like any other
		const goTo = (k: number, duration: number) => {
			const lenis = (window as any).__lenis;
			if (lenis?.scrollTo && !reduced()) lenis.scrollTo(stop(k), { duration, force: true });
			else window.scrollTo({ top: stop(k), behavior: reduced() ? 'auto' : 'smooth' });
		};
		const step = (dir: number) => {
			const k = Math.round(pos) + dir;
			if (k < 1 || k > n) return;
			goTo(k, 1.2);
		};
		const onKey = (e: KeyboardEvent) => {
			if (!stPin.isActive || pos < 0.5) return;
			if (e.key === 'ArrowRight') step(1);
			else if (e.key === 'ArrowLeft') step(-1);
		};
		window.addEventListener('keydown', onKey);

		const ro = new ResizeObserver(() => beam?.resize());
		ro.observe(frame);

		cleanup = () => {
			window.removeEventListener('keydown', onKey);
			window.removeEventListener('scroll', onClockScroll);
			window.removeEventListener('resize', onClockScroll);
			ScrollTrigger.removeEventListener('refresh', tick);
			cancelAnimationFrame(tickRaf);
			window.clearTimeout(gTimer);
			window.removeEventListener('touchstart', onTouchDown);
			window.removeEventListener('touchend', onTouchUp);
			window.removeEventListener('touchcancel', onTouchUp);
			mTween?.kill();
			stage.style.position = stage.style.top = stage.style.left = stage.style.width = '';
			window.removeEventListener('scroll', onTitleScroll);
			ScrollTrigger.removeEventListener('refresh', titleTick);
			cancelAnimationFrame(titleRaf);
			intro.style.visibility = '';
			stPin.kill();
			ro.disconnect();
			beam?.destroy();
			root.classList.remove('sw-hscroll', 'sw-lite-bands');
		};
	}

	document.addEventListener('astro:page-load', initWork);

	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
