---
import { Image, getImage } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
// deeer2.webp is a huge source file (7360px wide) — <Image> generates
// properly-downscaled assets instead of shipping the original (heavy
// enough to jank scroll on iOS Safari).
// Full-screen version for the case-study entrance (data-case-src, see
// afterPageTransition.ts) — a card-sized image blows up soft.
const deeer2Full = await getImage({ src: deeer2, width: 2400 });
// Phones/tablets work list. Placeholder pictures (stored locally — the
// site's CSP blocks remote images) for all but Winds of Sinai; swap the
// img for each project's own shot.
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';
import imgSteak from '../../img/process/launch.jpg';
import imgJosh from '../../img/process/support.jpg';
import imgUmzug from '../../img/process/discovery.jpg';
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, href: '/winds-of-sinai', caseSrc: deeer2Full.src },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, href: '/work/mousa-export' },
	{ title: 'Steak Club', desc: 'Premium steakhouse brand with booking system', img: imgSteak },
	{ title: 'Josh Jabs', desc: 'Personal brand & portfolio for a musician', img: imgJosh },
	{ title: 'Umzugsservice', desc: 'Moving service with SEO & lead generation', img: imgUmzug },
];
---
<section id="selected-work">

	<div class="sw-header-stage">
		<div class="sw-header">
			<h2 class="sw-header__title">What we've<br><em>created.</em></h2>
		</div>
	</div>

	<div class="scroll-section" id="sw-scroll-section">
		<div class="sticky-view">
			<div class="track" id="sw-track">

				<div class="slide slide-intro">
					<h2>What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn no-border">View All Projects</a>
				</div>

				<div class="slide slide-card card-fade" data-case data-case-src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=2400&auto=format&fit=crop">
					<a href="/winds-of-sinai" class="img-box" data-case-media>
						<img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Winds Of Sinai">
					</a>
					<div class="card-info">
						<div>
							<a href="/winds-of-sinai" class="card-title-link"><h3>Winds Of Sinai</h3></a>
							<p>Luxury travel brand identity &amp; digital presence</p>
						</div>
						<a href="/winds-of-sinai" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/unfallfix24" class="img-box">
						<img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="UnfallFix24">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/unfallfix24" class="card-title-link"><h3>UnfallFix24</h3></a>
							<p>Accident reporting &amp; claims management platform</p>
						</div>
						<a href="/work/unfallfix24" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/mousa-export" class="img-box">
						<img src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Mousa Export">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/mousa-export" class="card-title-link"><h3>Mousa Export</h3></a>
							<p>International export logistics platform</p>
						</div>
						<a href="/work/mousa-export" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Steak Club">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Steak Club</h3></a>
							<p>Premium steakhouse brand with booking system</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1511379938547-c1f69419868d?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Josh Jabs">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Josh Jabs</h3></a>
							<p>Personal brand &amp; portfolio for a musician</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src="https://images.unsplash.com/photo-1600607686527-6fb886090705?q=80&w=1200&auto=format&fit=crop" class="img-parallax" alt="Umzugsservice">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Umzugsservice</h3></a>
							<p>Moving service with SEO &amp; lead generation</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-curtain" id="sw-curtain">
					<div class="parallax-text" id="sw-curtain-text">
						<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
						<div class="h-hero-cta-wrap slide-curtain__cta">
							<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
							<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
							<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
								<span class="hud-spin-border"></span>
								<span class="h-hero-cta__text">Explore more projects</span>
							</a>
						</div>
					</div>
				</div>

				<div class="slide slide-final" id="sw-final-slide">
					<h2 class="final-title">A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
				</div>

			</div>
		</div>
	</div>

	<!-- Phones and tablets: a vertical list matching the desktop card style.
	     Desktop keeps the horizontal scene above. -->
	<div class="sw-m">
		<div class="sw-m__track">
			{projects.map((p, i) => {
				const Tag = p.href ? 'a' : 'div';
				return (
					<Tag class="sw-m__card" href={p.href} data-case={p.caseSrc ? '' : undefined} data-case-src={p.caseSrc}>
						<div class="sw-m__media" data-case-media={p.caseSrc ? '' : undefined}>
							<Image
								src={p.img}
								alt=""
								widths={[480, 800, 1200]}
								sizes="(min-width: 700px) 90vw, 92vw"
								loading={i === 0 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</div>
						<div class="sw-m__bar">
							<div class="sw-m__text">
								<h3 class="sw-m__title">{p.title}</h3>
								<p class="sw-m__desc">{p.desc}</p>
							</div>
							<span class="sw-m__explore link-btn no-border">Explore</span>
						</div>
					</Tag>
				);
			})}
		</div>
		<div class="h-hero-cta-wrap sw-m__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">View all projects</span>
			</a>
		</div>
	</div>
</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
	}

	.sw-header-stage { display: none; }

	/* Header — mobile only */
	.sw-header {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) clamp(1.8rem, 3.8vh, 3.5rem);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
		text-align: center;
	}
	.sw-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.sw-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.sw-header__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Horizontal scroll */
	.scroll-section {
		/* 70vh for the blur-in (ENTER_SCREENS in the script) + ~660vh of
		   horizontal travel + a 40vh hold on the final slide (FINAL_HOLD) +
		   the 100vh of the pinned view. */
		height: 870vh;
		position: relative;
		display: none;
	}
	.sticky-view {
		position: sticky;
		top: 0;
		height: 100vh;
		width: 100%;
		overflow: hidden;
		background-color: rgb(var(--c-bg));
	}
	.track {
		display: flex;
		height: 100%;
		align-items: center;
		/* No lead-in space: the intro is a whole screen wide (below), so the title
		   stands alone in the middle of it at the start and the first project is a
		   screen away, out of sight, until the scroll brings it in. */
		padding-left: 0;
		gap: 10vw;
		will-change: transform;
	}
	.slide { flex-shrink: 0; will-change: transform, opacity; }

	/* Intro */
	.slide-intro { width: 100vw; text-align: center; }
	.slide-intro h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		/* No white-space:nowrap — .slide-intro has flex-shrink:0 (needed for
		   the horizontal-scroll track's width math), so at laptop widths the
		   vw-scaled font-size can render wider than the fixed-width column;
		   nowrap then let it spill straight onto the neighboring image
		   instead of wrapping to a 3rd line like a normal heading would. */
		margin-bottom: 2.5rem;
	}
	.slide-intro h2 em { font-style: normal; color: rgb(var(--c-red)); }

	/* Cards */
	.slide-card {
		width: 45vw;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 2.5rem;
		padding: 1rem 1rem 1.4rem;
		border: 1px solid rgba(255,255,255,0.06);
		background: rgba(255,255,255,0.018);
	}
	.img-box {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background-color: #0d0d0f;
		border: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 8px 40px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.3);
	}
	.img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.2);
	}
	.card-info { display: flex; justify-content: space-between; align-items: flex-start; }
	.card-title-link { text-decoration: none; display: block; }
	.card-info h3 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		margin-bottom: 0.5rem;
	}
	.card-info p {
		font-family: var(--f-body);
		font-size: 0.9rem;
		font-weight: 300;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.82);
		max-width: 320px;
	}

	.link-btn {
		font-family: var(--f-body);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		position: relative;
		padding-bottom: 4px;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream) / 0.25);
		transform: scaleX(1);
		transform-origin: left;
		transition: background 0.3s ease;
	}
	@media (hover: hover) {
		.link-btn:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn:hover::after {
			background: rgb(var(--c-cream));
		}
	}

	.link-btn.no-border {
		border: none;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn.no-border::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.link-btn.no-border:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn.no-border:hover::after {
			transform: scaleX(1);
		}
	}

	/* Desktop: the whole card answers to the cursor, not only its small link —
	   the same as the cards on the Projects page. The frame leans in a touch
	   and its edge lights, the description comes to full strength and the
	   Explore link does what it does under the cursor (shifts, underline draws
	   in). The frame (not the <img>, which the parallax moves) is what scales. */
	@media (hover: hover) and (pointer: fine) {
		.img-box {
			transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.8s ease;
		}
		.card-info p { transition: color 0.5s ease; }
		.slide-card:hover .img-box {
			transform: scale(1.02);
			border-color: rgba(255,255,255,0.2);
		}
		.slide-card:hover .card-info p { color: rgb(var(--c-cream) / 0.95); }
		.slide-card:hover .link-btn.no-border {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.slide-card:hover .link-btn.no-border::after { transform: scaleX(1); }
	}

	/* Curtain */
	.slide-curtain {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 12vw;
		position: relative;
		z-index: 5;
		overflow: hidden;
	}
	.parallax-text { will-change: transform; display: flex; flex-direction: column; align-items: center; }
	.slide-curtain__cta { width: auto !important; margin-top: 0.5rem; }
	.slide-curtain h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2rem, 3.8vw, 4rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 1.05;
		color: rgb(var(--c-cream));
		margin-bottom: 2rem;
	}

	/* Final slide */
	.slide-final {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		margin-left: -10vw;
		will-change: transform;
	}
	.final-title {
		font-family: var(--f-display);
		font-weight: 600;
		/* Capped by height too, so it never outgrows the hero on a tall screen. */
		font-size: min(11vw, 13.5vh);
		line-height: 0.85;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-align: center;
		color: rgb(var(--c-cream));
	}
	.final-footer {
		position: absolute;
		bottom: 10%;
		width: 90%;
		font-family: var(--f-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: rgb(var(--c-cream) / 0.72);
	}

	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: it blurs in on the spot (nothing slides in from
		   below), then the horizontal travel starts. */
		.scroll-section { display: block; margin-top: -100vh; }
	}

	@media (min-width: 1025px) and (hover: hover) and (max-width: 1600px), (min-width: 1025px) and (pointer: fine) and (max-width: 1600px) {
		.track { gap: 5vw; }
		.slide-card { width: 42vw; }
		.slide-intro h2 { font-size: clamp(3rem, 6vw, 8rem); }
	}

	/* Laptop-height viewports: the card (16/10 image + info block + the
	   decorative margin-top) is tall enough that, vertically centred in the
	   sticky 100vh view, its footer runs into the fixed MENU button. Keep
	   the card WIDTH untouched (it drives the horizontal-scroll track math
	   and the final-slide reveal) — only drop the decorative offset and
	   flatten the image to a cinematic crop to reclaim the height. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 1000px), (min-width: 1025px) and (pointer: fine) and (max-height: 1000px) {
		.slide-card { margin-top: 0; }
		.img-box { aspect-ratio: 2 / 1; }
	}

	@media (min-width: 1025px) and (hover: hover) and (max-height: 820px), (min-width: 1025px) and (pointer: fine) and (max-height: 820px) {
		.img-box { aspect-ratio: 21 / 9; }
	}

	/* Final slide headline had only a vw size — on short laptops the four
	   lines overflowed the viewport top/bottom (and the wide words bled off
	   the sides), so the closing reveal looked broken. Cap it against height
	   too. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 1000px), (min-width: 1025px) and (pointer: fine) and (max-height: 1000px) {
		.final-title { font-size: min(11vw, 13.5vh); }
	}

	/* ── Phones/tablets work list (desktop has the horizontal scene) ── */
	.sw-m { display: none; }
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.sw-header-stage { display: block; }
		.sw-header__title { font-size: clamp(2.4rem, 10vw, 5rem); }
		@media (prefers-reduced-motion: no-preference) {
			.sw-header-stage {
				height: calc(var(--app-stable-vh) * 200);
				margin-top: calc(var(--app-stable-vh) * -100);
			}
			.sw-header {
				position: sticky;
				top: 0;
				height: calc(var(--app-stable-vh) * 100);
				min-height: calc(var(--app-stable-vh) * 100);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding-top: clamp(3rem, 8vh, 6rem);
				padding-bottom: clamp(3rem, 8vh, 6rem);
			}
			#selected-work .sw-header {
				opacity: 0 !important;
				filter: blur(8px) !important;
				transform: translateY(14px) !important;
				transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1) !important;
			}
			#selected-work .sw-header.visible {
				opacity: 1 !important;
				filter: blur(0) !important;
				transform: translateY(0) !important;
			}
		}
		.sw-m {
			display: block;
			padding-bottom: clamp(3.5rem, 10vw, 5.5rem);
		}
		.sw-m__track {
			display: flex;
			flex-direction: column;
			gap: clamp(2.5rem, 7vh, 5rem);
			padding: 0 var(--site-gutter);
		}
		.sw-m__card {
			width: min(100%, 900px);
			margin-inline: auto;
			display: block;
			color: inherit;
			text-decoration: none;
			background: rgba(255,255,255,0.018);
			border: 1px solid rgba(255,255,255,0.06);
			padding: 0.75rem;
			-webkit-tap-highlight-color: transparent;
		}
		.sw-m__media {
			position: relative;
			width: 100%;
			aspect-ratio: 16 / 10;
			overflow: hidden;
			background: #0d0d0f;
			border: 1px solid rgba(255,255,255,0.08);
			box-shadow: 0 8px 40px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.3);
		}
		.sw-m__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		.sw-m__bar {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1.25rem;
			padding: 1rem 0.15rem 0.25rem;
		}
		.sw-m__text { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
		.sw-m__title {
			margin: 0;
			font-family: var(--f-display);
			font-weight: 600;
			font-size: clamp(1.4rem, 2.2vw, 2.2rem);
			line-height: 1.1;
			letter-spacing: -0.02em;
			text-transform: uppercase;
			color: rgb(var(--c-cream));
		}
		.sw-m__desc {
			margin: 0;
			font-family: var(--f-body);
			font-size: 0.9rem;
			font-weight: 300;
			line-height: 1.6;
			color: rgb(var(--c-cream) / 0.82);
			max-width: 320px;
		}
		.sw-m__explore { margin-top: 0.2rem; }
		.sw-m__cta { margin: clamp(2.5rem, 7vh, 4rem) var(--site-gutter) 0; width: auto !important; }
		@media (hover: hover) {
			.sw-m__media { transition: transform 0.8s cubic-bezier(0.16,1,0.3,1), border-color 0.8s ease; }
			.sw-m__card:hover .sw-m__media { transform: scale(1.02); border-color: rgba(255,255,255,0.2); }
			.sw-m__card:hover .sw-m__explore { color: rgb(var(--c-cream)); transform: translateX(5px); }
			.sw-m__card:hover .sw-m__explore::after { transform: scaleX(1); }
		}
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';

	function initSelectedWork() {
		const section = document.getElementById('selected-work');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) {
			const header = section.querySelector<HTMLElement>('.sw-header');
			const headerStage = section.querySelector<HTMLElement>('.sw-header-stage');
			if (!header || !headerStage) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				header.classList.add('visible');
				return;
			}

			let scrollRaf = 0;
			const cleanup = () => {
				window.removeEventListener('scroll', onScroll);
				document.removeEventListener('astro:before-swap', cleanup);
				if (scrollRaf) cancelAnimationFrame(scrollRaf);
			};
			const reveal = () => {
				scrollRaf = 0;
				if (headerStage.getBoundingClientRect().top > 0) return;
				header.classList.add('visible');
				cleanup();
			};
			const onScroll = () => {
				if (!scrollRaf) scrollRaf = requestAnimationFrame(reveal);
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			document.addEventListener('astro:before-swap', cleanup, { once: true });
			reveal();
			return;
		}

		const ss = document.getElementById('sw-scroll-section')!;
		const tr = document.getElementById('sw-track')!;
		const sv = ss.querySelector<HTMLElement>('.sticky-view')!;
		const ce = document.getElementById('sw-curtain')!;
		const ct = document.getElementById('sw-curtain-text')!;
		const fs = document.getElementById('sw-final-slide')!;
		const cards      = Array.from(section.querySelectorAll<HTMLElement>('.card-anim'));
		const fadeCards  = Array.from(section.querySelectorAll<HTMLElement>('.card-fade'));
		const images = Array.from(section.querySelectorAll<HTMLElement>('.img-parallax'));

		/* All layout reads happen in measure() (init + resize only); tick() works
		   off cached offsets + window.scrollY so the frame never forces a reflow.
		   Easing is time-based, so it stays consistent across display refresh rates. */
		const EASE_PER_SECOND = 4.5;

		let currentX = 0;
		let maxScroll = 0;
		let sectionTop = 0;
		let enterFrom = 0; // scrollY where the manifesto's pin really ends
		let scrollableH = 1;
		let rafId = 0;
		let lastTime = 0;

		const cardX = new Array<number>(cards.length);
		const fadeX = new Array<number>(fadeCards.length);
		const imgBoxes: { el: HTMLElement; left: number; width: number }[] = [];
		let curtainX = 0;
		const FINAL_HOLD = 0.4; // screens — keep in step with .scroll-section's height
		const ENTER_SCREENS = 0.7; // screens of blur-in before the horizontal travel

		function measure() {
			maxScroll = tr.scrollWidth - window.innerWidth;
			sectionTop = ss.getBoundingClientRect().top + window.scrollY;
			// Measured, not assumed (the manifesto sizes off a frozen --app-stable-vh,
			// this off the live viewport; they differ once the window is resized):
			// the blur-in must start only when the manifesto's pin has ended
			// and this view is pinned itself.
			const man = document.getElementById('manifesto');
			const manPin = man?.firstElementChild as HTMLElement | null;
			enterFrom = man && manPin
				? Math.max(sectionTop, man.getBoundingClientRect().bottom + window.scrollY - manPin.offsetHeight)
				: sectionTop;
			// The travel ends FINAL_HOLD screens before the pin lets go, so the
			// last slide ("A.I. / Design / …"), once revealed, holds a moment.
			scrollableH = Math.max(1, ss.offsetHeight - window.innerHeight * (1 + FINAL_HOLD + ENTER_SCREENS));
			curtainX = ce.offsetLeft;
			cards.forEach((card, i) => { cardX[i] = card.offsetLeft; });
			fadeCards.forEach((card, i) => { fadeX[i] = card.offsetLeft; });
			imgBoxes.length = 0;
			images.forEach(img => {
				const box = img.parentElement!;
				imgBoxes.push({ el: img, left: box.offsetLeft, width: box.offsetWidth });
			});
		}

		function tick(now: number) {
			const dt = Math.min((now - lastTime) / 1000, 0.1);
			lastTime = now;

			const enterY = ENTER_SCREENS * window.innerHeight;
			const progress = Math.max(0, Math.min(1, (window.scrollY - enterFrom - enterY) / scrollableH));
			const targetX = progress * maxScroll;

			currentX += (targetX - currentX) * (1 - Math.exp(-EASE_PER_SECOND * dt));
			tr.style.transform = `translate3d(-${currentX}px,0,0)`;

			// Blurs in on the spot, once pinned (the manifesto has just faded
			// out), before the horizontal travel starts.
			const t = Math.max(0, Math.min(1, (window.scrollY - enterFrom) / (ENTER_SCREENS * window.innerHeight)));
			const e = 1 - (1 - t) * (1 - t); // comes in at once, then settles
			sv.style.opacity = e > 0 ? '1' : '0';
			tr.style.opacity = String(e);
			tr.style.filter = e < 1 ? `blur(${((1 - e) * 10).toFixed(1)}px)` : '';

			const vw = window.innerWidth;

			const distToEnd = maxScroll - currentX;
			fs.style.transform = distToEnd < vw * 1.5
				? `translate3d(-${distToEnd * 0.5}px,0,0)`
				: 'translate3d(0,0,0)';

			const maxY = window.innerHeight * 0.55;
			cards.forEach((card, i) => {
				const sp = (cardX[i] - currentX) / vw;
				const lp = Math.max(0, (sp - 0.5) * 2);
				card.style.transform = `translate3d(0,${Math.min(lp * maxY, maxY)}px,0)`;
			});

			fadeCards.forEach((card, i) => {
				const sp = (fadeX[i] - currentX) / vw;
				card.style.opacity = String(Math.max(0, Math.min(1, (1 - sp) * 2)));
			});

			const cp = (curtainX - currentX) / vw;
			if (cp < 1.2 && cp > -1) ct.style.transform = `translate3d(${cp * 200}px,0,0)`;

			imgBoxes.forEach(d => {
				const left = d.left - currentX;
				if (left < vw && left + d.width > 0) {
					const ip = (left - vw / 2) / vw;
					d.el.style.transform = `scale(1.2) translate3d(${ip * 8}%,0,0)`;
				}
			});

			rafId = requestAnimationFrame(tick);
		}

		function start() {
			if (rafId) return;
			/* snap to the correct spot on re-entry so the track never visibly
			   catches up from a stale position */
			const progress = Math.max(0, Math.min(1, (window.scrollY - enterFrom - ENTER_SCREENS * window.innerHeight) / scrollableH));
			currentX = progress * maxScroll;
			lastTime = performance.now();
			rafId = requestAnimationFrame(tick);
		}

		function stop() {
			if (!rafId) return;
			cancelAnimationFrame(rafId);
			rafId = 0;
		}

		const ro = new ResizeObserver(() => {
			const prevMax = maxScroll;
			measure();
			if (prevMax > 0 && maxScroll > 0) currentX = (currentX / prevMax) * maxScroll;
		});
		ro.observe(tr);

		/* run the loop only while the section (± one viewport) is near view */
		const io = new IntersectionObserver(entries => {
			entries.forEach(e => (e.isIntersecting ? start() : stop()));
		}, { rootMargin: '100% 0px 100% 0px' });
		io.observe(ss);

		/* On Astro navigation the whole #__astro tree is swapped out, so the
		   element-scoped observers above may never fire a final "out of view".
		   Tear down the loop + observers explicitly the moment the page swap
		   begins, and remove the listener again on exit (once:true). */
		const onBeforeSwap = () => {
			stop();
			io.disconnect();
			ro.disconnect();
			document.removeEventListener('astro:before-swap', onBeforeSwap);
		};
		document.addEventListener('astro:before-swap', onBeforeSwap);
	}

	onReady(initSelectedWork);
</script>
