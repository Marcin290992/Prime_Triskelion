---
import { Image, getImage } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
// deeer2.webp is a huge source file (7360px wide) — <Image> generates
// properly-downscaled assets instead of shipping the original (heavy
// enough to jank scroll on iOS Safari).
// Full-screen version for the case-study entrance (data-case-src, see
// afterPageTransition.ts) — a card-sized image blows up soft.
const deeer2Full = await getImage({ src: deeer2, width: 2400 });
const deeer2Card = await getImage({ src: deeer2, width: 1800 });
// Phones/tablets carousel. Placeholder pictures (stored locally — the
// site's CSP blocks remote images) for all but Winds of Sinai; swap the
// img for each project's own shot.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', tags: ['Branding', 'Web'], img: deeer2, href: '/winds-of-sinai', caseSrc: deeer2Full.src },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', tags: ['Web', 'Software'], img: deeer2, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', tags: ['Web'], img: deeer2, href: '/work/mousa-export' },
	{ title: 'Steak Club', desc: 'Premium steakhouse brand with booking system', tags: ['Web', 'Branding'], img: deeer2 },
	{ title: 'Josh Jabs', desc: 'Personal brand & portfolio for a musician', tags: ['Web', 'Branding'], img: deeer2 },
	{ title: 'Umzugsservice', desc: 'Moving service with SEO & lead generation', tags: ['Web', 'SEO'], img: deeer2 },
];
---
<section id="selected-work">

	<div class="sw-header">
		<h2 class="sw-header__title">What we've<br><em>built.</em></h2>
	</div>

	<div class="scroll-section" id="sw-scroll-section">
		<div class="sticky-view">
			<div class="track" id="sw-track">

				<div class="slide slide-intro">
					<h2>What we've<br><em>created.</em></h2>
					<a href="/projects" class="link-btn no-border">View All Projects</a>
				</div>

				<div class="slide slide-card card-fade" data-case data-case-src={deeer2Full.src}>
					<a href="/winds-of-sinai" class="img-box" data-case-media>
						<img src={deeer2Card.src} class="img-parallax" alt="Winds Of Sinai">
					</a>
					<div class="card-info">
						<div>
							<a href="/winds-of-sinai" class="card-title-link"><h3>Winds Of Sinai</h3></a>
							<p>Luxury travel brand identity &amp; digital presence</p>
						</div>
						<a href="/winds-of-sinai" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/unfallfix24" class="img-box">
						<img src={deeer2Card.src} class="img-parallax" alt="UnfallFix24">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/unfallfix24" class="card-title-link"><h3>UnfallFix24</h3></a>
							<p>Accident reporting &amp; claims management platform</p>
						</div>
						<a href="/work/unfallfix24" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="/work/mousa-export" class="img-box">
						<img src={deeer2Card.src} class="img-parallax" alt="Mousa Export">
					</a>
					<div class="card-info">
						<div>
							<a href="/work/mousa-export" class="card-title-link"><h3>Mousa Export</h3></a>
							<p>International export logistics platform</p>
						</div>
						<a href="/work/mousa-export" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src={deeer2Card.src} class="img-parallax" alt="Steak Club">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Steak Club</h3></a>
							<p>Premium steakhouse brand with booking system</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src={deeer2Card.src} class="img-parallax" alt="Josh Jabs">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Josh Jabs</h3></a>
							<p>Personal brand &amp; portfolio for a musician</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-card card-anim">
					<a href="#" class="img-box">
						<img src={deeer2Card.src} class="img-parallax" alt="Umzugsservice">
					</a>
					<div class="card-info">
						<div>
							<a href="#" class="card-title-link"><h3>Umzugsservice</h3></a>
							<p>Moving service with SEO &amp; lead generation</p>
						</div>
						<a href="#" class="link-btn no-border">Explore</a>
					</div>
				</div>

				<div class="slide slide-curtain" id="sw-curtain">
					<div class="parallax-text" id="sw-curtain-text">
						<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
					</div>
				</div>

				<div class="slide slide-final" id="sw-final-slide">
					<h2 class="final-title">A.I.<br>DESIGN<br>DEVELOPMENT<br>BRANDING</h2>
				</div>

			</div>
		</div>
	</div>

	<!-- Phones and tablets: the work as a carousel you swipe — native
	     horizontal scroll that snaps card to card (no script per frame),
	     the next card peeking in. Desktop keeps the horizontal scene above. -->
	<div class="sw-m">
		<div class="sw-m__track" aria-label="Selected work">
			{projects.map((p) => {
				const Tag = p.href ? 'a' : 'div';
				return (
					<Tag class="sw-m__card" href={p.href} data-case={p.caseSrc ? '' : undefined} data-case-src={p.caseSrc}>
						<div class="sw-m__media" data-case-media={p.caseSrc ? '' : undefined}>
							{/* Eager, not lazy: Safari only starts a lazy image once it's
							    nearly in view, so swiping showed the next card empty and its
							    picture popping in. Six card-sized images, loaded with the page. */}
							<Image src={p.img} alt="" widths={[480, 800, 1200]} sizes="(min-width: 700px) 78vw, 82vw" loading="eager" decoding="async" />
						</div>
						<div class="sw-m__bar">
							<div class="sw-m__text">
								<h3 class="sw-m__title">{p.title}</h3>
								<p class="sw-m__desc">{p.desc}</p>
								<span class="sw-m__tags">{p.tags.join(' · ')}</span>
							</div>
						</div>
					</Tag>
				);
			})}
		</div>
		<div class="sw-m__foot">
			<div class="sw-m__progress" aria-hidden="true"><span></span></div>
			<span class="sw-m__count" aria-hidden="true">01 / {String(projects.length).padStart(2, '0')}</span>
		</div>
		<div class="h-hero-cta-wrap sw-m__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">View all projects</span>
			</a>
		</div>
	</div>
</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
	}

	/* Header — mobile only */
	.sw-header {
		width: 100%;
		padding: var(--section-space-top) var(--site-gutter) clamp(1.8rem, 3.8vh, 3.5rem);
		box-sizing: border-box;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(14px);
		transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1);
	}
	.sw-header.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
	.sw-header__title {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 0.9;
		color: rgb(var(--c-cream));
	}
	.sw-header__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Horizontal scroll */
	.scroll-section {
		/* 100vh for the blur-in (ENTER_SCREENS in the script) + ~990vh of
		   horizontal travel (each project is a full screen wide) + a 40vh hold
		   on the final slide (FINAL_HOLD) + the 100vh of the pinned view. */
		height: 1230vh;
		position: relative;
		display: none;
	}
	.sticky-view {
		position: sticky;
		top: 0;
		height: 100vh;
		width: 100%;
		overflow: hidden;
		background-color: rgb(var(--c-bg));
	}
	.track {
		display: flex;
		height: 100%;
		align-items: center;
		/* No lead-in space: the intro is a whole screen wide (below), so the title
		   stands in the middle of it at the start, alone — the first frame is a
		   screen away, out of sight. */
		padding-left: 0;
		gap: 10vw;
		will-change: transform;
	}
	.slide { flex-shrink: 0; will-change: transform, opacity; }

	/* Intro */
	.slide-intro { width: 100vw; text-align: center; }
	.slide-intro h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		/* No white-space:nowrap — .slide-intro has flex-shrink:0 (needed for
		   the horizontal-scroll track's width math), so at laptop widths the
		   vw-scaled font-size can render wider than the fixed-width column;
		   nowrap then let it spill straight onto the neighboring image
		   instead of wrapping to a 3rd line like a normal heading would. */
		margin-bottom: 2.5rem;
	}
	.slide-intro h2 em { font-style: normal; color: rgb(var(--c-red)); }

	/* Cards: a full-screen-wide frame (widescreen, the screen above and below it
	   black, like the bars of a cinema frame), the title and the line about it
	   set over its foot. They come in the way they always did — rising from below
	   as they move toward the middle (the script). */
	.slide-card {
		position: relative;
		width: 100vw;
		height: min(78vh, calc(100vw / 2.1));
		overflow: hidden;
		background: #050506;
	}
	.img-box {
		position: absolute;
		inset: 0;
		display: block;
		overflow: hidden;
	}
	.img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.25);
	}
	/* Dark at the foot (the caption) and a little at the head. */
	.slide-card::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 30%, transparent 58%),
			linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 22%);
	}
	.card-info {
		position: absolute;
		left: var(--site-gutter);
		right: var(--site-gutter);
		bottom: clamp(1.4rem, 3.4vh, 2.6rem);
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
	}
	.card-title-link { text-decoration: none; display: block; }
	.card-info h3 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2.2rem, 4.4vw, 5rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
		margin-bottom: 0.6rem;
	}
	.card-info p {
		font-family: var(--f-body);
		font-size: clamp(0.85rem, 1.05vw, 1rem);
		font-weight: 300;
		line-height: 1.5;
		color: rgb(var(--c-cream) / 0.85);
		max-width: 38ch;
	}

	.link-btn {
		font-family: var(--f-body);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		position: relative;
		padding-bottom: 4px;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream) / 0.25);
		transform: scaleX(1);
		transform-origin: left;
		transition: background 0.3s ease;
	}
	@media (hover: hover) {
		.link-btn:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn:hover::after {
			background: rgb(var(--c-cream));
		}
	}

	.link-btn.no-border {
		border: none;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.link-btn.no-border::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.link-btn.no-border:hover {
			color: rgb(var(--c-cream));
			transform: translateX(5px);
		}
		.link-btn.no-border:hover::after {
			transform: scaleX(1);
		}
	}

	/* Explore: a real button — a hairline frame and the label — on a dark,
	   soft field so it holds up over any picture. Over the whole frame (the
	   cursor anywhere on it) it fills with cream. */
	.slide-card .card-info .link-btn {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		flex: none;
		padding: 1.05rem 1.7rem;
		font-size: 0.78rem;
		letter-spacing: 0.26em;
		color: rgb(var(--c-cream));
		background: rgba(0, 0, 0, 0.42);
		border: 1px solid rgb(var(--c-cream) / 0.6);
		transition: color 0.4s ease, background-color 0.4s ease, border-color 0.4s ease;
	}
	/* No arrow, and none of the link's usual underline either. */
	.slide-card .card-info .link-btn::after { content: none; }
	@media (hover: hover) and (pointer: fine) {
		/* The picture comes slowly a little closer under the cursor (its frame
		   scales; the picture inside keeps its own drift). The card clips it. */
		.img-box { transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1); }
		.slide-card:hover .img-box { transform: scale(1.045); }
		.card-info p { transition: color 0.5s ease; }
		.slide-card:hover .card-info p { color: rgb(var(--c-cream) / 0.95); }
		.slide-card:hover .card-info .link-btn,
		.slide-card .card-info .link-btn:hover {
			color: rgb(var(--c-bg));
			background: rgb(var(--c-cream));
			border-color: rgb(var(--c-cream));
			transform: none;
		}
	}

	/* Curtain */
	.slide-curtain {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0 15vw 0 10vw;
		position: relative;
		z-index: 5;
		overflow: hidden;
	}
	.parallax-text { will-change: transform; }
	.slide-curtain h2 {
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2rem, 3.8vw, 4rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 1.05;
		color: rgb(var(--c-cream));
		margin-bottom: 2rem;
	}

	/* Final slide */
	.slide-final {
		width: 100vw;
		height: 100vh;
		background-color: rgb(var(--c-bg));
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		margin-left: -10vw;
		will-change: transform;
	}
	.final-title {
		font-family: var(--f-display);
		font-weight: 600;
		/* Capped by height too, so it never outgrows the hero on a tall screen. */
		font-size: min(11vw, 13.5vh);
		line-height: 0.85;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-align: center;
		color: rgb(var(--c-cream));
	}
	.final-footer {
		position: absolute;
		bottom: 10%;
		width: 90%;
		font-family: var(--f-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: rgb(var(--c-cream) / 0.72);
	}

	@media (min-width: 1025px) and (hover: hover), (min-width: 1025px) and (pointer: fine) {
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: it blurs in on the spot (nothing slides in from
		   below), then the horizontal travel starts. */
		.scroll-section { display: block; margin-top: -100vh; }
		.sw-header { display: none; }
	}

	@media (min-width: 1025px) and (hover: hover) and (max-width: 1600px), (min-width: 1025px) and (pointer: fine) and (max-width: 1600px) {
		.track { gap: 5vw; }
		.slide-intro h2 { font-size: clamp(3rem, 6vw, 8rem); }
	}

	/* Final slide headline had only a vw size — on short laptops the four
	   lines overflowed the viewport top/bottom (and the wide words bled off
	   the sides), so the closing reveal looked broken. Cap it against height
	   too. */
	@media (min-width: 1025px) and (hover: hover) and (max-height: 1000px), (min-width: 1025px) and (pointer: fine) and (max-height: 1000px) {
		.final-title { font-size: min(11vw, 13.5vh); }
	}

	/* ── Phones/tablets carousel (desktop has the horizontal scene) ── */
	.sw-m { display: none; }
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.sw-header__title { font-size: clamp(2.4rem, 10vw, 5rem); }
		.sw-m {
			display: block;
			padding-bottom: clamp(3.5rem, 10vw, 5.5rem);
		}
		.sw-m__track {
			display: flex;
			gap: 0.75rem;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--site-gutter);
			padding: 0 var(--site-gutter);
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
		}
		.sw-m__track::-webkit-scrollbar { display: none; }
		.sw-m__card {
			position: relative;
			flex: 0 0 82%;
			scroll-snap-align: start;
			aspect-ratio: 4 / 5;
			max-height: 66vh;
			overflow: hidden;
			display: block;
			color: inherit;
			text-decoration: none;
			background: #0b0b0d;
			border: 1px solid rgb(var(--c-cream) / 0.1);
			-webkit-tap-highlight-color: transparent;
		}
		.sw-m__media { position: absolute; inset: 0; }
		.sw-m__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		/* Legibility for the bar at the foot. */
		.sw-m__media::after {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgb(0 0 0 / 0.75) 0%, rgb(0 0 0 / 0.15) 45%, transparent 70%);
		}
		/* Same glass info bar as the Projects page cards. */
		.sw-m__bar {
			position: absolute;
			left: 0.75rem;
			right: 0.75rem;
			bottom: 0.75rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding: 1rem 1.1rem;
			background: rgb(var(--c-bg) / 0.38);
			-webkit-backdrop-filter: blur(20px) saturate(160%);
			backdrop-filter: blur(20px) saturate(160%);
			border: 1px solid rgb(255 255 255 / 0.1);
		}
		.sw-m__text { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
		.sw-m__title {
			margin: 0;
			font-family: var(--f-display);
			font-weight: 600;
			font-size: clamp(1.35rem, 6vw, 1.9rem);
			line-height: 1;
			letter-spacing: -0.01em;
			text-transform: uppercase;
			color: rgb(var(--c-cream));
		}
		.sw-m__desc {
			margin: 0;
			font-family: var(--f-body);
			font-size: 0.82rem;
			font-weight: 300;
			line-height: 1.45;
			color: rgb(var(--c-cream) / 0.75);
		}
		.sw-m__tags {
			font-family: var(--f-body);
			font-size: 10px;
			font-weight: 500;
			letter-spacing: 0.32em;
			text-transform: uppercase;
			color: rgb(var(--c-cream) / 0.7);
		}
		/* Where in the row you are. */
		.sw-m__foot {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1.25rem var(--site-gutter) 0;
		}
		.sw-m__progress {
			flex: 1 1 auto;
			height: 1px;
			background: rgb(var(--c-cream) / 0.14);
			overflow: hidden;
		}
		.sw-m__progress span {
			display: block;
			height: 100%;
			background: rgb(var(--c-red));
			transform-origin: left center;
			transform: scaleX(var(--p, 0.1667));
			transition: transform 0.2s linear;
		}
		.sw-m__count {
			font-family: var(--f-body);
			font-size: 11px;
			font-weight: 500;
			letter-spacing: 0.28em;
			font-variant-numeric: tabular-nums;
			color: rgb(var(--c-cream) / 0.6);
		}
		.sw-m__cta { margin: 1.75rem var(--site-gutter) 0; width: auto !important; }
		/* Tablet width: still one main card with the next peeking in (as on
		   a phone), in a landscape frame — 4:5 at this width ran taller
		   than the screen. */
		@media (min-width: 700px) {
			.sw-m__card { flex-basis: 78%; aspect-ratio: 3 / 2; max-height: 70vh; }
			.sw-m__cta { margin-inline: var(--site-gutter) auto; }
		}
	}
</style>

<script>
	import { onReady } from '../../utils/onReady';

	// Phones/tablets: the carousel scrolls natively; this only keeps the
	// counter and the progress hairline in step (on scroll, a frame at most).
	let _workCarouselOff: (() => void) | null = null;
	function initWorkCarousel(section: HTMLElement) {
		_workCarouselOff?.();
		_workCarouselOff = null;
		const track = section.querySelector<HTMLElement>('.sw-m__track');
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.sw-m__card'));
		const bar = section.querySelector<HTMLElement>('.sw-m__progress');
		const count = section.querySelector<HTMLElement>('.sw-m__count');
		if (!track || cards.length < 2) return;
		const total = String(cards.length).padStart(2, '0');
		let ticking = false;
		let shown = -1;
		const update = () => {
			ticking = false;
			// The card nearest the start edge; the last one once the row is
			// scrolled to its end (on a tablet a few are in view at once).
			const pad = parseFloat(getComputedStyle(track).paddingLeft) || 0;
			const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
			let i = cards.length - 1;
			if (!atEnd) {
				let best = Infinity;
				cards.forEach((c, k) => {
					const d = Math.abs(c.offsetLeft - pad - track.scrollLeft);
					if (d < best) { best = d; i = k; }
				});
			}
			bar?.style.setProperty('--p', ((i + 1) / cards.length).toFixed(4));
			if (i !== shown && count) {
				shown = i;
				count.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
			}
		};
		const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
		track.addEventListener('scroll', onScroll, { passive: true });
		update();
		_workCarouselOff = () => track.removeEventListener('scroll', onScroll);
	}
	document.addEventListener('astro:before-swap', () => {
		_workCarouselOff?.();
		_workCarouselOff = null;
	});

	function initSelectedWork() {
		const section = document.getElementById('selected-work');
		if (!section) return;

		if (window.matchMedia('(max-width: 1024px), (hover: none) and (pointer: coarse)').matches) {
			section.querySelector<HTMLElement>('.sw-header')?.classList.add('visible');
			initWorkCarousel(section);
			return;
		}

		const ss = document.getElementById('sw-scroll-section')!;
		const tr = document.getElementById('sw-track')!;
		const sv = ss.querySelector<HTMLElement>('.sticky-view')!;
		const ce = document.getElementById('sw-curtain')!;
		const ct = document.getElementById('sw-curtain-text')!;
		const fs = document.getElementById('sw-final-slide')!;
		const cards      = Array.from(section.querySelectorAll<HTMLElement>('.card-anim'));
		const fadeCards  = Array.from(section.querySelectorAll<HTMLElement>('.card-fade'));
		const images = Array.from(section.querySelectorAll<HTMLElement>('.img-parallax'));

		/* All layout reads happen in measure() (init + resize only); tick() works
		   off cached offsets + window.scrollY so the frame never forces a reflow.
		   Easing is time-based: identical feel to the old 0.055/frame constant at
		   60 fps, but consistent on 120/144 Hz displays too. */
		const BASE_EASE = -Math.log(1 - 0.055) * 60;
		let EASE_PER_SECOND = BASE_EASE; // raised for a moment while a clicked card is brought to the middle

		let currentX = 0;
		let maxScroll = 0;
		let sectionTop = 0;
		let enterFrom = 0; // scrollY where the manifesto's pin really ends
		let scrollableH = 1;
		let rafId = 0;
		let lastTime = 0;

		const cardX = new Array<number>(cards.length);
		const fadeX = new Array<number>(fadeCards.length);
		const imgBoxes: { el: HTMLElement; left: number; width: number }[] = [];
		let curtainX = 0;
		const FINAL_HOLD = 0.4; // screens — keep in step with .scroll-section's height
		const ENTER_SCREENS = 1.0; // screens of blur-in before the horizontal travel

		function measure() {
			maxScroll = tr.scrollWidth - window.innerWidth;
			sectionTop = ss.getBoundingClientRect().top + window.scrollY;
			// Measured, not assumed (the manifesto sizes off a frozen --app-stable-vh,
			// this off the live viewport; they differ once the window is resized):
			// the blur-in must start only when the manifesto's pin has ended
			// and this view is pinned itself.
			const man = document.getElementById('manifesto');
			const manPin = man?.firstElementChild as HTMLElement | null;
			enterFrom = man && manPin
				? Math.max(sectionTop, man.getBoundingClientRect().bottom + window.scrollY - manPin.offsetHeight)
				: sectionTop;
			// The travel ends FINAL_HOLD screens before the pin lets go, so the
			// last slide ("A.I. / Design / …"), once revealed, holds a moment.
			scrollableH = Math.max(1, ss.offsetHeight - window.innerHeight * (1 + FINAL_HOLD + ENTER_SCREENS));
			curtainX = ce.offsetLeft;
			cards.forEach((card, i) => { cardX[i] = card.offsetLeft; });
			fadeCards.forEach((card, i) => { fadeX[i] = card.offsetLeft; });
			imgBoxes.length = 0;
			images.forEach(img => {
				// The card's place along the track (the picture's box is positioned
				// inside the card, so its own offsetLeft would say 0).
				const box = img.parentElement!;
				const card = (box.closest('.slide-card') as HTMLElement | null) ?? box;
				imgBoxes.push({ el: img, left: card.offsetLeft, width: card.offsetWidth });
			});
		}

		function tick(now: number) {
			const dt = Math.min((now - lastTime) / 1000, 0.1);
			lastTime = now;

			const enterY = ENTER_SCREENS * window.innerHeight;
			const progress = Math.max(0, Math.min(1, (window.scrollY - enterFrom - enterY) / scrollableH));
			const targetX = progress * maxScroll;

			currentX += (targetX - currentX) * (1 - Math.exp(-EASE_PER_SECOND * dt));
			tr.style.transform = `translate3d(-${currentX}px,0,0)`;

			// Blurs in on the spot, once pinned (the manifesto has just faded
			// out), before the horizontal travel starts.
			const t = Math.max(0, Math.min(1, (window.scrollY - enterFrom) / (ENTER_SCREENS * window.innerHeight)));
			const e = 1 - (1 - t) * (1 - t); // comes in at once, then settles
			sv.style.opacity = e > 0 ? '1' : '0';
			tr.style.opacity = String(e);
			tr.style.filter = e < 1 ? `blur(${((1 - e) * 10).toFixed(1)}px)` : '';

			const vw = window.innerWidth;

			const distToEnd = maxScroll - currentX;
			fs.style.transform = distToEnd < vw * 1.5
				? `translate3d(-${distToEnd * 0.5}px,0,0)`
				: 'translate3d(0,0,0)';

			const maxY = window.innerHeight * 0.55;
			cards.forEach((card, i) => {
				const sp = (cardX[i] - currentX) / vw;
				const lp = Math.max(0, (sp - 0.5) * 2);
				card.style.transform = `translate3d(0,${Math.min(lp * maxY, maxY)}px,0)`;
			});

			fadeCards.forEach((card, i) => {
				const sp = (fadeX[i] - currentX) / vw;
				card.style.opacity = String(Math.max(0, Math.min(1, (1 - sp) * 2)));
			});

			const cp = (curtainX - currentX) / vw;
			if (cp < 1.2 && cp > -1) ct.style.transform = `translate3d(${cp * 200}px,0,0)`;

			imgBoxes.forEach(d => {
				// A picture the page transition has taken hold of (it eases it to its
				// plain crop before opening) is not ours to move any more.
				if (d.el.hasAttribute('data-hold')) return;
				const left = d.left - currentX;
				if (left < vw && left + d.width > 0) {
					const ip = (left - vw / 2) / vw;
					d.el.style.transform = `scale(1.25) translate3d(${ip * 6}%,0,0)`;
				}
			});

			rafId = requestAnimationFrame(tick);
		}

		function start() {
			if (rafId) return;
			/* snap to the correct spot on re-entry so the track never visibly
			   catches up from a stale position */
			const progress = Math.max(0, Math.min(1, (window.scrollY - enterFrom - ENTER_SCREENS * window.innerHeight) / scrollableH));
			currentX = progress * maxScroll;
			lastTime = performance.now();
			rafId = requestAnimationFrame(tick);
		}

		function stop() {
			if (!rafId) return;
			cancelAnimationFrame(rafId);
			rafId = 0;
		}

		const ro = new ResizeObserver(() => {
			const prevMax = maxScroll;
			measure();
			if (prevMax > 0 && maxScroll > 0) currentX = (currentX / prevMax) * maxScroll;
		});
		ro.observe(tr);

		/* run the loop only while the section (± one viewport) is near view */
		const io = new IntersectionObserver(entries => {
			entries.forEach(e => (e.isIntersecting ? start() : stop()));
		}, { rootMargin: '100% 0px 100% 0px' });
		io.observe(ss);

		/* On Astro navigation the whole #__astro tree is swapped out, so the
		   element-scoped observers above may never fire a final "out of view".
		   Tear down the loop + observers explicitly the moment the page swap
		   begins, and remove the listener again on exit (once:true). */
		/* Opening a project that is not standing in the middle of the screen (the
		   strip is half-way along, the card still rising): the click is held, the
		   page scrolls so that the card comes to rest centred — the strip follows
		   the scroll — and only then is the click let through, so the transition
		   starts from a card that is where it should be. */
		let centring = false;
		const onCardClick = (e: MouseEvent) => {
			if (centring || e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
			const target = e.target as Element | null;
			const card = target?.closest<HTMLElement>('.slide-card');
			const link = target?.closest<HTMLAnchorElement>('a');
			if (!card || !link || !section.contains(card)) return;
			const left = () => card.getBoundingClientRect().left;
			if (Math.abs(left()) < 3) return; // already centred: nothing to do
			e.preventDefault();
			e.stopPropagation();
			centring = true;
			EASE_PER_SECOND = BASE_EASE * 3;
			const y = enterFrom + ENTER_SCREENS * window.innerHeight + (card.offsetLeft / Math.max(1, maxScroll)) * scrollableH;
			const lenis = (window as any).__lenis;
			if (lenis) lenis.scrollTo(y, { duration: 0.55, lock: true, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
			else window.scrollTo({ top: y, behavior: 'smooth' });
			// Through once it has stood still in the middle for a few frames (or, at
			// the latest, after a few seconds).
			const t0 = performance.now();
			let still = 0;
			const wait = () => {
				still = Math.abs(left()) < 8 ? still + 1 : 0;
				if (still >= 3 || performance.now() - t0 > 3000) {
					centring = false;
					EASE_PER_SECOND = BASE_EASE;
					link.click();
					return;
				}
				requestAnimationFrame(wait);
			};
			requestAnimationFrame(wait);
		};
		section.addEventListener('click', onCardClick, true);

		const onBeforeSwap = () => {
			section.removeEventListener('click', onCardClick, true);
			stop();
			io.disconnect();
			ro.disconnect();
			document.removeEventListener('astro:before-swap', onBeforeSwap);
		};
		document.addEventListener('astro:before-swap', onBeforeSwap);
	}

	onReady(initSelectedWork);
</script>
