---
import { Image } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';

// Selected work as full-screen frames: one pinned screen on every device, the
// scroll melts one project into the next along a band of light (WebGL, see
// utils/beamSlides.ts). The old horizontal carousel / phone strip is kept in
// components/backup/SelectedWorkSection.before-beam.astro.
//
// Pictures are stored locally (the site's CSP blocks remote images). Swap each
// for the project's own shot (wide, ~2400px). `fx` is where its subject sits
// across the picture (0 left .. 1 right): on a portrait screen the picture is
// cropped to a narrow window, and this keeps the subject (the deer) in it.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, fx: 0.15, href: '/projects/winds-of-sinai/' },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, fx: 0.5, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, fx: 0.5, href: '/work/mousa-export' },
];

// Scroll length: see LEAD / PER in the script (one screen per step, the snap lands each picture exactly). The
// value here is only the no-JS default.
const HOLD = 0.4;
const SCREENS = projects.length + HOLD;
---
<section id="selected-work">

	<!-- #sw-scroll-section keeps its id: HeroSection's menu button waits for it. -->
	<div class="swb" id="sw-scroll-section" data-n={projects.length} data-hold={HOLD} style={`--screens:${SCREENS + 1}`}>
		<div class="swb__stage">

			<!-- The picture fills the screen; the edge blur bands stay on over it
			     (lighter while this view is pinned, see global.css). -->
			<div class="swb__frame">
				<canvas class="swb__canvas" aria-hidden="true"></canvas>

				<!-- The same pictures, as ordinary images: they are the textures of the
				     canvas, and the cross-fade for browsers without WebGL. -->
				{projects.map((p) => (
					<Image class="swb__img" src={p.img} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="async" data-fx={p.fx} />
				))}

			</div>

			<div class="swb__intro">
				<h2 class="swb__title">What we've<br><em>created.</em></h2>
				<a href="/projects" class="link-btn sw-link">View All Projects</a>
			</div>

			<!-- The picture itself opens the project too, with a mouse only (CSS below):
			     on a touch screen it is the scrolling surface, and a tap to stop it
			     must not open anything. Real links, so they prefetch and middle-click. -->
			{projects.map((p) => (
				<a class="swb__hit" href={p.href} tabindex="-1" aria-hidden="true"></a>
			))}

			{projects.map((p) => (
				<div class="swb__slide">
					<div>
						<a href={p.href} class="swb__name"><h3>{p.title}</h3></a>
						<p>{p.desc}</p>
					</div>
					<div class="h-hero-cta-wrap swb__cta">
						<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
						<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
						<a href={p.href} class="h-hero-cta h-hero-cta--fixed">
							<span class="hud-spin-border"></span>
							<span class="h-hero-cta__text">Explore</span>
						</a>
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="swb-panel swb-cover">
		<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
		<div class="h-hero-cta-wrap swb-cover__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">Explore more projects</span>
			</a>
		</div>
	</div>

</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
		/* (no background of its own: pulled up a screen, it would paint over the
		   manifesto's last screen; the stage and the closing panel have theirs) */
	}

	/* The pinned view is sticky (not a script pin): the height is the scroll
	   length, in the locked screen height so a phone's moving address bar
	   cannot stretch it. */
	.swb {
		position: relative;
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: the title comes up out of the dark on the spot
		   (nothing slides in from below), as in the original section. */
		margin-top: calc(var(--app-stable-vh, 1svh) * -100);
		height: calc(var(--app-stable-vh, 1svh) * 100 * var(--screens));
	}
	.swb__stage {
		position: sticky;
		top: 0;
		height: calc(var(--app-stable-vh, 1svh) * 100);
		overflow: hidden;
		background: #000;
	}
	/* --band is the edge blur bands' height (utils/gradualBlur.js): the copy
	   stands clear of it, so the bands never blur the text. */
	.swb__stage { --band: clamp(5.5rem, 6vw, 7rem); }
	.swb__frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #000;
	}
	.swb__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* Without WebGL the images themselves cross-fade (the script sets opacity). */
	.swb__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 70%;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
	.swb--fallback .swb__img { visibility: visible; }
	.swb--fallback .swb__canvas { display: none; }

	/* Type and spacing are the original section's (title, card title, line,
	   text link, closing panels) — only the layout around them is new. */

	/* The opener: the title and its link alone in the dark, before the first picture. */
	.swb__intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		pointer-events: none;
		will-change: opacity, filter;
	}
	/* In from blur once the view is pinned (time-based, like the other sections'
	   headings); scrolling back up it goes out quicker. The script sets .in. */
	.swb__intro .swb__title,
	.swb__intro .sw-link {
		transition: opacity 0.8s ease, filter 1s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
	}
	.swb__intro:not(.in) .swb__title,
	.swb__intro:not(.in) .sw-link {
		opacity: 0;
		filter: blur(14px);
		transform: translateY(14px);
		transition: opacity 0.45s ease, filter 0.5s ease, transform 0.5s ease;
	}
	.swb__intro.in .sw-link { transition-delay: 0.15s; }
	.swb__title {
		margin: 0 0 2.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Every letter carries its own shadow (no box, no cloud): a tight dark edge
	   plus wider layers, so each line reads on bright and busy pictures alike. */
	.swb__slide {
		position: absolute;
		left: calc(var(--site-gutter, 2rem) + 1rem);
		bottom: calc(var(--band) + 3.5rem);
		width: min(30rem, calc(100% - 2 * (var(--site-gutter, 2rem) + 1rem)));
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		--ink-shadow:
			0 0 1px rgb(0 0 0 / 1),
			0 1px 2px rgb(0 0 0 / 0.95),
			0 0 5px rgb(0 0 0 / 0.95),
			0 0 12px rgb(0 0 0 / 0.85),
			0 0 26px rgb(0 0 0 / 0.75),
			0 0 52px rgb(0 0 0 / 0.6),
			0 0 90px rgb(0 0 0 / 0.4);
		opacity: 0;
		visibility: hidden;
		will-change: opacity, filter, transform;
	}
	/* The picture as a link: one per project, only the one on screen answers,
	   and only to a mouse. */
	.swb__hit {
		position: absolute;
		inset: 0;
		display: block;
		pointer-events: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.swb__hit.is-active { pointer-events: auto; cursor: pointer; }
	}
	.swb__name { display: block; text-decoration: none; }
	.swb__slide h3 {
		text-shadow: var(--ink-shadow);
		margin: 0 0 0.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 2.2rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__slide p {
		text-shadow: var(--ink-shadow);
		margin: 0 0 1.4rem;
		max-width: 340px;
		font-family: var(--f-body);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.9);
	}
	/* Explore is the site's own button (.h-hero-cta, as START A PROJECT), small,
	   under the text on the left. Only its size and backdrop are set here: dark
	   glass with a blur, the way the top-bar button does it (.nav-cta in
	   global.css), so it reads over any picture. A small element: the blur is
	   cheap. */
	.swb__cta { width: auto !important; max-width: none !important; margin: 0; }
	.swb__cta .h-hero-cta {
		--cta-bg: rgb(0 0 0 / 0.55);
		min-height: 46px;
		min-width: 11rem;
		padding: 0.7rem 1.8rem;
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
	}

	/* Text link whose underline draws in on hover. (Size and tracking come
	   from the global .link-btn rule.) */
	.sw-link {
		position: relative;
		padding-bottom: 3px;
		font-family: var(--f-body);
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.sw-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.sw-link:hover { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-link:hover::after { transform: scaleX(1); }
	}

	/* After the pinned view: the two closing screens, in the page's own
	   background, centred, as before. */
	.swb-panel {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding-left: 12vw;
		padding-right: 12vw;
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}
	.swb-panel h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
	}
	/* (The old carousel's last slide, the A.I. / DESIGN / DEVELOPMENT / BRANDING
	   line, is gone: the Services section already says it.) */
	.swb-cover { gap: 2.5rem; padding-top: clamp(6rem, 16vh, 11rem); padding-bottom: clamp(5rem, 14vh, 10rem); }
	.swb-cover h2 { font-size: clamp(2rem, 3.8vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
	.swb-cover__cta { width: auto !important; margin: 0; }

	@media (min-width: 1025px) and (max-width: 1600px) {
		.swb__title { font-size: clamp(3rem, 6vw, 8rem); }
	}
	/* Phones and tablets: the original's smaller steps. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb__intro { padding: 0 6vw; }
		.swb__title { margin-bottom: 2rem; font-size: clamp(3rem, 15vw, 6rem); }
		.swb__slide { left: var(--site-gutter, 2rem); bottom: calc(var(--band) + 1.75rem); width: calc(100% - 2 * var(--site-gutter, 2rem)); }
		/* (the shadow is on the letters themselves, see --ink-shadow) */
		.swb__slide h3 { font-size: clamp(1.25rem, 5.4vw, 1.9rem); }
		.swb__slide p { font-size: 0.95rem; line-height: 1.55; max-width: none; margin-bottom: 1.2rem; }
		.swb-panel { padding-left: 8vw; padding-right: 8vw; }
		.swb-cover { gap: 1.75rem; }
		.swb-cover h2 { font-size: clamp(1.5rem, 6.8vw, 3rem); }
	}
	/* Tablets: a card title one step under the page titles (as in the original). */
	@media (min-width: 700px) and (max-width: 1024px), (min-width: 700px) and (hover: none) and (pointer: coarse) {
		.swb__slide h3 { font-size: calc(var(--hero-size) * 0.55); }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';

	gsap.registerPlugin(ScrollTrigger);

	const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
	const smooth = (v: number) => { v = clamp(v); return v * v * (3 - 2 * v); };
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let cleanup: (() => void) | null = null;

	function initWork() {
		cleanup?.();
		cleanup = null;

		const wrap = document.getElementById('sw-scroll-section');
		const stage = wrap?.querySelector<HTMLElement>('.swb__stage');
		const canvas = wrap?.querySelector<HTMLCanvasElement>('.swb__canvas');
		const frame = wrap?.querySelector<HTMLElement>('.swb__frame');
		if (!wrap || !stage || !canvas || !frame) return;

		const n = Number(wrap.dataset.n) || 1;
		const hold = Number(wrap.dataset.hold) || 0;
		const images = Array.from(wrap.querySelectorAll<HTMLImageElement>('.swb__img'));
		const slides = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__slide'));
		const hits = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__hit'));
		const intro = wrap.querySelector<HTMLElement>('.swb__intro')!;
		const root = document.documentElement;

		// Phones and tablets: each picture rests for about a screen of scroll
		// before and after the beam (which keeps the hero's one-screen sweep), so
		// the text and the button can be reached with a thumb; on a mouse the rest
		// is short.
		// With the snap below every picture comes to rest exactly on its own stop, so
		// the same numbers do for a mouse and a finger.
		const lenis = (window as any).__lenis;
		const snapOn = !!lenis && !reduced();
		const RANGE: [number, number] = [0.15, 0.85];
		const TEXT_HOLD = 0.05;   // |pos - frame| below which the text is fully in
		const TEXT_FADE = 0.13;   // ... and the distance over which it goes out
		const fallback = () => stage.classList.add('swb--fallback');
		let beam: BeamSlides | null = null;
		if (reduced()) fallback();
		else {
			beam = createBeamSlides(canvas, images, fallback, RANGE);
			if (!beam) fallback();
		}

		let pos = 0;      // 0 .. n: the dark, then each project in turn

		const show = (el: HTMLElement, o: number) => {
			el.style.opacity = o.toFixed(3);
			el.style.visibility = o < 0.02 ? 'hidden' : 'visible';
			el.style.filter = o >= 0.999 ? '' : `blur(${((1 - o) * 14).toFixed(1)}px)`;
		};

		const render = () => {
			beam?.setPos(pos);
			// the opener goes out (blur) as the first picture comes
			const t = 1 - smooth(pos / 0.2);
			intro.style.opacity = t.toFixed(3);
			intro.style.filter = t >= 0.999 ? '' : `blur(${((1 - t) * 16).toFixed(1)}px)`;
			intro.style.pointerEvents = t > 0.5 && intro.classList.contains('in') ? 'auto' : 'none';
			slides.forEach((el, i) => {
				const o = 1 - smooth((Math.abs(pos - (i + 1)) - TEXT_HOLD) / TEXT_FADE);
				show(el, o);
				el.style.transform = o >= 0.999 ? '' : `translateY(${((1 - o) * 14).toFixed(1)}px)`;
				el.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
				hits[i]?.classList.toggle('is-active', o > 0.5);
			});
			if (stage.classList.contains('swb--fallback')) {
				images.forEach((im, k) => { im.style.opacity = (1 - smooth((Math.abs(pos - (k + 1)) - 0.1) / 0.5)).toFixed(3); });
			}
		};

		// How much scroll each step takes: one screen, as the home hero's exit. The title
		// first stands alone for LEAD screens, then each picture gets PER screens.
		const LEAD = 0.8;
		const PER = 1;
		const length = LEAD + PER * (n + hold);   // in screens
		wrap.style.setProperty('--screens', String(length + 1));
		const setFrom = (progress: number) => { pos = clamp((progress * length - LEAD) / PER, 0, n); render(); };

		// The edge blur bands stay on over the pictures; while the view is pinned
		// they run light and, on phones, off (the original behaviour of this
		// section, global.css html.sw-hscroll).
		const sync = (st: ScrollTrigger) => {
			const pinned = st.scroll() >= st.start;
			intro.classList.toggle('in', pinned);
			// Hidden until its pin starts: pulled up a screen, its black stage would
			// otherwise slide up over the manifesto's last screen like a curtain
			// (and scrolling back up it goes away the same way).
			stage.style.visibility = pinned ? '' : 'hidden';
			root.classList.toggle('sw-hscroll', st.isActive);
		};
		const stPin = ScrollTrigger.create({
			trigger: wrap, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
			onUpdate: (s) => { setFrom(s.progress); sync(s); },
			onRefresh: (s) => { setFrom(s.progress); sync(s); },
			onToggle: sync,
		});
		render();

		// ── The snap ───────────────────────────────────────────────────────────
		// The mechanism of the Forge stock page (read from its code, not guessed):
		// the light FOLLOWS the wheel or the finger, and the snap decides on release.
		//  - wheel / trackpad: once it has been quiet for 200 ms and the smooth
		//    scroll has settled, go on to the next picture if the scroll got far enough
		//    towards it (DEPART of the gap), else fall back to the one it left; 0.45 s on
		//    a critically damped ease (damping 5).
		//  - finger: on release, under 32 px of drag the picture stays (falls back),
		//    over it the next or previous one comes, 0.5 s on the same ease.
		// Before the first and after the last picture the page scrolls freely. Needs the
		// site's Lenis; without it (or with reduced motion) the light just follows.
		let snapOff = () => {};
		if (snapOn) {
			const WHEEL_IDLE = 200;     // ms of quiet before the wheel snap decides
			const WHEEL_DUR = 0.45;     // s
			const DEPART = 0.15;        // share of the gap to have travelled (Forge: 0.5 at a 1x wheel; ours is 0.3x)
			const TOUCH_DUR = 0.5;      // s
			const TOUCH_MIN = 32;       // px of drag
			const settle = (t: number) => { const k = 5; return (1 - (1 + k * t) * Math.exp(-k * t)) / (1 - (1 + k) * Math.exp(-k)); };
			const unit = () => (stPin.end - stPin.start) / length;   // one screen of scroll
			const stop = (k: number) => stPin.start + (LEAD + PER * k) * unit();
			const inZone = (y: number) => y > stop(0) - 0.6 * unit() && y < stop(n) + 0.45 * unit();
			const nearest = (y: number) => {
				let b = 0;
				for (let k = 1; k <= n; k++) if (Math.abs(stop(k) - y) < Math.abs(stop(b) - y)) b = k;
				return b;
			};
			let snapping = false;
			let touching = false;
			let idle = 0, fail = 0;
			let touchY = 0, touchAnchor = 0;

			const go = (k: number, duration: number) => {
				snapping = true;
				clearTimeout(fail);
				fail = window.setTimeout(() => { snapping = false; }, 3000);   // never stay stuck
				lenis.scrollTo(stop(k), {
					duration,
					easing: settle,
					force: true,
					onComplete: () => { clearTimeout(fail); snapping = false; },
				});
			};

			// the wheel: decide after it has been quiet
			const decide = () => {
				idle = 0;
				if (snapping || touching || root.classList.contains('pt-restoring')) return;
				if (Math.abs(lenis.targetScroll - lenis.animatedScroll) > 12) { idle = window.setTimeout(decide, 50); return; }
				const y = lenis.targetScroll;
				if (!inZone(y)) return;
				const lo = Math.max(0, Math.min(n - 1, Math.floor((y - stop(0)) / (PER * unit()))));
				const a = stop(lo), c = stop(lo + 1);
				if (y <= a + 1) { if (Math.abs(y - a) > 1) go(lo, WHEEL_DUR); return; }
				if (y >= c - 1) { if (Math.abs(y - c) > 1) go(lo + 1, WHEEL_DUR); return; }
				const forward = lenis.direction >= 0;
				const need = (c - a) * DEPART;
				// moving on: got far enough from the one it left; moving back: far enough from the next
				go(forward ? (y - a >= need ? lo + 1 : lo) : (c - y >= need ? lo : lo + 1), WHEEL_DUR);
			};
			const onScroll = () => {
				if (snapping || touching) return;
				window.clearTimeout(idle);
				idle = window.setTimeout(decide, WHEEL_IDLE);
			};

			// the finger: decide on release
			const onTouchStart = (e: TouchEvent) => {
				window.clearTimeout(idle);
				if (e.touches.length !== 1) return;
				touching = true;
				touchY = e.touches[0].clientY;
				touchAnchor = nearest(lenis.scroll);
			};
			const onTouchEnd = (e: TouchEvent) => {
				if (!touching || e.touches.length) return;
				touching = false;
				const end = e.changedTouches[0]?.clientY ?? touchY;
				const drag = touchY - end;   // + = scrolling on
				if (!inZone(lenis.scroll)) return;
				if (Math.abs(drag) < TOUCH_MIN) { go(touchAnchor, TOUCH_DUR); return; }
				const k = touchAnchor + (drag > 0 ? 1 : -1);
				if (k < 0 || k > n) return;   // past the first / last picture: free scroll
				go(k, TOUCH_DUR);
			};
			lenis.on('scroll', onScroll);
			window.addEventListener('touchstart', onTouchStart, { passive: true });
			window.addEventListener('touchend', onTouchEnd, { passive: true });
			window.addEventListener('touchcancel', onTouchEnd, { passive: true });
			snapOff = () => {
				lenis.off('scroll', onScroll);
				window.removeEventListener('touchstart', onTouchStart);
				window.removeEventListener('touchend', onTouchEnd);
				window.removeEventListener('touchcancel', onTouchEnd);
				window.clearTimeout(idle);
				window.clearTimeout(fail);
			};
		}

		const ro = new ResizeObserver(() => beam?.resize());
		ro.observe(frame);

		cleanup = () => {
			snapOff();
			stPin.kill();
			ro.disconnect();
			beam?.destroy();
			root.classList.remove('sw-hscroll');
		};
	}

	document.addEventListener('astro:page-load', initWork);

	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
