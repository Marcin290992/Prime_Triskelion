---
import { Image } from 'astro:assets';
import deeer2 from '../../img/deeer2.webp';
import imgUnfall from '../../img/services/websites.jpg';
import imgMousa from '../../img/process/development.jpg';

// Selected work as full-screen frames: one pinned screen on every device, the
// scroll melts one project into the next along a band of light (WebGL, see
// utils/beamSlides.ts). The old horizontal carousel / phone strip is kept in
// components/backup/SelectedWorkSection.before-beam.astro.
//
// Pictures are stored locally (the site's CSP blocks remote images). Swap each
// for the project's own shot (wide, ~2400px). `fx` is where its subject sits
// across the picture (0 left .. 1 right): on a portrait screen the picture is
// cropped to a narrow window, and this keeps the subject (the deer) in it.
const projects = [
	{ title: 'Winds of Sinai', desc: 'Luxury travel brand identity & digital presence', img: deeer2, fx: 0.15, href: '/projects/winds-of-sinai/' },
	{ title: 'UnfallFix24', desc: 'Accident reporting & claims management platform', img: imgUnfall, fx: 0.5, href: '/work/unfallfix24' },
	{ title: 'Mousa Export', desc: 'International export logistics platform', img: imgMousa, fx: 0.5, href: '/work/mousa-export' },
];

// Scroll length: see LEAD / PER in the script (one screen per step, the snap lands each picture exactly). The
// value here is only the no-JS default.
const HOLD = 0.4;
const SCREENS = projects.length + HOLD;
---
<section id="selected-work">

	<!-- #sw-scroll-section keeps its id: HeroSection's menu button waits for it. -->
	<div class="swb" id="sw-scroll-section" data-n={projects.length} data-hold={HOLD} style={`--screens:${SCREENS + 1}`}>
		<div class="swb__stage">

			<!-- The picture fills the screen; the edge blur bands stay on over it
			     (lighter while this view is pinned, see global.css). -->
			<div class="swb__frame">
				<canvas class="swb__canvas" aria-hidden="true"></canvas>

				<!-- The same pictures, as ordinary images: they are the textures of the
				     canvas, and the cross-fade for browsers without WebGL. -->
				{projects.map((p) => (
					<Image class="swb__img" src={p.img} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="async" data-fx={p.fx} />
				))}

			</div>

			<div class="swb__intro">
				<h2 class="swb__title" aria-label="What we've created."><span class="swb__w">What</span> <span class="swb__w">we've</span><br><em><span class="swb__w">created.</span></em></h2>
				<a href="/projects" class="link-btn sw-link">View All Projects</a>
			</div>

			<!-- The picture itself opens the project too, with a mouse only (CSS below):
			     on a touch screen it is the scrolling surface, and a tap to stop it
			     must not open anything. Real links, so they prefetch and middle-click. -->
			{projects.map((p) => (
				<a class="swb__hit" href={p.href} tabindex="-1" aria-hidden="true"></a>
			))}

			{projects.map((p) => (
				<div class="swb__slide">
					<div>
						<a href={p.href} class="swb__name"><h3>{p.title}</h3></a>
						<p>{p.desc}</p>
					</div>
					<div class="h-hero-cta-wrap swb__cta">
						<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
						<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
						<a href={p.href} class="h-hero-cta h-hero-cta--fixed">
							<span class="hud-spin-border"></span>
							<span class="h-hero-cta__text">Explore</span>
						</a>
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="swb-panel swb-cover">
		<h2>Discover my complete collection of digital experiences, brands, and platforms.</h2>
		<div class="h-hero-cta-wrap swb-cover__cta">
			<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
			<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
			<a href="/projects" class="h-hero-cta h-hero-cta--fixed">
				<span class="hud-spin-border"></span>
				<span class="h-hero-cta__text">Explore more projects</span>
			</a>
		</div>
	</div>

</section>

<style>
	#selected-work {
		position: relative;
		z-index: 44;
		color: rgb(var(--c-cream));
		/* (no background of its own: pulled up a screen, it would paint over the
		   manifesto's last screen; the stage and the closing panel have theirs) */
	}

	/* The pinned view is sticky (not a script pin): the height is the scroll
	   length, in the locked screen height so a phone's moving address bar
	   cannot stretch it. */
	.swb {
		position: relative;
		/* Pulled up by one screen, so the pinned view takes over exactly where the
		   manifesto's pin ends: the title comes up out of the dark on the spot
		   (nothing slides in from below), as in the original section. */
		margin-top: calc(var(--app-stable-vh, 1svh) * -100);
		height: calc(var(--app-stable-vh, 1svh) * 100 * var(--screens));
	}
	.swb__stage {
		position: sticky;
		top: 0;
		height: calc(var(--app-stable-vh, 1svh) * 100);
		overflow: hidden;
		background: #000;
	}
	/* --band is the edge blur bands' height (utils/gradualBlur.js): the copy
	   stands clear of it, so the bands never blur the text. */
	.swb__stage { --band: clamp(5.5rem, 6vw, 7rem); }
	.swb__frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #000;
	}
	.swb__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* Without WebGL the images themselves cross-fade (the script sets opacity). */
	.swb__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 70%;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
	.swb--fallback .swb__img { visibility: visible; }
	.swb--fallback .swb__canvas { display: none; }

	/* Type and spacing are the original section's (title, card title, line,
	   text link, closing panels) — only the layout around them is new. */

	/* The opener: the title and its link alone in the dark, before the first picture. */
	.swb__intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		pointer-events: none;
		will-change: opacity, filter;
	}
	/* The words come in, hold and go out on the scroll (a scrubbed timeline, the
	   Manifesto's own: see the script). */
	.swb__w { display: inline-block; }
	.swb__title {
		margin: 0 0 2.5rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(3.5rem, 8vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__title em { font-style: normal; color: rgb(var(--c-red)); }

	/* Every letter carries its own shadow (no box, no cloud): a tight dark edge
	   plus wider layers, so each line reads on bright and busy pictures alike. */
	.swb__slide {
		/* Centred, in the middle of the picture, as on the Forge stock listing: title,
		   line and button one under the other. (The slide is only the layout box; the
		   pictures' own link stays clickable under it, see pointer-events.) */
		position: absolute;
		inset: 0;
		padding: calc(var(--band) + 1rem) var(--site-gutter, 2rem);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: none;
		--ink-shadow:
			0 0 1px rgb(0 0 0 / 1),
			0 1px 2px rgb(0 0 0 / 0.95),
			0 0 5px rgb(0 0 0 / 0.95),
			0 0 12px rgb(0 0 0 / 0.85),
			0 0 26px rgb(0 0 0 / 0.75),
			0 0 52px rgb(0 0 0 / 0.6),
			0 0 90px rgb(0 0 0 / 0.4);
		opacity: 0;
		visibility: hidden;
		will-change: opacity, filter, transform;
	}
	/* The picture as a link: one per project, only the one on screen answers,
	   and only to a mouse. */
	.swb__hit {
		position: absolute;
		inset: 0;
		display: block;
		pointer-events: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.swb__hit.is-active { pointer-events: auto; cursor: pointer; }
	}
	.swb__name { display: block; text-decoration: none; pointer-events: auto; }
	.swb__slide .swb__cta { pointer-events: auto; }
	.swb__slide h3 {
		text-shadow: var(--ink-shadow);
		margin: 0 0 0.9rem;
		font-family: var(--f-display);
		font-weight: 600;
		font-size: clamp(2rem, 4vw, 4rem);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: rgb(var(--c-cream));
	}
	.swb__slide p {
		text-shadow: var(--ink-shadow);
		margin: 0 auto 1.8rem;
		max-width: 36rem;
		font-family: var(--f-body);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.6;
		color: rgb(var(--c-cream) / 0.9);
	}
	/* Explore is the site's own button (.h-hero-cta, as START A PROJECT), small,
	   under the text on the left. Only its size and backdrop are set here: dark
	   glass with a blur, the way the top-bar button does it (.nav-cta in
	   global.css), so it reads over any picture. A small element: the blur is
	   cheap. */
	.swb__cta { width: auto !important; max-width: none !important; margin: 0; }
	.swb__cta .h-hero-cta {
		--cta-bg: rgb(0 0 0 / 0.55);
		min-height: 46px;
		min-width: 11rem;
		padding: 0.7rem 1.8rem;
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
	}

	/* Text link whose underline draws in on hover. (Size and tracking come
	   from the global .link-btn rule.) */
	.sw-link {
		position: relative;
		padding-bottom: 3px;
		font-family: var(--f-body);
		color: rgb(var(--c-cream) / 0.65);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s ease, transform 0.35s cubic-bezier(0.25,1,0.5,1);
	}
	.sw-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: rgb(var(--c-cream));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
	}
	@media (hover: hover) {
		.sw-link:hover { color: rgb(var(--c-cream)); transform: translateX(5px); }
		.sw-link:hover::after { transform: scaleX(1); }
	}

	/* After the pinned view: the two closing screens, in the page's own
	   background, centred, as before. */
	.swb-panel {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding-left: 12vw;
		padding-right: 12vw;
		background: rgb(var(--c-bg));
		color: rgb(var(--c-cream));
	}
	.swb-panel h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 600;
		text-transform: uppercase;
	}
	/* (The old carousel's last slide, the A.I. / DESIGN / DEVELOPMENT / BRANDING
	   line, is gone: the Services section already says it.) */
	.swb-cover { gap: 2.5rem; padding-top: clamp(6rem, 16vh, 11rem); padding-bottom: clamp(5rem, 14vh, 10rem); }
	.swb-cover h2 { font-size: clamp(2rem, 3.8vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
	.swb-cover__cta { width: auto !important; margin: 0; }

	@media (min-width: 1025px) and (max-width: 1600px) {
		.swb__title { font-size: clamp(3rem, 6vw, 8rem); }
	}
	/* Touch: no filter blur on the opener (it stutters), a light backdrop on the button. */
	@media all {
		.swb__intro, .swb__slide { will-change: opacity, transform; }
		.swb__cta .h-hero-cta { -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
	}
	/* Phones and tablets: the original's smaller steps. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.swb__intro { padding: 0 6vw; }
		.swb__title { margin-bottom: 2rem; font-size: clamp(3rem, 15vw, 6rem); }
		.swb__slide { padding: calc(var(--band) + 0.5rem) var(--site-gutter, 1.25rem); }
		/* (the shadow is on the letters themselves, see --ink-shadow) */
		.swb__slide h3 { font-size: clamp(1.8rem, 8vw, 2.6rem); }
		.swb__slide p { font-size: 0.95rem; line-height: 1.55; max-width: none; margin-bottom: 1.2rem; }
		.swb-panel { padding-left: 8vw; padding-right: 8vw; }
		.swb-cover { gap: 1.75rem; }
		.swb-cover h2 { font-size: clamp(1.5rem, 6.8vw, 3rem); }
	}
	/* Tablets: a card title one step under the page titles (as in the original). */
	@media (min-width: 700px) and (max-width: 1024px), (min-width: 700px) and (hover: none) and (pointer: coarse) {
		.swb__slide h3 { font-size: calc(var(--hero-size) * 0.55); }
	}
</style>

<script>
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import { createBeamSlides, type BeamSlides } from '../../utils/beamSlides';

	gsap.registerPlugin(ScrollTrigger);

	const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
	const smooth = (v: number) => { v = clamp(v); return v * v * (3 - 2 * v); };
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let cleanup: (() => void) | null = null;

	// ── Selected work, after the Forge stock page ─────────────────────────────
	// The section is pinned for one screen of scroll per picture. The light is
	// scrubbed by the scroll itself (wheel, trackpad or finger: the beam sits
	// exactly where the page is, no clock, no captured input). When the scroll
	// stops for ~200 ms it is eased to the nearest picture (or the dark title) with
	// the site's Lenis, over 0.45 s plus a little for the distance, on a critically
	// damped curve. Outside the pinned range (before the title, after the last
	// picture) nothing snaps and the page just scrolls.
	function initWork() {
		cleanup?.();
		cleanup = null;

		const wrap = document.getElementById('sw-scroll-section');
		const stage = wrap?.querySelector<HTMLElement>('.swb__stage');
		const canvas = wrap?.querySelector<HTMLCanvasElement>('.swb__canvas');
		const frame = wrap?.querySelector<HTMLElement>('.swb__frame');
		if (!wrap || !stage || !canvas || !frame) return;

		const n = Number(wrap.dataset.n) || 1;
		const images = Array.from(wrap.querySelectorAll<HTMLImageElement>('.swb__img'));
		const slides = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__slide'));
		const hits = Array.from(wrap.querySelectorAll<HTMLElement>('.swb__hit'));
		const intro = wrap.querySelector<HTMLElement>('.swb__intro')!;
		const root = document.documentElement;

		const RANGE: [number, number] = [0.25, 0.8];   // text out (0..0.21) -> light (0.25..0.8) -> text in (0.79..1)
		const TEXT_HOLD = 0.05;        // |pos - frame| below which the text is fully in
		const TEXT_FADE = 0.16;        // ... and the distance over which it goes out

		const fallback = () => stage.classList.add('swb--fallback');
		let beam: BeamSlides | null = null;
		if (reduced()) fallback();
		else {
			beam = createBeamSlides(canvas, images, fallback, RANGE);
			if (!beam) fallback();
		}

		let pos = 0;      // 0 .. n: the dark with the title, then each project in turn

		// Phones and tablets: no blur filters on the text while scrolling (they stutter);
		// opacity and a small lift only.
		const light = true;

		// ── the opener: the Manifesto's own timeline, scrubbed by the scroll ──
		// faint blurred words (blur 8px, opacity .15) -> focus one by one (stagger .1) ->
		// held with a slow push-in (scale 1.04) -> the whole block out into blur 7px and
		// the dark (sine.inOut) -> a breath of black. Same numbers, same scroll length
		// (the Manifesto's pin is 160% of a screen).
		const LEAD = 1.6;
		// The entrance is the home hero's claim: out of the dark, each word on its own
		// focus pull (opacity sine.inOut, blur power2.inOut, scale 1.04 -> 1 power2.out,
		// stagger .2), the link after them like the hero's supporting lines.
		const title = [...intro.querySelectorAll<HTMLElement>('.swb__w')];
		const link = intro.querySelector<HTMLElement>('.sw-link')!;
		const HOLD = 1.5;
		const blurIn = window.matchMedia('(max-width: 1024px)').matches ? 16 : 24;
		gsap.set(title, { opacity: 0, filter: `blur(${blurIn}px)`, scale: 1.04 });
		gsap.set(link, { opacity: 0, filter: 'blur(10px)', y: 12 });
		gsap.set(intro, { transformOrigin: '50% 50%' });
		const tl = gsap.timeline({ paused: true });
		const AT = 1.0;   // the dark first, as the Manifesto's lead-in
		tl.to(title, { opacity: 1, duration: 0.8, ease: 'sine.inOut', stagger: 0.2 }, AT)
		  .to(title, { filter: 'blur(0px)', duration: 1.3, ease: 'power2.inOut', stagger: 0.2 }, AT)
		  .to(title, { scale: 1, duration: 1.5, ease: 'power2.out', stagger: 0.2 }, AT)
		  .to(link, { opacity: 1, duration: 0.7, ease: 'sine.inOut' }, AT + 0.7)
		  .to(link, { filter: 'blur(0px)', y: 0, duration: 1.0, ease: 'power2.inOut' }, AT + 0.7);
		const tlIn = tl.duration();                           // when everything is whole
		tl.to(intro, { scale: 1.04, duration: HOLD, ease: 'none' }, '>');
		tl.to(intro, { filter: 'blur(7px)', opacity: 0, duration: 1.6, ease: 'sine.inOut' }, tl.duration());
		tl.to({}, { duration: 0.15 });
		const tlOut = tlIn + HOLD;                            // when the exit begins
		let introP = 0;

		const show = (el: HTMLElement, o: number) => {
			el.style.opacity = o.toFixed(3);
			el.style.visibility = o < 0.02 ? 'hidden' : 'visible';
			el.style.filter = light || o >= 0.999 ? '' : `blur(${((1 - o) * 14).toFixed(1)}px)`;
		};

		// Text drift, as the Forge copy: it travels with the scroll but a part of that is
		// taken back by a counter-drift (their yPercent -a..+a on a half-screen block), so
		// it crosses the screen slower than the page. Net: -(1 - a/2) screens per screen
		// of scroll, a = 0.5 on desktop, 0.2 on phones/tablets.
		const drift = () => (window.matchMedia('(min-width: 1024px)').matches ? 0.75 : 0.9);
		let vhPx = window.innerHeight;
		let driftK = drift();
		const measure = () => { vhPx = stage.getBoundingClientRect().height || window.innerHeight; driftK = drift(); };
		measure();
		window.addEventListener('resize', measure);

		const render = () => {
			beam?.setPos(pos);
			tl.progress(introP);
			const tt = introP * tl.duration();
			intro.style.pointerEvents = tt > tlIn - 0.3 && tt < tlOut + 0.4 ? 'auto' : 'none';
			slides.forEach((el, i) => {
				const o = 1 - smooth((Math.abs(pos - (i + 1)) - TEXT_HOLD) / TEXT_FADE);
				show(el, o);
				el.style.transform = `translate3d(0, ${(-(pos - (i + 1)) * driftK * vhPx).toFixed(1)}px, 0)`;
				hits[i]?.classList.toggle('is-active', o > 0.5);
			});
			if (stage.classList.contains('swb--fallback')) {
				images.forEach((im, k) => { im.style.opacity = (1 - smooth((Math.abs(pos - (k + 1)) - 0.1) / 0.5)).toFixed(3); });
			}
		};

		const ro = new ResizeObserver(() => beam?.resize());
		ro.observe(frame);
		const offs: Array<() => void> = [() => ro.disconnect(), () => beam?.destroy(), () => window.removeEventListener('resize', measure)];

		// ── the light follows the scroll through a pinned section ──
		// one step (title -> picture, picture -> picture) takes only PER of a screen of scroll
		const PER = 1;
		wrap.style.setProperty('--screens', String(1 + LEAD - RANGE[0] + n * PER));
		const here = (sc: ScrollTrigger) => {
			stage.style.visibility = sc.scroll() >= sc.start ? '' : 'hidden';
		};
		// d = scroll into the pinned view: the first LEAD screens are the opener (the
		// Manifesto's timeline), then PER of a screen per picture.
		const apply = (sc: ScrollTrigger) => {
			const vh = stage.getBoundingClientRect().height || window.innerHeight;
			const d = Math.max(0, sc.scroll() - sc.start);
			introP = clamp(d / (LEAD * vh));
			// the light starts (RANGE[0] into the first step) the moment the title is gone: no dead scroll
			pos = clamp((d - (LEAD - RANGE[0]) * vh) / (PER * vh), 0, n);
			here(sc);
			render();
		};
		const st = ScrollTrigger.create({
			trigger: wrap, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
			onUpdate: apply,
			onRefresh: apply,
			onToggle: (sc) => { here(sc); root.classList.toggle('sw-hscroll', sc.isActive); },
		});
		render();
		offs.push(() => { st.kill(); root.classList.remove('sw-hscroll'); });

		// ── snap on release (Forge): when the scroll rests, settle on the nearest picture ──
		// The site's Lenis is created a frame AFTER page-load (Layout), so it is not there
		// yet when this runs: wait for it, then hang the snap on it.
		const attachSnap = (lenis: any) => {
			const settle = (t: number) => { const c = 5; return (1 - (1 + c * t) * Math.exp(-c * t)) / (1 - (1 + c) * Math.exp(-c)); };
			let timer = 0;
			let snapping = false;
			let dir = 1;                // which way the last move went
			let last = lenis.scroll;
			let freeTimer = 0;
			const touch = window.matchMedia('(pointer: coarse)').matches;
			let fingerDown = false;   // never snap under a finger that is still on the glass
			const snap = () => {
				if (fingerDown || lenis.isStopped || document.body.classList.contains('oxygen-menu-open') || root.classList.contains('pt-restoring')) return;
				const r = wrap.getBoundingClientRect();
				const vh = stage.getBoundingClientRect().height || window.innerHeight;
				const start = r.top + window.scrollY + (LEAD - RANGE[0]) * vh;   // scroll where pos = 0
				const y = lenis.scroll;
				const gap = PER * vh;                                // scroll length of one step
				if (y < start + RANGE[0] * gap - 1 || y > start + n * gap + 1) return; // the opener and what follows: free scroll
				// Forge: settle on the NEAREST stop, whatever the device.
				const to = Math.max(1, Math.round((y - start) / gap));   // never back into the title
				const nearest = start + clamp(to, 0, n) * gap;
				const dist = Math.abs(nearest - y);
				if (dist < 1) return;
				snapping = true;
				const dur = 0.45 + Math.min(0.75, dist / vh);   // Forge
				window.clearTimeout(freeTimer);
				freeTimer = window.setTimeout(() => { snapping = false; }, dur * 1000 + 150);   // never stay stuck if the tween is interrupted
				lenis.scrollTo(nearest, {
					duration: dur,
					easing: settle,
					force: true,
					onComplete: () => { snapping = false; },
				});
			};
			const onScroll = () => {
				const d = lenis.scroll - last;
				last = lenis.scroll;
				if (snapping) return;
				if (Math.abs(d) > 0.2) dir = d > 0 ? 1 : -1;
				// Forge: 200 ms after the last scroll event (the momentum tail included).
				window.clearTimeout(timer);
				timer = window.setTimeout(() => { timer = 0; snap(); }, 200);
			};
			// the user taking over during a snap hands the scroll back at once
			const onInput = () => { snapping = false; };
			const down = () => { fingerDown = true; snapping = false; window.clearTimeout(timer); timer = 0; };
			const up = () => { fingerDown = false; window.clearTimeout(timer); timer = window.setTimeout(() => { timer = 0; snap(); }, 200); };
			window.addEventListener('wheel', onInput, { passive: true });
			window.addEventListener('touchstart', down, { passive: true });
			window.addEventListener('touchend', up, { passive: true });
			window.addEventListener('touchcancel', up, { passive: true });
			lenis.on('scroll', onScroll);
			offs.push(() => { window.clearTimeout(timer); window.clearTimeout(freeTimer); window.removeEventListener('wheel', onInput); window.removeEventListener('touchstart', down); window.removeEventListener('touchend', up); window.removeEventListener('touchcancel', up); lenis.off('scroll', onScroll); });
		};
		if (!reduced()) {
			let tries = 0;
			let raf = 0;
			const wait = () => {
				const l = (window as any).__lenis;
				if (l) { attachSnap(l); return; }
				if (++tries < 180) raf = requestAnimationFrame(wait);
			};
			wait();
			offs.push(() => cancelAnimationFrame(raf));
		}
		cleanup = () => offs.forEach((f) => f());
	}

	document.addEventListener('astro:page-load', initWork);
	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
