		text-transform: uppercase;
		line-height: 1;
		text-align: center;
	}

	.h-hero-claim {
		position: relative;
		z-index: 31;
		margin: 0;
		font-family: var(--f-display);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: #e4e4e4;
		text-align: left;
	}
	.h-hero-claim__line { display: block; }
	.h-hero-claim__line:first-child { white-space: nowrap; }
	.h-hero-claim__line--word { color: #FF3E1E; }

	.h-hero-sub {
		margin: 1.25rem 0 0;
		max-width: 38ch;
		font-family: var(--f-body);
		font-size: clamp(0.98rem, 1.4vw, 1.4rem);
