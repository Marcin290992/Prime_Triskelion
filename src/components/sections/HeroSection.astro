<!-- ═══════ HERO 100vh ═══════ -->
<section id="hero" class="relative overflow-hidden" style="height:100vh;height:100lvh;height:calc(var(--app-stable-vh) * 100);min-height:100vh;min-height:100lvh;min-height:calc(var(--app-stable-vh) * 100);opacity:0">
	<canvas id="rays-canvas"></canvas>
	<div class="hero-vignette" aria-hidden="true"></div>
	<div class="relative h-full hero-grid" style="z-index:100">

		<!-- TOP / NAV -->
		<div class="hero-nav" id="hero-nav"></div>

		<!-- CENTER -->
		<div class="hero-stage">
			<div class="hero-center">
				<p class="hero-kicker">ONE-PERSON DESIGN STUDIO</p>
				<p class="h-hero-claim text-[2.2rem] sm:text-[2.8rem] md:text-[4.25rem] desk:text-[92px] mt-16 sm:mt-10 md:mt-6 desk:mt-6"><span class="h-hero-claim__line">I BUILD FOR</span><span class="h-hero-claim__line h-hero-claim__line--word"><span class="h-hero-word-wrap"><span class="h-hero-word" id="hero-dynamic-word">MOMENTUM</span></span></span></p>
				<p class="h-hero-sub">I design and build digital experiences that help ambitious brands move faster.</p>
				<div class="hero-cta-row">
					<div class="h-hero-cta-wrap mt-6 desk:mt-8" id="hero-main-cta-wrap">
						<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
						<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
						<a href="/contact" class="h-hero-cta h-hero-cta--fixed h-hero-cta--primary" id="hero-main-cta">
							<span class="hud-spin-border"></span>
							<span class="h-hero-cta__text">Start a project</span>
						</a>
					</div>
				</div>
				<div class="hero-bottom__stats hero-inline-stats" aria-label="Key performance metrics">
					<span class="hero-bottom__stat"><strong>5.0</strong><em>G2 REVIEWS</em></span>
					<span class="hero-bottom__sep" aria-hidden="true">•</span>
					<span class="hero-bottom__stat"><strong>7.5M+</strong><em>USERS REACHED</em></span>
					<span class="hero-bottom__sep" aria-hidden="true">•</span>
					<span class="hero-bottom__stat"><strong>0</strong><em>TEMPLATES</em></span>
				</div>
			</div>
		</div>

		<div class="hero-bottom" id="hero-bottom"></div>
	</div>
</section>

<!-- CTA — top right, desktop only, reveals once the hero scrolls out of view.
     Fixed at the page level (not inside #hero) so it stays put while scrolling. -->
<div class="hero-nav-cta-wrap h-hero-cta-wrap" id="hero-nav-cta-wrap">
	<div class="h-hero-cta-grad-top" aria-hidden="true"></div>
	<div class="h-hero-cta-grad-bottom" aria-hidden="true"></div>
	<a href="/contact" class="h-hero-cta hero-nav-cta nav-cta h-hero-cta--fixed h-hero-cta--primary">
		<span class="hud-spin-border"></span>
		<span class="h-hero-cta__text">Start a project</span>
	</a>
</div>

<style>
	/* ── Grid layout ── */
	.hero-grid {
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: clamp(1.2rem, 3vw, 2.25rem) var(--site-gutter) clamp(1.2rem, 2.8vw, 2.4rem);
		width: min(100%, var(--site-max-width));
		margin-inline: auto;
		box-sizing: border-box;
		position: relative;
	}
	.hero-grid::before {
		content: '';
		position: absolute;
		inset: 0;
		background: none;
		z-index: -1;
	}

	/* ── Nav ── */
	.hero-nav {
		grid-row: 1;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		overflow: hidden;
		min-height: 46px;
	}

	/* CTA — fixed top-right, hidden until scrolled past the hero, desktop only */
	.hero-nav-cta-wrap {
		position: fixed;
		top: clamp(0.85rem, 1.6vw, 1.35rem);
		right: clamp(1rem, 1.9vw, 1.8rem);
		z-index: 1002;
		pointer-events: none;
		opacity: 0;
		transform: translateY(-8px);
		transition: opacity 0.4s ease, transform 0.4s ease;
	}
	.hero-nav-cta-wrap.hero-nav-cta--visible {
		pointer-events: all;
		opacity: 1;
		transform: translateY(0);
	}
	/* Button appearance/sizing is the shared .nav-cta + .h-hero-cta--fixed
	   (global.css); TopBarCta on every other page uses the same pair. */
	@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
		.hero-nav-cta-wrap { display: none; }
	}
	/* ── Hero stage centered ── */
	.hero-stage {
		grid-row: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 0;
		width: 100%;
		margin-inline: auto;
	}

	/* ── Center ── */
	.hero-center {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		position: relative;
		padding-top: clamp(2rem, 5vh, 4rem);
		padding-bottom: clamp(1rem, 3vh, 2.25rem);
		max-width: 720px;
		width: 100%;
		z-index: 2;
	}

	/* ── Hero kicker / claim / sub ── */
	.hero-kicker {
		display: block;
		margin: 1.7rem 0 0;
		font-family: var(--f-body);
		font-size: 0.68rem;
